---
/* FabGuard: ONE place that keeps the floating buttons (Ask Fursat pill + the WhatsApp concierge) off the content.
   Zones: anything marked data-fab-avoid, the Home hero ribbon (.mq-strip), menu prices (.mv-item-price), book / add controls
   (.mv-open, .mb-add, .mb-plus, .mb-picks-bar, .mb-dock) and booking forms (form, fields). One IntersectionObserver, no per-scroll work.
   - <html data-fab-clear> (below 1024px): Ask Fursat steps aside while any zone is in the bottom band (unchanged behaviour).
   - <html data-wac-hide> (all widths): the concierge button fades out while a zone is in ITS corner (bottom-right band; on wider screens
     only zones that reach the right edge). It stays while its own panel is open. The footer is never observed (curtain footer). */
---
<style is:global>
@media (max-width: 1023px) {
  html[data-fab-clear] :is(.afab, .afab-ear) {
    opacity: 0 !important; visibility: hidden !important; pointer-events: none !important;
    transition: opacity .18s ease, visibility 0s .18s !important;
  }
}
@media (max-width: 767px) {
  html { scroll-padding-bottom: calc(var(--mb-clear, 76px) + 12px); }
}
</style>
<script is:inline>
(function () {
  var de = document.documentElement, ZONES = '[data-fab-avoid],.mq-strip,.mv-item-price,.mv-open,.mb-add,.mb-plus,.mb-picks-bar,.mb-dock,form,input:not([type=hidden]),select,textarea,.fk-btn,.fk-f-field';
  var io = null, inSet = new Set(), known = new WeakSet(), tm = 0, rt = 0, lastH = 0, lastW = 0;
  function bandPx() { return innerWidth < 768 ? 270 : 150; }
  function update() {
    var wide = innerWidth >= 1024, hitAsk = false, hitWac = false;
    for (var el of inSet) {
      if (el.closest('#fxsticky,#pb-dock,.mb-bar,.wac')) continue;     // fixed bars never count as content
      if (!wide) hitAsk = true;
      if (innerWidth < 768) hitWac = true;                           // phones: always counts (no rect needed)
      else {
        var r = el.getBoundingClientRect(), tall = r.height > innerHeight * 1.2;
        if (!tall && r.right > innerWidth - 110) hitWac = true;      // a zone taller than 1.2 screens is the page, not a corner panel
      }
      if ((wide || hitAsk) && hitWac) break;                         // both decided
    }
    de.toggleAttribute('data-fab-clear', !wide && hitAsk);
    de.toggleAttribute('data-wac-hide', hitWac);
  }
  function onIO(es) {
    es.forEach(function (e) { if (e.isIntersecting) inSet.add(e.target); else inSet.delete(e.target); });
    update();
  }
  function scan() {
    if (!io) return;
    document.querySelectorAll(ZONES).forEach(function (el) { if (!known.has(el)) { known.add(el); io.observe(el); } });
  }
  function start(force) {
    if (!force && io && Math.abs(innerHeight - lastH) < 40 && innerWidth === lastW) return;   // the phone URL bar must not rebuild the observer
    lastH = innerHeight; lastW = innerWidth;
    if (io) { io.disconnect(); io = null; known = new WeakSet(); inSet.clear(); }
    if (!('IntersectionObserver' in window)) { update(); return; }
    io = new IntersectionObserver(onIO, { rootMargin: '-' + Math.max(0, innerHeight - bandPx()) + 'px 0px 0px 0px', threshold: 0 });
    scan(); update();
  }
  function later() { if (tm) return; tm = setTimeout(function () { tm = 0; scan(); update(); }, 150); }   // throttle, not debounce: a list that keeps changing must still be scanned
  start();
  addEventListener('resize', function () { clearTimeout(rt); rt = setTimeout(start, 150); }, { passive: true });
  addEventListener('pageshow', function () { start(true); });
  new MutationObserver(later).observe(document.body || de, { childList: true, subtree: true, attributes: true, attributeFilter: ['data-fab-avoid'] });
})();
</script>
