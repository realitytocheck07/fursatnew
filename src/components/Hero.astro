---
import slots from '../data/slots.json';
import site from '../data/site.json';
import MarqueeStrip from './MarqueeStrip.astro';
---
<section class="fxhero" id="top" aria-label="Fursat Kitchen | Bar">
 <!-- ambient background, anchored to the viewport edges -->
 <div class="fx-bg" aria-hidden="true">
  <svg class="fx-leaf" viewBox="0 0 1536 1024" preserveAspectRatio="xMinYMin slice"><g filter="url(#fxLeafBlur)" fill="#6a6a34" opacity=".22">
    <g transform="translate(-40 40) rotate(28)"><path d="M0,0 C60,-18 120,-18 190,6 C120,22 60,22 0,0Z"/><path d="M20,80 C70,52 130,52 200,84 C130,104 70,104 20,80Z"/><path d="M-10,170 C50,140 120,142 186,176 C120,196 50,198 -10,170Z"/><path d="M30,260 C80,232 140,236 196,270 C140,288 80,288 30,260Z"/></g>
    <g transform="translate(70 -30) rotate(52)"><path d="M0,0 C46,-14 92,-12 140,6 C92,18 46,18 0,0Z"/><path d="M10,64 C52,42 100,44 150,70 C100,86 52,86 10,64Z"/><path d="M0,130 C44,110 92,114 136,140 C92,152 44,152 0,130Z"/></g>
    <path d="M-20,330 C30,300 70,320 80,360 C50,352 20,352 -20,372Z"/><path d="M0,440 C40,420 80,440 84,480 C54,470 24,470 0,490Z"/>
    <g transform="translate(1330 -20) rotate(-12)"><path d="M0,0 C46,-14 92,-12 140,6 C92,18 46,18 0,0Z"/><path d="M60,60 C102,38 150,40 200,66 C150,82 102,82 60,60Z"/></g></g></svg>
  <svg class="fx-olive fx-olive-l" viewBox="0 0 340 280" preserveAspectRatio="none"><path d="M0,0 C70,0 130,25 190,70 C240,102 300,106 340,108 C262,120 192,130 140,170 C90,210 40,240 0,262 Z" fill="url(#gOlive)"/></svg>
  <svg class="fx-olive fx-olive-b" viewBox="0 0 100 64" preserveAspectRatio="none"><path d="M0,0 C40,14 82,30 100,64 L0,64 Z" fill="#46411B"/></svg>
 </div>

 <div class="fx-stage" id="fxstage"><div class="fx-pl" id="fxpl"><video class="fx-pl-rv" id="fxplv" aria-hidden="true" muted loop disablepictureinpicture disableremoteplayback playsinline webkit-playsinline preload="none" poster="/assets/51db3af80d.webp" data-src="/assets/hero-master-v3.mp4" data-src-sm="/assets/hero-master-v3-sm.mp4"></video><div class="fx-rv" id="fxrv" aria-hidden="true"><video class="fx-rv-b" id="fxrvb" muted playsinline webkit-playsinline disablepictureinpicture disableremoteplayback preload="none" tabindex="-1" poster="/assets/home/hero-reel-poster.jpg"><source src="/assets/home/hero-reel-540-a.webm" type="video/webm"><source src="/assets/home/hero-reel-540-a.mp4" type="video/mp4"></video><video class="fx-rv-f" id="fxrvf" muted playsinline webkit-playsinline disablepictureinpicture disableremoteplayback preload="none" tabindex="-1" poster="/assets/home/hero-reel-poster.jpg"><source src="/assets/home/hero-reel-540-a.webm" type="video/webm"><source src="/assets/home/hero-reel-540-a.mp4" type="video/mp4"></video><i class="fx-rv-p" id="fxrvp"></i></div><div class="fx-dn" id="fxdn" data-dish="" aria-hidden="true" hidden><b class="fx-dn-n" id="fxdn-n"></b><span class="fx-dn-bar" aria-hidden="true"><i id="fxdn-b"></i></span></div><div class="hx-ctl" role="group" aria-label="Background music and video"><button class="snd nudge" id="snd" type="button" aria-label="Turn sound on"><span class="vz-eq" aria-hidden="true"><i></i><i></i><i></i><i></i></span><span class="snd-t">Vibe with us</span></button><button class="snd" id="rsnd" type="button" aria-label="Turn reel sound off" hidden><span class="vz-eq" aria-hidden="true"><i></i><i></i><i></i><i></i></span><span class="snd-t">Reel sound off</span></button><button class="fx-pv" id="fxpv" type="button" data-s="playing" aria-label="Pause background video"><svg class="i-pause" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><rect x="6" y="5" width="4" height="14" rx="1"/><rect x="14" y="5" width="4" height="14" rx="1"/></svg><svg class="i-play" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M8 5.5v13a1 1 0 0 0 1.5.86l10.5-6.5a1 1 0 0 0 0-1.72L9.5 4.64A1 1 0 0 0 8 5.5z"/></svg></button></div></div>

  <div class="txt">
   <h1 class="fx-h1" data-greet="Welcome · come hungry, stay long" aria-label="Your Moment to Pause."><b class="l1"><u>Your</u></b><b class="l2"><u>Moment</u></b><b class="l3"><u>to Pause<s>.</s></u></b></h1>
   <p class="fx-p rv" style="--d:.55s">Café, kitchen, bar and banquet at Capital Park, Madhapur.</p>
   <div class="fx-btns rv" style="--d:.7s"><button class="fk-btn fk-btn--primary fk-btn--md pill" type="button" data-open="book">Reserve a table <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6"/></svg></button><a class="fk-btn fk-btn--secondary fk-btn--md fx-ghost" href="/menu">Explore the menu <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6"/></svg></a></div>
  </div>

  <aside class="fx-info rv" style="--d:1.05s" aria-label="Visit Fursat"><i class="fi-d" aria-hidden="true"></i><span class="fi-a"><b>Last table {slots[slots.length - 1].time}</b><small>Capital Park, Madhapur · {site.phone}</small></span></aside>


  
 </div>
  <div class="fxs-wrap" id="fxsw" inert aria-hidden="true">
   <figure class="fxs-tile"><img src="/assets/dishes/new/fursat-rahasyam-480.webp" width="480" height="720" alt="Fursat Rahasyam, a layered house cocktail" loading="lazy" decoding="async" /></figure>
   <div class="fxs-card">
    <img class="fxs-el" src="/assets/brand/mascot/welcome-480.webp" width="480" height="480" alt="" loading="lazy" decoding="async" />
    <p class="fxs-pill fxs-st" style="--i:0"><i aria-hidden="true"></i>Capital Park, Madhapur</p>
    <h2 class="fxs-h"><b class="fxs-st" style="--i:1"><u>Experience the vibe.</u></b><b class="fxs-st" style="--i:2"><u>Feel the <em>Fursat.</em></u></b></h2>
    <p class="fxs-p fxs-st" style="--i:3">South Indian flavours, continental classics and crafted drinks, and a hall for your celebrations.</p>
    <div class="fxs-btns fxs-st" style="--i:4"><button class="fk-btn fk-btn--primary fk-btn--md fxs-book" type="button" data-open="book">Book a table <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6"/></svg></button><a class="fk-btn fk-btn--secondary fk-btn--md" href="#whats-new">See what&rsquo;s on</a></div>
   </div>
  </div>
  <i class="fxs-rim" aria-hidden="true"></i>
<MarqueeStrip />
</section>
<script is:inline>
/* Time-of-day greeting: the data-greet text in the HTML is the neutral fallback; swap it by the visitor's local hour. Same size, so nothing shifts. */
(function(){var e=document.querySelector('.fx-h1[data-greet]');if(!e)return;var h=new Date().getHours();
e.setAttribute('data-greet',h>=5&&h<12?'Good morning · slow brunch mood':h>=12&&h<17?'Good afternoon · long lunch':h>=17&&h<22?'Good evening · drinks & dinner':'Late night · the bar is on')})();
</script>

<script is:inline>
/* H1 part B: after ONE round of the reel (or an early scroll / tap) the framed box grows into the right half and the card slides in. Box = clip-path + inner video translate/scale (FLIP), nothing animates width/height. Returning visitors (sessionStorage fx-split) land on the split. */
(function(){
var hero=document.getElementById('top'),pl=document.getElementById('fxpl'),stg=document.getElementById('fxstage'),wrap=document.getElementById('fxsw'),rim=hero&&hero.querySelector('.fxs-rim'),rv=document.getElementById('fxrv');
if(!hero||!pl||!stg||!wrap||!rim)return;
var on=false,tm=0,goAt=0,de=document.documentElement,KEY='fx-split';
function phone(){return matchMedia('(max-width:899px)').matches}
function vids(){return[document.getElementById('fxplv'),document.getElementById('fxrvf')].filter(Boolean)}
function cov(v,w,h){var f=v.id==='fxrvf',vw=v.videoWidth||(f?540:1280),vh=v.videoHeight||(f?960:720);return Math.max(w/vw,h/vh)}
function open(){wrap.removeAttribute('inert');wrap.removeAttribute('aria-hidden')}
function split(now){
 if(on)return;on=true;clearTimeout(tm);try{sessionStorage.setItem(KEY,'1')}catch(e){}
 if(now){hero.classList.add('fxs-on','fxs-now','fxs-go','fxs-done');open();return}
 var b=pl.getBoundingClientRect(),h=hero.getBoundingClientRect(),ctl=pl.querySelector('.hx-ctl'),dn=document.getElementById('fxdn'),vs=vids();
 if(!phone()){var g=getComputedStyle(stg).gridTemplateRows;if(g&&g!=='none')stg.style.gridTemplateRows=g}  /* freeze the rows: the box leaving the grid must not move the old text */
 hero.classList.add('fxs-on');
 var p=pl.getBoundingClientRect(),R=phone()?28:36,t=b.top-p.top,l=b.left-p.left,r=p.right-b.right,bt=p.bottom-b.bottom;
 pl.style.clipPath='inset('+t+'px '+r+'px '+bt+'px '+l+'px round '+R+'px)';
 rim.style.cssText='left:'+(b.left-h.left)+'px;top:'+(b.top-h.top)+'px;width:'+b.width+'px;height:'+b.height+'px;border-radius:'+R+'px';
 var dx=(b.left+b.width/2)-(p.left+p.width/2),dy=(b.top+b.height/2)-(p.top+p.height/2);
 vs.forEach(function(v){v.style.translate=dx+'px '+dy+'px';v.style.scale=cov(v,b.width,b.height)/cov(v,p.width,p.height)});
 if(ctl)ctl.style.translate=l+'px '+t+'px';
 if(dn){var left=getComputedStyle(dn).left!=='auto';dn.style.translate=(left?l:-r)+'px '+(-bt)+'px'}
 void pl.offsetWidth;                                   /* commit the start frame */
 open();hero.classList.add('fxs-go');
 pl.style.clipPath='';vs.forEach(function(v){v.style.translate='';v.style.scale=''});if(ctl)ctl.style.translate='';if(dn)dn.style.translate='';
 setTimeout(function(){hero.classList.add('fxs-done');rim.removeAttribute('style')},1700)}
function active(){return hero.classList.contains('go')&&!de.classList.contains('lock')&&Date.now()-goAt>600}
if(hero.classList.contains('go'))goAt=Date.now();
else if(window.MutationObserver){var mg=new MutationObserver(function(){if(hero.classList.contains('go')){goAt=Date.now();mg.disconnect()}});mg.observe(hero,{attributes:true,attributeFilter:['class']})}
/* one round done: 10.js hands the reel over to the master loop and adds .out to #fxrv; wait for the crossfade, then split */
if(rv&&window.MutationObserver){var mr=new MutationObserver(function(){if(rv.classList.contains('out')){mr.disconnect();tm=setTimeout(function(){split()},800)}});mr.observe(rv,{attributes:true,attributeFilter:['class']})}
/* early: a scroll (desktop scrolls the body, so listen in the capture phase) or a tap anywhere but the hero controls */
document.addEventListener('scroll',function(e){if(on||!active())return;var s=e.target,y=(s&&(s.scrollingElement||s).scrollTop)||window.scrollY||0;if(y>8)split()},{passive:true,capture:true});
document.addEventListener('pointerdown',function(e){if(on||!active())return;var c=e.target&&e.target.closest;if(c&&e.target.closest('.hx-ctl,#fxskipall'))return;split()},{passive:true,capture:true});
var seen=false;try{seen=sessionStorage.getItem(KEY)==='1'}catch(e){}
if(seen)split(true);
})();
</script>

<style is:global>
/* Greeting: a line above the h1, drawn from its data-greet attribute. It is positioned off the h1 itself, so it follows every breakpoint; one fixed-height line, so swapping the text never moves anything. */
.fx-h1[data-greet]::before{content:attr(data-greet);position:absolute;left:3px;bottom:100%;margin-bottom:calc(12px * var(--r,1));white-space:nowrap;font:600 calc(13px * var(--r,1))/1.2 var(--fk-sans,'Poppins',system-ui,sans-serif);letter-spacing:.06em;text-transform:uppercase;color:#6b5a2c;pointer-events:none}
@media (max-width: 899px) { .txt .fx-h1[data-greet] { margin-top: 38px; } .fx-h1[data-greet]::before { left: 0; margin-bottom: 12px; white-space: normal; max-width: 92vw } }
/* Hero buttons use the design system (fk-btn). `pill` and `fx-ghost` stay only as hooks for js/15.js (magnetic hover).
   Desktop: the hero sits in a scaled 1536x1024 canvas, so the 44px size is written in screen pixels with --r (1 screen px in canvas units). Phone: plain px, no override needed. */
@media (min-width: 900px) {
  .fxhero .fx-btns .fk-btn.fk-btn--md { min-height: 0; height: 100%; padding: 0 calc(20px * var(--r)); gap: calc(8px * var(--r)); border-width: calc(2px * var(--r)); border-radius: 9999px; font-family: var(--fk-font-text); font-size: calc(14px * var(--r)); font-weight: 600; }
}
/* Music toggle: same type as every button (Poppins 600), pressed = the one green */
.hx-ctl .snd { font-family: var(--fk-font-text); font-style: normal; font-weight: 600; letter-spacing: 0; border-color: var(--fk-btn-green); }
.hx-ctl .snd[hidden] { display: none; }
.hx-ctl .snd[aria-pressed="true"] { background: var(--fk-btn-green); border-color: var(--fk-btn-green); color: var(--fk-btn-on-green); }

/* ── v5.61 GOLDEN-HOUR FRAME (MotionSites craft pass) ─────────────────────────────────────────────
   Signature: the reel sits in a real inset frame (36px radius, gold rim light) over a giant ghost "FURSAT" word.
   Desktop no longer scales a 1536x1024 canvas down (tiny type on laptops): the hero fills the viewport under the header and the
   type is sized in real px. Phone keeps its stack. Everything is transform/opacity, one-shot; reduced motion shows the final state.
   Hooks kept: #top .go .reel-on, #fxstage #fxpl #fxrv #fxrvf #fxrvb #fxplv, .fx-h1 u, .rv, .hx-ctl. */
.fxhero .fx-olive{display:none}
@media (min-width: 900px) {
  html .fxhero { --u: 1; --r: 1; --mq-h: 56px; --hh: clamp(500px, calc(100dvh - var(--sh-h, 104px) - 30px), 900px); --h1: clamp(52px, min(6.6vw, 10.6vh), 112px); height: var(--hh); margin-top: 0; }
  html .fxhero .fx-stage { position: relative; left: auto; top: auto; width: 100%; max-width: 1760px; height: 100%; margin: 0 auto; transform: none;
    padding: 0 clamp(32px, 6vw, 112px) var(--mq-h) clamp(176px, 14vw, 270px); box-sizing: border-box; display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1fr); grid-template-rows: auto auto;
    align-content: center; column-gap: clamp(24px, 4vw, 80px); }
  html .fxhero .txt, html .fxhero .fx-logo, html .fxhero .askdock { margin-left: 0; }
  html .fxhero .txt { position: relative; left: auto; top: auto; width: auto; height: auto; grid-column: 1; grid-row: 1; align-self: end; padding-top: 34px; z-index: 5; }
  html .fxhero .fx-h1 { position: relative; left: auto; top: auto; margin: 0; font: 700 var(--h1)/.94 var(--serif); letter-spacing: -.035em; white-space: nowrap; }
  html .fxhero .fx-h1 b { padding-bottom: .06em; }
  html .fxhero .fx-h1 .l2 u { font-size: 1.04em; }
  html .fxhero .fx-h1[data-greet]::before { left: 4px; margin-bottom: 16px; font-size: 12.5px; letter-spacing: .22em; color: #7a6a38; }
  html .fxhero .fx-p { position: relative; left: auto; top: auto; margin: 22px 0 0; max-width: 33rem; font: 400 clamp(15px, 1.3vw, 18px)/1.6 var(--fk-font-text, Rupee,'Poppins', system-ui, sans-serif) !important; letter-spacing: 0; color: rgba(26,22,8,.7); white-space: normal; }
  html .fxhero .fx-btns { position: relative; left: auto; top: auto; width: auto; height: 48px; margin-top: 28px; gap: 12px; }
  html .fxhero .fx-btns .fk-btn.fk-btn--md { font-size: 14.5px; padding: 0 24px; }
  html .fxhero .fx-info { position: relative; left: auto; top: auto; grid-column: 1; grid-row: 2; align-self: start; justify-self: start; margin-top: 26px; width: auto; max-width: none; z-index: 5; }
  html .fxhero .fx-pl { position: relative; right: auto; top: auto; grid-column: 2; grid-row: 1 / span 2; align-self: center; justify-self: center; z-index: 2;
    width: min(100%, calc((var(--hh) - var(--mq-h) - 44px) * .9)); height: auto; aspect-ratio: 9 / 10; border-radius: 36px;
    box-shadow: 0 0 0 1px rgba(214,160,64,.6), 0 2px 0 0 rgba(255,236,190,.6) inset, 0 44px 80px -34px rgba(60,32,8,.6), 0 0 120px -30px rgba(240,160,60,.5); }
  html .fxhero .fx-pl { isolation: isolate; }
  html .fxhero .fx-rv { border-radius: inherit; }
  html .fxhero .fx-pl-rv { width: 100%; height: 100%; object-fit: cover; object-position: 50% 40%; }
  html .fxhero .fx-rv, html .fxhero .fx-rv-f { --rv-x: 0px; }
  html .fxhero .fx-rv-f { inset: 0; left: 0; width: 100%; height: 100%; aspect-ratio: auto; transform: none; object-position: 50% 14%; }
  html .fxhero .hx-ctl { top: 16px; left: 16px; right: auto; gap: 8px; }
  /* ghost word: architecture behind the frame (a grid item in the frame's cell, so it centres on it and peeks out both sides) */
  html .fxhero .fx-stage::before { content: "FURSAT"; grid-column: 2; grid-row: 1 / span 2; align-self: center; justify-self: center; z-index: 1; pointer-events: none; white-space: nowrap;
    font: 800 min(16.5vw, 35vh)/.8 var(--serif); letter-spacing: -.06em; color: rgba(190,132,44,.15); }
}
@media (max-width: 899px) {
  /* H1 part A (phone): the hero is exactly one screen under the header; the video box takes whatever height is left, so the ribbon (56px) sits on the first screen */
  html .fxhero { --mq-h: 56px; height: calc(100svh - var(--sh-h, 94px) - 76px - env(safe-area-inset-bottom, 0px)); min-height: 0; padding-bottom: var(--mq-h); display: flex; flex-direction: column; box-sizing: border-box; }
  html .fxhero .fx-stage { flex: 1 1 auto; min-height: 0; }
  html .fxhero .fx-pl { flex: 1 1 0; min-height: 150px; aspect-ratio: auto !important; margin-top: 16px; }
  /* the fixed mobile bar (64px + 12px gap) covers the bottom of the screen, so the hero ends above it and the ribbon is the last thing you see over the bar */
  @media (max-height: 780px) { html .fxhero .fx-h1 { font-size: clamp(36px, 10.4vw, 66px); } html .fxhero .fx-p { margin-top: 10px; font-size: 14px; line-height: 1.45; } html .fxhero .fx-btns { margin-top: 12px; } html .fxhero .txt .fx-h1[data-greet] { margin-top: 30px; } }
  .fxhero .fx-pl { isolation: isolate; }
  .fxhero .fx-rv { border-radius: inherit; }
  .fxhero .fx-pl { border-radius: 28px; box-shadow: 0 0 0 1px rgba(214,160,64,.55), 0 28px 50px -26px rgba(60,32,8,.55); }
}
@media (min-width: 900px) and (prefers-reduced-motion: no-preference) {
  html .fxhero .fx-stage::before { opacity: 0; transform: translate3d(0, 5%, 0); transition: opacity 1.6s cubic-bezier(.22,1,.36,1) .35s, transform 1.6s cubic-bezier(.22,1,.36,1) .35s; }
  html .fxhero.go .fx-stage::before { opacity: 1; transform: none; }
}

/* ── H1 part B (fxs-): split after one round (fxs- prefix). Layout B: the video box stays right and grows to the right half; the card takes the left. ── */
.fxs-wrap{display:none}
html .fxhero{position:relative}
html .fxhero .fxs-wrap{display:flex;visibility:hidden;position:absolute;z-index:5;flex-direction:column}
html .fxhero.fxs-go .fxs-wrap{visibility:visible}
html .fxhero .fxs-rim{display:none;position:absolute;z-index:3;pointer-events:none;box-shadow:0 0 0 1px rgba(214,160,64,.6),0 44px 80px -34px rgba(60,32,8,.6),0 0 120px -30px rgba(240,160,60,.5);opacity:1}
html .fxhero.fxs-on .fxs-rim{display:block}
html .fxhero.fxs-go .fxs-rim{opacity:0;transition:opacity .3s ease-out}
html .fxhero.fxs-done .fxs-rim,html .fxhero.fxs-now .fxs-rim{display:none}
/* the box becomes the panel (final geometry; the framed look is a clip-path window onto it) */
html .fxhero.fxs-on .fx-stage{position:static}
html .fxhero.fxs-on .fx-pl{position:absolute;grid-area:auto;justify-self:stretch;align-self:stretch;margin:0;max-width:none;aspect-ratio:auto!important;border-radius:0;box-shadow:none;clip-path:inset(0 0 0 0 round 0px);z-index:2;transition:none}
html .fxhero.fxs-go .fx-pl{transition:clip-path .9s cubic-bezier(.22,1,.36,1)}
html .fxhero.fxs-on .fx-pl-rv,html .fxhero.fxs-on .fx-rv-f{scale:1.04}
html .fxhero.fxs-go .fx-pl-rv,html .fxhero.fxs-go .fx-rv-f{transition:translate .9s cubic-bezier(.22,1,.36,1),scale .9s cubic-bezier(.22,1,.36,1),opacity .4s ease}
html .fxhero.fxs-go .hx-ctl,html .fxhero.fxs-go .fx-dn{transition:translate .9s cubic-bezier(.22,1,.36,1)}
/* old text: up 12px and out in 300ms; the h1 stays in the page for readers and search */
html .fxhero.fxs-go .txt{opacity:0;transform:translate3d(0,-12px,0);pointer-events:none;transition:opacity .3s ease,transform .3s ease}
html .fxhero.fxs-go .txt .fx-p,html .fxhero.fxs-go .txt .fx-btns{visibility:hidden;transition:visibility 0s .3s}
html .fxhero.fxs-go .fx-info{opacity:0;visibility:hidden;pointer-events:none;transition:opacity .3s ease,visibility 0s .3s}
html .fxhero.fxs-go .fx-stage::before{opacity:0;transition:opacity .4s ease}
/* the card */
.fxs-tile{margin:0;flex:none;overflow:hidden;border-radius:20px;box-shadow:0 18px 36px -18px rgba(60,32,8,.55),0 0 0 1px rgba(214,160,64,.5);opacity:0;transform:scale(.96);transform-origin:100% 100%}
.fxs-tile img{display:block;width:100%;height:100%;object-fit:cover;object-position:50% 58%}
html .fxhero.fxs-go .fxs-tile{opacity:1;transform:none;transition:opacity .5s ease-out .4s,transform .5s cubic-bezier(.34,1.56,.64,1) .4s}
