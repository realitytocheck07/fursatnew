    <h2 class="fxs-h"><b class="fxs-st" style="--i:1"><u>Experience the vibe.</u></b><b class="fxs-st" style="--i:2"><u>Feel the <em>Fursat.</em></u></b></h2>
    <p class="fxs-p fxs-st" style="--i:3">South Indian flavours, continental classics and crafted drinks, and a hall for your celebrations.</p>
    <div class="fxs-btns fxs-st" style="--i:4"><button class="fk-btn fk-btn--primary fk-btn--md fxs-book" type="button" data-open="book">Book a table <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6"/></svg></button><a class="fk-btn fk-btn--secondary fk-btn--md" href="#whats-new">See what&rsquo;s on</a></div>
   </div>
  </div>
  <i class="fxs-rim" aria-hidden="true"></i>
<button class="fx-again" id="fxagain" type="button" aria-label="Why FURSAT: watch again"><span>Why FURSAT</span><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M8 5.5v13a1 1 0 0 0 1.5.86l10.5-6.5a1 1 0 0 0 0-1.72L9.5 4.64A1 1 0 0 0 8 5.5z"/></svg><span>Watch again</span></button>
<MarqueeStrip />
</section>
<script is:inline>
/* Time-of-day greeting: the data-greet text in the HTML is the neutral fallback; swap it by the visitor's local hour. Same size, so nothing shifts. */
(function(){var e=document.querySelector('.fx-h1[data-greet]');if(!e)return;var h=new Date().getHours();
e.setAttribute('data-greet',h>=5&&h<12?'Good morning · slow brunch mood':h>=12&&h<17?'Good afternoon · long lunch':h>=17&&h<22?'Good evening · drinks & dinner':'Late night · the bar is on')})();
</script>

<script is:inline>
(function(){
/* U2 task 4: "Fall into the lens" intro. Plays once per visit (fz_lens), after the site intro has set #top.go, and holds the reel (window.__fzLens) until it ends or is skipped. */
var KEY='fz_lens',de=document.documentElement,hero=document.getElementById('top');
if(!hero)return;
/* HR3: the lens intro is switched off. Flip LENS_ON to true to bring it back (all code below stays as it was). With it off, window.__fzLens is never set, so 10.js starts the reel as soon as #top has .go. */
var LENS_ON=false;if(!LENS_ON)return;
try{if(sessionStorage.getItem(KEY)==='1')return}catch(e){}
try{if(navigator.connection&&navigator.connection.saveData)return}catch(e){}
window.__fzLens=true;
var B='/assets/lens/',SF='(max-width:899px) 720px,1080px',SD='(max-width:899px) 900px,1600px',EZ='cubic-bezier(.7,0,.2,1)';
/* lens outlines traced on the 1080x1045 crops (A = burger lens, B = tiramisu lens); reg = where the sharp photo sits inside the lens (scale r, offset tx,ty) so the swap is seamless */
var LA=[[410,340],[470,285],[560,250],[660,235],[760,235],[860,250],[930,285],[975,330],[990,400],[985,480],[960,550],[920,610],[860,665],[780,710],[690,730],[600,722],[520,690],[460,630],[420,560],[398,470],[398,390]];
var LB=[[95,300],[200,245],[330,232],[450,238],[560,270],[640,345],[668,420],[660,490],[630,570],[580,640],[500,690],[400,715],[300,712],[210,680],[140,610],[95,520],[75,420],[85,340]];
var WD={a:{face:'lz-a',poly:LA,tx:319,ty:284,r:.465,dish:'lz-burger',cx:.47},b:{face:'lz-b',poly:LB,tx:-29,ty:277,r:.457,dish:'lz-tira',cx:.5}};
function pre(n,a,b,s){var l=document.createElement('link');l.rel='preload';l.as='image';l.type='image/webp';l.setAttribute('imagesrcset',B+n+'-'+a+'.webp '+a+'w,'+B+n+'-'+b+'.webp '+b+'w');l.setAttribute('imagesizes',s);document.head.appendChild(l)}
/* the lens pictures are requested only after first paint + load + idle, so they never compete with the LCP resources */
function preLater(){pre('lz-a',720,1080,SF);pre('lz-burger',900,1600,SD);warm()}
/* V1b: decode the two first pictures at idle too, so the lens is built sooner after #top.go */
function warm(){[['lz-a',720,1080,SF],['lz-burger',900,1600,SD]].forEach(function(x){try{var i=new Image();i.sizes=x[3];i.srcset=B+x[0]+'-'+x[1]+'.webp '+x[1]+'w,'+B+x[0]+'-'+x[2]+'.webp '+x[2]+'w';i.src=B+x[0]+'-'+x[2]+'.webp';if(i.decode)i.decode().catch(function(){})}catch(e){}})}
var idl=window.requestIdleCallback||function(f){setTimeout(f,300)};
if(document.readyState==='complete')idl(preLater,{timeout:2000});else addEventListener('load',function(){idl(preLater,{timeout:2000})},{once:true});
function el(t,c){var e=document.createElement(t);if(c)e.className=c;return e}
function im(n,a,b,s,c,w,h){var i=new Image();i.className=c;i.alt='';i.decoding='async';i.draggable=false;i.sizes=s;i.srcset=B+n+'-'+a+'.webp '+a+'w,'+B+n+'-'+b+'.webp '+b+'w';i.src=B+n+'-'+b+'.webp';i.width=w;i.height=h;return i}
function ctr(p){var x0=1e9,x1=-1e9,y0=1e9,y1=-1e9;p.forEach(function(q){x0=Math.min(x0,q[0]);x1=Math.max(x1,q[0]);y0=Math.min(y0,q[1]);y1=Math.max(y1,q[1])});return[(x0+x1)/2,(y0+y1)/2,x0,x1,y0,y1]}
function pg(pts){return 'polygon('+pts.map(function(p){return p[0].toFixed(1)+'px '+p[1].toFixed(1)+'px'}).join(',')+')'}
function loc(w){return w.poly.map(function(p){return[(p[0]-w.tx)/w.r,(p[1]-w.ty)/w.r]})}
function grow(pts){var c=ctr(pts),L=-300,R=1972,T=-300,Bt=1241;return pts.map(function(p){var dx=p[0]-c[0],dy=p[1]-c[1],t=1e9;
  if(dx>0)t=Math.min(t,(R-c[0])/dx);else if(dx<0)t=Math.min(t,(L-c[0])/dx);if(dy>0)t=Math.min(t,(Bt-c[1])/dy);else if(dy<0)t=Math.min(t,(T-c[1])/dy);
  return[c[0]+dx*t,c[1]+dy*t]})}
function tr(x,y,k){return 'translate('+x.toFixed(1)+'px,'+y.toFixed(1)+'px) scale('+k.toFixed(4)+')'}
var ov,all=[],done=false;
function end(){if(done)return;done=true;try{all.forEach(function(a){a.cancel()})}catch(e){}if(ov&&ov.parentNode)ov.remove();window.__fzLens=false;try{dispatchEvent(new Event('fz:lensend'))}catch(e){}}
function an(e,kf,o){o.fill='forwards';var a=e.animate(kf,o);all.push(a);return a}
function build(k){var w=WD[k],wr=el('div','lz-w lz-w'+k),wo=el('div','lz-world'),face=im(w.face,720,1080,SF,'lz-face',1080,1045),dish=el('div','lz-dish'),dim=el('div','lz-dim'),pc=[];
  dish.style.transform='translate('+w.tx+'px,'+w.ty+'px) scale('+w.r+')';
  dim.appendChild(im(w.dish,900,1600,SD,'lz-bgb',1672,941));dim.appendChild(im(w.dish,900,1600,SD,'lz-fg',1672,941));
  if(k==='a')[['ellipse(4.4% 6.6% at 49.6% 16%)',-10,-14,1.05],['ellipse(20% 19% at 60% 66%)',14,10,1.04],['ellipse(18% 13% at 66% 80%)',22,16,1.06],['ellipse(11% 9% at 15% 38%)',-18,-6,1.04]].forEach(function(d){
    var p=im(w.dish,900,1600,SD,'lz-pc',1672,941);p.style.clipPath=d[0];dim.appendChild(p);pc.push([p,d])});
  dish.appendChild(dim);wo.appendChild(face);wo.appendChild(dish);
  var g=null,bar=null;if(k==='a'){g=el('div','lz-glint');g.style.clipPath=pg(w.poly);bar=el('i');var c=ctr(w.poly);bar.style.left=c[2]-200+'px';g.appendChild(bar);wo.appendChild(g)}
  wr.appendChild(wo);return{w:w,wr:wr,wo:wo,face:face,dish:dish,dim:dim,pc:pc,bar:bar,bg:dim.firstChild}}
function run(){
  var A=build('a'),Bw=build('b'),vg=el('i','lz-vg'),end_=el('div','lz-end'),scr=el('i','lz-scrim'),lab=el('div','lz-lab'),line=el('i','lz-line'),btns=el('div','lz-btns');
  /* burger and cocktail names are unconfirmed (see the note in Hero.astro frontmatter): only the tiramisu, a real menu item, is labelled */
  lab.innerHTML='<b>Tiramisu</b><span>\u20B9375</span>';
  btns.innerHTML='<a class="fk-btn fk-btn--primary fk-btn--md" href="/order/">Order</a><button type="button" class="fk-btn fk-btn--secondary fk-btn--md lz-sec" data-open="book">Reserve</button>';
  end_.appendChild(scr);end_.appendChild(lab);end_.appendChild(line);end_.appendChild(btns);
  ov=el('div','lz');ov.id='lz';ov.appendChild(Bw.wr);ov.appendChild(A.wr);ov.appendChild(vg);ov.appendChild(end_);hero.appendChild(ov);an(ov,[{opacity:0},{opacity:1}],{duration:150,easing:'ease-out'});   /* V1b: ease in, no hard cut from the page */
  var W=ov.clientWidth,H=ov.clientHeight,ph=W<900,s=ph?Math.max(W/1080,H/1045):H/1045,fs=ph?W*2.2/1672:Math.max(W/1672,H/941);
  function geo(o){var w=o.w,c=ctr(w.poly),Ox,Oy;
    if(ph){Ox=Math.min(0,Math.max(W-1080*s,W/2-s*c[0]));Oy=Math.min(0,Math.max(H-1045*s,H/2-s*c[1]))}else{Ox=(W-1080*s)/2;Oy=(H-1045*s)/2}
    var Lx=Ox+s*c[0],Ly=Oy+s*c[1],k1=s*1.06,K=fs/w.r,tlx=ph?W/2-fs*1672*w.cx:(W-1672*fs)/2,tly=(H-941*fs)/2;
    return{T0:tr(Ox,Oy,s),T1:tr(Lx-k1*c[0],Ly-k1*c[1],k1),TE:tr(tlx-K*w.tx,tly-K*w.ty,K),lens:pg(loc(w)),exp:pg(grow(loc(w)))}}
  var ga=geo(A),gb=geo(Bw);
  A.wo.style.transform=ga.T0;A.dish.style.clipPath=ga.lens;
  Bw.wo.style.transform=gb.TE;Bw.dish.style.clipPath=gb.exp;Bw.dish.style.opacity=1;Bw.face.style.opacity=0;Bw.wr.style.opacity=0;
  /* shot 1: A tight, push-in 1->1.06 over 1.2 s, gold glint 500 ms */
  an(A.wo,[{transform:ga.T0},{transform:ga.T1}],{duration:1200,easing:'cubic-bezier(.25,.6,.35,1)'});
  var c=ctr(LA);an(A.bar,[{transform:'translateX(0) skewX(-18deg)',opacity:0},{opacity:.95,offset:.5},{transform:'translateX('+(c[3]-c[2]+400)+'px) skewX(-18deg)',opacity:0}],{duration:500,delay:450,easing:'ease-in-out'});
  /* dive: lens-shaped window expands to the whole stage while the picture scales toward the lens centre (same framing at the swap) */
  function dive(o,g,from,d,fade){
    an(o.wo,[{transform:from},{transform:g.TE}],{duration:700,delay:d,easing:EZ});
    an(o.dish,[{clipPath:g.lens},{clipPath:g.exp}],{duration:700,delay:d,easing:EZ});
    if(fade)an(o.dish,[{opacity:0},{opacity:1}],{duration:180,delay:d});
    an(o.face,[{opacity:1},{opacity:0}],{duration:350,delay:d+350})}
  dive(A,ga,ga.T1,1200,true);
  /* depth on the burger: dish 1 -> 1.08, background blur 0 -> 6px, fry / sauce / tomato pieces drift */
  an(A.dim,[{transform:'scale(1)'},{transform:'scale(1.08)'}],{duration:1000,delay:1400,easing:'cubic-bezier(.2,.7,.3,1)'});
  an(A.bg,[{filter:'blur(0px)'},{filter:'blur(6px)'}],{duration:800,delay:1500,easing:'ease-out'});
  A.pc.forEach(function(p){an(p[0],[{transform:'translate(0,0) scale(1)'},{transform:'translate('+p[1][1]+'px,'+p[1][2]+'px) scale('+p[1][3]+')'}],{duration:1000,delay:1400,easing:'cubic-bezier(.2,.7,.3,1)'})});
  /* match cut into lens B (zoomed lens, same framing), pull out to photo B, dive 2 into the sharp tiramisu + cocktail */
  an(A.wr,[{opacity:1},{opacity:0}],{duration:120,delay:2350});an(Bw.wr,[{opacity:0},{opacity:1}],{duration:120,delay:2350});
  an(Bw.wo,[{transform:gb.TE},{transform:gb.T0}],{duration:700,delay:2350,easing:EZ});
  an(Bw.dish,[{clipPath:gb.exp},{clipPath:gb.lens}],{duration:700,delay:2350,easing:EZ});
  an(Bw.face,[{opacity:0},{opacity:1}],{duration:450,delay:2600});
  dive(Bw,gb,gb.T0,3150,false);
  /* label lands, gold line, buttons, then the overlay is removed and the reel starts */
  an(scr,[{opacity:0},{opacity:1}],{duration:400,delay:3600});
  an(lab,[{opacity:0,transform:'translateY(16px)'},{opacity:1,transform:'none'}],{duration:450,delay:3750,easing:'cubic-bezier(.2,.8,.2,1)'});
  an(line,[{opacity:1,transform:'scaleX(0)'},{opacity:1,transform:'scaleX(1)'}],{duration:350,delay:4050,easing:'cubic-bezier(.7,0,.2,1)'});
  an(btns,[{opacity:0,transform:'translateY(12px)'},{opacity:1,transform:'none'}],{duration:400,delay:4150,easing:'cubic-bezier(.2,.8,.2,1)'});
  /* V1b: at the designed end the lens holds its last frame until the front reel has a decoded frame (10.js: __fzReelReady, cap 1500 ms), then fades 200 ms ON TOP of the reel; 10.js starts the reel on fz:lensfade. #lz is removed (fz:lensend) when the fade ends. */
  var fz=0;
  function fade(d){if(fz||done)return;fz=1;try{dispatchEvent(new Event('fz:lensfade'))}catch(e){}try{an(ov,[{opacity:1},{opacity:0}],{duration:d}).finished.then(end,end)}catch(e){end()}}
  function gate(){if(fz||done)return;var r=window.__fzReelReady;if(!r){fade(200);return}try{r(function(){fade(200)},1500)}catch(e){fade(200)}}
  an(ov,[{opacity:1},{opacity:1}],{duration:1,delay:4700}).finished.then(gate,gate);
  /* stuck-lens guard only: if the normal fade has not started by 5.6 s from the moment the lens was built, fade out quickly */
  setTimeout(function(){fade(120)},5600);
  setTimeout(function(){if(!(Bw.face.complete&&Bw.face.naturalWidth&&Bw.bg.complete&&Bw.bg.naturalWidth))end()},2200);
  ov.addEventListener('pointerdown',function(e){if(e.target.closest&&e.target.closest('.lz-btns'))return;end()},{passive:true});
  btns.addEventListener('click',function(){setTimeout(end,80)});
  document.addEventListener('keydown',function(e){if(e.key==='Escape')end()});
  document.addEventListener('scroll',function(e){var t=e.target,y=(t&&(t.scrollingElement||t).scrollTop)||window.scrollY||0;if(y>8)end()},{passive:true,capture:true});
  window.__fzLensAnims=all;
  try{dispatchEvent(new Event('fz:lensrun'))}catch(e){}
}
function start(){try{sessionStorage.setItem(KEY,'1')}catch(e){}
  var a=new Image();a.srcset=B+'lz-a-720.webp 720w,'+B+'lz-a-1080.webp 1080w';a.sizes=SF;a.src=B+'lz-a-1080.webp';
  var d=new Image();d.srcset=B+'lz-burger-900.webp 900w,'+B+'lz-burger-1600.webp 1600w';d.sizes=SD;d.src=B+'lz-burger-1600.webp';
  var t=setTimeout(end,1800);   /* first two pictures not here in 1.8 s: skip the lens, never delay the site */
  Promise.all([a,d].map(function(i){return i.decode?i.decode():Promise.resolve()})).then(function(){if(done)return;clearTimeout(t);try{run()}catch(e){end()}},function(){end()});
