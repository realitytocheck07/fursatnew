---
// InstaFollow — a row of glass tiles for the four Fursat Instagram accounts (the same four the footer links).
// The `handle` prop is the page's own account: it goes first. Usage: <InstaFollow handle="fursatbanquets" />
// Desktop: 4 tiles in a row. Tablet: 2 x 2. Phone: a swipe rail (snap, no visible scrollbar).
interface Props { handle: 'fursatind.in' | 'fursatbanquets' | 'fursat_bitesandbuffet' | 'fursatsocialclub'; tone?: 'light' | 'dark' }
const ACC = [
  { handle: 'fursatind.in', name: 'Kitchen & Bar' },
  { handle: 'fursat_bitesandbuffet', name: 'Bites & Buffet' },
  { handle: 'fursatbanquets', name: 'Banquets' },
  { handle: 'fursatsocialclub', name: 'Social Club' },
] as const;
const { handle, tone = 'light' } = Astro.props;
const tiles = [...ACC.filter((a) => a.handle === handle), ...ACC.filter((a) => a.handle !== handle)];
---
<aside class={`ig ig--${tone}`} aria-labelledby="ig-h">
  <p class="ig-k" id="ig-h">Follow Fursat on Instagram</p>
  <ul class="ig-row">
    {tiles.map((a, i) => (
      <li class="ig-li">
        <a class={`ig-tile${i === 0 ? ' is-main' : ''}`} href={`https://instagram.com/${a.handle}`} target="_blank" rel="noopener" aria-label={`${a.name} on Instagram, @${a.handle}`}>
          <span class="ig-ico" aria-hidden="true">
            <svg viewBox="0 0 24 24"><rect x="3" y="3" width="18" height="18" rx="5.5"/><circle cx="12" cy="12" r="4.2"/><circle cx="17.4" cy="6.6" r="1.1" class="ig-dot"/></svg>
          </span>
          <span class="ig-txt">
            <span class="ig-n">{a.name}</span>
            <span class="ig-u">@{a.handle}</span>
          </span>
        </a>
      </li>
    ))}
  </ul>
</aside>
<style>
/* Hide when an InstagramFeed above it (same section / previous sibling) has loaded posts; otherwise this strip stays as the fallback. */
:global([data-igfeed][data-state="ready"]) ~ .ig { display: none; }
.ig { max-width: 1300px; margin: clamp(28px, 4vw, 48px) auto; padding: 0 clamp(16px, 4vw, 40px); }
.ig-k { margin: 0 0 12px; text-align: center; font: 600 .75rem/1.2 Rupee,Poppins, system-ui, sans-serif; letter-spacing: .14em; text-transform: uppercase; color: #74501a; }
.ig--dark .ig-k { color: #e7c27a; }
.ig-row { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 12px; }
.ig-li { display: flex; min-width: 0; }
.ig-tile { flex: 1; min-width: 0; min-height: 64px; display: flex; align-items: center; gap: 12px; padding: 10px 14px; border-radius: 18px; text-decoration: none; color: #1f2a1a; background: rgb(255 251 244 / .62); border: 1px solid rgb(201 154 67 / .45); -webkit-backdrop-filter: blur(10px) saturate(1.2); backdrop-filter: blur(10px) saturate(1.2); box-shadow: inset 0 1px 0 rgb(255 255 255 / .6); transition-property: transform, box-shadow, border-color; transition-duration: .18s; transition-timing-function: ease-out; }
.ig-tile.is-main { border-color: #c99a43; box-shadow: inset 0 1px 0 rgb(255 255 255 / .6), 0 0 0 2px rgb(201 154 67 / .28); }
.ig--dark .ig-tile { color: #f6ecd8; background: rgb(255 255 255 / .07); border-color: rgb(243 197 107 / .35); box-shadow: inset 0 1px 0 rgb(255 255 255 / .12); }
.ig--dark .ig-tile.is-main { border-color: #e7c27a; box-shadow: inset 0 1px 0 rgb(255 255 255 / .12), 0 0 0 2px rgb(231 194 122 / .3); }
.ig-ico { flex: none; width: 44px; height: 44px; border-radius: 14px; display: grid; place-items: center; background: radial-gradient(circle at 30% 107%, #fdf497 0%, #fdf497 5%, #fd5949 45%, #d6249f 60%, #285AEB 90%); color: #fff; }
.ig-ico svg { width: 24px; height: 24px; fill: none; stroke: currentColor; stroke-width: 1.8; }
.ig-ico .ig-dot { fill: currentColor; stroke: none; }
.ig-txt { min-width: 0; display: grid; gap: 1px; text-align: left; }
.ig-n { font: 600 1rem/1.2 "Playfair Display", Georgia, serif; }
.ig-u { font: 400 .8125rem/1.3 Rupee,Poppins, system-ui, sans-serif; color: #5b5240; overflow-wrap: anywhere; }
.ig--dark .ig-u { color: #d9c9a6; }
.ig-tile:focus-visible { outline: 3px solid #1d5a32; outline-offset: 3px; }
.ig--dark .ig-tile:focus-visible { outline-color: #e7c27a; }
@media (hover: hover) and (pointer: fine) { .ig-tile:hover { transform: translateY(-2px); border-color: #c99a43; box-shadow: 0 14px 26px -16px rgb(90 60 20 / .5); } }
@media (max-width: 1023px) { .ig-row { grid-template-columns: repeat(2, minmax(0, 1fr)); } }
@media (max-width: 767px) {
  .ig { padding-inline: 0; }
  .ig-k { padding-inline: 16px; text-align: left; }
  .ig-row { display: flex; gap: 10px; overflow-x: auto; overscroll-behavior-x: contain; scroll-snap-type: x mandatory; scrollbar-width: none; padding: 4px 16px 8px; scroll-padding-inline: 16px; }
  .ig-row::-webkit-scrollbar { display: none; }
  .ig-li { flex: 0 0 min(72vw, 270px); scroll-snap-align: start; }
}
@media (prefers-reduced-motion: reduce) { .ig-tile, .ig-tile:hover { transition: none; transform: none; } }
</style>
