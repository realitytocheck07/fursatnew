---
import site from '../data/site.json';
// Home legal strip: links, credit and the legal dialog button. The © / GSTIN / FSSAI line lives in the footer only.
---
<footer class="fx-legalbar" id="legal" aria-label="Legal information">
 <p class="lb-l"><a href="/terms">Terms of use</a><a href="/terms#privacy">Privacy policy</a><a href="/terms#refund">Refund &amp; cancellation</a></p>
 <a class="lb-by" href="https://bjnexusai.com" target="_blank" rel="noopener">Designed &amp; being developed by <b>BJNexus AI</b> · bjnexusai.com</a>
 <button class="lb-btn" type="button" id="lbopen" aria-haspopup="dialog" aria-controls="fxlegal">Legal information</button>
</footer>
<style is:global>
/* Session E: every size here is >= 12px. The selectors are one step more specific than the 07.css rules they replace
   (07.css sets 11px / 11.5px / 10px / 10.5px, and a fixed 30px strip from 900px up). */
body footer.fx-legalbar { font-size: 12px; line-height: 1.4; }
body footer.fx-legalbar .lb-by { font-size: 12px; }
body footer.fx-legalbar .lb-btn { font-size: 12px; letter-spacing: .08em; min-height: 44px; display: inline-flex; align-items: center; padding: 0 18px; }
.lb-l a{color:inherit;opacity:.92;white-space:nowrap;text-decoration:underline;text-underline-offset:.2em;text-decoration-thickness:from-font}
.lb-l a:focus-visible,.lb-by:focus-visible{outline:2px solid #F6C45A;outline-offset:2px}
.lb-btn:focus-visible{outline:2px solid #F4ECDA;outline-offset:2px}
@media(max-width:899px){.lb-l a{display:inline-flex;align-items:center;min-height:44px}}
@media(min-width:900px){
  /* fixed one-line strip (30px, set in 07.css, unchanged so the Home layout does not move): the button fits inside it */
  body footer.fx-legalbar .lb-btn { min-height: 26px; padding: 0 14px; }
}
</style>
