---
/* Home "Reserve a table" sheet (prefix bk-). 3 steps: 1 When, 2 Details, then the Done screen.
   Bottom sheet on phones, centred dialog on laptops. Looks like the Banquet "Lock your date" form: it reuses the fe-* classes
   from src/styles/fe-form.css (steps row, crimson ticket, crown date chips, FeGo buttons, ready ring, float labels, done arch + wave).
   Opens from every [data-open="book"] on Home. WhatsApp text, email copy (fkForm.send), honeypot and data-pick zone are the same as the old popup. */
import '../styles/fe-form.css';
import FeGo from './FeGo.astro';
import slots from '../data/slots.json';
import site from '../data/site.json';

const M = '/assets/brand/mascot/';
const hour24 = (t: string) => { const m = /^(\d{1,2})\s*(AM|PM)$/i.exec(String(t).trim()); return m ? (Number(m[1]) % 12) + (m[2].toUpperCase() === 'PM' ? 12 : 0) : 0; };
const times = (slots as { time: string }[]).map((s) => ({ label: s.time, h: hour24(s.time) }));
const zones = ['Café', 'Kitchen', 'Bar', 'Banquets'];
const CK = '<svg viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="2.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M3 8.5l3.2 3.2L13 4.8"/></svg>';
/* 18 gold sparkles: end positions on two arcs round the arch (they burst out, then stay and drift) */
const sparks = Array.from({ length: 18 }, (_, k) => {
  const ring = k % 2, i = Math.floor(k / 2), a = (-172 + i * (164 / 8)) * Math.PI / 180, r = ring ? 168 : 128;
  return { k, x: Math.round(Math.cos(a) * r * 1.02), y: Math.round(Math.sin(a) * r * 0.92 + 40), s: 7 + ((k * 5) % 7), d: (2.8 + (k % 5) * 0.45).toFixed(2) };
});
---
<dialog class="bk-dlg" id="bkdlg" aria-labelledby="bk-h" data-wa={site.whatsapp}>
  <div class="bk-sheet fk-f-card fe-card" id="bk-sheet" data-step="1" data-fab-avoid>
    <img class="bk-welcome" src={M + 'welcome-480.webp'} srcset={`${M}welcome-480.webp 480w, ${M}welcome-720.webp 720w`} sizes="112px" width="720" height="720" alt="" aria-hidden="true" loading="lazy" decoding="async" draggable="false">
    <div class="bk-top" id="bk-top">
      <span class="bk-grab" aria-hidden="true"></span>
      <h2 class="fe-h2" id="bk-h" tabindex="-1">Reserve a <em>table</em></h2>
    </div>
    <button class="bk-x" type="button" id="bk-x" aria-label="Close booking form"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" aria-hidden="true"><path d="M6 6l12 12M18 6 6 18"/></svg></button>

    <form class="fe-form bk-form" id="bk-f" novalidate>
      <input type="checkbox" name="botcheck" value="" tabindex="-1" autocomplete="off" aria-hidden="true" style="position:absolute;left:-9999px;width:1px;height:1px;opacity:0">
      <p class="fe-sr" id="bk-steplabel" aria-live="polite">Step 1 of 2 · When</p>
      <ol class="fe-steps bk-steps" aria-hidden="true">
        <li data-n="1"><i><b>1</b><svg viewBox="0 0 24 24"><path d="m5 12.5 4.5 4.5L19 7.5" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"/></svg></i><span>When</span></li>
        <li data-n="2"><i><b>2</b><svg viewBox="0 0 24 24"><path d="m5 12.5 4.5 4.5L19 7.5" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"/></svg></i><span>Details</span></li>
      </ol>

      <div class="bk-main">
        <div class="bk-scroll" id="bk-scroll">
          <div class="fe-vp" id="bk-vp">
            <!-- 1 · when -->
            <section class="fe-step is-active" data-step="1" aria-labelledby="bk-s1-h">
              <h3 class="fe-q fe-q--sm" id="bk-s1-h" tabindex="-1">When shall we <em>save you a table?</em></h3>

              <div class="fe-sechead bk-sh"><span class="fe-lab" id="bk-dl">Day</span><button type="button" class="fe-link" id="bk-more">More dates</button></div>
              <div class="fe-days bk-days" id="bk-days" role="group" aria-labelledby="bk-dl"></div>
              <input class="bk-date" type="date" id="bk-date" tabindex="-1" aria-hidden="true" autocomplete="off">

              <div class="fe-sechead bk-sh"><span class="fe-lab" id="bk-tl">Time</span></div>
              <div class="bk-times" id="bk-times" role="radiogroup" aria-labelledby="bk-tl">
                {times.map((t) => (
                  <label class="fk-f-chip bk-chip" data-h={t.h}><input type="radio" name="time" value={t.label}><span class="fe-ck bk-ck" set:html={CK} /><span>{t.label}</span></label>
                ))}
              </div>

              <div class="fe-sechead bk-sh"><span class="fe-lab" id="bk-gl">Guests</span></div>
              <div class="fk-f-panel fe-guests bk-gpanel">
                <div class="fk-f-step fe-step-g">
                  <button type="button" id="bk-gm" aria-label="Fewer guests">−</button>
                  <div class="bk-gv" role="group" aria-labelledby="bk-gl"><span class="fe-sw bk-gnum" id="bk-gnum" role="status" aria-live="polite"></span></div>
                  <button type="button" id="bk-gp" aria-label="More guests">+</button>
                </div>
              </div>

              <div class="fe-sechead bk-sh"><span class="fe-lab" id="bk-zl">Zone</span></div>
              <div class="bk-zones" id="bk-zones" role="radiogroup" aria-labelledby="bk-zl">
                {zones.map((z) => (
                  <label class="fk-f-chip bk-chip"><input type="radio" name="zone" value={z}><span class="fe-ck bk-ck" set:html={CK} /><span>{z}</span></label>
                ))}
              </div>

              <p class="fk-f-err fe-err bk-hint" id="bk-hint" role="alert"></p>
              <div class="fe-actions">
                <FeGo tone="red" label="Next: your details" id="bk-next" class="is-idle" aria-disabled="true" />
              </div>
            </section>

            <!-- 2 · details -->
            <section class="fe-step" data-step="2" aria-labelledby="bk-s2-h" inert>
              <h3 class="fe-q fe-q--sm bk-s2h" id="bk-s2-h" tabindex="-1">Almost there, your <em>details</em></h3>
              <div class="bk-s2">
              <div class="bk-s2-l fe-tk-slot">
                <div class="fe-tk">
                  <div class="fe-tk-top"><span class="fe-tk-eyebrow">FURSAT · MADHAPUR</span><span class="fe-tk-title">Your table</span></div>
                  <div class="fe-tk-bot">
                    <div class="fe-tk-cell"><span class="fe-tk-k">DATE</span><span class="fe-tk-v fe-sw" id="bk-t-d"></span></div>
                    <div class="fe-tk-cell"><span class="fe-tk-k">TIME</span><span class="fe-tk-v fe-sw" id="bk-t-t"></span></div>
                    <div class="fe-tk-cell"><span class="fe-tk-k">GUESTS</span><span class="fe-tk-v fe-sw" id="bk-t-g"></span></div>
                    <div class="fe-tk-cell"><span class="fe-tk-k">SEATING</span><span class="fe-tk-v fe-sw" id="bk-t-z"></span></div>
                  </div>
                </div>
              </div>

              <div class="bk-s2-r">
              <div class="fk-f-remember fe-remember" id="bk-rem" hidden><span>Booking as <b id="bk-rn"></b></span><button type="button" id="bk-rc">Not you? Clear</button></div>
              <div class="fk-f-stack fe-fields" id="bk-fields">
                <div>
                  <div class="fe-fl"><input type="text" id="bk-n" name="name" class="fk-f-field" placeholder=" " autocomplete="name" maxlength="40" aria-required="true" aria-describedby="bk-en"><label class="fe-fl-lab" for="bk-n">Full name <span aria-hidden="true">*</span></label><svg class="fe-ok" viewBox="0 0 24 24" aria-hidden="true"><path d="m5 12.5 4.5 4.5L19 7.5" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"/></svg></div>
                  <p class="fk-f-err fe-err" id="bk-en" role="alert"></p>
                </div>
                <div>
                  <div class="fe-fl"><input type="tel" id="bk-ph" name="phone" class="fk-f-field" placeholder=" " autocomplete="tel" inputmode="tel" maxlength="18" aria-required="true" aria-describedby="bk-eph"><label class="fe-fl-lab" for="bk-ph">Mobile number <span aria-hidden="true">*</span></label><svg class="fe-ok" viewBox="0 0 24 24" aria-hidden="true"><path d="m5 12.5 4.5 4.5L19 7.5" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"/></svg></div>
                  <p class="fk-f-err fe-err" id="bk-eph" role="alert"></p>
                </div>
                <div>
                  <div class="fe-fl"><input type="email" id="bk-em" name="email" class="fk-f-field" placeholder=" " autocomplete="email" inputmode="email" autocapitalize="off" spellcheck="false" maxlength="80" aria-describedby="bk-eem"><label class="fe-fl-lab" for="bk-em">Email <span class="fk-f-opt">(optional)</span></label><svg class="fe-ok" viewBox="0 0 24 24" aria-hidden="true"><path d="m5 12.5 4.5 4.5L19 7.5" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"/></svg></div>
                  <p class="fk-f-err fe-err" id="bk-eem" role="alert"></p>
                </div>
              </div>

              <div class="fe-actions fe-actions--col" id="bk-acts">
                <span class="fe-ring" id="bk-ring"><FeGo type="submit" label="Send on WhatsApp" id="bk-send" icon="wa" class="bk-send" /></span>
                <div class="fe-row2">
                  <button type="button" class="fk-f-btn fk-f-btn--ghost fe-sec2 fe-back" id="bk-back" aria-label="Back to day and time"><span aria-hidden="true">←</span> Back</button>
                </div>
              </div>
              <p class="fk-f-fine">Your request opens in WhatsApp, ready to send.</p>
              <p class="bk-more">Planning something bigger?<span class="bk-more-l"><a href="/banquet">Banquets</a><a href="/party">Parties &amp; events</a><a href="/catering">Catering</a></span></p>
              </div>
              </div>
            </section>
          </div>
        </div>

        <!-- Done -->
        <div class="fe-done bk-done" id="bk-done" hidden>
          <span class="fe-done-arch" aria-hidden="true"><img class="fe-masc-n" src={M + 'namaste-480.webp'} srcset={`${M}namaste-480.webp 480w, ${M}namaste-720.webp 720w`} sizes="240px" width="720" height="720" alt="" loading="lazy" decoding="async"><span class="bk-sparks">{sparks.map((s) => <i style={`--k:${s.k};--x:${s.x}px;--y:${s.y}px;--s:${s.s}px;--dd:${s.d}s`}></i>)}</span></span>
          <span class="fe-done-ring"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="m5.5 12.5 4.2 4.2L18.5 7.8" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"/></svg></span>
          <p class="fe-done-t" id="bk-done-t" role="status" tabindex="-1">Opening WhatsApp…</p>
          <a class="fe-link" id="bk-done-wa" href={`https://wa.me/${site.whatsapp}`} target="_blank" rel="noopener">Not opening? Tap here</a>
          <span class="fe-or" aria-hidden="true">or</span>
          <button type="button" class="fe-link fe-edit" id="bk-again"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M4 20h4L19 9l-4-4L4 16v4ZM13.5 6.5l4 4" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linejoin="round"/></svg>Edit my request</button>
          <svg class="fe-swoosh" viewBox="0 0 400 100" preserveAspectRatio="none" aria-hidden="true"><defs><linearGradient id="bk-sw-a" x1="0" y1="0" x2="1" y2="0"><stop offset="0" stop-color="#d81e22"/><stop offset=".6" stop-color="#c3161a"/><stop offset="1" stop-color="#a50d11"/></linearGradient><linearGradient id="bk-sw-b" x1="0" y1="0" x2="1" y2="1"><stop offset="0" stop-color="#9e0b10"/><stop offset="1" stop-color="#7c070b"/></linearGradient></defs><path d="M0 100 L22 100 C70 86 118 66 166 62 C212 58 244 66 284 56 C328 46 364 22 400 0 L400 100 Z" fill="url(#bk-sw-a)"/><path d="M176 100 C246 96 308 80 344 54 C366 38 384 28 400 24 L400 100 Z" fill="url(#bk-sw-b)"/><path d="M22 100 C70 86 118 66 166 62 C212 58 244 66 284 56 C328 46 364 22 400 0" fill="none" stroke="rgb(255 255 255 / .22)" stroke-width="1.2"/></svg>
        </div>
      </div>
    </form>
  </div>
</dialog>
<style is:global>
/* ---------- dialog + sheet ---------- */
.bk-dlg { --bk-ease: cubic-bezier(.25, 1, .5, 1); --bk-out: cubic-bezier(.19, 1, .22, 1); --bk-spring: cubic-bezier(.34, 1.56, .64, 1); border: 0; padding: 0; margin: 0; max-width: none; max-height: none; width: 100%; height: 100%; inset: 0; background: transparent; color: #17140f; overflow: visible; }
.bk-dlg[open] { display: flex; align-items: flex-end; justify-content: center; }
.bk-dlg::backdrop { background: rgb(40 14 8 / .5); backdrop-filter: blur(6px); -webkit-backdrop-filter: blur(6px); opacity: 0; transition: opacity 260ms ease; }
.bk-dlg.is-in::backdrop { opacity: var(--bk-bd, 1); }
.bk-dlg.is-out::backdrop { transition-duration: 200ms; }
.bk-dlg.is-drag::backdrop { transition: none; }
html:has(.bk-dlg[open]) { overflow: hidden; }

.bk-sheet.fe-card { --bk-pad: 20px; --bk-r: 28px; position: relative; display: flex; flex-direction: column; width: min(560px, 100%); max-height: calc(100dvh - 96px); padding: calc(var(--bk-pad) + 6px) var(--bk-pad) 0; border-radius: var(--bk-r) var(--bk-r) 0 0; overflow: visible; box-sizing: border-box;
  background: radial-gradient(120% 60% at 50% 0%, #fffaf2, transparent), linear-gradient(180deg, #fff8ee, #fbf0e1); box-shadow: 0 1px 0 #fff inset, 0 -20px 60px -24px rgb(60 20 10 / .45), 0 0 0 1px #f0dfc6;
  transform: translateY(100%); transition: transform 320ms var(--bk-out); -webkit-tap-highlight-color: transparent; }
.bk-dlg.is-in .bk-sheet { transform: none; }
.bk-dlg.is-out .bk-sheet { transform: translateY(100%); transition: transform 200ms cubic-bezier(.4, 0, 1, 1); }
.bk-dlg.is-drag .bk-sheet { transition: none; }
@media (min-width: 641px) {
  .bk-dlg[open] { align-items: center; }
  .bk-sheet.fe-card { --bk-pad: 32px; max-height: min(780px, calc(100dvh - 150px)); margin-top: 56px; border-radius: var(--bk-r); transform: scale(.96); opacity: 0; transition: transform 280ms var(--bk-out), opacity 280ms ease; box-shadow: 0 1px 0 #fff inset, 0 40px 80px -30px rgb(60 20 10 / .55), 0 0 0 1px #f0dfc6; }
  .bk-dlg.is-in .bk-sheet { opacity: 1; }
  .bk-dlg.is-out .bk-sheet { transform: scale(.96); opacity: 0; transition: transform 200ms ease, opacity 200ms ease; }
}
.bk-sheet::before { border-radius: inherit; }
.bk-top { position: relative; flex: none; touch-action: none; cursor: grab; }
.bk-grab { display: none; }
@media (max-width: 640px) { .bk-grab { display: block; position: absolute; left: 50%; top: -16px; width: 40px; height: 5px; margin-left: -20px; border-radius: 3px; background: rgb(60 30 20 / .22); } .bk-top::after { content: ""; position: absolute; left: 0; right: 0; top: -22px; height: 22px; } }
.bk-sheet .fe-h2 { margin: 0 0 12px; padding-right: 56px; text-align: left; font-size: clamp(28px, 7.4vw, 38px); outline: none; }
.bk-x { position: absolute; right: 12px; top: 12px; z-index: 4; width: 44px; height: 44px; display: grid; place-items: center; border: 0; border-radius: 50%; background: #fff; color: #17140f; box-shadow: 0 2px 8px -4px rgb(60 30 20 / .3); cursor: pointer; transition: background-color 200ms ease, scale 120ms cubic-bezier(.25, .46, .45, .94); -webkit-tap-highlight-color: transparent; touch-action: manipulation; }
.bk-x svg { width: 18px; height: 18px; }
.bk-x:active { scale: .94; }
.bk-x:focus-visible, .bk-sheet button:focus-visible, .bk-sheet .fk-f-chip:has(input:focus-visible) { outline: 3px solid rgb(180 18 22 / .25); outline-offset: 3px; }
@media (hover: hover) { .bk-x:hover { background: #fbe9e5; } }

/* welcome elephant peeks over the top-right edge, mirrored to point at the form */
.bk-welcome { position: absolute; z-index: 3; right: 66px; top: -88px; width: 112px; height: auto; pointer-events: none; scale: -1 1; transform-origin: 50% 100%; filter: drop-shadow(0 8px 10px rgb(60 30 20 / .22)); }
.bk-dlg.is-in .bk-sheet[data-step="1"] .bk-welcome { animation: fe-masc-in 700ms var(--bk-spring) 200ms both, fe-masc-sway 3.2s ease-in-out 900ms infinite; }
.bk-dlg.is-in .bk-sheet:not([data-step="1"]) .bk-welcome { animation: fe-masc-out 200ms ease-out both; }

/* steps row: two steps */
.bk-steps { grid-template-columns: repeat(2, 1fr); margin: 0 0 14px; }
.bk-sheet .fe-steps li::before { background: #ead6bb; }
.bk-sheet .bk-form { flex: 1 1 auto; min-height: 0; display: flex; flex-direction: column; }
.bk-main { position: relative; flex: 1 1 auto; min-height: 0; display: flex; flex-direction: column; margin: 0 calc(-1 * var(--bk-pad)); }
.bk-scroll { flex: 1 1 auto; min-height: 0; overflow-x: hidden; overflow-y: auto; overscroll-behavior: contain; padding: 0 var(--bk-pad); scrollbar-width: none; }
.bk-scroll::-webkit-scrollbar { display: none; }
.bk-sheet .fe-q--sm { margin: 2px 0 10px; font-size: clamp(21px, 5.4vw, 26px); }
.bk-sheet .fe-vp { overflow: visible; overflow: clip; overflow-clip-margin: 0; }
.bk-sh { margin: 16px 0 8px; }
.bk-sh:first-of-type { margin-top: 6px; }

/* field colours: ivory like the Banquet form */
.bk-sheet .fk-f-field { background: #fffdf9; border-color: #ecdcc4; box-shadow: 0 2px 6px -3px rgb(120 70 20 / .18); }
.bk-sheet .fe-sec2 { background: #fffdf9; box-shadow: 0 6px 14px -8px rgb(120 70 20 / .35); }

/* day strip (crown chips come from fe-form.css) */
.bk-sheet .fe-days { padding-top: 22px; margin-top: -16px; }
.bk-date { position: absolute; width: 1px; height: 1px; opacity: 0; pointer-events: none; }

/* time + zone chips */
.bk-times { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 8px; }
.bk-zones { display: flex; flex-wrap: wrap; gap: 8px; padding-bottom: 76px; }
.bk-times .bk-chip { flex: none; }
.bk-sheet .bk-chip { position: relative; flex: 1 1 auto; gap: 0; min-height: 44px; padding: 0 10px; background: #fffdf9; border: 1.5px solid #ecdcc4; color: #17140f; font-weight: 500; font-variant-numeric: tabular-nums; transition: background-color 200ms ease, color 200ms ease, border-color 200ms ease, opacity 200ms ease, scale 120ms cubic-bezier(.25, .46, .45, .94), translate 150ms var(--bk-out); }
.bk-times .bk-chip { padding: 0 4px; min-width: 0; }
.bk-sheet .bk-chip:has(input:checked) { background-image: linear-gradient(180deg in oklab, #c4171c, var(--fe-red-d)); border-color: var(--fe-red-d); color: #fff; box-shadow: 0 6px 14px -6px rgb(146 9 12 / .55); }
.bk-sheet .bk-chip:has(input:disabled) { opacity: .38; cursor: not-allowed; }
.bk-sheet .bk-chip:has(input:disabled):active { scale: 1; }
.bk-ck { color: #fff; margin: 0; }
.bk-sheet .bk-chip:has(input:checked) .bk-ck { width: 14px; margin-right: 5px; transform: none; }
@media (hover: hover) { .bk-sheet .bk-chip:not(:has(input:checked)):not(:has(input:disabled)):hover { border-color: var(--fe-red); } .bk-sheet .bk-chip:not(:has(input:disabled)):hover { translate: 0 -1px; } }
.bk-sheet label.bk-chip:not(:has(input:disabled)):active { scale: .97; }

/* guests stepper: number rolls (odometer) */
.bk-sheet .bk-gpanel { padding: 8px; background: #fffdf9; border-color: #ecdcc4; }
.bk-sheet .fe-step-g button { box-shadow: 0 2px 6px -3px rgb(120 70 20 / .3); }
.bk-gv { display: grid; place-items: center; min-width: 0; }
.bk-gnum { justify-items: center; font: 600 30px/1.25 'Poppins', sans-serif; font-variant-numeric: tabular-nums; color: #17140f; min-width: 3ch; text-align: center; }

/* step hint + sticky actions */
.bk-hint { margin: 10px 0 0; }
.bk-sheet .fe-actions:not(.fe-actions--col) { position: sticky; bottom: 0; z-index: 2; margin: auto -4px 0; padding: 14px 4px calc(14px + env(safe-area-inset-bottom, 0px)); background: linear-gradient(180deg, rgb(251 240 225 / 0), #fbf0e1 30%); }
.bk-sheet .fe-actions--col { padding: 86px 0 calc(10px + env(safe-area-inset-bottom, 0px)); }
.bk-sheet .fk-f-fine { margin: 0 0 calc(14px + env(safe-area-inset-bottom, 0px)); text-align: center; }
.bk-sheet .fe-go.is-idle { cursor: pointer; }
.bk-sheet .fe-go.is-idle .fe-go-chip { opacity: .45; }
@media (hover: hover) { .bk-sheet .fe-go.is-idle:hover .fe-go-roll, .bk-sheet .fe-go.is-idle:hover .fe-go-chip svg { transform: none; } .bk-sheet .fe-go.is-idle:hover::after { transform: translateX(-130%); } }
.bk-sheet .fe-go.is-idle:focus-visible .fe-go-roll { transform: none; }
.bk-sheet .fe-go.is-idle:active { scale: 1; }
.bk-sheet .fe-back { width: 100%; }

/* ticket: 4 cells, no photo (the Banquet ticket photo is for laptop only) */
.bk-sheet .fe-tk-top, .bk-sheet .fe-tk-bot { padding-right: 18px; padding-left: 18px; }
.bk-sheet .fe-tk::after { display: none; }
.bk-sheet .fe-tk-bot { grid-template-columns: minmax(0, 1.55fr) auto auto auto; gap: 10px; }
.bk-sheet .fe-tk-v { font-size: clamp(14px, 3.9vw, 18px); }
.bk-sheet .fe-tk-title { font-size: clamp(24px, 6vw, 28px); }
.bk-sheet .fe-tk-slot { margin-bottom: 18px; }
.bk-sheet .fe-sw > span { white-space: nowrap; }

/* thumbs-up: peeks in once per visit (JS adds .is-thumb the first time the form is valid) */
.bk-sheet .fe-actions--col > .fe-masc-t { width: 80px; top: 6px; right: 12px; }
.bk-sheet .fe-actions--col:has(.fe-ring.is-ready) > .fe-masc-t { animation: none; }
.bk-sheet .fe-actions--col.is-thumb:has(.fe-ring) > .fe-masc-t { animation: fe-thumb-in 500ms var(--bk-spring) both; }
.bk-send { position: relative; }

/* done: arch + namaste + 18 sparkles that stay and drift + wave */
.bk-done.fe-done { inset: 0; border-radius: 0 0 var(--bk-r) var(--bk-r); background: linear-gradient(180deg, #fff8ee, #fbf0e1); justify-content: center; padding: 16px 0 clamp(96px, 26vw, 128px); z-index: 5; }
