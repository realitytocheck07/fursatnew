---
import site from '../data/site.json';
// SiteFooter.astro (v5.87): compact designed close. Brand row, 4 short columns, legal bar,
// plus the trendy layer: curtain reveal, giant wordmark, marquee, micro-interactions.
// TODO(client): the unit number / floor of the address is unconfirmed (legal info says Shop G1, the old footer said 'Level 3'). Only the confirmed part is shown.
// TODO(client): a second phone number is unconfirmed. Only the main phone from site.json is shown.
// TODO(client): the banquet-loop footer video is not in the repo (no /assets/video), so the optional video layer is skipped.
const hoursData = JSON.stringify(site.hours.schedule.map((s) => ({ d: s.dayOfWeek, o: s.opens, c: s.closes, ol: s.open, cl: s.close })));
const year = new Date().getFullYear();
const insta = [
  { h: 'fursatind.in', l: 'Kitchen & Bar' },
  { h: 'fursat_bitesandbuffet', l: 'Bites & Buffet' },
  { h: 'fursatbanquets', l: 'Banquets' },
  { h: 'fursatsocialclub', l: 'Social Club' },
];
const marquee = ['Café', 'Kitchen', 'Bar', 'Banquets', 'Catering', 'Capital Park, Madhapur'];
// The legal dialog (LegalDialog.astro) only exists on Home, so the opener button only renders there.
const hasLegalDialog = Astro.url.pathname === '/';
---
<footer class="sf-footer" id="visit" data-sf>
  <div class="sf-marquee" aria-hidden="true">
    <div class="sf-mq-track">
      {[0, 1].map(() => (
        <ul class="sf-mq-set">
          {marquee.map((w) => <li>{w}<i></i></li>)}
        </ul>
      ))}
    </div>
  </div>

  <div class="sf-band">
    <div class="sf-giant" aria-hidden="true"></div>
    <div class="sf-container">
      <div class="sf-top">
        <div class="sf-brand">
          <a href="/" class="sf-word" aria-label="Fursat Kitchen | Bar, home"><img src="/assets/brand/fursat-wordmark.svg" alt="" aria-hidden="true" width="441" height="88" loading="lazy" decoding="async" /></a>
          <p class="sf-tagline">Good food · Great drinks · Better days</p>
        </div>
        <div class="sf-actions">
          <a class="sf-btn sf-btn--red" href="/reserve" data-open="book">Reserve a table</a>
          <a class="sf-btn" href={`https://wa.me/${site.whatsapp}`} target="_blank" rel="noopener">WhatsApp</a>
          <a class="sf-btn" href={`tel:+${site.phonePlain}`}>Call</a>
        </div>
      </div>

      <div class="sf-cols">
        <section class="sf-col sf-visit" aria-labelledby="sf-t-visit">
          <h2 class="sf-title" id="sf-t-visit">Visit</h2>
          {/* TODO(client): add the unit number and floor once the client confirms them. */}
          <p class="sf-addr">{site.address.line1}, {site.address.line2}, {site.address.state} {site.address.pin}</p>
          <a class="sf-link" href={site.address.googleMaps} target="_blank" rel="noopener">Get directions</a>
          <p class="sf-hours">{site.hours.display}</p>
          <p class="sf-open" data-hours={hoursData} hidden></p>
        </section>
        <nav class="sf-col sf-explore" aria-labelledby="sf-t-explore">
          <h2 class="sf-title" id="sf-t-explore">Explore</h2>
          <a class="sf-link" href="/menu">Menu</a>
          <a class="sf-link" href="/restaurant-bar">Bar &amp; Kitchen</a>
          <a class="sf-link" href="/cafe">Café</a>
          <a class="sf-link" href="/story">Our Story</a>
          <a class="sf-link" href="/ask">Ask Fursat</a>
          <p class="sf-order">Order: <a href={site.order.swiggy} target="_blank" rel="noopener">Swiggy</a> · <a href={site.order.zomato} target="_blank" rel="noopener">Zomato</a></p>
        </nav>
        <nav class="sf-col sf-celebrate" aria-labelledby="sf-t-cel">
          <h2 class="sf-title" id="sf-t-cel">Celebrate</h2>
          <a class="sf-link" href="/party">Parties &amp; events</a>
          <a class="sf-link" href="/banquet">Banquet hall</a>
          <a class="sf-link" href="/catering">Outdoor catering</a>
        </nav>
        <section class="sf-col sf-connect" aria-labelledby="sf-t-con">
          <h2 class="sf-title" id="sf-t-con">Connect</h2>
          <div class="sf-conn-links">
            <a class="sf-link" href={`tel:+${site.phonePlain}`}>{site.phone}</a>
            <a class="sf-link" href={`mailto:${site.email}`}>{site.email}</a>
            <a class="sf-link" href={site.address.review} target="_blank" rel="noopener">Rate us on Google ★</a>
          </div>
          <ul class="sf-ig">
            {insta.map((a) => (
              <li><a href={`https://www.instagram.com/${a.h}`} target="_blank" rel="noopener" aria-label={`Instagram: ${a.l} (@${a.h})`}>
                <svg viewBox="0 0 24 24" aria-hidden="true"><rect x="3.5" y="3.5" width="17" height="17" rx="5"/><circle cx="12" cy="12" r="4"/><circle cx="17.2" cy="6.8" r="1" class="sf-dot"/></svg>
                <span class="sf-ig-n">{a.l}</span>
              </a></li>
            ))}
          </ul>
        </section>
      </div>

      <div class="sf-bottom">
        <p class="sf-copy">© {year} Fursat Kitchen | Bar · {site.legal.name} · GSTIN {site.legal.gstin} · FSSAI {site.legal.fssai}</p>
        <p class="sf-legal">{hasLegalDialog && <button class="sf-legal-btn" type="button" id="lbopen" aria-haspopup="dialog" aria-controls="fxlegal">Legal information</button>}<a href="/terms">Terms</a><a href="/terms#privacy">Privacy</a><a href="/terms#refund">Refund</a><a class="sf-by" href="https://bjnexusai.com" target="_blank" rel="noopener">Website by BJNexus AI</a></p>
      </div>
    </div>
  </div>
</footer>

<style is:global>
  .sf-footer { --sf-bg:#10261a; --sf-cream:#f3ecd9; --sf-gold:#e8c27a; --sf-red:#c0291f; position:relative; z-index:0; background:var(--sf-bg); color:var(--sf-cream); font-family:var(--sans, Rupee,"Poppins",system-ui,sans-serif); }
  .sf-footer *, .sf-footer *::before, .sf-footer *::after { box-sizing:border-box; }
  .sf-footer a { color:var(--sf-cream); text-decoration:none; }
  .sf-footer :focus-visible { outline:2px solid var(--sf-gold); outline-offset:3px; border-radius:4px; }

  /* marquee */
  .sf-marquee { overflow:hidden; background:var(--sf-bg); padding:clamp(14px,2.4vw,28px) 0 0; -webkit-mask-image:linear-gradient(90deg,transparent,#000 10%,#000 90%,transparent); mask-image:linear-gradient(90deg,transparent,#000 10%,#000 90%,transparent); }
  .sf-mq-track { display:flex; width:max-content; animation:sf-mq 70s linear infinite; will-change:transform; }
  .sf-mq-set { display:flex; flex:none; margin:0; padding:0; list-style:none; font:italic 500 clamp(2rem,6vw,4.5rem)/1.15 "Playfair Display",Georgia,serif; color:var(--sf-gold); white-space:nowrap; }
  .sf-mq-set li { display:flex; align-items:center; }
  .sf-mq-set i { width:.2em; height:.2em; border-radius:50%; background:var(--sf-red); margin:0 .6em; flex:none; }
  @keyframes sf-mq { to { transform:translateX(-50%); } }
  .sf-footer.sf-paused .sf-mq-track { animation-play-state:paused; }
  @media (hover:hover) { .sf-marquee:hover .sf-mq-track { animation-play-state:paused; } }

  /* band */
  .sf-band { position:relative; overflow:hidden; padding:clamp(20px,2.4vw,28px) 0 0; }
  .sf-giant { position:absolute; left:0; right:0; margin:0 auto; width:min(96vw,1500px); aspect-ratio:441/88; bottom:-.02em; background:var(--sf-cream); opacity:.08; -webkit-mask:url(/assets/brand/fursat-wordmark.svg) center bottom/100% auto no-repeat; mask:url(/assets/brand/fursat-wordmark.svg) center bottom/100% auto no-repeat; pointer-events:none; z-index:0; }
  .sf-container { position:relative; z-index:1; max-width:1400px; margin:0 auto; padding:0 clamp(16px,4vw,40px); }
  .sf-top { display:flex; flex-direction:column; gap:18px; padding-bottom:clamp(18px,2vw,22px); }
  .sf-word img { display:block; height:clamp(40px,4.8vw,64px); width:auto; filter:brightness(0) invert(1) sepia(.15) saturate(.6); opacity:.97; }
  .sf-word { display:inline-block; }
  .sf-tagline { margin:10px 0 0; font-size:.9375rem; color:var(--sf-cream); }
  .sf-actions { display:grid; grid-template-columns:repeat(3,1fr); gap:10px; }
  .sf-btn { display:inline-flex; align-items:center; justify-content:center; min-height:44px; padding:0 20px; border-radius:999px; border:1.5px solid rgba(243,236,217,.55); font-weight:600; font-size:.9375rem; transition:transform .12s ease, background-color .2s ease; -webkit-tap-highlight-color:transparent; }
  .sf-btn--red { background:var(--sf-red); border-color:var(--sf-red); color:#fff !important; }
  .sf-btn:active { transform:scale(.96); }
  @media (hover:hover) { .sf-btn:not(.sf-btn--red):hover { background:rgba(243,236,217,.1); } .sf-btn--red:hover { background:#d63326; } }

  /* columns */
  .sf-cols { display:grid; grid-template-columns:1fr 1fr; gap:22px 20px; padding:22px 0; border-top:1px solid rgba(201,154,67,.35); }
  .sf-col { display:flex; flex-direction:column; align-items:flex-start; gap:2px; min-width:0; }
  .sf-title { margin:0 0 8px; font:600 .75rem/1.2 var(--sans,"Poppins",sans-serif); letter-spacing:.14em; text-transform:uppercase; color:var(--sf-gold); }
  .sf-link { position:relative; display:inline-flex; align-items:center; min-height:36px; font-size:.9375rem; overflow-wrap:anywhere; }
  .sf-link::after { content:""; position:absolute; left:0; right:0; bottom:4px; height:1.5px; background:var(--sf-gold); transform:scaleX(0); transform-origin:left; transition:transform .2s ease; }
  .sf-link:focus-visible::after { transform:scaleX(1); }
  @media (hover:hover) { .sf-link:hover::after, .sf-order a:hover, .sf-legal a:hover { transform:scaleX(1); } .sf-order a:hover, .sf-legal a:hover { text-decoration:underline; text-decoration-color:var(--sf-gold); text-underline-offset:4px; } }
  .sf-addr, .sf-hours { margin:0 0 6px; font-size:.9375rem; line-height:1.5; }
  .sf-open { margin:2px 0 0; display:inline-flex; align-items:center; gap:7px; font-weight:600; font-size:.875rem; }
  .sf-open::before { content:""; width:8px; height:8px; border-radius:50%; background:#ffb3a8; }
  .sf-open.is-open::before { background:#7fd19a; }
  .sf-order { margin:6px 0 0; font-size:.875rem; white-space:nowrap; }
  .sf-order a { display:inline-flex; align-items:center; min-height:36px; padding:0 2px; }
  .sf-visit { grid-column:1 / -1; background:#16301f; padding:16px; border-radius:14px; }
  .sf-connect { grid-column:1 / -1; }
  .sf-conn-links { display:flex; flex-wrap:wrap; column-gap:22px; }
  .sf-ig { display:flex; flex-wrap:nowrap; justify-content:flex-start; gap:8px; margin:10px 0 0; padding:0; list-style:none; }
  .sf-ig a { display:flex; flex-direction:column; align-items:center; gap:4px; min-width:44px; transition:transform .2s ease; }
  .sf-ig svg { box-sizing:content-box; padding:12px; border-radius:50%; background:#1d3d29; }
  .sf-ig svg { width:20px; height:20px; fill:none; stroke:var(--sf-cream); stroke-width:1.7; } .sf-ig .sf-dot { fill:var(--sf-cream); stroke:none; }
  .sf-ig-n { font-size:.75rem; line-height:1.2; text-align:center; max-width:76px; transition:color .2s ease; }
  .sf-ig a:focus-visible .sf-ig-n { color:var(--sf-gold); }
  @media (hover:hover) { .sf-ig a:hover { transform:translateY(-2px); } .sf-ig a:hover .sf-ig-n { color:var(--sf-gold); } }

  /* bottom bar */
  .sf-bottom { display:flex; flex-direction:column; gap:6px; padding:8px 0 10px; border-top:1px solid rgba(201,154,67,.2); font-size:.75rem; }
  .sf-copy { margin:0; color:var(--sf-cream); line-height:1.5; }
  .sf-legal { margin:0; display:flex; gap:4px; }
  .sf-legal a { display:inline-flex; align-items:center; min-height:44px; padding:0 10px 0 0; font-size:.8125rem; }
  .sf-legal a + a, .sf-legal-btn + a { padding-left:10px; border-left:1px solid rgba(243,236,217,.3); }
  .sf-legal { flex-wrap:wrap; }
  .sf-legal-btn { all:unset; cursor:pointer; box-sizing:border-box; display:inline-flex; align-items:center; min-height:44px; padding:0 10px 0 0; font-size:.8125rem; text-decoration:underline; text-decoration-color:var(--sf-gold); text-underline-offset:.2em; }
  .sf-legal-btn:focus-visible { outline:2px solid var(--sf-gold); outline-offset:2px; border-radius:4px; }
  .sf-legal .sf-by { font-size:.75rem; opacity:.8; }

  /* entrance (once) */
  .sf-js .sf-giant { opacity:0; transform:translateY(24px); transition:opacity .6s ease-out, transform .6s ease-out; }
  .sf-js.sf-in .sf-giant { opacity:.08; transform:none; }
  .sf-js .sf-col { opacity:0; transform:translateY(12px); transition:opacity .5s ease-out, transform .5s ease-out; transition-delay:calc(var(--i,0) * 70ms); }
  .sf-js.sf-in .sf-col { opacity:1; transform:none; }

  /* phone: keep v5.83 clearance for the Book bar / nav bar */
  @media (max-width:899px) { .sf-band { padding-bottom:calc(var(--mb-clear,76px) + 72px + env(safe-area-inset-bottom,0px)); } .sf-giant { bottom:calc(var(--mb-clear,76px) + 10px + env(safe-area-inset-bottom,0px)); } .sf-link { min-height:44px; } .sf-order { display:flex; align-items:center; flex-wrap:nowrap; white-space:nowrap; min-height:44px; margin:0; } .sf-order a { padding:12px 4px; } .sf-mq-set { font-size:clamp(1.75rem,6vw,4.5rem); } }
  @media (min-width:640px) and (max-width:899px) { .sf-cols { grid-template-columns:1.25fr 1fr 1fr 1.25fr; gap:20px 16px; } .sf-visit, .sf-connect { grid-column:auto; } .sf-visit { order:0; background:none; padding:0; border-radius:0; } .sf-ig { flex-wrap:wrap; } .sf-conn-links { display:flex; flex-direction:column; align-items:flex-start; } .sf-top { flex-direction:row; align-items:center; justify-content:space-between; } .sf-actions { display:flex; } }
  @media (max-width:899px) { .sf-visit { order:-1; } }

  /* desktop */
  @media (min-width:900px) {
    .sf-top { flex-direction:row; align-items:center; justify-content:space-between; }
    .sf-actions { display:flex; }
    .sf-cols { grid-template-columns:1.3fr .8fr .9fr 1.2fr; gap:32px; padding:22px 0; }
    .sf-visit { grid-column:auto; background:none; padding:0; border-radius:0; order:0; }
    .sf-connect { grid-column:auto; }
    .sf-conn-links { display:flex; flex-direction:column; align-items:flex-start; }
    .sf-bottom { flex-direction:row; justify-content:space-between; align-items:center; }
    .sf-legal a { min-height:36px; }
    .sf-footer.sf-curtain { position:sticky; bottom:0; }
  }
  .sf-curtain-lift { position:relative; z-index:1; }
  .sf-footer.sf-curtain::before { content:""; position:absolute; left:0; right:0; top:0; height:72px; background:linear-gradient(rgba(0,0,0,.38),rgba(0,0,0,0)); pointer-events:none; z-index:2; }

</style>

<script is:inline>
  (function () {
    var f = document.querySelector('footer.sf-footer[data-sf]');
    if (!f) return;
    var rm = false; // owner rule: motion runs for every visitor
    // live Open now / Closed badge (same logic as the header; IST)
    try {
      var b = f.querySelector('.sf-open'), s = JSON.parse(b.getAttribute('data-hours'));
      var P = new Intl.DateTimeFormat('en-GB', { timeZone: 'Asia/Kolkata', weekday: 'long', hour: '2-digit', minute: '2-digit', hourCycle: 'h23' }).formatToParts(new Date());
      var g = function (t) { var p = P.find(function (x) { return x.type === t; }); return p ? p.value : ''; };
      var D = ['Sunday', 'Monday', 'Tuesday', 'Wednesday', 'Thursday', 'Friday', 'Saturday'], day = g('weekday'), m = parseInt(g('hour'), 10) * 60 + parseInt(g('minute'), 10);
      var M = function (x) { var a = x.split(':'); return parseInt(a[0], 10) * 60 + parseInt(a[1], 10); };
      var R = function (d) { return s.find(function (r) { return r.d.indexOf(d) > -1; }); };
      var t = R(day), y = R(D[(D.indexOf(day) + 6) % 7]), open = false, until = '';
      if (y && M(y.c) < M(y.o) && m < M(y.c)) { open = true; until = y.cl; }
      else if (t) { var o = M(t.o), c = M(t.c); if (c <= o) c += 1440; if (m >= o && m < c) { open = true; until = t.cl; } }
      b.textContent = open ? 'Open now · until ' + until : 'Closed · opens ' + (t && m < M(t.o) ? t.ol : (R(D[(D.indexOf(day) + 1) % 7]) || {}).ol || '');
      b.classList.toggle('is-open', open); b.hidden = false;
    } catch (e) {}
    f.querySelectorAll('.sf-col').forEach(function (c, i) { c.style.setProperty('--i', i); });
    // curtain reveal: desktop only; the content above is lifted over the sticky footer. Skipped on the party stack.
    var lifted = [];
    var siblings = function () {
      var out = [], e = f.previousElementSibling;
      while (e) { if (!/^(SCRIPT|STYLE|LINK|TEMPLATE)$/.test(e.tagName)) { var cs = getComputedStyle(e); if (cs.position !== 'fixed' && cs.position !== 'absolute' && cs.display !== 'none') out.push(e); } e = e.previousElementSibling; }
      return out;
    };
    var setCurtain = function () {
      var on = window.matchMedia('(min-width: 900px)').matches && !rm && !document.querySelector('.pa-stack, [data-pa-stack]') && !/^\/party/.test(location.pathname) && !!f.previousElementSibling;
      f.classList.toggle('sf-curtain', on);
      lifted.forEach(function (e) { e.classList.remove('sf-curtain-lift'); if (e.dataset.sfBg) { e.style.backgroundColor = ''; delete e.dataset.sfBg; } if (e.dataset.sfBleed) { e.style.boxShadow = ''; e.style.clipPath = ''; delete e.dataset.sfBleed; } });
      lifted = [];
      if (!on) return;
      var bg = getComputedStyle(document.body).backgroundColor;
      if (/rgba\(.*,\s*0\)|transparent/.test(bg)) bg = getComputedStyle(document.documentElement).backgroundColor;
      siblings().forEach(function (e) {
        // never lift the header or anything fixed/sticky or already stacked above (its menus must stay on top of the page)
        var cs = getComputedStyle(e), z = parseInt(cs.zIndex, 10);
        if (e.matches('header, .sh-header, [data-no-curtain]') || cs.position === 'fixed' || cs.position === 'sticky' || z > 1) return;
        e.classList.add('sf-curtain-lift'); lifted.push(e);
        var c = getComputedStyle(e).backgroundColor;
        if (/rgba\(.*,\s*0\)|transparent/.test(c)) { e.style.backgroundColor = bg; e.dataset.sfBg = '1'; c = bg; }
        // a lifted block narrower than the page (or with margins) left gaps where the dark footer showed through: paint its colour full width and over its own margins
        var lc = getComputedStyle(e);
        if (lc.boxShadow === 'none' && lc.clipPath === 'none') {
          e.style.boxShadow = '0 0 0 100vmax ' + c;
          e.style.clipPath = 'inset(-' + (parseFloat(lc.marginTop) || 0) + 'px -100vmax -' + (parseFloat(lc.marginBottom) || 0) + 'px -100vmax)';
          e.dataset.sfBleed = '1';
        }
      });
    };
    setCurtain(); window.addEventListener('resize', setCurtain);
    // once-in-view entrance + pause marquee off screen
    if (rm || !('IntersectionObserver' in window)) return;
    f.classList.add('sf-js');
    var once = new IntersectionObserver(function (e) { if (e[0].isIntersecting) { f.classList.add('sf-in'); once.disconnect(); } }, { threshold: 0.15 });
    once.observe(f);
    var mq = f.querySelector('.sf-marquee');
    new IntersectionObserver(function (e) { f.classList.toggle('sf-paused', !e[0].isIntersecting); }).observe(mq);
  })();
</script>
