---
// PackageBuilder — the five banquet packages (party.json, group "banquet") as an interactive menu builder.
// Guests pick a package, choose dishes within each course's "Any N", set guests/date and send the menu on WhatsApp.
// Data: names, prices and rules come only from party.json (the client's package sheets, Nov 2026). Nothing invented.
// No JS: the first package shows as a plain list. Owner rule: no reduced-motion fallbacks.
import data from '../../data/party.json';
import site from '../../data/site.json';

const ORDER = ['Welcome drink', 'Soup', 'Salad', 'Veg starters', 'Non-veg starters', 'Rice, veg', 'Rice', 'Rice, non-veg', 'Veg curries', 'Non-veg curries', 'Veg fry', 'Dal', 'Indian breads', 'Desserts', 'Accompaniments'];
const rank = (h: string) => { const i = ORDER.findIndex((o) => h.toLowerCase().startsWith(o.toLowerCase())); return i < 0 ? 99 : i; };
const label = (h: string) => h.replace(/\s*\(mocktail\)/i, '').replace('Rice, veg', 'Veg rice').replace('Rice, non-veg', 'Non-veg rice');
const isNonVeg = (h: string) => /non-veg/i.test(h);
const pkgs = (data as any).packages
  .filter((p: any) => p.group === 'banquet')
  .map((p: any) => {
    const courses = [...p.sections].sort((a: any, b: any) => rank(a.h) - rank(b.h)).map((s: any, i: number) => {
      const n = parseInt(String(s.rule || '').replace(/\D/g, ''), 10);
      return { id: `${p.id}-c${i}`, h: label(s.h), pick: Number.isFinite(n) ? n : 0, items: s.items as string[], nv: isNonVeg(s.h) };
    });
    const choose = courses.filter((c: any) => c.pick > 0);
    const count = (re: RegExp) => choose.filter((c: any) => re.test(c.h)).reduce((t: number, c: any) => t + c.pick, 0);
    const tags = ([[count(/starters/i), 'starter', 'starters'], [count(/rice/i), 'rice', 'rice'], [count(/curries/i), 'curry', 'curries'], [count(/desserts/i), 'dessert', 'desserts']] as [number, string, string][])
      .filter(([n]) => n > 0).map(([n, one, many]) => `${n} ${n === 1 ? one : many}`);
    return {
      id: p.id, price: p.price, veg: !!p.veg, courses, choose: choose.length,
      kind: p.veg ? 'Veg' : 'Non-veg',
      tags, sum: tags.join(' · '),
    };
  })
  .sort((a: any, b: any) => a.price - b.price);
const inr = (n: number) => '₹' + n.toLocaleString('en-IN');
const first = pkgs[0];
const ICON: Record<string, string> = {
  drink: '<path d="M6 3h12l-1.5 7a4.5 4.5 0 0 1-9 0z"/><path d="M12 14.5V21M8.5 21h7"/>',
  bowl: '<path d="M3 11h18a9 9 0 0 1-18 0z"/><path d="M8 7c0-1.5 1-2 1-3.5M12 7c0-1.5 1-2 1-3.5M16 7c0-1.5 1-2 1-3.5"/>',
  leaf: '<path d="M5 19c0-8 5-14 15-14 0 10-6 15-14 15"/><path d="M5 19 14 10"/>',
  flame: '<path d="M12 3c3 4 6 6.5 6 10.5a6 6 0 0 1-12 0C6 10 9 9 9 6c2 1.5 3 3 3 5"/>',
  rice: '<path d="M4 12h16a8 8 0 0 1-16 0z"/><path d="M7 12c.5-3 2.5-5 5-5s4.5 2 5 5"/>',
  pot: '<path d="M5 10h14v5a5 5 0 0 1-5 5h-4a5 5 0 0 1-5-5z"/><path d="M3 10h18M9 6c0-1 1-1.5 1-2.5M14 6c0-1 1-1.5 1-2.5"/>',
  bread: '<path d="M5 9a4 4 0 0 1 4-4h6a4 4 0 0 1 4 4c0 1.2-.8 2-2 2v8H7v-8c-1.2 0-2-.8-2-2z"/>',
  sweet: '<path d="M7 11h10l-1.2 9H8.2z"/><path d="M6 11a6 6 0 0 1 12 0"/><circle cx="12" cy="5" r="1.5"/>',
  plate: '<circle cx="12" cy="12" r="8"/><circle cx="12" cy="12" r="4"/>',
};
const iconFor = (h: string) => /drink/i.test(h) ? ICON.drink : /soup/i.test(h) ? ICON.bowl : /salad/i.test(h) ? ICON.leaf : /starter/i.test(h) ? ICON.flame : /rice/i.test(h) ? ICON.rice : /curr|dal|fry/i.test(h) ? ICON.pot : /bread/i.test(h) ? ICON.bread : /dessert/i.test(h) ? ICON.sweet : ICON.plate;
---
<section class="pb" id="feast" aria-labelledby="pb-h" data-wa={site.phonePlain}>
  <span class="pb-anchor" id="packages" aria-hidden="true"></span>{/* old #packages links (Home, footer, WhatsApp) still land here */}
  <div class="pb-in">
    <header class="pb-head">
      <h2 id="pb-h" class="fk-ty-h2 pb-title">Craft your <span class="pb-hl">feast</span></h2>
      <p class="pb-lead">Pick a package, choose your dishes course by course, and send the menu to us on WhatsApp. Prices are per guest, plus taxes.</p>
    </header>

    <div class="pb-pkgp fk-f-card">
    <h3 class="pb-sh"><span class="pb-n" aria-hidden="true">1</span>Choose your package</h3>
    <div class="pb-pkgs" role="radiogroup" aria-label="Banquet package">
      {pkgs.map((p: any, i: number) => (
        <button type="button" class={`pb-pkg${i === 0 ? ' is-on' : ''}`} role="radio" aria-checked={i === 0 ? 'true' : 'false'} tabindex={i === 0 ? 0 : -1} data-pkg={p.id} data-price={p.price} data-kind={p.kind} data-sum={p.sum}>
          <span class={`pb-dot ${p.veg ? 'is-veg' : 'is-nv'}`} aria-hidden="true"></span>
          <span class="pb-kind">{p.kind}</span>
          <span class="pb-price">{inr(p.price)}</span>
          <span class="pb-per">per guest + taxes</span>
          <span class="pb-tags">{p.tags.map((t: string) => <span class="pb-tag">{t}</span>)}</span>
        </button>
      ))}
    </div>
    <p class="pb-cap" id="pb-cap" aria-hidden="true">{inr(first.price)} per guest + taxes · {first.sum}</p>
    </div>

    <div class="pb-body">
      <div class="pb-panels">
        <h3 class="pb-sh"><span class="pb-n" aria-hidden="true">2</span>Choose your dishes</h3>
        {pkgs.map((p: any, i: number) => (
          <div class="pb-panel" data-panel={p.id} hidden={i !== 0 ? true : undefined}>
            {p.courses.map((c: any) => (
              <fieldset class={`pb-course${c.pick ? '' : ' is-incl'}`} data-course={c.id} data-pick={c.pick} data-h={c.h}>
                <legend class="pb-ch">
                  <span class="pb-ico" aria-hidden="true"><svg viewBox="0 0 24 24" set:html={iconFor(c.h)} /></span>
                  <span class="pb-cn">{c.h}{c.nv && <span class="pb-nv" title="Non-vegetarian">Non-veg</span>}</span>
                  {c.pick
                    ? <span class="pb-rule"><b class="pb-got">0</b>/{c.pick} <span class="pb-sr">chosen</span></span>
                    : <span class="pb-rule pb-rule--incl">Included</span>}
                </legend>
                {c.pick
                  ? <div class="pb-chips">{c.items.map((it: string) => <button type="button" class="fk-f-chip pb-chip" aria-pressed="false" data-item={it}>{it}</button>)}</div>
                  : <p class="pb-incl">{c.items.join(' · ')}</p>}
              </fieldset>
            ))}
          </div>
        ))}
      </div>

      <aside class="pb-sum-card fk-f-card" aria-label="Your menu">
        <input type="checkbox" name="botcheck" tabindex="-1" autocomplete="off" aria-hidden="true" style="position:absolute;left:-9999px;width:1px;height:1px;opacity:0">
        <div class="pb-sc-top">
          <p class="pb-sc-k">Your package</p>
          <p class="pb-sc-p"><span id="pb-sc-price">{inr(first.price)}</span> <small id="pb-sc-kind">{first.kind}</small></p>
          <div class="pb-meter" aria-hidden="true"><i id="pb-bar"></i></div>
          <p class="pb-sc-prog" id="pb-prog">0 of {first.choose} courses chosen</p>
        </div>
        <p class="pb-sh"><span class="pb-n" aria-hidden="true">3</span>Guests &amp; date</p>
        <div class="pb-fields">
          <label class="pb-f fk-f-group"><span class="fk-f-label">Guests</span>
            <span class="pb-step fk-f-step"><button type="button" id="pb-minus" aria-label="Fewer guests">−</button><input id="pb-guests" type="number" inputmode="numeric" min="1" value="50" aria-label="Number of guests" /><button type="button" id="pb-plus" aria-label="More guests">+</button></span>
          </label>
          <label class="pb-f fl-field"><span class="fl-fl">Event date <span class="fl-opt">(optional)</span></span><input id="pb-date" class="fk-f-field" type="date" /><svg class="fl-ok" viewBox="0 0 24 24" aria-hidden="true"><path d="M5 12.5l4.5 4.5L19 7.5" fill="none" stroke="#2a5019" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" pathLength="20"/></svg></label>
        </div>
        <div class="fl-live" id="fl-live"><div class="fl-live-in"><p class="fl-live-p" aria-live="polite"><span class="fl-sr" id="fl-live-sr"></span><span id="fl-live-vis" aria-hidden="true"></span></p></div></div>
        <p class="pb-est" aria-live="polite"><span>Estimate</span> <b id="pb-est">{inr(first.price * 50)}</b> <small>+ taxes</small></p>
        <span class="fl-ring"><button type="button" class="fl-go pb-send" id="pb-send"><span class="fl-roll" aria-hidden="true"><span class="fl-roll-in"><span>Send on WhatsApp</span><span>Send on WhatsApp</span></span></span><span class="fl-sr">Send on WhatsApp</span><span class="fl-chip" aria-hidden="true"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"/></svg></span></button></span>
        <a class="fl-sec pb-call" href={`tel:+${site.phonePlain}`}><span>Call Fursat</span></a>
        <p class="pb-note" id="pb-note">You can send it even before every course is chosen; we will help you finish it.</p>
        <a class="pb-alt" href="#lock-date">Prefer a call back? Use the enquiry form</a>
      </aside>
    </div>
    <p class="pb-lockline">Not sure about dishes yet? <a href="#lock-date">Lock your date first →</a></p>
    <p class="pb-live pb-sr" id="pb-live" aria-live="polite"></p>
  </div>

  <!-- phone: compact bar above the bottom navigation -->
  <div class="pb-dock" id="pb-dock" hidden>
    <span class="pb-dock-t"><span class="pb-dock-1"><span id="pb-dock-pkg">{inr(first.price)} {first.kind}</span> · <span id="pb-dock-prog">0 of {first.choose} chosen</span></span><span class="pb-dock-2">Est. <b id="pb-dock-price">{inr(first.price * 50)}</b> + taxes</span></span>
    <span class="fl-ring"><button type="button" class="fl-go pb-dock-b" id="pb-dock-send" aria-label="Send my menu on WhatsApp"><span class="fl-roll" aria-hidden="true"><span class="fl-roll-in"><span>Send</span><span>Send</span></span></span><span class="fl-chip" aria-hidden="true"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"/></svg></span></button></span>
  </div>
</section>

<script is:inline>
(function () {
  var root = document.getElementById('feast'); if (!root) return;
  var q = function (s, c) { return (c || root).querySelector(s); }, qa = function (s, c) { return [].slice.call((c || root).querySelectorAll(s)); };
  var inr = function (n) { return '₹' + Number(n).toLocaleString('en-IN'); };
  var pkgBtns = qa('.pb-pkg'), live = q('#pb-live'), guests = q('#pb-guests'), date = q('#pb-date');
  var cur = pkgBtns[0];
  function panel() { return q('[data-panel="' + cur.dataset.pkg + '"]'); }
  function courses() { return qa('.pb-course', panel()); }
  function chosen(c) { return qa('.pb-chip[aria-pressed="true"]', c); }
  function refresh() {
    var cs = courses().filter(function (c) { return +c.dataset.pick > 0; }), done = 0;
    cs.forEach(function (c) {
      var n = chosen(c).length, pick = +c.dataset.pick; c.querySelector('.pb-got').textContent = n;
      c.classList.toggle('is-done', n >= pick);
      qa('.pb-chip', c).forEach(function (b) { b.classList.toggle('is-locked', n >= pick && pick > 1 && b.getAttribute('aria-pressed') !== 'true'); });
      if (n >= pick) done++;
    });
    var g = Math.max(1, parseInt(guests.value, 10) || 0), price = +cur.dataset.price;
    q('#pb-sc-price').textContent = inr(price); q('#pb-sc-kind').textContent = cur.dataset.kind;
    q('#pb-dock-price').textContent = inr(price * g);
    q('#pb-prog').textContent = done + ' of ' + cs.length + ' courses chosen';
    q('#pb-dock-prog').textContent = done + ' of ' + cs.length + ' chosen';
    q('#pb-dock-pkg').textContent = inr(price) + ' ' + cur.dataset.kind;
    q('#pb-bar').style.transform = 'scaleX(' + (cs.length ? done / cs.length : 0) + ')';
    q('#pb-est').textContent = inr(price * g);
    var rdy = cs.length > 0 && done === cs.length; qa('.fl-ring').forEach(function (w) { w.classList.toggle('is-ready', rdy); });
    flLive(cs.length, done, price, g);
  }
  function selectPkg(btn, focus) {
    cur = btn;
    pkgBtns.forEach(function (b) { var on = b === btn; b.setAttribute('aria-checked', on); b.classList.toggle('is-on', on); b.tabIndex = on ? 0 : -1; });
    qa('.pb-panel').forEach(function (p) { p.hidden = p.dataset.panel !== btn.dataset.pkg; });
    if (focus) btn.focus();
    q('#pb-cap').textContent = inr(btn.dataset.price) + ' per guest + taxes · ' + btn.dataset.sum;
    live.textContent = btn.dataset.kind + ' package, ' + inr(btn.dataset.price) + ' per guest selected';
    refresh();
    try { history.replaceState(null, '', '?pkg=' + btn.dataset.pkg + '#feast'); } catch (e) {}
    try { document.dispatchEvent(new CustomEvent('pb:pkg', { detail: { id: btn.dataset.pkg, price: btn.dataset.price, kind: btn.dataset.kind } })); } catch (e) {}
  }
  pkgBtns.forEach(function (b, i) {
    b.addEventListener('click', function () { selectPkg(b, false); });
    b.addEventListener('keydown', function (e) {
      var k = e.key, j = k === 'ArrowRight' || k === 'ArrowDown' ? i + 1 : k === 'ArrowLeft' || k === 'ArrowUp' ? i - 1 : k === 'Home' ? 0 : k === 'End' ? pkgBtns.length - 1 : null;
      if (j === null) return; e.preventDefault(); selectPkg(pkgBtns[(j + pkgBtns.length) % pkgBtns.length], true);
    });
  });
  root.addEventListener('click', function (e) {
    var chip = e.target.closest && e.target.closest('.pb-chip'); if (!chip) return;
    var c = chip.closest('.pb-course'), pick = +c.dataset.pick, on = chip.getAttribute('aria-pressed') === 'true', got = chosen(c);
    if (on) { chip.setAttribute('aria-pressed', 'false'); }
    else if (got.length < pick) { chip.setAttribute('aria-pressed', 'true'); }
    else if (pick === 1) { got[0].setAttribute('aria-pressed', 'false'); chip.setAttribute('aria-pressed', 'true'); }
    else { live.textContent = c.dataset.h + ': you already chose ' + pick + '. Remove one to change.'; c.classList.remove('is-nudge'); void c.offsetWidth; c.classList.add('is-nudge'); return; }
    refresh();
    var n = chosen(c).length; live.textContent = c.dataset.h + ': ' + n + ' of ' + pick + ' chosen';
  });
  function step(d) { guests.value = Math.max(1, (parseInt(guests.value, 10) || 0) + d); refresh(); }
  q('#pb-minus').addEventListener('click', function () { step(-5); });
  q('#pb-plus').addEventListener('click', function () { step(5); });
  guests.addEventListener('input', refresh);
  function send() {
    var price = +cur.dataset.price, g = Math.max(1, parseInt(guests.value, 10) || 0), L = [], fields = { package: inr(price) + ' ' + cur.dataset.kind + ' (per guest + taxes)', guests: g };
    L.push('Hi Fursat! 👋 I would like to plan a banquet.');
    L.push('• Package: ' + inr(price) + ' ' + cur.dataset.kind + ' (per guest + taxes)');
    L.push('• Guests: ' + g);
    if (date.value) { var d = new Date(date.value + 'T00:00'); fields.date = d.toLocaleDateString('en-IN', { weekday: 'short', day: 'numeric', month: 'short', year: 'numeric' }); L.push('• Date: ' + fields.date); }
    L.push('• Estimate: ' + inr(price * g) + ' + taxes');
    courses().forEach(function (c) {
      if (+c.dataset.pick > 0) { var n = chosen(c).map(function (b) { return b.dataset.item; }); fields[c.dataset.h] = n.length ? n.join(', ') : 'please suggest'; L.push('• ' + c.dataset.h + ': ' + fields[c.dataset.h]); }
    });
    if (window.fkForm) window.fkForm.send('events', 'Banquet menu builder', fields, q('[name=botcheck]'));
    window.open('https://wa.me/' + root.dataset.wa + '?text=' + encodeURIComponent(L.join('\n')), '_blank', 'noopener');
  }
  q('#pb-send').addEventListener('click', send);
  q('#pb-dock-send').addEventListener('click', send);
  // phone summary bar: visible while the builder is on screen, hidden while the real summary card is in view
  var dock = q('#pb-dock'), inBody = false, inCard = false;
  function dockSync() { dock.hidden = !(inBody && !inCard); }
  if ('IntersectionObserver' in window) {
    new IntersectionObserver(function (es) { inBody = es[0].isIntersecting; dockSync(); }, { threshold: 0.05 }).observe(q('.pb-body'));
    new IntersectionObserver(function (es) { inCard = es[0].isIntersecting; dockSync(); }, { threshold: 0.25 }).observe(q('.pb-sum-card'));
  }
  // ---- modern finish: live summary (odometer) + touched state. Display only; send() above is untouched.
  var touched = false, liveEl = q('#fl-live'), liveVis = q('#fl-live-vis'), liveSr = q('#fl-live-sr'), lastPat = '', odCols = [];
  function flLive(nc, done, price, g) {
    if (!liveEl) return;
    var parts = [inr(price) + ' ' + cur.dataset.kind, done + ' of ' + nc + ' courses chosen', g + (g === 1 ? ' guest' : ' guests')];
    if (date.value) parts.push(new Date(date.value + 'T00:00').toLocaleDateString('en-GB', { weekday: 'short', day: 'numeric', month: 'short' }));
    var s = parts.join(' \u00b7 ');
    liveSr.textContent = s;
    liveEl.classList.toggle('is-open', touched);
    var pat = s.replace(/\d/g, '#');
    if (pat !== lastPat) {
      lastPat = pat; liveVis.textContent = ''; odCols = [];
      parts.forEach(function (part, pi) {
        var seg = document.createElement('span'); seg.className = 'fl-seg'; liveVis.appendChild(seg);
        part.split('').forEach(function (ch) {
          if (/\d/.test(ch)) {
            var w = document.createElement('span'); w.className = 'fl-od';
            var c = document.createElement('span'); c.className = 'fl-od-c'; c.style.setProperty('--d', ch);
            for (var i = 0; i < 10; i++) { var d = document.createElement('i'); d.textContent = i; c.appendChild(d); }
            w.appendChild(c); seg.appendChild(w); odCols.push(c);
          } else { seg.appendChild(document.createTextNode(ch)); }
        });
        if (pi < parts.length - 1) liveVis.appendChild(document.createTextNode(' \u00b7 '));
      });
    } else {
      var k = 0; s.replace(/\d/g, function (ch) { odCols[k++].style.setProperty('--d', ch); return ch; });
    }
  }
  function flTouch() { touched = true; refresh(); }
  root.addEventListener('click', function (e) { if (e.target.closest && e.target.closest('.pb-chip, .pb-pkg, #pb-minus, #pb-plus')) flTouch(); });
  guests.addEventListener('input', flTouch); date.addEventListener('input', flTouch); date.addEventListener('change', flTouch);
  // deep link ?pkg=b1399
  var want = new URLSearchParams(location.search).get('pkg'), hit = want && pkgBtns.filter(function (b) { return b.dataset.pkg === want; })[0];
  if (hit) selectPkg(hit, false); else { refresh(); try { document.dispatchEvent(new CustomEvent('pb:pkg', { detail: { id: cur.dataset.pkg, price: cur.dataset.price, kind: cur.dataset.kind } })); } catch (e) {} }
})();
</script>

<style>
/* F3 mock (prefix pb- kept so the JS hooks stay): white + red + Fursat green. red = what the guest picks, green = moving forward. Transform/opacity/clip-path only. */
.pb { --pb-ink:var(--fkf-ink); --pb-mute:var(--fkf-mute); padding: clamp(56px, 7vw, 96px) 0; scroll-margin-top: 96px; }
.pb-in { max-width: 1300px; margin: 0 auto; padding: 0 clamp(16px, 4vw, 40px); }
.pb-head { text-align: center; max-width: 720px; margin: 0 auto clamp(28px, 4vw, 44px); }
.pb-title { margin: 0 0 12px; color: var(--pb-ink); }
.pb-hl { color: var(--fk-red); font-style: italic; }
.pb-lead { margin: 0; font: 400 1rem/1.6 var(--fk-sans); color: var(--pb-mute); }
.pb-anchor { display: block; height: 0; scroll-margin-top: 96px; }
.pb-sr { position: absolute; width: 1px; height: 1px; overflow: hidden; clip-path: inset(50%); white-space: nowrap; }

/* step headings: circle sits BESIDE its label */
.pb-sh { display: flex; align-items: center; gap: 12px; margin: 0 0 16px; font: 600 .8125rem/1.2 var(--fk-sans); letter-spacing: .08em; text-transform: uppercase; color: var(--pb-ink); grid-column: 1 / -1; }
.pb-n { flex: none; display: grid; place-items: center; width: 28px; height: 28px; border-radius: 50%; background: var(--fkf-soft); color: var(--pb-ink); font: 600 .875rem/1 var(--fk-sans); letter-spacing: 0; font-variant-numeric: tabular-nums; }

/* 1. packages: white chips, chosen = red, price on its own line */
.pb-pkgp { margin-bottom: clamp(22px, 3vw, 32px); padding: clamp(18px, 3vw, 32px); }
.pb-pkgs { display: grid; grid-template-columns: repeat(5, minmax(0, 1fr)); gap: 10px; }
.pb-pkg { position: relative; display: grid; gap: 2px; justify-items: start; align-content: start; text-align: left; min-height: 44px; min-width: 96px; padding: 14px 14px 12px; border-radius: 20px; background: var(--fkf-card); color: var(--fkf-ink); border: 1.5px solid var(--fkf-line); cursor: pointer; -webkit-tap-highlight-color: transparent; transition: background-color 200ms ease, border-color 200ms ease, color 200ms ease, scale 120ms cubic-bezier(.25,.46,.45,.94); }
.pb-pkg:active { scale: .96; }
@media (hover: hover) { .pb-pkg:not(.is-on):hover { border-color: var(--fkf-line-strong); } }
.pb-pkg:focus-visible { outline: 2px solid var(--fkf-red); outline-offset: 2px; }
.pb-pkg.is-on { background: var(--fkf-red); border-color: var(--fkf-red); color: #fff; }
.pb-dot { position: absolute; top: 12px; right: 12px; width: 18px; height: 18px; background: #fff; border: 1.5px solid currentColor; border-radius: 4px; display: grid; place-items: center; }
.pb-dot::after { content: ""; width: 6px; height: 6px; border-radius: 50%; background: currentColor; }
.pb-dot.is-veg { color: var(--fkf-green); } .pb-dot.is-nv { color: var(--fkf-red); }
