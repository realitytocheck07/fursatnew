---
// F2 main button: text-roll pill with arrow chip (MODERN-FINISH §1). tone="green" (move forward) or "red" (a pick: Next on step 1).
const { label, tone = 'green', type = 'button', icon = 'arrow', class: cls = '', ...rest } = Astro.props;
---
<button type={type} class:list={['fk-f-btn', icon === 'wa' && 'fe-go--wa', tone === 'green' && 'fk-f-btn--go', 'fe-go', tone === 'red' && 'fe-go--red', cls]} {...rest}>
  {icon === 'wa' && <svg class="fe-go-wa" viewBox="0 0 24 24" aria-hidden="true"><path d="M12 3.2a8.7 8.7 0 0 0-7.5 13.1L3.3 20.8l4.6-1.2A8.7 8.7 0 1 0 12 3.2Z" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linejoin="round"/><path d="M9 8.3c.3-.6.6-.6.9-.6h.6c.2 0 .4 0 .6.5l.7 1.7c.1.2 0 .4-.1.6l-.5.6c-.1.2-.2.3 0 .6.6 1 1.4 1.8 2.5 2.4.3.1.4.1.6-.1l.6-.8c.2-.2.4-.2.6-.1l1.6.8c.2.1.4.2.4.4 0 .5-.2 1.3-1 1.7-.7.4-1.6.5-3.7-.5-2.3-1.1-3.7-3.4-3.9-3.7-.2-.3-.9-1.3-.9-2.4 0-.5.1-.9.3-1.1Z" fill="currentColor"/></svg>}
  {icon === 'wa' && <span class="fe-go-spin" aria-hidden="true"></span>}
  <span class="fe-go-lab"><span class="fe-go-roll"><span>{label}</span><span aria-hidden="true">{label}</span></span></span>
  <span class="fe-go-chip" aria-hidden="true"><svg class="fe-go-arr" viewBox="0 0 24 24"><path d="M5 12h14m-6-6 6 6-6 6" fill="none" stroke="currentColor" stroke-width="2.6" stroke-linecap="round" stroke-linejoin="round"/></svg>{icon === 'wa' && <svg class="fe-go-tick" viewBox="0 0 24 24"><path d="m5 12.5 4.5 4.5L19 7.5" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"/></svg>}</span>
</button>
