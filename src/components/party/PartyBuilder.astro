---
// "Build Your Celebration" (like INSPO-1): pick event type + guests + package, see the estimate, explore the menu, send on WhatsApp.
// Everything (names, prices, dishes, add-ons) comes from party.json. Behaviour lives in public/js/party.js.
import data from '../../data/party.json';
const inr = (n: number) => '\u20b9' + n.toLocaleString('en-IN');
const WA = '919059670033';
const waHi = 'https://wa.me/' + WA + '?text=' + encodeURIComponent('Hi Fursat! I would like to plan a party.');
// CLIENT/LEGAL TO CONFIRM: liquor brand names stay off the public page until cleared (Telangana excise advertising rules).
const SHOW_LIQUOR_BRANDS = false;
// ASSUMPTION TO CONFIRM: the printed prices ("4999+Taxes") read as per guest.
const UNIT = 'per guest';

const pkgs = (data.packages as any[]).map((p) => {
  const name = p.name;
  const tag = p.veg && !/veg/i.test(name) ? 'Veg' : '';
  const sec = (h: string) => (p.sections || []).find((s: any) => s.h === h);
  const line = (h: string, start: string) => { const s = sec(h); const l = s && (s.lines || []).find((x: string) => x.toLowerCase().startsWith(start)); const m = l && l.match(/any\s+(\d+)/i); return m ? +m[1] : l ? 0 : null; };
  const anyN = (h: string) => { const s = sec(h); const l = s && (s.lines || [])[0]; const m = l && l.match(/any\s+(\d+)/i); return m ? +m[1] : s ? 0 : null; };
  // pick counts per course row of party.json "choices" (same order): null = the package does not have that course
  const picks = [line('Starters', 'veg,'), line('Starters', 'non-veg'), line('Main course', 'veg,'), line('Main course', 'non-veg'), anyN('Rice'), anyN('Dessert')];
  const menu = p.group === 'banquet' ? p.id : (p.sections || []).length ? 'choices' : p.id;
  return { id: p.id, group: p.group, name, tag, label: name + (tag ? ' (' + tag + ')' : ''), price: p.price, menu, picks, p };
});
const groups = data.groups as any[];
const dot = (h: string) => (/non-veg/i.test(h) ? 'n' : /veg/i.test(h) ? 'v' : '');
const rowIcon = (h: string) => {
  const t = h.toLowerCase();
  if (/drink/.test(t)) return '<path d="M5 4h14l-7 8z"/><path d="M12 12v8M8 20h8"/>';
  if (/dessert/.test(t)) return '<path d="M5 12a7 7 0 0 1 14 0z"/><path d="M6 12l1.5 8h9L18 12"/><circle cx="12" cy="4.5" r="1.3"/>';
  if (/rice|biryani|pulav/.test(t)) return '<path d="M3 12h18a9 9 0 0 1-18 0z"/><path d="M8 8c0-1.5 1-1.5 1-3M12 8c0-1.5 1-1.5 1-3M16 8c0-1.5 1-1.5 1-3"/>';
  if (/non-veg/.test(t) && /appetizer|starter|fry/.test(t)) return '<path d="M14.5 4.5a5 5 0 0 1 5 5c0 3-3 5-6 5l-3-3c0-3 1-7 4-7z"/><path d="M10.5 13.5L5 19M4 16l4 4"/>';
  if (/soup|dal|curr|main/.test(t)) return '<path d="M3 11h18a9 9 0 0 1-18 0z"/><path d="M12 3v4M10 3h4"/>';
  if (/appetizer|starter|fry|salad/.test(t)) return '<path d="M5 19c0-8 5-14 14-14 0 9-6 14-14 14z"/><path d="M5 19L14 10"/>';
  if (/bread/.test(t)) return '<path d="M4 14a8 6 0 0 1 16 0v4H4z"/><path d="M9 11l1 3M13 11l1 3"/>';
  return '<path d="M3 20h18"/><path d="M20 16a8 8 0 1 0-16 0"/><path d="M12 4v4M10 4h4"/>';
};
const addIcon = (n: string) => {
  const t = n.toLowerCase();
  if (/seafood/.test(t)) return '<path d="M3 12c3-5 8-6 13-3l5-2v10l-5-2c-5 3-10 2-13-3z"/><circle cx="8" cy="11" r=".8"/>';
  if (/chicken|mutton/.test(t)) return '<path d="M14.5 4.5a5 5 0 0 1 5 5c0 3-3 5-6 5l-3-3c0-3 1-7 4-7z"/><path d="M10.5 13.5L5 19M4 16l4 4"/>';
  if (/main/.test(t)) return '<path d="M3 11h18a9 9 0 0 1-18 0z"/><path d="M12 3v4M10 3h4"/>';
  if (/dessert/.test(t)) return '<path d="M5 12a7 7 0 0 1 14 0z"/><path d="M6 12l1.5 8h9L18 12"/><circle cx="12" cy="4.5" r="1.3"/>';
  return '<path d="M4 12a8 8 0 0 0 16 0z"/><path d="M8 12c0-4 2-6 4-8 2 2 4 4 4 8"/>';
};
const pick = (r?: string) => (r && /any\s+\d+/i.test(r) ? 'Pick ' + r.toLowerCase() : '');
const initial = pkgs.find((x) => x.id === 'platinum') || pkgs[0];
const initGuests = 25;
const client = { groups: groups.map((g) => ({ id: g.id, label: g.label })), pkgs: pkgs.map((x) => ({ id: x.id, group: x.group, label: x.label, price: x.price, menu: x.menu, picks: x.picks })), unit: UNIT, wa: WA, init: { group: initial.group, pkg: initial.id, guests: initGuests } };
---
<section class="pb" id="pa-plan" aria-labelledby="pa-plan-h">
  <div class="pb-card">
    <div class="pb-host" id="pa-host" data-pose="idle" aria-hidden="false">
      <div class="pa-stage">
        <img class="pa-p pa-idle" src="/assets/ask-mascot-md.webp" srcset="/assets/ask-mascot-md-240.webp 240w, /assets/ask-mascot-md.webp 400w" sizes="(max-width: 767px) 88px, 120px" alt="Fursat&rsquo;s elephant host in a gold crown and sunglasses" width="400" height="400" loading="lazy" decoding="async" />
        <img class="pa-p pa-cheer" src="/assets/ask-mascot-cheer-md.webp" srcset="/assets/ask-mascot-cheer-md-240.webp 240w, /assets/ask-mascot-cheer-md.webp 400w" sizes="(max-width: 767px) 88px, 120px" alt="" aria-hidden="true" width="400" height="400" loading="lazy" decoding="async" />
      </div>
    </div>

    <div class="pb-grid">
      <div class="pb-left">
        <header class="pb-head">
          <h2 class="fk-ty-h2 pb-h" id="pa-plan-h" data-fx-reveal>Build Your <span class="pb-hl">Celebration</span></h2>
          <p class="pb-sub">Pick a package, tell us how many are coming, and see your estimate.</p>
        </header>
        <!-- Event type + guests: segmented control and stepper on desktop, pills that open a bottom sheet on phones -->
        <div class="pb-ctls">
          <div class="pb-ctl">
            <span class="pb-lab" id="pb-evt-l"><span class="pb-n" aria-hidden="true"></span>Event type</span>
            <div class="pb-seg" role="radiogroup" aria-labelledby="pb-evt-l" style="--n:3;--i:0">
              <i class="pb-thumb" aria-hidden="true"></i>
              {groups.map((g, i) => (
                <label class="pb-seg-o"><input type="radio" name="pb-evt" value={g.id} checked={g.id === initial.group ? true : undefined} /><span>{g.label}</span></label>
              ))}
            </div>
            <button type="button" class="pb-pill" data-sheet="event" aria-haspopup="dialog">
              <svg viewBox="0 0 24 24" aria-hidden="true"><rect x="3" y="5" width="18" height="16" rx="2"/><path d="M3 10h18M8 3v4M16 3v4"/></svg>
              <span class="pb-pill-t"><small>Event type</small><b data-out="event">{groups.find((g) => g.id === initial.group)?.label}</b></span>
              <svg class="pb-chev" viewBox="0 0 24 24" aria-hidden="true"><path d="M6 9l6 6 6-6"/></svg>
            </button>
          </div>
          <div class="pb-ctl">
            <label class="pb-lab" for="pb-n"><span class="pb-n" aria-hidden="true"></span>Guests</label>
            <div class="pb-step">
              <button type="button" class="pb-sb" data-step="-1" aria-label="Fewer guests">&minus;</button>
              <input id="pb-n" type="number" inputmode="numeric" min="1" max="500" value={initGuests} />
              <button type="button" class="pb-sb" data-step="1" aria-label="More guests">+</button>
            </div>
            <button type="button" class="pb-pill" data-sheet="guests" aria-haspopup="dialog">
              <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M16 20v-1.5a3.5 3.5 0 0 0-3.5-3.5h-5A3.5 3.5 0 0 0 4 18.5V20"/><circle cx="10" cy="8" r="3.2"/><path d="M20 20v-1.5a3.5 3.5 0 0 0-2.5-3.3M15.5 4.9a3.2 3.2 0 0 1 0 6.2"/></svg>
              <span class="pb-pill-t"><small>Guests</small><b data-out="guests">{initGuests}</b></span>
              <svg class="pb-chev" viewBox="0 0 24 24" aria-hidden="true"><path d="M6 9l6 6 6-6"/></svg>
            </button>
          </div>
        </div>
        <p class="pb-blurb" id="pb-blurb">{groups.find((g) => g.id === initial.group)?.blurb}</p>

        <h3 class="pb-h3 pb-h3--pkg"><span class="pb-n" aria-hidden="true"></span>Choose your package</h3>
        {groups.map((g) => (
          <fieldset class="pb-pkgs" data-group={g.id} hidden={g.id !== initial.group ? true : undefined}>
            <legend class="pb-sr">{g.label} packages</legend>
            {pkgs.filter((x) => x.group === g.id).map((x) => (
              <div class="pb-pk" data-pkg={x.id}>
                <label class="pb-pk-l">
                  <input class="pb-r" type="radio" name="pb-pkg" value={x.id} checked={x.id === initial.id ? true : undefined} aria-describedby={`pb-inc-${x.id}`} />
                  <span class="pb-rd" aria-hidden="true"></span>
                  <span class="pb-pk-n">{x.name}{x.tag && <span class="pb-tag">{x.tag}</span>}</span>
                  <span class="pb-pk-p">{inr(x.price)}<small> / guest</small></span>
                  <svg class="pb-ck" viewBox="0 0 24 24" aria-hidden="true"><path d="M5 12.5l4.5 4.5L19 7.5"/></svg>
                </label>
                <div class="pb-inc" id={`pb-inc-${x.id}`}>
                  <div class="pb-inc-in">
                    <dl class="pb-dl">
                      {x.p.sections?.map((s: any) => (
                        <div><dt>{s.h}</dt><dd>{x.group === 'banquet' ? (s.rule ? s.rule : (s.items || s.lines).join(' \u00b7 ')) : (s.lines || s.items).join(' \u00b7 ')}</dd></div>
                      ))}
                      {x.p.drinks && <div><dt>Drinks{x.p.drinks.serve ? ' \u00b7 ' + x.p.drinks.serve : ''}</dt><dd>{[...(SHOW_LIQUOR_BRANDS ? x.p.drinks.brands : []), ...x.p.drinks.lines].join(' \u00b7 ')}</dd></div>}
                    </dl>
                    {x.group === 'bar' && <p class="pb-age">Alcohol is served to guests aged 21 and above only.</p>}
                    {x.group === 'banquet' && <a class="pb-build" href={`/banquet?pkg=${x.id}#packages`}>Choose the dishes for this menu <span aria-hidden="true">&rarr;</span></a>}
                  </div>
                </div>
              </div>
            ))}
            {g.id === 'banquet' && <a class="pb-build pb-hall" href="/banquet#enquire">Enquire about the hall <span aria-hidden="true">&rarr;</span></a>}
          </fieldset>
        ))}

      </div>

        <div class="pb-est" id="pb-est">
          <p class="pb-est-l">Your estimated package value</p>
          <p class="pb-est-v" id="pb-total" data-val={initial.price * initGuests}>{inr(initial.price * initGuests)}</p>
          <p class="pb-est-s" id="pb-sub">{initGuests} guests &times; {inr(initial.price)} {UNIT} &middot; before taxes</p>
          <p class="pb-sr" id="pb-live" role="status" aria-live="polite"></p>
          <div class="pb-contact">
            <label class="pb-cf fl-field"><input class="fk-f-field" type="text" id="pb-name" name="name" autocomplete="name" placeholder="e.g. Priya" /><span class="fl-fl">Your name</span><svg class="fl-ok" viewBox="0 0 24 24" aria-hidden="true"><path d="M5 12.5l4.5 4.5L19 7.5" fill="none" stroke="#2a5019" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" pathLength="20"/></svg></label>
            <label class="pb-cf fl-field"><input class="fk-f-field" type="tel" id="pb-phone" name="phone" inputmode="tel" autocomplete="tel" placeholder="10-digit number" pattern="[0-9 +]{10,14}" /><span class="fl-fl">Mobile / WhatsApp</span><svg class="fl-ok" viewBox="0 0 24 24" aria-hidden="true"><path d="M5 12.5l4.5 4.5L19 7.5" fill="none" stroke="#2a5019" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" pathLength="20"/></svg></label>
            <label class="pb-cf pb-cf--w fl-field"><input class="fk-f-field" type="email" id="pb-email" name="email" autocomplete="email" placeholder="you@example.com" /><span class="fl-fl">Email <span class="fl-opt">(optional)</span></span><svg class="fl-ok" viewBox="0 0 24 24" aria-hidden="true"><path d="M5 12.5l4.5 4.5L19 7.5" fill="none" stroke="#2a5019" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" pathLength="20"/></svg></label>
          </div>
          <input type="checkbox" name="botcheck" tabindex="-1" autocomplete="off" aria-hidden="true" style="position:absolute;left:-9999px;width:1px;height:1px;opacity:0" />
          <span class="fl-ring"><a class="fl-go pb-wa" id="pa-wa" href={waHi} target="_blank" rel="noopener"><span class="fl-roll" aria-hidden="true"><span class="fl-roll-in"><span>Continue on WhatsApp</span><span>Continue on WhatsApp</span></span></span><span class="fl-sr">Continue on WhatsApp</span><span class="fl-chip" aria-hidden="true"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"/></svg></span></a></span>
          <a class="fl-sec pb-call" href={`tel:+${WA}`}><span>Call Fursat</span></a>
          <p class="pb-fine">Your final quote is confirmed by the Fursat team.</p>
        </div>

      <div class="pb-right">
        <h3 class="pb-h3 pb-h3--r">Explore our menu</h3>
        <p class="pb-blurb pb-blurb--r">Tap a course to see the dishes.</p>

        <div class="pb-menu" data-menu="choices">
          {(data.choices as any[]).map((c, i) => (
            <div class="pb-row" data-row={i}>
              <button type="button" class="pb-row-b" aria-expanded="false" aria-controls={`pb-rp-${i}`} id={`pb-rb-${i}`}>
                <span class="pb-tile" aria-hidden="true"><svg viewBox="0 0 24 24" set:html={rowIcon(c.h)} /></span>
                <span class="pb-row-t">{c.h}</span>
                <span class="pb-row-k" data-pick></span>
                <svg class="pb-chev" viewBox="0 0 24 24" aria-hidden="true"><path d="M6 9l6 6 6-6"/></svg>
              </button>
              <div class="pb-rp" id={`pb-rp-${i}`} role="region" aria-labelledby={`pb-rb-${i}`}><div class="pb-rp-in">
                {c.cols.map((col: any) => (
                  <div class="pb-col">
                    {col.h && <h4 class="pb-col-h">{col.h}</h4>}
                    <ul class="pb-chips">{col.items.map((it: string) => <li class="pb-chip">{(dot(c.h) || dot(col.h || '')) && <i class={`pb-vd pb-vd--${dot(c.h) || dot(col.h || '')}`} aria-hidden="true"></i>}{it}</li>)}</ul>
                  </div>
                ))}
              </div></div>
            </div>
          ))}
        </div>

        {pkgs.filter((x) => x.menu === x.id).map((x) => (
          <div class="pb-menu" data-menu={x.id} hidden>
            {x.group === 'banquet' ? (x.p.sections as any[]).map((s: any, i: number) => {
              const items = s.items || s.lines;
              return (
                <div class="pb-row">
                  <button type="button" class="pb-row-b" aria-expanded="false" aria-controls={`pb-rp-${x.id}-${i}`} id={`pb-rb-${x.id}-${i}`}>
                    <span class="pb-tile" aria-hidden="true"><svg viewBox="0 0 24 24" set:html={rowIcon(s.h)} /></span>
                    <span class="pb-row-t">{s.h}</span>
                    <span class="pb-row-k">{pick(s.rule) || 'Included'}</span>
                    <svg class="pb-chev" viewBox="0 0 24 24" aria-hidden="true"><path d="M6 9l6 6 6-6"/></svg>
                  </button>
                  <div class="pb-rp" id={`pb-rp-${x.id}-${i}`} role="region" aria-labelledby={`pb-rb-${x.id}-${i}`}><div class="pb-rp-in">
                    <div class="pb-col"><ul class="pb-chips">{items.map((it: string) => <li class="pb-chip">{dot(s.h) && <i class={`pb-vd pb-vd--${dot(s.h)}`} aria-hidden="true"></i>}{it}</li>)}</ul></div>
                  </div></div>
                </div>
              );
            }) : (
              <p class="pb-note">{x.name} is a drinks package{x.p.drinks ? ': ' + x.p.drinks.lines.join(' \u00b7 ') + (x.p.drinks.serve ? ', ' + x.p.drinks.serve : '') : ''}.</p>
            )}
          </div>
        ))}

        <h3 class="pb-h3 pb-h3--r pb-h3--add">Add-ons</h3>
        <ul class="pb-adds">
          {(data.addons as any[]).map((a) => (
            <li class="pb-add"><span class="pb-tile pb-tile--s" aria-hidden="true"><svg viewBox="0 0 24 24" set:html={addIcon(a.n)} /></span><span class="pb-add-n">{a.n}</span><b class="pb-add-p">{'\u20b9' + a.p}</b></li>
          ))}
        </ul>
        <p class="pb-fine">Add-on prices are as printed on the Fursat party menu.</p>
      </div>
    </div>
  </div>
</section>

<!-- phone only: summary bar that follows the guest while a package is chosen -->
<div class="pb-bar" id="pb-bar">
  <p class="pb-bar-t" id="pb-bar-t"></p>
  <a class="fk-btn fk-btn--primary fk-btn--md pb-bar-b" id="pb-bar-wa" href={waHi} target="_blank" rel="noopener"><span>WhatsApp</span></a>
</div>

<!-- phone only: bottom sheet for Event type and Guests -->
<div class="pb-sheet" id="pb-sheet" hidden>
  <div class="pb-sheet-bg" data-close></div>
  <div class="pb-sheet-p" role="dialog" aria-modal="true" aria-labelledby="pb-sheet-t" tabindex="-1">
    <div class="pb-grab" id="pb-grab"><i aria-hidden="true"></i></div>
    <div class="pb-sheet-h"><h3 id="pb-sheet-t">Event type</h3><button type="button" class="pb-x" data-close aria-label="Close">&#10005;</button></div>
    <div class="pb-sheet-b" data-body="event" role="radiogroup" aria-labelledby="pb-sheet-t">
      {groups.map((g) => (
        <label class="pb-opt"><input type="radio" name="pb-evt-s" value={g.id} /><span class="pb-opt-in"><b>{g.label}</b><small>{g.blurb}</small></span><svg class="pb-ck" viewBox="0 0 24 24" aria-hidden="true"><path d="M5 12.5l4.5 4.5L19 7.5"/></svg></label>
      ))}
    </div>
    <div class="pb-sheet-b" data-body="guests">
      <div class="pb-step pb-step--l">
        <button type="button" class="pb-sb" data-step="-1" aria-label="Fewer guests">&minus;</button>
        <input type="number" inputmode="numeric" min="1" max="500" value={initGuests} aria-label="Number of guests" data-gin />
        <button type="button" class="pb-sb" data-step="1" aria-label="More guests">+</button>
      </div>
      <div class="pb-quick" role="group" aria-label="Quick picks">
        {[10, 25, 50, 100].map((n) => <button type="button" class="pb-qk" data-n={n}>{n}</button>)}
      </div>
    </div>
    <button type="button" class="fk-btn fk-btn--primary pb-done" data-close><span>Done</span></button>
  </div>
</div>

<script type="application/json" id="pb-data" set:html={JSON.stringify(client)}></script>
<script>import '../../scripts/fe-swipe.js';</script>
<style is:global>
.pb{max-width:1240px;margin:0 auto;padding:clamp(64px,7vw,88px) clamp(16px,4vw,48px) clamp(24px,3vw,40px);scroll-margin-top:56px}
.pb-sr{position:absolute;width:1px;height:1px;margin:-1px;overflow:hidden;clip-path:inset(50%);white-space:nowrap}
.pb-card{position:relative}
.pb-head{margin:0 0 clamp(18px,2.4vw,28px)}
.pb-h{margin:0;color:#fbf3e6}
.pb-hl{color:var(--fk-red-on-dark);font-style:italic}
.pb-sub{margin:8px 0 0;max-width:46ch;font:400 1rem/1.5 var(--fk-sans);color:#e9dcc2}
.pb-grid{display:grid;grid-template-columns:minmax(0,1.25fr) minmax(0,1fr);grid-template-areas:"left est" "right right";align-items:stretch}
.pb-left{grid-area:left;min-width:0;padding:clamp(24px,3.4vw,44px);border-radius:28px 0 0 28px;background:#10261a;color:#f6ecd6}
.pb-right{grid-area:right;min-width:0;padding-top:clamp(32px,4vw,52px)}
/* mascot: peeks over the top edge of the card, cheers when a package is picked */
.pb-host{position:absolute;right:clamp(18px,4vw,52px);top:0;translate:0 -60%;z-index:2;pointer-events:none}
.pa-stage{position:relative;isolation:isolate;width:clamp(84px,11vw,128px);aspect-ratio:1;display:grid}
.pa-stage::after{content:"";position:absolute;left:18%;right:18%;bottom:-2px;height:9px;border-radius:50%;background:rgba(14,34,20,.35);transform:scaleY(.6);z-index:-1}
.pa-p{grid-area:1/1;width:100%;height:100%;object-fit:contain;opacity:0;transform-origin:50% 100%;transition:opacity .15s var(--fk-ease-out)}
.pb-host[data-pose="idle"] .pa-idle,.pb-host[data-pose="cheer"] .pa-cheer{opacity:1}
.pb-host[data-pose="cheer"] .pa-cheer{animation:pa-hop .6s var(--fk-ease-out) 2}
@keyframes pa-hop{0%,100%{transform:translateY(0)}40%{transform:translateY(-12px) scale(.97,1.04)}70%{transform:translateY(0) scale(1.04,.96)}}
.pa-star{position:absolute;left:50%;top:42%;width:12px;height:12px;margin:-6px 0 0 -6px;background:#c99a43;clip-path:polygon(50% 0,62% 38%,100% 50%,62% 62%,50% 100%,38% 62%,0 50%,38% 38%);pointer-events:none;animation:pa-star .9s var(--fk-ease-out) forwards}
@keyframes pa-star{from{opacity:1;transform:translate(0,0) scale(.5)}to{opacity:0;transform:translate(var(--sx),var(--sy)) scale(1.1)}}

/* controls */
.pb-ctls{display:grid;gap:22px;counter-reset:pbs}
.pb-ctl{display:grid;gap:7px;min-width:0}
.pb-lab{display:flex;align-items:center;gap:10px;font:600 .75rem/1.2 var(--fk-sans);letter-spacing:.12em;text-transform:uppercase;color:#e6c27a}
.pb-n{counter-increment:pbs;flex:none;display:grid;place-items:center;width:28px;height:28px;border-radius:50%;box-shadow:inset 0 0 0 1.5px rgba(230,194,122,.7);font:500 .875rem/1 var(--fk-serif);letter-spacing:0;color:#e6c27a}
.pb-n::before{content:counter(pbs)}
.pb-seg{position:relative;display:grid;grid-template-columns:repeat(var(--n),minmax(0,1fr));padding:4px;border-radius:999px;background:rgba(255,255,255,.07);box-shadow:inset 0 0 0 1px rgba(230,194,122,.4)}
.pb-thumb{position:absolute;top:4px;bottom:4px;left:4px;width:calc((100% - 8px) / var(--n));border-radius:999px;background:var(--fk-selected-bg);box-shadow:var(--fk-selected-shadow);transform:translateX(calc(var(--i) * 100%));transition:transform 320ms var(--fk-ease-out)}
.pb-seg-o{position:relative;z-index:1;display:grid;place-items:center;min-height:44px;padding:0 8px;border-radius:999px;cursor:pointer;text-align:center;font:600 .875rem/1.15 var(--fk-sans);color:#f6ecd6;touch-action:manipulation;transition:transform 150ms var(--fk-ease-out)}
.pb-seg-o:active{transform:scale(.96)}
.pb-seg-o input{position:absolute;inset:0;opacity:0;margin:0;cursor:pointer}
.pb-seg-o:has(input:checked){color:#2a1d0c}
.pb-seg-o:has(input:focus-visible){outline:2px solid #8a5a14;outline-offset:2px}
.pb-step{display:grid;grid-template-columns:48px minmax(0,1fr) 48px;gap:8px;max-width:280px}
.pb-sb{width:48px;height:48px;padding:0;border-radius:50%;border:1px solid rgba(201,154,67,.55);background:linear-gradient(180deg,#fffaf3,#f3e4cf);color:#14301c;font:600 1.4rem/1 var(--fk-sans);cursor:pointer;touch-action:manipulation;transition:transform 150ms var(--fk-ease-out),border-color 200ms}
.pb-sb:active{transform:scale(.94)}
.pb-step input{min-height:48px;width:100%;min-width:0;padding:0 8px;text-align:center;border-radius:14px;border:1px solid rgba(201,154,67,.5);background:#fcf7f0;box-shadow:inset 0 2px 4px rgba(122,78,24,.12);font:600 1.125rem/1.2 var(--fk-sans);color:#1f2a1a;font-variant-numeric:tabular-nums;-moz-appearance:textfield}
.pb-step input::-webkit-outer-spin-button,.pb-step input::-webkit-inner-spin-button{-webkit-appearance:none;margin:0}
.pb-left :is(.pb-sb,.pb-step input,.pb-pill,.pb-r,.pb-seg-o input):focus-visible{outline-color:#e6c27a}
.pb-sb:focus-visible,.pb-step input:focus-visible,.pb-pill:focus-visible,.pb-row-b:focus-visible,.pb-qk:focus-visible,.pb-x:focus-visible,.pb-build:focus-visible,.pb-wa:focus-visible{outline:2px solid #8a5a14;outline-offset:3px}
.pb-pill{display:none;align-items:center;gap:10px;width:100%;min-height:56px;padding:0 12px;border-radius:16px;background:#fcf7f0;border:1px solid rgba(201,154,67,.55);box-shadow:inset 0 2px 4px rgba(122,78,24,.1);cursor:pointer;text-align:left;font-family:var(--fk-sans);color:#1f2a1a;touch-action:manipulation;transition:transform 150ms var(--fk-ease-out)}
.pb-pill:active{transform:scale(.97)}
.pb-pill>svg:first-child{width:22px;height:22px;flex:none;fill:none;stroke:#9a6f2a;stroke-width:1.6;stroke-linecap:round;stroke-linejoin:round}
.pb-pill-t{display:grid;gap:2px;min-width:0;flex:1}
.pb-pill-t small{font:500 .75rem/1.1 var(--fk-sans);color:#74501a}
.pb-pill-t b{font:600 .9375rem/1.2 var(--fk-sans);white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
.pb-chev{width:18px;height:18px;flex:none;fill:none;stroke:#74501a;stroke-width:2;stroke-linecap:round;stroke-linejoin:round;transition:rotate 250ms var(--fk-ease-out)}
.pb-blurb{margin:14px 0 0;font:400 .875rem/1.5 var(--fk-sans);color:#e9dcc2}
.pb-h3{display:flex;align-items:center;gap:10px;margin:26px 0 12px;font:600 .75rem/1.2 var(--fk-sans);letter-spacing:.12em;text-transform:uppercase;color:#e6c27a}
.pb-h3--r{margin:0 0 4px;font:500 1.35rem/1.2 var(--fk-serif);letter-spacing:0;text-transform:none;color:#18301f}
.pb-blurb--r{margin:0 0 14px;color:#5a5040}
.pb-h3--add{margin-top:22px}

/* package radio pills */
.pb-pkgs{border:0;margin:0;padding:0;display:grid;gap:10px;min-width:0}
.pb-pkgs[hidden],.pb-menu[hidden],.pb-sheet[hidden],.pb-sheet-b[hidden]{display:none}
.pb-pk{border-radius:16px;background:rgba(255,255,255,.06);box-shadow:inset 0 0 0 1px rgba(230,194,122,.4);transition:background-color 300ms,box-shadow 300ms}
.pb-pk.is-on{background:#fffaf0;box-shadow:inset 0 0 0 2px #e6c27a}
.pb-pk-l{position:relative;display:grid;grid-template-columns:auto minmax(0,1fr) auto 20px;align-items:center;gap:12px;min-height:56px;padding:8px 14px;border-radius:16px;cursor:pointer;touch-action:manipulation;transition:transform 150ms var(--fk-ease-out)}
.pb-pk-l:active{transform:scale(.985)}
.pb-pk-l:has(.pb-r:focus-visible){outline:2px solid #8a5a14;outline-offset:2px}
.pb-r{position:absolute;inset:0;width:100%;height:100%;opacity:0;margin:0;cursor:pointer}
.pb-rd{width:20px;height:20px;box-sizing:border-box;border-radius:50%;border:2px solid #e6c27a;background:transparent;transition:border-color 200ms,background 200ms}
.pb-pk.is-on .pb-rd{border-color:#a8731c;background:radial-gradient(circle,#a8731c 0 38%,#fff 42%)}
.pb-pk-n{display:flex;flex-wrap:wrap;align-items:center;gap:4px 8px;font:600 1rem/1.25 var(--fk-sans);color:#fbf3e6}
.pb-tag{padding:4px 8px;border-radius:999px;background:#e8f0e0;border:1px solid #9bb98a;font:600 .75rem/1 var(--fk-sans);color:#2a5019}
.pb-pk-p{white-space:nowrap;font:600 1.0625rem/1 var(--fk-serif);color:#fbf3e6;font-variant-numeric:tabular-nums}
.pb-pk-p small{font:400 .75rem/1 var(--fk-sans);color:#e1d3b6}
.pb-pk.is-on .pb-pk-n,.pb-pk.is-on .pb-pk-p{color:#18301f}
.pb-pk.is-on .pb-pk-p small{color:#6a5c45}
.pb-ck{width:20px;height:20px;fill:none;stroke:#a8731c;stroke-width:2.4;stroke-linecap:round;stroke-linejoin:round;opacity:0;scale:.5;transition:opacity 200ms,scale 300ms var(--fk-ease-out)}
.pb-pk.is-on .pb-ck,.pb-opt:has(input:checked) .pb-ck{opacity:1;scale:1}
.pb-inc,.pb-rp{display:grid;grid-template-rows:0fr;visibility:hidden;transition:grid-template-rows 340ms var(--fk-ease-out),visibility 0s linear 340ms}
.pb-pk.is-on .pb-inc,.pb-row.is-open .pb-rp{grid-template-rows:1fr;visibility:visible;transition-delay:0s}
.pb-inc-in,.pb-rp-in{overflow:hidden;min-height:0}
.pb-inc-in{padding:0 14px}
.pb-dl{margin:0;display:grid;gap:6px;padding:10px 0 12px;border-top:1px dashed rgba(201,154,67,.55)}
.pb-dl>div{display:grid;grid-template-columns:minmax(0,8.5rem) minmax(0,1fr);gap:10px}
.pb-dl dt{font:600 .75rem/1.5 var(--fk-sans);letter-spacing:.06em;text-transform:uppercase;color:#74501a}
.pb-dl dd{margin:0;font:400 .8125rem/1.5 var(--fk-sans);color:#4a4232}
.pb-age{margin:-4px 0 12px;font:600 .75rem/1.4 var(--fk-sans);color:#4a4232}
.pb-build{display:inline-flex;align-items:center;gap:6px;min-height:44px;margin:2px 0 6px;font:600 .8125rem/1.2 var(--fk-sans);color:#74501a;text-decoration:underline;text-underline-offset:3px}
.pb-hall{padding:0 4px}

/* estimate */
.pb-est{grid-area:est;position:relative;display:flex;flex-direction:column;justify-content:center;padding:clamp(24px,3.4vw,44px);border-radius:0 28px 28px 0;text-align:left;background:linear-gradient(180deg,#fffaf0,#f6e8d0);border-left:2px dashed #c99a43}
.pb-est-l{margin:0;font:600 .75rem/1.3 var(--fk-sans);letter-spacing:.12em;text-transform:uppercase;color:#74501a}
.pb-est-v{margin:6px 0 2px;font:500 clamp(2.6rem,5vw,3.4rem)/1.1 var(--fk-serif);color:#2a5019;font-variant-numeric:tabular-nums}
.pb-est-s{margin:0 0 14px;font:400 .875rem/1.4 var(--fk-sans);color:#5a5040}
.pb-wa{width:auto;max-width:100%;gap:10px;min-height:44px;padding:6px 6px 6px 20px;white-space:nowrap}.fl-ring:has(.pb-wa){display:flex;justify-content:center}.pb-wa .fl-chip{margin-left:4px}.pb-wa .fl-chip,.pb-wa .fl-roll{-webkit-user-select:none;user-select:none}@media (hover:hover){.pb-wa:hover .fl-chip svg{transform:translateX(3px)}}.pb-wa:focus-visible .fl-chip svg{transform:none}
.pb-call{display:grid;place-items:center;min-height:48px;margin-top:10px;border-radius:999px;border:1.5px solid #c99a43;color:#18301f;font:600 .9375rem/1 var(--fk-sans);text-decoration:none;transition:transform 150ms var(--fk-ease-out)}
.pb-call:active{transform:scale(.96)}
.pb-call:focus-visible{outline:2px solid #8a5a14;outline-offset:3px}
.pb-fine{margin:10px 0 0;font:400 .75rem/1.4 var(--fk-sans);color:#5a5040}
.pb-est .pb-fine{margin-top:12px}

/* menu rows */
.pb-row{margin:0 0 8px;border-radius:16px;background:#fcf7f0;border:1px solid rgba(201,154,67,.4);overflow:hidden;transition:border-color 250ms,box-shadow 250ms}
.pb-row[hidden]{display:none}
.pb-row.is-open{border-color:#c99a43;box-shadow:0 8px 16px -12px rgba(122,78,24,.5)}
.pb-row-b{display:grid;grid-template-columns:44px minmax(0,1fr) auto 18px;align-items:center;gap:12px;width:100%;min-height:56px;padding:6px 14px 6px 6px;border:0;background:transparent;cursor:pointer;text-align:left;font-family:var(--fk-sans);color:#18301f;touch-action:manipulation}
.pb-row-b[aria-expanded="true"] .pb-chev{rotate:180deg}
.pb-tile{width:44px;height:44px;border-radius:13px;display:grid;place-items:center;background:linear-gradient(145deg,#f7dc9a,#dba947);box-shadow:inset 0 1px 0 rgba(255,250,235,.75),0 0 0 1px #a8731c}
.pb-tile svg{width:24px;height:24px;fill:none;stroke:#4a3410;stroke-width:1.6;stroke-linecap:round;stroke-linejoin:round}
.pb-tile--s{width:40px;height:40px;border-radius:12px}
.pb-row-t{font:500 1.05rem/1.25 var(--fk-serif)}
.pb-row-k{padding:5px 9px;border-radius:999px;background:#f6e6c4;font:600 .75rem/1 var(--fk-sans);color:#6b4713;white-space:nowrap}
.pb-row-k:empty{display:none}
.pb-rp-in{padding:0 14px}
.pb-col{padding:2px 0 12px}
.pb-col-h{margin:8px 0 8px;font:600 .75rem/1.2 var(--fk-sans);letter-spacing:.1em;text-transform:uppercase;color:#74501a}
.pb-chips{list-style:none;margin:0;padding:0;display:flex;flex-wrap:wrap;gap:6px}
.pb-chip{display:inline-flex;align-items:center;gap:6px;min-height:32px;padding:4px 11px;border-radius:999px;background:#fff;border:1px solid rgba(201,154,67,.5);font:400 .8125rem/1.25 var(--fk-sans);color:#2b2416}
.pb-vd{flex:none;display:inline-grid;place-items:center;width:12px;height:12px;box-sizing:border-box;border:1.5px solid currentColor;border-radius:3px}
.pb-vd::after{content:"";width:6px;height:6px;background:currentColor}
.pb-vd--v{color:#1f7a2e}.pb-vd--v::after{border-radius:50%}
.pb-vd--n{color:#b3261e}.pb-vd--n::after{clip-path:polygon(50% 0,100% 100%,0 100%)}
.pb-note{margin:0 0 8px;padding:14px 16px;border-radius:16px;background:#fcf7f0;border:1px dashed rgba(201,154,67,.6);font:400 .9375rem/1.5 var(--fk-sans);color:#4a4232}
.pb-adds{list-style:none;margin:0;padding:0;display:grid;grid-template-columns:repeat(auto-fit,minmax(132px,1fr));gap:10px}
.pb-add{display:grid;justify-items:center;align-content:start;gap:6px;padding:12px 8px;border-radius:16px;background:#fcf7f0;border:1px solid rgba(201,154,67,.4);text-align:center}
.pb-add-n{font:400 .8125rem/1.3 var(--fk-sans);color:#2b2416}
.pb-add-p{font:600 .9375rem/1.2 var(--fk-serif);color:#18301f}

/* summary bar + bottom sheet (phones) */
.pb-bar{display:none}
.pb-sheet{display:none}
@media(hover:hover) and (pointer:fine){
  .pb-pk:not(.is-on):hover{box-shadow:inset 0 0 0 1px #e6c27a}
  .pb-row:hover{border-color:#c99a43}
  .pb-sb:hover{border-color:#c99a43}
}
@media(max-width:899px){
  .pb-grid{grid-template-columns:minmax(0,1fr);grid-template-areas:"left" "est" "right"}
  .pb-left{border-radius:24px 24px 0 0}
  .pb-est{border-radius:0 0 24px 24px;border-left:0;border-top:2px dashed #c99a43}
}
@media(max-width:767px){
  .pb{padding-inline:12px;padding-top:72px}
  .pb-left{padding:24px 16px}
  .pb-est{padding:22px 16px}
  .pb-host{right:16px;translate:0 -74%}
  .pb-ctls{grid-template-columns:1fr 1fr;gap:10px}
  .pb-lab,.pb-seg,.pb-ctl>.pb-step{display:none}
  .pb-pill{display:flex}
  .pb-pk-l{gap:10px;padding:8px 12px}
  .pb-dl>div{grid-template-columns:minmax(0,1fr);gap:0}
  .pb-dl{gap:8px}
  .pb-pill>svg:first-child{display:none}
  .pb-bar{display:flex;align-items:center;gap:10px;position:fixed;left:12px;right:12px;bottom:calc(64px + env(safe-area-inset-bottom,0px) + 10px);z-index:8900;padding:6px 6px 6px 18px;border-radius:999px;background:rgba(14,34,20,.97);color:#fbf3e6;border:1px solid #c99a43;box-shadow:0 14px 28px -10px rgba(14,34,20,.7);visibility:hidden;opacity:0;translate:0 14px;transition:opacity 250ms var(--fk-ease-out),translate 300ms var(--fk-ease-out),visibility 0s linear 300ms}
  .pb-bar.is-in{visibility:visible;opacity:1;translate:0 0;transition-delay:0s}
  .pb-bar-t{margin:0;flex:1;min-width:0;font:600 .8125rem/1.25 var(--fk-sans)}
  .pb-bar-b{flex:none;border-color:#c99a43}
  .pb-sheet{position:fixed;inset:0;z-index:9500;display:flex;align-items:flex-end}
  .pb-sheet-bg{position:absolute;inset:0;background:rgba(14,34,20,.55);opacity:0;transition:opacity 280ms var(--fk-ease-out)}
  .pb-sheet-p{position:relative;width:100%;max-height:88svh;overflow:auto;overscroll-behavior:contain;padding:0 16px calc(18px + env(safe-area-inset-bottom,0px));border-radius:24px 24px 0 0;background:#fcf7f0;border-top:2px solid #c99a43;box-shadow:0 -18px 40px -12px rgba(14,34,20,.5);transform:translateY(100%);transition:transform 340ms var(--fk-ease-out);outline:0}
  .pb-sheet.is-open .pb-sheet-bg{opacity:1}
  .pb-sheet.is-open .pb-sheet-p{transform:translateY(var(--dy,0px))}
  .pb-sheet.is-drag .pb-sheet-p{transition:none}
  .pb-grab{display:grid;place-items:center;height:44px;margin:0 -16px;cursor:grab;touch-action:none}
  .pb-grab i{width:44px;height:5px;border-radius:999px;background:#c99a43}
  .pb-sheet-h{display:flex;align-items:center;justify-content:space-between;gap:12px;margin:-6px 0 12px}
  .pb-sheet-h h3{margin:0;font:500 1.35rem/1.2 var(--fk-serif);color:#18301f}
  .pb-x{width:44px;height:44px;border-radius:50%;border:1px solid rgba(201,154,67,.55);background:#fff;color:#18301f;font:600 1rem/1 var(--fk-sans);cursor:pointer}
  .pb-opt{position:relative;display:grid;grid-template-columns:minmax(0,1fr) 20px;align-items:center;gap:10px;min-height:56px;margin:0 0 8px;padding:10px 14px;border-radius:16px;border:1px solid rgba(201,154,67,.45);background:#fff;cursor:pointer;transition:box-shadow 250ms,border-color 250ms}
  .pb-opt input{position:absolute;inset:0;width:100%;height:100%;opacity:0;margin:0}
  .pb-opt:has(input:checked){border-color:#c99a43;box-shadow:0 0 0 1px #c99a43,0 0 18px -2px rgba(226,170,70,.55)}
  .pb-opt:has(input:focus-visible){outline:2px solid #8a5a14;outline-offset:2px}
  .pb-opt-in{display:grid;gap:2px}
  .pb-opt-in b{font:600 1rem/1.25 var(--fk-sans);color:#18301f}
  .pb-opt-in small{font:400 .8125rem/1.4 var(--fk-sans);color:#5a5040}
  .pb-step--l{max-width:none;grid-template-columns:56px minmax(0,1fr) 56px}
  .pb-step--l .pb-sb{width:56px;height:56px}
  .pb-step--l input{min-height:56px;font-size:1.5rem}
  .pb-quick{display:flex;gap:8px;margin-top:14px}
  .pb-qk{flex:1;min-height:44px;border-radius:999px;border:1px solid rgba(201,154,67,.55);background:#fff;color:#18301f;font:600 .9375rem/1 var(--fk-sans);cursor:pointer;touch-action:manipulation;transition:transform 150ms var(--fk-ease-out)}
  .pb-qk:active{transform:scale(.96)}
  .pb-qk[aria-pressed="true"]{background:var(--fk-selected-bg);color:var(--fk-selected-fg);box-shadow:var(--fk-selected-shadow);border-color:#a8731c}
  .pb-done{width:100%;margin-top:16px}
}
@media(prefers-reduced-motion:reduce){
  .pb *,.pb-bar,.pb-sheet *{transition:none!important}
  .pb-host[data-pose="cheer"] .pa-cheer,.pa-star{animation:none!important}.pa-star{display:none}
}

/* contact fields (name, phone, optional email) — sent with the WhatsApp message and the email copy */
.pb-contact{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:10px 12px;margin:14px 0 12px}
.pb-cf{min-width:0;display:flex;flex-direction:column;gap:5px;font:600 .75rem/1.2 var(--fk-sans,"Poppins",sans-serif);letter-spacing:.06em;text-transform:uppercase;color:inherit;opacity:.92}
.pb-cf em{font-style:normal;text-transform:none;letter-spacing:0;opacity:.75}
.pb-cf--w{grid-column:1/-1}
.pb-cf input{width:100%;min-width:0;box-sizing:border-box;min-height:46px;padding:0 14px;border-radius:12px;border:1px solid rgba(201,154,67,.55);background:rgba(255,250,240,.96);color:#10261a;font:500 1rem/1 var(--fk-sans,"Poppins",sans-serif);text-transform:none;letter-spacing:0}
.pb-cf input:focus-visible{outline:2px solid #c99a43;outline-offset:2px}
@media (max-width:420px){.pb-contact{grid-template-columns:minmax(0,1fr)}}

/* ===== F3 light touch patch: contact block + estimate card (white + red + green, MODERN-FINISH) ===== */
.fl-sr{position:absolute;width:1px;height:1px;overflow:hidden;clip-path:inset(50%);white-space:nowrap}
.pb-est{background:linear-gradient(180deg in oklab,rgba(42,80,25,.08),transparent 140px),#fff;border-left:1px dashed rgba(42,80,25,.35)}
.pb-est-l{color:#666}.pb-est-s,.pb-est .pb-fine{color:#666}
/* fields: 52px, 16px, radius 14, float label (input BEFORE label so a sibling selector works everywhere, no :has) */
.pb-contact{gap:12px}
.pb-cf{position:relative;display:block;text-transform:none;letter-spacing:0;opacity:1}
.pb-est .pb-cf .fk-f-field{height:52px;padding:20px 44px 0 16px;font-size:16px;border:1px solid #cfcfcf;border-radius:14px;background:#fff;color:#17140f;box-shadow:none;min-height:0;transition:border-color 200ms ease,box-shadow 200ms ease}
.pb-est .pb-cf .fk-f-field:focus,.pb-est .pb-cf .fk-f-field:focus-visible{outline:0;border-color:#2a5019;box-shadow:0 0 0 4px rgba(42,80,25,.12)}
.pb-est .pb-cf .fk-f-field::placeholder{color:transparent}
.pb-est .pb-cf .fk-f-field:focus::placeholder{color:#666}
.fl-fl{position:absolute;left:16px;top:0;height:52px;display:flex;align-items:center;font:400 16px/1 var(--fk-sans);color:#666;transform-origin:left center;pointer-events:none;transition:transform 200ms cubic-bezier(.25,1,.5,1),color 200ms ease}
.fl-opt{margin-left:.3em}
.pb-cf .fk-f-field:focus~.fl-fl,.pb-cf .fk-f-field:not(:placeholder-shown)~.fl-fl,.pb-cf .fk-f-field:-webkit-autofill~.fl-fl{transform:translateY(-6px) scale(.75)}
.pb-cf .fk-f-field:focus~.fl-fl{color:#2a5019}
.fl-ok{position:absolute;right:16px;top:17px;width:18px;height:18px;pointer-events:none}
.fl-ok path{stroke-dasharray:20;stroke-dashoffset:20;transition:stroke-dashoffset .3s ease}
.pb-cf .fk-f-field:not(:placeholder-shown):valid~.fl-ok path{stroke-dashoffset:0}
/* Continue on WhatsApp = green text-roll pill with arrow chip */
.fl-ring{display:block;padding:2px;margin:0 -2px;border-radius:999px}
.fl-go{position:relative;isolation:isolate;overflow:hidden;display:flex;align-items:center;justify-content:space-between;gap:14px;width:100%;padding:8px 8px 8px 24px;border:0;border-radius:999px;color:#fff;font:600 15px/20px var(--fk-sans);text-decoration:none;-webkit-tap-highlight-color:transparent;background:linear-gradient(180deg in oklab,#2f5a1c,#24461a);box-shadow:inset 0 1px 0 rgba(255,255,255,.18),0 6px 16px -6px rgba(42,80,25,.45);transition:scale 120ms cubic-bezier(.25,.46,.45,.94)}
.fl-go:active{scale:.96}
.fl-go::after{content:"";position:absolute;inset:0;z-index:-1;pointer-events:none;background:linear-gradient(115deg,transparent 20%,rgba(255,255,255,.35) 48%,transparent 76%);transform:translateX(-130%)}
.fl-roll{display:block;height:20px;overflow:hidden;min-width:0}
.fl-roll-in{display:flex;flex-direction:column;transition:transform 500ms cubic-bezier(.25,1,.5,1)}
.fl-roll-in>span{display:block;height:20px;white-space:nowrap}
.fl-chip{flex:none;width:32px;height:32px;display:grid;place-items:center;border-radius:50%;background:#fff;color:#2a5019}
.fl-chip svg{width:16px;height:16px;transition:transform 500ms cubic-bezier(.25,1,.5,1)}
.fl-go:focus-visible{outline:2px solid #2a5019;outline-offset:3px}
.fl-go:focus-visible .fl-roll-in{transform:translateY(-50%)}
.fl-go:focus-visible .fl-chip svg{transform:rotate(-45deg)}
@media (hover:hover){.fl-go:hover .fl-roll-in{transform:translateY(-50%)}.fl-go:hover .fl-chip svg{transform:rotate(-45deg)}.fl-go:hover::after{transform:translateX(130%);transition:transform .65s ease}}
/* Call Fursat = ghost with a sliding green fill */
.fl-sec{position:relative;isolation:isolate;overflow:hidden;display:grid;place-items:center;min-height:48px;margin-top:10px;padding:0 24px;border:1px solid #2a5019;border-radius:999px;background:#fff;color:#2a5019;font:600 15px/20px var(--fk-sans);text-decoration:none;transition:color .4s cubic-bezier(.22,1,.36,1),scale 120ms cubic-bezier(.25,.46,.45,.94)}
.fl-sec::before{content:"";position:absolute;inset:0;z-index:-1;background:#2a5019;transform:translateX(-100%);transition:transform .4s cubic-bezier(.22,1,.36,1)}
.fl-sec:active{scale:.96}
.fl-sec:focus-visible{outline:2px solid #2a5019;outline-offset:3px;color:#fff}
.fl-sec:focus-visible::before{transform:none}
@media (hover:hover){.fl-sec:hover{color:#fff}.fl-sec:hover::before{transform:none}}
</style>
