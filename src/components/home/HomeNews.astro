---
// HomeNews: Home "What's new". Renders whatever getNews() returns (Sanity, or the built-in fallback). No content is written here.
// Design system classes: fk-card / fk-card--text, fk-btn, fk-ty-* (src/styles/DESIGN-SYSTEM.md).
// Home loads fk-tokens.css (via HomeShared), so the fk-card, fk-btn and fk-ty rules come from there.
import { getNews } from '../../lib/cms/news';
import InstagramFeed from '../InstagramFeed.astro';
import type { NewsItem } from '../../lib/cms/news';

// getNews() (src/lib/cms/news.ts) returns items in the shape the old section used; map them to the card fields below.
type Kind = 'offer' | 'event' | 'news';
type NewsCard = { id: string; kind: Kind; label: string; title: string; text: string;
  image?: { src: string; srcset: string; w: number; h: number; alt: string; lqip?: string };
  cta?: { label: string; href: string; external?: boolean }; endsAt?: string; pinned?: boolean; terms?: string };
const res = await getNews();
const kindOf = (tag: string): Kind => (/^offer$/i.test(tag) ? 'offer' : /^event$/i.test(tag) ? 'event' : 'news');
const toCard = (it: NewsItem, i: number): NewsCard => ({
  id: `n${i}`, kind: kindOf(it.tag), label: it.tag, title: it.title, text: it.line,
  image: it.image ? { src: it.image.src, srcset: it.image.srcset, w: it.image.width, h: it.image.height, alt: it.image.alt, lqip: it.image.lqip || it.image.color } : undefined,
  cta: it.href && it.cta ? { label: it.cta, href: it.href, external: /^https?:\/\//i.test(it.href) } : undefined,
  endsAt: it.end, pinned: it.pinned, terms: it.terms,
});
const data = {
  kicker: res.kicker, heading: res.heading, source: res.source,
  cards: res.enabled ? res.items.map(toCard) : [],
  wish: res.enabled && res.wish ? { title: res.wish.text, endsAt: res.wish.to || '' } : undefined,
} as { kicker: string; heading: string; source: string; cards: NewsCard[]; wish?: { title: string; text?: string; endsAt: string } };

// A date-only end ("2026-11-30") means the end of that day in India, not midnight UTC.
const endIso = (s?: string) => (!s ? '' : /^\d{4}-\d{2}-\d{2}$/.test(s) ? `${s}T23:59:59+05:30` : s);
const endMs = (s?: string) => Date.parse(endIso(s));
const dayFmt = new Intl.DateTimeFormat('en-IN', { day: 'numeric', month: 'short', timeZone: 'Asia/Kolkata' });
const endLabel = (s?: string) => (Number.isNaN(endMs(s)) ? '' : dayFmt.format(new Date(endMs(s))));
// CMS links: site paths, #anchors, https, mailto, tel only.
const safeHref = (h: string) => (/^(\/(?!\/)|#|https:\/\/|http:\/\/|mailto:|tel:)/i.test(h.trim()) ? h.trim() : '');

const ICON: Record<Kind, string> = {
  offer: '<path d="M3 12V4h8l10 10-8 8z"/><circle cx="7.5" cy="8.5" r="1.5"/>',
  event: '<rect x="4" y="5" width="16" height="15" rx="2"/><path d="M4 10h16M9 3v4M15 3v4"/>',
  news: '<path d="M12 3v4M12 17v4M3 12h4M17 12h4M6 6l2.5 2.5M15.5 15.5 18 18M6 18l2.5-2.5M15.5 8.5 18 6"/>',
};

// One pinned card (the first), shown first. Everything else keeps the CMS order.
const pinIdx = data.cards.findIndex((c) => c.pinned);
const cards = pinIdx > 0 ? [data.cards[pinIdx], ...data.cards.filter((_, i) => i !== pinIdx)] : data.cards;
const hasPin = pinIdx >= 0;
const lq = (s?: string) => (!s ? '' : /^(data:|url\()/i.test(s) ? `background-image:url(${s.replace(/^url\(|\)$/g, '')});background-size:cover` : `background-color:${s}`);
const SIZES = '(max-width: 767px) 78vw, (max-width: 1023px) 50vw, 34vw';
---
{(
<section class="hn" id="whats-new" aria-labelledby={cards.length > 0 || data.wish ? "hn-h" : undefined} data-source={data.source}>
  <div class="hn-in">
    {(cards.length > 0 || data.wish) && (
    <div class="hn-head" data-fk-reveal>
      <h2 id="hn-h" class="fk-ty-h2 hn-title">{data.heading}</h2>
    </div>
    )}
    {data.wish && (
      <div class="hn-wish" data-ends={endIso(data.wish.endsAt)}>
        <svg class="hn-wish-ico" viewBox="0 0 24 24" aria-hidden="true"><path d="M12 3l1.8 5.2L19 10l-5.2 1.8L12 17l-1.8-5.2L5 10l5.2-1.8zM19 16l.8 2.2L22 19l-2.2.8L19 22l-.8-2.2L16 19l2.2-.8z"/></svg>
        <div>
          <p class="fk-ty-h4 hn-wish-t">{data.wish.title}</p>
          {data.wish.text && <p class="fk-ty-small hn-wish-p">{data.wish.text}</p>}
        </div>
      </div>
    )}
    {cards.length > 0 && (
    <ul class="hn-row fk-rail fk-rail--cards fk-rail--m" data-n={cards.length} data-pin={hasPin ? '' : undefined} data-dots>
      {cards.map((c, i) => {
        const pin = hasPin && i === 0;
        const lead = i === 0;
        const href = c.cta ? safeHref(c.cta.href) : '';
        const ends = c.kind !== 'news' ? endLabel(c.endsAt) : '';
        return (
          <li class:list={['hn-item', pin && 'hn-item--pin']} data-ends={c.endsAt ? endIso(c.endsAt) : undefined}>
            <article class:list={['fk-card', 'fk-card--glass', 'hn-card', !c.image && 'fk-card--text']}>
              {c.image ? (
                <div class="fk-card__ph hn-ph" style={lq(c.image.lqip)}>
                  <img src={c.image.src} srcset={c.image.srcset} sizes={SIZES} width={c.image.w} height={c.image.h} alt={c.image.alt} loading="lazy" decoding="async" />
                  <span class={`fk-ty-label hn-chip hn-chip--${c.kind}`}>{c.label}</span>
                </div>
              ) : null}
              <div class="fk-card__b">
                {!c.image && (
                  <div class="hn-top">
                    <span class="hn-ico" aria-hidden="true"><svg viewBox="0 0 24 24" set:html={ICON[c.kind]} /></span>
                    <span class={`fk-ty-label hn-chip hn-chip--${c.kind}`}>{c.label}</span>
                  </div>
                )}
                <h3 class:list={['fk-card__t', lead ? 'fk-ty-h3' : 'fk-ty-h4']}>{c.title}</h3>
                <p class="fk-card__p fk-ty-small">{c.text}</p>
                {ends && <p class="fk-ty-small hn-ends"><svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="12" r="8.5"/><path d="M12 7.5V12l3 2"/></svg><time datetime={endIso(c.endsAt)}>Ends {ends}</time></p>}
                {c.kind === 'offer' && <p class="fk-ty-small hn-terms">{c.terms ? `${c.terms} ` : ''}<a href="/terms">Terms apply</a></p>}
                {c.cta && href && (
                  <div class="fk-card__foot">
                    <a class:list={['fk-btn', 'fk-btn--md', c.kind === 'offer' || lead ? 'fk-btn--primary' : 'fk-btn--secondary']} href={href} target={c.cta.external ? '_blank' : undefined} rel={c.cta.external ? 'noopener noreferrer' : undefined}>{c.cta.label}{c.cta.external && <span class="hn-sr"> (opens in a new tab)</span>}</a>
                  </div>
                )}
              </div>
            </article>
          </li>
        );
      })}
    </ul>
    )}
    <InstagramFeed account="all" limit={12} title="From our Instagram" />
  </div>
  <script is:inline>
    // Hides a card (or the wish) the moment its end time passes, even before the next rebuild; removes the whole section when nothing is left.
    (function () {
      var sec = document.getElementById('whats-new'); if (!sec) return;
      var timer;
      function run() {
        var now = Date.now(), next = Infinity;
        [].slice.call(sec.querySelectorAll('[data-ends]')).forEach(function (el) {
          var t = Date.parse(el.getAttribute('data-ends')); if (isNaN(t)) return;
          if (t <= now) el.remove(); else if (t < next) next = t;
        });
        var row = sec.querySelector('.hn-row'), left = row ? row.querySelectorAll('.hn-item').length : 0;
        if (row) {
          if (left) { row.setAttribute('data-n', left); if (!row.querySelector('.hn-item--pin')) row.removeAttribute('data-pin'); } else row.remove();
        }
        if (!left && !sec.querySelector('.hn-wish') && !sec.querySelector('.igfeed')) { sec.remove(); return; }
        clearTimeout(timer);
        if (next < Infinity) timer = setTimeout(run, Math.min(next - now + 50, 2147483647));
      }
      run();
      document.addEventListener('visibilitychange', function () { if (!document.hidden) run(); });
    })();
  </script>
</section>
)}
<style>

  /* Home loads fk-tokens.css, so --fk-plaster is the same plaster as the other pages */
  .hn { padding: clamp(48px, 6vw, 88px) 0; background: var(--fk-plaster, transparent); background-blend-mode: multiply; }
  .hn-in { --gut: clamp(16px, 4vw, 40px); max-width: 1500px; margin: 0 auto; padding: 0 var(--gut); }
  .hn-head { display: grid; gap: 8px; text-align: center; margin-bottom: clamp(20px, 3vw, 32px); }
  .hn-title { color: #18301f; }

  /* Desktop and tablet: wrapping row, the last short row is centred. Pinned card = 2 cells wide. */
  .hn .hn-row { --gap: clamp(16px, 2vw, 28px); list-style: none; margin: 0; padding: 0; display: flex; flex-wrap: wrap; justify-content: center; gap: var(--gap); }
  .hn .hn-row > .hn-item { display: flex; min-width: 0; flex: 0 1 calc((100% - var(--gap)) / 2 - .5px); }
  .hn .hn-row > .hn-item--pin { flex-basis: 100%; }
  .hn-card { flex: 1; }

  /* Photo: the box has a fixed 4:3 ratio before the image loads (no layout shift); LQIP colour sits behind. */
  .hn-ph { aspect-ratio: 4 / 3; background-color: #e3d3b6; }
  .hn-ph img { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; }
  .hn-chip { position: absolute; left: 16px; top: 22px; z-index: 2; }
  .hn-top { display: flex; align-items: center; gap: 10px; margin-bottom: 4px; }
  .hn-top .hn-chip { position: static; }
  .hn-chip { padding: 6px 12px; border-radius: 999px; line-height: 1; }
  .hn-chip--offer { background: #14301c; color: #fbf3e6; }
  .hn-chip--event { background: #e6c27a; color: #14301c; }
  .hn-chip--news { background: #fcf7f0; color: #7a4d17; box-shadow: inset 0 0 0 1px #c99a43; }
  .hn-ico { flex: none; display: grid; place-items: center; width: 44px; height: 44px; border-radius: 50%; background: #fbf3e7; box-shadow: 0 0 0 1px #d6aa5a; }
  .hn-ico svg { width: 22px; height: 22px; fill: none; stroke: #7a4d17; stroke-width: 1.6; stroke-linecap: round; stroke-linejoin: round; }

  /* Wish: gold banner above the cards */
  .hn-wish { display: flex; align-items: center; justify-content: center; gap: 14px; max-width: 880px; margin: 0 auto clamp(20px, 3vw, 28px); padding: 16px 24px; border-radius: 22px; text-align: left; color: #3b2306;
    background: linear-gradient(90deg, #f3d38c, #e8bb62); box-shadow: inset 0 0 0 1px rgba(154, 111, 42, .6), 0 12px 24px -16px rgba(90, 60, 20, .55); }
  .hn-wish-ico { flex: none; width: 28px; height: 28px; fill: none; stroke: #5a3a0a; stroke-width: 1.6; stroke-linecap: round; stroke-linejoin: round; }
  .hn-wish-t { font-style: italic; color: #3b2306; }
  .hn-wish-p { margin-top: 2px; color: #4a2c08; }
  .hn-card .fk-card__t { color: #1f2a1a; }
  .hn-card .fk-card__p { color: #4a4232; }
  .hn-card.fk-card--text .fk-card__t { padding-right: 0; }
  .hn-ends { display: flex; align-items: center; gap: 6px; font-weight: 600; color: #14301c; }
  .hn-ends svg { width: 16px; height: 16px; flex: none; fill: none; stroke: currentColor; stroke-width: 1.8; stroke-linecap: round; stroke-linejoin: round; }
  .hn-terms { color: #5b4a2c; }
  .hn-terms a { color: #14301c; text-decoration: underline; text-underline-offset: 2px; display: inline-flex; align-items: center; min-height: 44px; }
  .hn-card .fk-card__foot { justify-content: flex-start; }
  .hn-sr { position: absolute; width: 1px; height: 1px; overflow: hidden; clip-path: inset(50%); white-space: nowrap; }

  /* Pinned card: photo left, text right, larger title. */
  @media (min-width: 768px) {
    .hn-item--pin .hn-card { display: grid; grid-template-columns: 1fr 1fr; }
    .hn-item--pin .fk-card__ph { -webkit-mask: none; mask: none; margin: 0; align-self: stretch; aspect-ratio: auto; min-width: 0; }
    .hn-item--pin .fk-card__ph::before { content: ""; display: block; padding-top: 75%; } /* keeps the 4:3 box before the image loads; grows if the text is taller */
    .hn-item--pin .fk-card__b { justify-content: center; padding: 34px 28px 28px; gap: 10px; }
    .hn-item--pin .fk-card__t { padding-right: 0; }
    .hn-item--pin .fk-card__p.fk-ty-small { font-size: 1rem; line-height: 1.6; }
    .hn-item--pin .fk-card--text, .hn-item--pin .hn-card.fk-card--text { grid-template-columns: 1fr; }
  }
  @media (min-width: 1024px) {
    .hn .hn-row > .hn-item { flex-basis: calc((100% - 2 * var(--gap)) / 3 - .5px); }
    .hn .hn-row > .hn-item--pin { flex-basis: calc(2 * (100% - 2 * var(--gap)) / 3 + var(--gap) - .5px); }
    .hn .hn-row[data-n="4"]:not([data-pin]) > .hn-item { flex-basis: calc((100% - 3 * var(--gap)) / 4 - .5px); }
    .hn .hn-row[data-n="3"][data-pin] > .hn-item--pin { flex-basis: 100%; } /* pinned + 2: full-width pinned, the two sit centred below */
  }

  /* Phone: swipe rail (fk-rail--cards gives snap + peek + dots). Text-only cards have no photo to overlap. */
  @media (max-width: 767px) {
    .hn .hn-row { display: flex; flex-wrap: nowrap; justify-content: flex-start; padding: 8px var(--gut) 14px; margin: 0 calc(-1 * var(--gut)); gap: 12px; scroll-padding-inline: var(--gut); }
    .hn .hn-row > .hn-item, .hn .hn-row > .hn-item--pin { flex: 0 0 min(80vw, 340px); }
    .hn .hn-row[data-n="1"] > .hn-item { flex-basis: 100%; }
  }
  .hn-card.fk-card--text .fk-card__b { margin: 0; padding-top: 18px; }
  .hn-row .fk-card__ph { -webkit-mask: none; mask: none; }
  /* Desktop: pinned card (photo left, text right) keeps its flat, wide layout. */
  @media (min-width: 768px) {
    .hn-item--pin .fk-card__b { margin: 0; }
  }

  @media (hover: hover) and (pointer: fine) { .hn-card:hover { transform: translateY(-3px); } }
  @media (prefers-reduced-motion: reduce) { .fk-btn { transition: none; } .fk-btn:active { transform: none; } .hn-card, .hn-card .fk-card__ph img { transition: none; } .hn-card:hover { transform: none; } .hn-card:hover .fk-card__ph img { transform: none; } }
</style>
