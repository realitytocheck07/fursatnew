---
// HomeNews: Home "What's new" block = the red/gold WhatsNew bento, then the Instagram feed.
// All card content comes from getNews() (Sanity, or the built-in cards) inside WhatsNew.astro. Nothing is written here.
import WhatsNew from './WhatsNew.astro';
import InstagramFeed from '../InstagramFeed.astro';
---
<WhatsNew />
<section class="hn-ig">
  <div class="hn-in">
    <InstagramFeed account="all" limit={12} title="From our Instagram" />
  </div>
</section>
<style>
  /* Home loads fk-tokens.css, so --fk-plaster is the same plaster as the other pages */
  .hn-ig { padding: clamp(32px, 5vw, 64px) 0; background: var(--fk-plaster, transparent); background-blend-mode: multiply; }
  .hn-in { --gut: clamp(16px, 4vw, 40px); max-width: 1500px; margin: 0 auto; padding: 0 var(--gut); }
</style>
