---
// "What brings you in?": 5 slim tiles, one per space. Real venue photos only.
const TILES = [
  { href: '/restaurant-bar', label: 'Restaurant & Bar', base: '/assets/interior/fursat_space_04', alt: 'Restaurant seating with red banquettes and framed art' },
  { href: '/cafe', label: 'Café', base: '/assets/interior/fursat_space_02', alt: 'Café lounge with sofas and a marble coffee table' },
  { href: '/party', label: 'Parties & Events', base: '/assets/venue/banquet/banquet-stage-01', alt: 'Banquet hall set with chairs facing the stage' },
  { href: '/banquet', label: 'Banquet', base: '/assets/venue/banquet/banquet-tables-05', alt: 'Banquet hall with a long U-shaped table setup' },
  { href: '/catering', label: 'Catering', base: '/assets/dishes/new/nalli-gosht-biryani-half', alt: 'Ustad Special Nalli Gosht Biryani' },
];
// 480 and 720 wide files exist for every tile; the browser picks by the tile's real width
const SIZES = '(min-width: 1000px) 20vw, 50vw';
const SIZES_LAST = '(min-width: 1000px) 20vw, (min-width: 600px) 50vw, 100vw';
---
<section class="hw" id="spaces" aria-labelledby="hw-h">
  <h2 class="fk-ty-h2" id="hw-h" data-fk-reveal>What brings you in?</h2>
  <ul class="hw-row fk-rail fk-rail--cards fk-rail--m" data-dots>
    {TILES.map((t, i) => (
      <li>
        <a class="hw-tile fk-card fk-card--glass" href={t.href}>
          <span class="fk-card__ph"><img src={`${t.base}-720.webp`} srcset={`${t.base}-480.webp 480w, ${t.base}-720.webp 720w`} sizes={i === TILES.length - 1 ? SIZES_LAST : SIZES} alt={t.alt} loading="lazy" decoding="async" width="720" height="960" /></span>
          <span class="fk-card__b hw-label"><span class="fk-card__t">{t.label}</span><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6"/></svg></span>
        </a>
      </li>
    ))}
  </ul>
</section>
<script is:inline>
/* Tiles sit below the fold: after the page has loaded and the browser is idle, fetch all five photos so a fast scroll never shows an empty tile. */
(function(){function go(){document.querySelectorAll('.hw-tile img').forEach(function(i){i.loading='eager'})}
function arm(){(window.requestIdleCallback||function(f){setTimeout(f,1200)})(go,{timeout:3000})}
if(document.readyState==='complete')arm();else addEventListener('load',arm,{once:true})})();
</script>

<style is:global>
.hw{background:var(--fk-plaster);background-blend-mode:multiply;color:#1A1608;padding:clamp(36px,5vw,64px) 0 clamp(32px,4.5vw,56px)}
.hw h2{margin:0 0 clamp(18px,2.6vw,30px);padding:0 clamp(12px,2vw,28px);text-align:center}
.hw .hw-row{list-style:none;margin:0;padding:0 clamp(12px,2vw,28px);display:grid;grid-template-columns:repeat(5,minmax(0,1fr));gap:clamp(10px,1.4vw,20px)}
.hw-tile{width:100%;height:100%;color:inherit;text-decoration:none;-webkit-tap-highlight-color:transparent}
.hw-tile .fk-card__ph{aspect-ratio:3/4;max-height:340px}
.hw .hw-label{flex:none;flex-direction:row;align-items:center;justify-content:space-between;gap:8px;min-height:56px;margin-top:-34px;padding:10px 14px}
.hw-label .fk-card__t{font-size:1.0625rem}
.hw-label svg{flex:none;width:16px;height:16px;color:#1b3a26}
.hw-tile:focus-visible{outline:3px solid #C94716;outline-offset:3px}
@media(max-width:999px) and (min-width:768px){
  .hw .hw-row{grid-template-columns:repeat(6,minmax(0,1fr))}
  .hw-row li{grid-column:span 2}
  .hw-row li:nth-child(4),.hw-row li:nth-child(5){grid-column:span 3}
  .hw-tile .fk-card__ph{aspect-ratio:4/3;max-height:none}
}
@media(max-width:767px){
  .hw .hw-row{display:flex;padding:8px 16px 14px;margin:0;scroll-padding-inline:16px}
  .hw-row li{flex:0 0 min(72vw,300px)}
  .hw-tile .fk-card__ph{aspect-ratio:4/5;max-height:none}
}
</style>
