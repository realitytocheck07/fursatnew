---
// "Celebrate at Fursat": one real banquet photo + the 3 party groups. Labels, blurbs and "From" prices come from party.json only.
import party from '../../data/party.json';

const rupee = (n: number) => `₹${n.toLocaleString('en-IN')}`;
const groups = (party as any).groups.map((g: any) => ({
  ...g,
  from: rupee(Math.min(...(party as any).packages.filter((p: any) => p.group === g.id).map((p: any) => p.price))),
}));
const arrow = '<path d="M5 12h14M13 6l6 6-6 6"/>';
const chev = '<path d="M9 6l6 6-6 6"/>';
const icons: Record<string, string> = {
  bar: '<path d="M4 4h7l-.8 5.2a2.7 2.7 0 0 1-5.4 0z"/><path d="M7.5 12v6M5.5 18h4"/><path d="M13 4h7l-.8 5.2a2.7 2.7 0 0 1-5.4 0z"/><path d="M16.5 12v6M14.5 18h4"/>',
  elite: '<path d="M5 17a7 7 0 0 1 14 0M3 17h18M3.5 20h17M12 10V8M10.5 8h3"/>',
  banquet: '<path d="M7 3v6a2 2 0 0 0 4 0V3M9 3v18"/><path d="M17 21V3c-2 1.6-3 4-3 7 0 1.6.9 2.6 3 3"/>',
};
const iconFallback = '<circle cx="12" cy="12" r="5"/>';
import InstaFeed from '../InstaFeed.astro';
---
<section class="hc" id="celebrate" aria-labelledby="hc-h">
  <div class="hc-phw fk-dna-sh"><figure class="hc-ph fk-dna" style="--dna-pos:50% 50%" data-fk-reveal>
    <img
      src="/assets/celebrations/birthday-stage-screen-45-640.webp"
      srcset="/assets/celebrations/birthday-stage-screen-45-360.webp 360w, /assets/celebrations/birthday-stage-screen-45-640.webp 640w"
      sizes="(min-width: 900px) 48vw, 100vw"
      alt="The Fursat stage set for a birthday, with a Happy Birthday message on the big LED screen"
      width="640" height="800" loading="lazy" decoding="async" />
  </figure></div>
  <div class="hc-body" data-fk-reveal>
    <svg class="hc-wave" viewBox="0 0 400 30" preserveAspectRatio="none" aria-hidden="true" focusable="false"><path d="M0 0H400V13C340 29 282 3 204 13S60 27 0 11Z"/></svg>
    <h2 class="fk-ty-h2" id="hc-h">Celebrate at <span class="hc-hl">Fursat</span></h2>
    <p class="hlead">Birthdays, corporate gatherings, kitty parties and bar parties.</p>
    <ul class="hc-gl">
      {groups.map((g: any) => (
        <li>
          <a class="hc-g" href={`/party?group=${g.id}`}>
            <svg class="hc-gi" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false" set:html={icons[g.id] ?? iconFallback} />
            <span class="hc-gt"><b class="fk-ty-h4">{g.label}</b><small class="fk-ty-small">{g.blurb}</small></span>
            <span class="hc-gp"><span class="hc-gf">From {g.from}</span><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" set:html={chev} /></span>
          </a>
        </li>
      ))}
    </ul>
    <div class="hc-btns">
      <a class="fk-btn fk-btn--primary" href="/party">Plan my party<span class="hc-pa" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" set:html={arrow} /></span></a>
      <a class="fk-btn fk-btn--secondary" href="/banquet">See the banquet hall</a>
    </div>
    <InstaFeed handle="fursatbanquets" count={3} />
  </div>
</section>

<style is:global>
.hc{--hc-gold:#e6c27a;--hc-gold5:#c99a43;--hc-ink:#10261a;background:var(--fk-plaster);background-blend-mode:multiply;color:#1A1608;padding:clamp(36px,5vw,64px) clamp(12px,2vw,28px);display:grid;grid-template-columns:minmax(0,5fr) minmax(0,6fr);gap:clamp(20px,3.4vw,56px);align-items:center}
.hc-phw{min-width:0;align-self:center}
.hc-ph{margin:0;background:#d9cdb3;max-height:600px;width:100%}
.hc-ph img{display:block;width:100%;height:100%;object-fit:cover}
.hc-body{position:relative;overflow:hidden;display:flex;flex-direction:column;gap:14px;min-width:0;padding:calc(clamp(24px,3.4vw,40px) + 20px) clamp(16px,3vw,36px) clamp(24px,3.4vw,40px);border-radius:28px;color:#f6ecd6;background:radial-gradient(46% 26% at 96% 7%,rgba(230,194,122,.3),transparent 70%),radial-gradient(30% 18% at 80% 20%,rgba(230,194,122,.16),transparent 70%),radial-gradient(44% 34% at 0% 14%,rgba(92,138,52,.5),transparent 72%),radial-gradient(60% 30% at 50% 108%,rgba(201,154,67,.14),transparent 70%),linear-gradient(180deg,#14301c,var(--hc-ink) 70%)}
.hc-wave{position:absolute;left:0;top:0;width:100%;height:26px;display:block;pointer-events:none}
.hc-wave path{fill:var(--fk-cream-100)}
.hc .fk-ty-h2{color:#fbf3e6}
.hc-hl{color:var(--fk-gold-300);font-style:italic}
.hc .fk-ty-h2::after{content:"";display:block;width:96px;height:3px;margin-top:12px;border-radius:50%;background:linear-gradient(90deg in oklab,transparent,var(--fk-gold-500) 30%,var(--fk-gold-300) 70%,transparent)}
.hc .hlead{margin:0;color:#f1e5cc}
.hc-gl{list-style:none;margin:8px 0 0;padding:0;display:flex;flex-direction:column;gap:12px}
.hc-g{display:grid;grid-template-columns:40px minmax(0,1fr) auto;align-items:center;gap:12px;min-height:72px;padding:14px 16px 14px 14px;border-radius:24px;background:var(--fk-cream-50);border:1px solid rgba(201,154,67,.6);box-shadow:0 12px 24px -16px rgba(14,34,20,.7),inset 0 1px 0 #fff;color:var(--fk-forest-800);text-decoration:none;transition:transform .2s}
.hc-gl li:first-child .hc-g{background:#fffaf0;border-color:var(--fk-gold-500);box-shadow:0 0 0 1px rgba(230,194,122,.7),0 0 18px 2px rgba(230,194,122,.5),0 12px 24px -16px rgba(14,34,20,.7),inset 0 1px 0 #fff}
.hc-gi{width:40px;height:40px;padding:9px;box-sizing:border-box;border-radius:50%;background:#e6ecd9;color:var(--fk-forest-800)}
.hc-gt{display:flex;flex-direction:column;gap:2px;min-width:0}
.hc-gt b{color:var(--fk-forest-800)}
.hc-gt small{color:#4a4330}
.hc-gp{display:inline-flex;align-items:center;gap:8px;align-self:stretch;padding-left:12px;border-left:1px solid rgba(201,154,67,.7);font:600 15px/1 Rupee,Poppins,system-ui,sans-serif;font-variant-numeric:tabular-nums;white-space:nowrap;color:var(--fk-forest-800)}
.hc-gp svg{width:15px;height:15px;transition:transform .25s}
.hc-g:focus-visible{outline:3px solid var(--hc-gold);outline-offset:3px}
.hc-g:active{transform:scale(.98)}
@media(hover:hover){.hc-g:hover{transform:translateY(-2px)}.hc-g:hover .hc-gp svg{transform:translateX(4px)}}
.hc-btns{display:flex;flex-wrap:wrap;gap:12px;margin-top:10px}
.hc .hc-btns .fk-btn{position:relative;min-height:56px}
.hc .hc-btns .fk-btn--primary{padding-right:60px;border-color:var(--hc-gold5);box-shadow:0 0 0 1px rgba(201,154,67,.55),0 8px 18px -10px rgba(0,0,0,.6)}
.hc-pa{position:absolute;right:8px;top:50%;translate:0 -50%;display:grid;place-items:center;width:40px;height:40px;border-radius:50%;background:#fff;color:var(--fk-forest-800)}
.hc-pa svg{width:18px;height:18px}
.hc .hc-btns .fk-btn--secondary{background:transparent;border-color:rgba(251,243,230,.85);color:#fbf3e6}
.hc .hc-btns .fk-btn:focus-visible{outline-color:var(--hc-gold)}
.hc .igf-t{color:#f6ecd8}
.hc .igf-t span{color:#d9c9a6}
@media(max-width:899px){
  .hc{grid-template-columns:minmax(0,1fr);gap:0}
  .hc-ph{max-height:none}
  html .hc .hc-ph.fk-dna{border-radius:28px;-webkit-mask:none;mask:none}
  .hc-body{margin-top:-26px;z-index:1;text-align:center;align-items:stretch}
  .hc .fk-ty-h2::after{margin-inline:auto}
  .hc-gt{text-align:left}
  .hc-hl{display:block;font-size:1.3em;line-height:1.1}
}
@media(max-width:767px){
  .hc{padding-bottom:calc(var(--mb-clear,76px) + 64px)}
}
@media(max-width:479px){
  .hc-btns .fk-btn{flex:1 1 100%;padding-left:60px}
  .hc-g{grid-template-columns:40px minmax(0,1fr) auto;gap:10px;padding:14px 12px 14px 12px}
  .hc-gp{gap:6px;padding-left:10px;width:88px;box-sizing:border-box;font-size:14px}
  .hc-gf{display:block;width:min-content;line-height:1.25;white-space:normal}
}
@media(prefers-reduced-motion:reduce){.hc-gp svg{transition:none}}
</style>
