---
// "Our story": two lines taken word for word from /story ("Crafted for Good Times") + one real interior photo.
---
<section class="hst" id="our-story" aria-labelledby="hst-h">
  <div class="hst-body" data-fk-reveal>
    <h2 class="fk-ty-h2" id="hst-h">Our story</h2>
    <p class="hlead">A café, a kitchen, a bar and banquet spaces under one roof at Capital Park, Madhapur.</p>
    <p class="hlead">Come for a coffee, stay for dinner, bring everyone for the celebration.</p>
    <ul class="hst-stats">
      <li><b>4</b> <span>spaces</span></li>
      <li><b>1</b> <span>big screen</span></li>
      <li><b aria-label="endless">∞</b> <span>reasons to stay longer</span></li>
    </ul>
    <div class="hst-btns"><a class="fk-btn fk-btn--secondary" href="/story">Read our story</a></div>
  </div>
  <figure class="hst-ph" data-fk-reveal>
    <img src="/assets/interior/fursat_space_03-720.webp" alt="Fursat interior with patterned wooden screens, green plants and a black-and-white tiled floor" width="720" height="900" loading="lazy" decoding="async" />
  </figure>
</section>

<style is:global>
.hst{background:var(--fk-plaster);background-blend-mode:multiply;color:#1A1608;padding:clamp(36px,5vw,64px) clamp(12px,2vw,28px);display:grid;grid-template-columns:minmax(0,6fr) minmax(0,5fr);gap:clamp(20px,3.4vw,56px);align-items:center}
.hst-body{display:flex;flex-direction:column;gap:14px;min-width:0}
.hst-stats{list-style:none;margin:6px 0 0;padding:0;display:flex;flex-wrap:wrap;align-items:baseline;gap:6px 0;font-size:.9375rem;color:#3a3220}
.hst-stats li{display:flex;align-items:baseline;gap:6px}
.hst-stats li+li::before{content:"·";margin:0 12px;color:#b8892e;font-weight:700}
.hst-stats b{font-family:'Playfair Display',serif;font-weight:600;font-size:1.5rem;line-height:1;color:#1b3a26}
.hst-btns{margin-top:8px}
.hst-ph{margin:0;border-radius:26px;overflow:hidden;background:#d9cdb3;aspect-ratio:4/5;max-height:560px;width:100%}
.hst-ph img{display:block;width:100%;height:100%;object-fit:cover}
@media(max-width:899px){
  .hst{grid-template-columns:minmax(0,1fr)}
  .hst-ph{order:-1;aspect-ratio:4/3;max-height:none}
}
@media(max-width:599px){
  .hst-stats{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:8px}
  .hst-stats li{flex-direction:column;align-items:center;justify-content:flex-start;gap:6px;padding:12px 6px;text-align:center;border:1px solid rgba(184,137,46,.4);border-radius:16px;background:rgba(255,255,255,.45);font-size:.8125rem;line-height:1.3}
  .hst-stats li+li::before{content:none}
  .hst-stats b{font-size:1.625rem}
}
@media(max-width:479px){.hst-btns .fk-btn{width:100%}}
</style>
