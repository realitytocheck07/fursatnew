---
// "Crafted for the Season": 4 cards, each slowly rotating through real dishes.
// Names, prices and descriptions come from the menu data (menus 5/7), never typed here.
import food from '../../data/food.json';
import drinks from '../../data/drinks.json';
import dishPhotos from '../../data/dish-photos.json';

type Row = { name: string; price: number; description?: string; section: string };
const norm = (s: string) => s.toLowerCase().replace(/[^a-z0-9]/g, '');
const rows: Row[] = [...(food as any[]), ...(drinks as any[])].flatMap((sec) =>
  sec.items.map((i: any) => ({ ...i, section: sec.section })),
);
const photos = (dishPhotos as any).photos as Record<string, { src: string; sm: string; w: number; h: number; todo?: string }>;

type Dish = { name: string; alt: string; photo: string };
type Card = { kind: string; dishes: Dish[] };

// `photo` = key in dish-photos.json (only photos from public/assets/dishes/new, confirmed, no hands or people in shot).
const CARDS: Card[] = [
  { kind: 'drink', dishes: [
    { name: 'Fursat Rahasyam', alt: 'Fursat Rahasyam mocktail', photo: 'FURSAT RAHASYAM' },
    { name: 'Gongura Muchatlu', alt: 'Gongura Muchatlu cocktail', photo: 'GONGURA MUCHATLU' },
    { name: 'Iced Latte', alt: 'Iced latte', photo: 'ICED LATTE' },
    { name: 'Cappuccino', alt: 'Cappuccino with latte art', photo: 'CAPPUCCINO' },
  ] },
  { kind: 'plate', dishes: [
    { name: 'Ustad Special Nalli Gosht Biryani', alt: 'Ustad Special Nalli Gosht Biryani', photo: 'Ustad Special Nalli Gosht Biryani' },
    { name: 'Guntur Karam Wings', alt: 'Guntur Karam Wings', photo: 'Guntur Karam Wings' },
    { name: 'Chicken Tikka (Angara/ Malai/ Hariyali)', alt: 'Angara chicken tikka', photo: 'Chicken Tikka (Angara/ Malai/ Hariyali)' },
    { name: 'Nalla Karam Kodi Vepudu', alt: 'Nalla Karam Kodi Vepudu', photo: 'Nalla Karam Kodi Vepudu' },
  ] },
  { kind: 'sweet', dishes: [
    { name: 'Biscoff Cheesecake', alt: 'Biscoff cheesecake', photo: 'Biscoff Cheesecake' },
    { name: 'Apricot Delight', alt: 'Apricot delight', photo: 'Apricot Delight' },
  ] },
  { kind: 'bite', dishes: [
    { name: 'Jeedi Pappu Kodi Pakodi', alt: 'Jeedi Pappu Kodi Pakodi', photo: 'Jeedi Pappu Kodi Pakodi' },
    { name: 'Korean Bun', alt: 'Korean bun', photo: 'Korean Bun' },
    { name: 'OG French Toast', alt: 'OG French toast', photo: 'OG French Toast' },
  ] },
];

const rupee = (n: number) => `₹${n.toLocaleString('en-IN')}`;
const cards = CARDS.map((c) => ({
  kind: c.kind,
  dishes: c.dishes.map((d) => {
    const row = rows.find((r) => norm(r.name) === norm(d.name));
    if (!row) throw new Error(`HomeSeason: "${d.name}" is not in food.json / drinks.json`);
    // Menu row "Half ₹599 | Full ₹999": show both, as the menu does.
    const hf = /half\s*₹?\s*(\d+).*full\s*₹?\s*(\d+)/i.exec(row.description ?? '');
    const priceText = hf ? `Half ${rupee(+hf[1])} · Full ${rupee(+hf[2])}` : rupee(row.price);
    const tray = hf ? `${hf[1]} half / ${hf[2]} full` : String(row.price);
    // Short line under the name: the menu's own description, else the menu section.
    const note = hf ? row.section : (row.description || row.section);
    const ph = photos[d.photo];
    if (!ph || ph.todo) throw new Error(`HomeSeason: no confirmed photo for "${d.photo}"`);
    const img = { src: ph.sm, srcset: `${ph.sm} 427w, ${ph.src} ${ph.w}w`, w: ph.w, h: ph.h };
    const name = row.name === row.name.toUpperCase() ? d.name : row.name;
    // Deep link target: the exact menu name (as in food.json / drinks.json), URL-encoded.
    return { name, menuName: row.name, alt: d.alt, note, priceText, tray, img };
  }),
}));
const BADGE: Record<string, string> = {"drink": "<path d=\"M6 3h12l-1.5 7a4.5 4.5 0 0 1-9 0z\"/><path d=\"M12 14.5V21M8.5 21h7\"/>", "plate": "<path d=\"M3 12h18a9 9 0 0 1-18 0z\"/><path d=\"M8 8c0-1.5 1-2 1-3.5M12 8c0-1.5 1-2 1-3.5M16 8c0-1.5 1-2 1-3.5\"/>", "sweet": "<path d=\"M7 11h10l-1.2 9H8.2z\"/><path d=\"M6 11a6 6 0 0 1 12 0\"/><circle cx=\"12\" cy=\"5\" r=\"1.5\"/>", "bite": "<path d=\"M12 3c3 4 6 6.5 6 10.5a6 6 0 0 1-12 0C6 10 9 9 9 6c2 1.5 3 3 3 5\"/>"};
---
<section class="hs" id="season" aria-labelledby="hs-h">
  <div class="hs-head" data-fk-reveal>
    <h2 class="fk-ty-h2" id="hs-h">Crafted for the Season</h2>
    <p>A few favorites, curated with intention.</p>
    <a class="fk-btn fk-btn--secondary fk-btn--md" href="/menu">View full menu</a>
  </div>
  <div class="hs-cards fk-rail fk-rail--cards fk-rail--m" data-dots data-fk-stagger>
    {cards.map((c) => {
      const d0 = c.dishes[0];
      return (
        <article class="hs-card fk-card fk-card--glass" data-name={d0.name} data-price={d0.tray} data-kind={c.kind} data-dishes={JSON.stringify(c.dishes.map((d) => [d.name, d.note, d.priceText, d.tray]))} data-menus={JSON.stringify(c.dishes.map((d) => d.menuName))}>
          <span class="hs-badge" aria-hidden="true"><svg viewBox="0 0 24 24" set:html={BADGE[c.kind] || BADGE.plate} /></span>
          <div class="hs-imgw fk-dna-sh"><div class="hs-img fk-card__ph fk-dna">
            {c.dishes.map((d, i) => (
              <img class:list={['hs-sl', { on: i === 0 }]} src={d.img.src} srcset={d.img.srcset} sizes="(min-width: 768px) 25vw, 80vw" alt={d.alt} width={d.img.w} height={d.img.h} loading="lazy" decoding="async" />
            ))}
          </div></div>
          <div class="hs-body fk-card__b">
            <h3 class="fk-card__t">{d0.name}</h3>
            <p class="fk-card__p">{d0.note}</p>
            <b class="hs-price fk-card__price">{d0.priceText}</b>
          </div>
          <a class="hs-link" href={`/menu#dish=${encodeURIComponent(d0.menuName)}`} aria-label={`See ${d0.name} on the menu`}></a>
          <span class="hs-more" aria-hidden="true">See dish <i>→</i></span>
        </article>
      );
    })}
  </div>
</section>
<script is:inline>
/* The card rotates through dishes (js/10.js changes data-name). Keep the card link on the dish that is showing: /menu#dish=<exact menu name>. */
(function(){
  [].forEach.call(document.querySelectorAll('.hs-card[data-menus]'),function(c){
    var N,M,l=c.querySelector('.hs-link');
    try{N=JSON.parse(c.getAttribute('data-dishes')).map(function(d){return d[0]});M=JSON.parse(c.getAttribute('data-menus'))}catch(e){return}
    if(!l||!window.MutationObserver)return;
    new MutationObserver(function(){var i=N.indexOf(c.getAttribute('data-name'));if(i<0)return;l.href='/menu#dish='+encodeURIComponent(M[i]);l.setAttribute('aria-label','See '+N[i]+' on the menu')}).observe(c,{attributes:true,attributeFilter:['data-name']});
  });
})();
</script>

<style is:global>
.hs{background:var(--fk-plaster);background-blend-mode:multiply;color:#1A1608;padding:clamp(40px,6vw,72px) 0 clamp(36px,5vw,64px)}
.hs-head{display:flex;flex-direction:column;align-items:center;text-align:center;gap:6px;padding:0 clamp(12px,2vw,28px);margin-bottom:clamp(20px,3vw,34px)}
.hs-head p{margin:0;font:400 14px/1.5 Rupee,Poppins,system-ui,sans-serif;color:#4a4330}

.hs-cards{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:clamp(12px,1.6vw,24px);padding:0 clamp(12px,2vw,28px)}
.hs-card{min-width:0}
.hs-card .hs-img{background:#d9cdb3}
.hs-badge{position:absolute;left:14px;top:14px;z-index:3;display:grid;place-items:center;width:40px;height:40px;border-radius:50%;background:rgba(251,243,231,.94);box-shadow:0 0 0 1px #d6aa5a,0 4px 12px -4px rgba(60,40,10,.25)}
.hs-badge svg{width:21px;height:21px;fill:none;stroke:#8a5a22;stroke-width:1.5;stroke-linecap:round;stroke-linejoin:round}
.hs-sl{position:absolute;inset:0;width:100%;height:100%;object-fit:cover;opacity:0;transition:opacity .7s ease}
.hs-sl.on{opacity:1}
.hs-card .hs-body{min-height:112px;transition:opacity .45s ease}
.hs-body.sw{opacity:0}
.hs-card .hs-price{text-align:left}
.hs-link{position:absolute;inset:0;z-index:2;border-radius:24px}
.hs-link:focus-visible{outline:3px solid #C94716;outline-offset:-3px}


/* v5.64 reference layout: photo on top with a swooped corner, then name, line, price; no cart, so no add button; the whole card opens the dish on the menu. No glass panel over the photo. */
.hs .hs-cards{max-width:1280px;margin-inline:auto}
html .hs .hs-card.hs-card{position:relative;display:flex;flex-direction:column;min-height:0;aspect-ratio:auto;border-radius:26px;overflow:hidden;background:linear-gradient(180deg,#fffaf0,#f7ecd5) !important;-webkit-backdrop-filter:none;backdrop-filter:none;box-shadow:0 0 0 1px rgba(196,154,84,.38),0 22px 36px -24px rgba(70,45,10,.5) !important}
.hs .hs-card .hs-imgw{margin:8px 8px 0}
.hs .hs-card .hs-img{position:relative;inset:auto;width:auto;height:auto;margin:0;border-radius:0;background:#d9cdb3}
.hs .hs-card .hs-sl{--dna-pos:50% 100%}
.hs .hs-card .hs-body{position:relative;inset:auto;left:auto;right:auto;bottom:auto;width:auto;transform:none;margin:0;padding:14px 18px 18px;min-height:128px;background:none;border:0;border-radius:0;box-shadow:none;-webkit-backdrop-filter:none;backdrop-filter:none;display:flex;flex-direction:column;gap:4px}
.hs .hs-card .fk-card__t{margin:0;font:600 clamp(17px,1.5vw,20px)/1.2 var(--serif,'Playfair Display',serif);color:#1d2a14}
.hs .hs-card .fk-card__p{margin:0;font:400 12.5px/1.45 Rupee,Poppins,system-ui,sans-serif;color:#5a5238;display:-webkit-box;-webkit-line-clamp:2;-webkit-box-orient:vertical;overflow:hidden}
.hs .hs-card .hs-price{margin-top:auto;padding:8px 96px 0 0;font:700 14px/1.3 Rupee,Poppins,system-ui,sans-serif;color:#1c2a12;text-align:left}
.hs .hs-badge{left:20px;top:20px}
/* "See dish →": a quiet hint on hover (mouse) or keyboard focus; the whole card is the link */
.hs-more{position:absolute;right:18px;bottom:18px;z-index:1;font:600 12.5px/1 Rupee,Poppins,system-ui,sans-serif;color:#8a5a22;opacity:0;transform:translateX(-4px);transition:opacity .2s ease-out,transform .2s cubic-bezier(.23,1,.32,1);pointer-events:none}
.hs-more i{font-style:normal}
.hs-card:has(.hs-link:focus-visible) .hs-more{opacity:1;transform:none}
@media(hover:hover) and (pointer:fine){.hs-card:hover .hs-more{opacity:1;transform:none}}
@media(max-width:767px){
  .hs-cards{display:flex;padding:8px 16px 14px;margin:0;scroll-padding-inline:16px}
  .hs-card{flex:0 0 min(80vw,340px)}
}
@media(min-width:768px) and (max-width:1023px){.hs-cards{grid-template-columns:repeat(2,minmax(0,1fr))}}
</style>
