---
// "Visit & reserve": every fact comes from site.json. Lines still marked TODO(client) there are not shown.
import site from '../../data/site.json';

const real = (v?: string) => !!v && !v.startsWith('TODO');
const a = site.address;
const address = [real(a.line1) ? a.line1 : '', a.line2, `${a.state} ${a.pin}`].filter(Boolean).join(', ');
const schedule = site.hours.schedule;
const tel = `+${site.phonePlain}`;
const arrow = '<path d="M5 12h14M13 6l6 6-6 6"/>';
---
<section class="hv" id="plan-visit" aria-labelledby="hv-h">
  <div class="hv-info" data-fk-reveal>
    <h2 class="fk-ty-h2" id="hv-h">Visit &amp; reserve</h2>
    <dl class="hv-dl">
      <div><dt>Address</dt><dd>{address}</dd></div>
      <div>
        <dt>Hours</dt>
        <dd>
          <ul class="hv-hrs">
            {schedule.map((s) => <li><span>{s.days}</span><span class="hv-t">{s.open} – {s.close}</span></li>)}
          </ul>
        </dd>
      </div>
      <div><dt>Phone</dt><dd><a class="hv-tel" href={`tel:${tel}`}>{site.phone}</a></dd></div>
    </dl>
  </div>
  <div class="hv-btns" data-fk-reveal>
    <figure class="hv-ele">
      <img src="/assets/home/elephant-cocktail-480.webp" srcset="/assets/home/elephant-cocktail-480.webp 480w, /assets/home/elephant-cocktail-640.webp 640w" sizes="(min-width: 900px) 200px, 150px" alt="" width="640" height="582" loading="lazy" decoding="async" />
      <figcaption>Table for one</figcaption>
    </figure>
    <button class="fk-btn fk-btn--primary" type="button" data-open="book">Reserve a table<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" set:html={arrow} /></button>
    <a class="fk-btn fk-btn--secondary" href={`https://wa.me/${site.phonePlain}?text=${encodeURIComponent("Hi Fursat! I have a question.")}`} target="_blank" rel="noopener">WhatsApp</a>
    <a class="fk-btn fk-btn--secondary" href={`tel:${tel}`}>Call</a>
    <a class="fk-btn fk-btn--secondary" href={a.googleMaps} target="_blank" rel="noopener">Directions</a>
    <a class="fk-btn fk-btn--secondary hv-rate" href={a.review} target="_blank" rel="noopener">Rate us on Google</a>
  </div>
</section>

<style is:global>
.hv{background:var(--fk-plaster);background-blend-mode:multiply;color:#1A1608;padding:clamp(36px,5vw,64px) clamp(12px,2vw,28px) clamp(40px,5.5vw,72px);display:grid;grid-template-columns:minmax(0,1fr) minmax(0,1fr);gap:clamp(20px,3.4vw,56px);align-items:center}
.hv-info{display:flex;flex-direction:column;gap:clamp(16px,2vw,24px);min-width:0}
.hv-dl{margin:0;display:grid;gap:18px}
.hv-dl>div{display:grid;grid-template-columns:96px minmax(0,1fr);gap:12px;align-items:baseline}
.hv-dl dt{font:600 12px/1.4 Poppins,system-ui,sans-serif;letter-spacing:.14em;text-transform:uppercase;color:#74501a}
.hv-dl dd{margin:0;font:400 16px/1.6 Poppins,system-ui,sans-serif}
.hv-hrs{list-style:none;margin:0;padding:0;display:grid;gap:4px}
.hv-hrs li{display:flex;flex-wrap:wrap;gap:2px 16px}
.hv-hrs li>span:first-child{min-width:5.5em}
.hv-t{font-variant-numeric:tabular-nums}
.hv-tel{display:inline-flex;align-items:center;min-height:44px;color:#1A1608;font-variant-numeric:tabular-nums;text-underline-offset:3px}
.hv-tel:focus-visible{outline:2px solid #C94716;outline-offset:3px;border-radius:4px}
.hv-btns{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:12px}
.hv-rate{grid-column:1/-1}
.hv-ele{grid-column:1/-1;margin:0 0 4px;display:flex;align-items:center;gap:clamp(14px,2vw,22px)}
.hv-ele img{flex:none;display:block;width:clamp(130px,16vw,200px);height:auto;aspect-ratio:640/582;object-fit:cover;border-radius:22px;box-shadow:0 10px 24px -14px rgba(26,22,8,.45)}
.hv-ele figcaption{font:italic 600 clamp(1.375rem,2.4vw,1.75rem)/1.2 'Playfair Display',serif;color:#1b3a26}
@media(max-width:899px){.hv{grid-template-columns:minmax(0,1fr)}}
@media(max-width:479px){.hv-btns{grid-template-columns:minmax(0,1fr)}.hv-dl>div{grid-template-columns:minmax(0,1fr);gap:2px}}
</style>
