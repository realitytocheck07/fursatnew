---
// "Visit & reserve": every fact comes from site.json. Lines still marked TODO(client) there are not shown.
import site from '../../data/site.json';

const real = (v?: string) => !!v && !v.startsWith('TODO');
const a = site.address;
const address = [real(a.line1) ? a.line1 : '', a.line2, `${a.state} ${a.pin}`].filter(Boolean).join(', ');
const schedule = site.hours.schedule;
const tel = `+${site.phonePlain}`;
const star = 'M12 2.6l2.9 6 6.6.9-4.8 4.6 1.2 6.5L12 17.4l-5.9 3.2 1.2-6.5L2.5 9.5l6.6-.9z';
const arrow = '<path d="M5 12h14M13 6l6 6-6 6"/>';
---
<section class="hv" id="plan-visit" aria-labelledby="hv-h">
  <div class="hv-l">
    <h2 class="fk-ty-h2" id="hv-h">Visit &amp; <span class="hv-hl">reserve</span></h2>
    <figure class="hv-ele"><div class="hv-elew"><img src="/assets/home/elephant-cocktail-480.webp" srcset="/assets/home/elephant-cocktail-480.webp 480w, /assets/home/elephant-cocktail-640.webp 640w" sizes="(min-width: 900px) 320px, 70vw" alt="Fursat elephant mascot holding a pink cocktail glass" width="640" height="582" loading="lazy" decoding="async" /></div><figcaption class="hv-cap">Table for one</figcaption></figure>
  </div>
  <div class="hv-card">
    <dl class="hv-dl">
      <div><dt>Address</dt><dd>{address}</dd></div>
      <div>
        <dt>Hours</dt>
        <dd>
          <ul class="hv-hrs">
            {schedule.map((s) => <li><span>{s.days}</span><span class="hv-t">{s.open} – {s.close}</span></li>)}
          </ul>
        </dd>
      </div>
      <div><dt>Phone</dt><dd><a class="hv-tel" href={`tel:${tel}`}>{site.phone}</a></dd></div>
    </dl>
    <div class="hv-btns">
    <button class="fk-btn fk-btn--primary" type="button" data-open="book">Reserve a table<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" set:html={arrow} /></button>
    <a class="fk-btn fk-btn--secondary" href={`https://wa.me/${site.phonePlain}?text=${encodeURIComponent("Hi Fursat! I have a question.")}`} target="_blank" rel="noopener">WhatsApp</a>
    <a class="fk-btn fk-btn--secondary" href={`tel:${tel}`}>Call</a>
    <a class="fk-btn fk-btn--secondary" href={a.googleMaps} target="_blank" rel="noopener">Directions</a>
    </div>
    <div class="hv-rev" id="rate-us">
      <div class="hv-rev-main">
        <p class="hv-rev-k">Loved your Fursat?</p>
        <a class="hv-stars" href={a.review} target="_blank" rel="noopener" aria-label="Rate Fursat on Google (opens in a new tab)">
          {[0, 1, 2, 3, 4].map((i) => (
            <svg class="hv-st" style={`--i:${i}`} viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path class="hv-st-b" d={star} /><path class="hv-st-l" d={star} /></svg>
          ))}
        </a>
        <a class="fk-btn fk-btn--secondary hv-rate" href={a.review} target="_blank" rel="noopener">
          <svg class="hv-g" viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path fill="currentColor" d="M12.2 10.2v3.9h5.5c-.2 1.4-1.7 4.1-5.5 4.1a6.2 6.2 0 010-12.4c2 0 3.3.9 4.1 1.6l2.7-2.6A9.8 9.8 0 0012.2 2a10 10 0 100 20c5.8 0 9.6-4 9.6-9.8 0-.7-.1-1.2-.2-2z"/></svg>
          Rate us on Google<span class="hv-sr"> (opens in a new tab)</span>
        </a>
      </div>
      <figure class="hv-qr">
        <img src="/assets/brand/google-review-qr.png" alt="QR code that opens the Fursat review page on Google" width="132" height="132" loading="lazy" decoding="async" />
        <figcaption>Scan with your phone</figcaption>
      </figure>
    </div>
  </div>
</section>

<style is:global>
.hv{background:radial-gradient(70% 55% at 100% 0%,#1f4326 0%,rgba(31,67,38,0) 70%),linear-gradient(180deg,#16301a,#0f2113);color:#1A1608;padding:clamp(36px,5vw,56px) clamp(16px,3vw,28px) clamp(40px,5vw,64px);display:grid;grid-template-columns:minmax(0,1fr) minmax(0,1fr);gap:clamp(24px,3.4vw,56px);align-items:center}
.hv-l{display:flex;flex-direction:column;gap:clamp(18px,2.4vw,28px);min-width:0}
.hv .fk-ty-h2{color:#fbf3e6;line-height:1.08;text-wrap:balance}
.hv-hl{font-style:italic;color:var(--fk-gold-300)}
.hv-ele{margin:0;display:flex;flex-direction:column;align-items:center;gap:14px}
.hv-elew{position:relative;width:min(100%,320px);aspect-ratio:4/4.6;margin:6px;display:grid;place-items:end center;border-radius:999px 999px 18px 18px;background:#fbf3e6;outline:1px solid rgba(201,154,67,.85);outline-offset:5px;box-shadow:0 18px 30px -18px rgba(0,0,0,.6);overflow:hidden}
.hv-elew img{display:block;width:88%;height:auto;max-height:100%;object-fit:contain}
.hv-cap{margin:0;font:italic 600 clamp(1.375rem,2.4vw,1.75rem)/1.2 'Playfair Display',serif;color:var(--fk-gold-300)}
.hv-card{display:flex;flex-direction:column;gap:18px;min-width:0;padding:clamp(18px,2.6vw,28px);border-radius:24px;background:#fbf3e6;box-shadow:0 24px 40px -24px rgba(0,0,0,.7)}
.hv-dl{margin:0;display:grid;gap:14px}
.hv-dl>div{display:grid;grid-template-columns:96px minmax(0,1fr);gap:12px;align-items:baseline;padding-bottom:14px;border-bottom:1px solid rgba(20,48,28,.16)}
.hv-dl>div:last-child{border-bottom:0;padding-bottom:0}
.hv-dl dt{font:600 12px/1.4 Rupee,Poppins,system-ui,sans-serif;letter-spacing:.14em;text-transform:uppercase;color:#74501a}
.hv-dl dd{margin:0;font:400 16px/1.6 Rupee,Poppins,system-ui,sans-serif}
.hv-hrs{list-style:none;margin:0;padding:0;display:grid;gap:4px}
.hv-hrs li{display:flex;flex-wrap:wrap;gap:2px 16px}
.hv-hrs li>span:first-child{min-width:5.5em}
.hv-t{font-variant-numeric:tabular-nums}
.hv-tel{display:inline-flex;align-items:center;min-height:44px;color:#1A1608;font-variant-numeric:tabular-nums;text-underline-offset:3px}
.hv-tel:focus-visible{outline:2px solid #C94716;outline-offset:3px;border-radius:4px}
.hv-btns{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:12px}
.hv-btns>.fk-btn:first-child{grid-column:1/-1}
.hv .fk-btn{transition:transform .2s}
.hv .fk-btn:active{transform:scale(.97)}
@media(hover:hover){.hv .fk-btn:hover{transform:translateY(-2px)}}
.hv .hv-btns .fk-btn--primary{background:#C94716;border-color:#C94716;color:#fff}
.hv .fk-btn--secondary{background:transparent;border-color:rgba(20,48,28,.55);color:#14301c}
@media(max-width:599px){.hv-btns{grid-template-columns:repeat(2,minmax(0,1fr))}.hv-btns>.fk-btn:last-child{grid-column:1/-1}}
.hv-rev{scroll-margin-top:96px;display:flex;align-items:center;justify-content:space-between;gap:16px;padding:16px 0 0;border-top:1px solid rgba(20,48,28,.16)}
.hv-rev-main{display:flex;flex-direction:column;align-items:flex-start;gap:6px;min-width:0}
.hv-rev-k{margin:0;font:600 12px/1.4 Rupee,Poppins,system-ui,sans-serif;letter-spacing:.14em;text-transform:uppercase;color:#74501a}
.hv-stars{display:inline-flex;gap:2px;min-height:44px;align-items:center;border-radius:999px;text-decoration:none;-webkit-tap-highlight-color:transparent}
.hv-stars:focus-visible{outline:2px solid #C94716;outline-offset:3px}
.hv-st{display:block;width:34px;height:34px;overflow:visible;flex:none}
.hv-st-b{fill:#f3e3b8;stroke:#c99a43;stroke-width:1.2;stroke-linejoin:round}
.hv-st-l{fill:#f3c56b;stroke:#c99a43;stroke-width:1.2;stroke-linejoin:round;opacity:0;transform-origin:50% 55%;transform:scale(.82)}
.hv-stars:focus-visible .hv-st-l{opacity:1;transform:none;transition:opacity .22s ease-out calc(var(--i)*75ms),transform .22s ease-out calc(var(--i)*75ms)}
@media(hover:hover){.hv-stars:hover .hv-st-l{opacity:1;transform:none;transition:opacity .22s ease-out calc(var(--i)*75ms),transform .22s ease-out calc(var(--i)*75ms)}}
.hv-rate{gap:10px}
.hv-g{width:18px;height:18px;flex:none}
.hv-sr{position:absolute;width:1px;height:1px;overflow:hidden;clip:rect(0 0 0 0);white-space:nowrap}
.hv-qr{display:none;margin:0}
@media(min-width:900px){
  .hv-qr{display:flex;flex-direction:column;align-items:center;gap:6px;flex:none}
  .hv-qr img{display:block;width:112px;height:112px;padding:6px;background:#fffaf0;border:2px solid #c99a43;border-radius:14px;image-rendering:pixelated;image-rendering:crisp-edges}
  .hv-qr figcaption{font:600 10px/1.3 Rupee,Poppins,system-ui,sans-serif;letter-spacing:.1em;text-transform:uppercase;color:#74501a}
}
@media(max-width:899px){.hv{grid-template-columns:minmax(0,1fr)}}
@media(max-width:479px){.hv-btns{grid-template-columns:minmax(0,1fr)}.hv-dl>div{grid-template-columns:minmax(0,1fr);gap:2px}}
</style>
