---
// Drinks video intro. The overlay and the <video> are created by /js/drinks-intro.js on the first
// Drinks open per visit; nothing here loads the video. No JS = no intro.
---
<script is:inline src="/js/drinks-intro.js" defer></script>
<style is:global>
  .di{position:fixed;inset:0;z-index:10000;background:#0b0705;opacity:0;transition:opacity 200ms linear;cursor:pointer;overflow:hidden;touch-action:manipulation}
  .di.is-on{opacity:1}
  .di.is-out{opacity:0;transition-duration:600ms;pointer-events:none}
  .di video{position:absolute;inset:0;width:100%;height:100%;object-fit:cover;display:block}
  .di-skip{position:absolute;top:max(14px,env(safe-area-inset-top));right:max(14px,env(safe-area-inset-right));min-height:44px;min-width:44px;padding:0 20px;display:inline-flex;align-items:center;gap:8px;border:1px solid rgb(255 226 166 / .55);border-radius:999px;background:rgb(11 7 5 / .6);color:#F6EDDF;font:500 14px/1 var(--fk-font-ui,'Poppins',system-ui,sans-serif);letter-spacing:.04em;cursor:pointer;-webkit-backdrop-filter:blur(6px);backdrop-filter:blur(6px)}
  .di-skip:hover{background:rgb(11 7 5 / .82)}
  .di-skip:focus-visible{outline:2px solid #f3c56b;outline-offset:3px}
  @media (prefers-reduced-motion:reduce){.di,.di.is-out{transition:none}}
</style>
