---
import { rowHtml, type RowRec, type RowCtx } from './dish-row';
// One dish in the full menu, rendered by dish-row.ts (the same function menu-v2.ts uses for the groups it fills in on demand).
// Hooks the menu script reads: [data-row], .mv-open, .mv-iname, .mv-idesc, .mv-note, .mv-item-price, .fk-chip, [data-add].
interface Props { rec: RowRec; ctx: RowCtx }
const { rec, ctx } = Astro.props as Props;
---
<Fragment set:html={rowHtml(rec, ctx)} />
