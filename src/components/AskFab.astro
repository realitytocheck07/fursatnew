---
// AskFab — the "Ask Fursat" mascot button on every page (not on /ask). Plays a lively Super-Mario routine (more hops, spin and back-flip jumps, triple coins + sparkles, a power jump every 3rd section): drops in on Home after the intro,
// hops now and then, hops when scrolling starts, jumps + coin + a tiny hint when a new main section arrives, and jumps big on tap.
// Page-aware: opens /ask with a starting question that fits the page the guest is on.
// Motion is CSS transform only. Reduced motion: static, no bubbles except on tap. No sound.
const path = Astro.url.pathname.replace(/\/$/, '') || '/';
const HINTS: Record<string, string> = {
  '/cafe': 'coffee and desserts',
  '/restaurant-bar': 'cocktails and starters',
  '/banquet': 'party starters',
  '/party': 'party starters',
  '/catering': 'biryani for a group',
  '/reserve': 'dinner for two',
};
const q = HINTS[path];
const href = q ? `/ask?q=${encodeURIComponent(q)}` : '/ask';
const show = path !== '/ask' && path !== '/404';
const tip = q ? `Ask Fursat: ${q}` : 'Ask Fursat what to eat or drink';
// the hint bubble each kind of section gets (the page's own default comes from its path)
const BUBBLES = { menu: 'Hungry? 🍛', party: 'Party plans? 🎉', bar: 'Cricket tonight? 🏏' /* TODO(client): confirm the cricket line */, cafe: 'Coffee break? ☕', any: 'Ask me anything!' };
const PAGE_KEY: Record<string, string> = { '/menu': 'menu', '/banquet': 'party', '/party': 'party', '/restaurant-bar': 'bar', '/cafe': 'cafe' };
---
{show && (
  <a class="afab" href={href} aria-label={tip} data-fk-ask data-home={path === '/' ? '' : undefined} data-page-key={PAGE_KEY[path] || 'any'} data-bubbles={JSON.stringify(BUBBLES)}>
    <img class="afab-img" src="/assets/ask-mascot-sm.webp" alt="" width="56" height="56" decoding="async" loading="lazy" data-cheer="/assets/ask-mascot-cheer-sm.webp" />
    <span class="afab-t"><b>Ask</b> <span translate="no">Fursat</span></span>
    {q && <span class="afab-q">{q}</span>}
    <span class="afab-coin" aria-hidden="true"></span><span class="afab-coin c2" aria-hidden="true"></span><span class="afab-coin c3" aria-hidden="true"></span>
    <span class="afab-spk" aria-hidden="true"><i style="--sx:-30px;--sy:-34px"></i><i style="--sx:0px;--sy:-46px"></i><i style="--sx:30px;--sy:-34px"></i><i style="--sx:-42px;--sy:-8px"></i><i style="--sx:42px;--sy:-8px"></i><i style="--sx:0px;--sy:-24px"></i></span>
    <span class="afab-bub" aria-hidden="true"></span>
  </a>
  <script is:inline>
  (() => {
    const a = document.querySelector('[data-fk-ask]');
    if (!a) return;
    const img = a.querySelector('.afab-img'), bub = a.querySelector('.afab-bub');
    const reduce = matchMedia('(prefers-reduced-motion: reduce)');
    const B = JSON.parse(a.dataset.bubbles || '{}');
    const home = a.hasAttribute('data-home');
    let live = !home;                  // Home waits for the intro; other pages are live straight away
    let inFooter = false, lastHop = 0, lastJump = 0, lastBubble = -1e9, lastSection = '', bt = 0, idleT = 0, scrolling = 0, cheerOn = false, combo = 0;
    const store = (k, v) => { try { if (v === undefined) return sessionStorage.getItem(k); sessionStorage.setItem(k, v); } catch (e) {} };
    const typing = () => { const e = document.activeElement; return !!e && (/^(INPUT|TEXTAREA|SELECT)$/.test(e.tagName) || e.isContentEditable); };
    const visible = () => !document.hidden && !a.hasAttribute('data-hold') && getComputedStyle(a).visibility !== 'hidden' && !typing() && !document.querySelector('dialog[open]');
    const swap = (cheer) => { if (!img || cheerOn === cheer) return; cheerOn = cheer; if (cheer) { img.dataset.src = img.src; img.src = img.dataset.cheer; } else img.src = img.dataset.src || img.src; };
    // play one move: drop | hop | jump | big | tilt | spin | flip | power. Class is removed when it ends so the next one can restart.
    const play = (name, cheer) => {
      if (reduce.matches && name !== 'big') return;
      a.classList.remove('m-drop', 'm-hop', 'm-jump', 'm-big', 'm-tilt', 'm-spin', 'm-flip', 'm-power'); void a.offsetWidth;
      a.classList.add('m-' + name); lastHop = performance.now();
      swap(!!cheer);
    };
    a.addEventListener('animationend', (e) => { if (e.target !== a) return; a.className = a.className.replace(/\bm-\w+/g, '').trim(); swap(false); });
    const coin = () => { if (reduce.matches) return; a.classList.remove('m-coin'); void a.offsetWidth; a.classList.add('m-coin'); setTimeout(() => a.classList.remove('m-coin'), 1100); };
    const say = (text, force) => {
      const now = performance.now();
      if (!force && (reduce.matches || now - lastBubble < 6000 || typing())) return;
      lastBubble = now; bub.textContent = text; a.classList.add('m-say'); clearTimeout(bt);
      bt = setTimeout(() => a.classList.remove('m-say'), 2000);
    };
    // --- Home: drop in once the intro is gone (heli / intro / gate / lcap are the intro's elements) ---
    const introOn = () => document.documentElement.classList.contains('lock') || ['heli', 'intro', 'gate', 'lcap'].some((i) => document.getElementById(i));
    // During the intro the pill sits at the left in elephant red (is-intro). When the intro ends it hops from there to its normal place (FLIP, transform only).
    const inIntro = home && introOn();
    if (inIntro) a.classList.add('is-intro');
    const enter = () => {
      live = true; a.setAttribute('data-early', '');
      if (inIntro) {
        const f = a.getBoundingClientRect(); a.classList.remove('is-intro'); const l = a.getBoundingClientRect();
        const dx = f.left - l.left, dy = f.top - l.top; store('fk-ask-drop', '1');
        if (!reduce.matches && (dx || dy)) a.animate([
          { transform: `translate(${dx}px, ${dy}px) scale(1, 1)`, offset: 0 },
          { transform: `translate(${dx * .5}px, ${dy * .5 - 70}px) scale(.94, 1.08)`, offset: .45, easing: 'cubic-bezier(.77,0,.175,1)' },
          { transform: 'translate(0, 0) scale(1.1, .88)', offset: .85, easing: 'cubic-bezier(.23,1,.32,1)' },
          { transform: 'translate(0, 0) scale(1, 1)', offset: 1 },
        ], { duration: 950, easing: 'cubic-bezier(.23,1,.32,1)' });
      } else if (store('fk-ask-drop') !== '1' && !reduce.matches) { store('fk-ask-drop', '1'); play('drop'); }
      else store('fk-ask-drop', '1');
      arm();
    };
    if (home) { const iv = setInterval(() => { if (!introOn()) { clearInterval(iv); enter(); } }, 400); } else arm();
    // --- idle hop / tilt every 8-10 s ---
    function idle() {
      clearTimeout(idleT);
      idleT = setTimeout(() => { if (live && visible() && performance.now() - lastHop > 3000) { const r = Math.random(); play(r < .35 ? 'hop' : r < .6 ? 'spin' : r < .8 ? 'flip' : 'tilt'); if (r > .6 && r < .8) coin(); } idle(); }, 4000 + Math.random() * 2000);
    }
    function arm() {
      if (arm.done) return; arm.done = true;
      if (!reduce.matches) idle();
      // scroll start: one small hop
      addEventListener('scroll', () => {
        if (!scrolling && live && visible() && performance.now() - lastHop > 900 && performance.now() - lastJump > 900) play(Math.random() < .5 ? 'hop' : 'spin');
        scrolling = 1; clearTimeout(arm.st); arm.st = setTimeout(() => { scrolling = 0; }, 200);
      }, { passive: true });
      // a new main section comes into view: jump + coin + hint (one hint per 12 s)
      if (!('IntersectionObserver' in window)) return;
      const keyOf = (s) => {
        const t = ((s.id || '') + ' ' + (s.getAttribute('aria-labelledby') || '') + ' ' + s.className).toLowerCase();
        if (/season|menu|dish|food|biryani/.test(t)) return 'menu';
        if (/celebr|banquet|party|event/.test(t)) return 'party';
        if (/\bbar\b|cricket|social|cocktail/.test(t)) return 'bar';
        if (/caf[eé]|coffee|dessert/.test(t)) return 'cafe';
        return a.dataset.pageKey || 'any';
      };
      const io = new IntersectionObserver((es) => {
        for (const e of es) {
          if (!e.isIntersecting || !live) continue;
          const id = e.target.id || e.target.className;
          if (id === lastSection) continue;
          const first = !lastSection; lastSection = id;
          if (first || !visible() || performance.now() - lastJump < 900) continue; // the section already on screen at load does not count
          lastJump = performance.now(); combo++; play(combo % 3 === 0 ? 'power' : combo % 2 ? 'jump' : 'flip', true); coin(); say(B[keyOf(e.target)] || B.any);
        }
      }, { rootMargin: '-35% 0px -35% 0px' });
      document.querySelectorAll('main > section, main section[id]').forEach((s) => io.observe(s));
    }
    // --- hold while the footer is in view or a sticky panel sits in the corner (same rule as the Instagram button) ---
    const hold = () => {
      let h = inFooter;
      if (!h) for (const el of document.querySelectorAll('[data-fab-avoid], #pa-plan')) {
        const r = el.getBoundingClientRect();
        if (r.left < 260 && r.bottom > innerHeight - 170 && r.top < innerHeight) { h = true; break; }
      }
      a.toggleAttribute('data-hold', h);
    };
    addEventListener('scroll', hold, { passive: true }); addEventListener('resize', hold, { passive: true });
    const foot = document.querySelector('.sf-footer');
    if (foot && 'IntersectionObserver' in window) new IntersectionObserver((es) => { inFooter = es[es.length - 1].isIntersecting; hold(); }, { rootMargin: '0px 0px -150px 0px' }).observe(foot);
    // --- Mario routine: one rAF loop (runs only while a move plays). Walk along the bottom edge and back, sit, or peek off the edge.
    //     The pill moves with --wx (CSS `translate`); bob / lean / flip / squash go on the image. Transform only. Static under reduced motion. ---
    const img2 = img, rnd = (x, y) => x + Math.random() * (y - x), phone = () => innerWidth < 768;
    const ease = (t) => (t < .5 ? 2 * t * t : 1 - Math.pow(-2 * t + 2, 2) / 2), cl = (v, x, y) => Math.max(x, Math.min(y, v));
    let st = null, wx = 0, nextAt = performance.now() + rnd(8000, 15000), raf = 0, prev = 0, lastScroll = -1e9, face = 1, phase = 0, chk = 0;
    addEventListener('scroll', () => { lastScroll = performance.now(); }, { passive: true });
    const paused = () => !live || reduce.matches || document.hidden || a.hasAttribute('data-hold') || a.classList.contains('is-intro') || !(a.classList.contains('is-on') || a.hasAttribute('data-early'))
      || typing() || !!document.querySelector('dialog[open], [aria-modal="true"]') || document.documentElement.classList.contains('fk-sheet-open') || document.documentElement.classList.contains('lock')
      || /\bm-/.test(a.className) || a.matches(':active') || performance.now() - lastScroll < 600;
    // is the strip the mascot would cover at offset dx free of links / buttons?
    const spotFree = (dx, r) => {
      const bl = r.left - wx, L = bl + dx - 6, R = bl + dx + r.width + 6, T = r.top - 6, B = r.bottom + 6;
      for (const el of document.querySelectorAll('a, button')) {
        if (el === a || a.contains(el)) continue;
        const q = el.getBoundingClientRect();
        if (!q.width || !q.height || q.right < L || q.left > R || q.bottom < T || q.top > B) continue;
        if (getComputedStyle(el).visibility === 'hidden') continue;
        return false;
      }
      return true;
    };
    const pathFree = (to, r) => { const n = Math.max(1, Math.ceil(Math.abs(to - wx) / 48)); for (let i = 1; i <= n; i++) if (!spotFree(wx + (to - wx) * i / n, r)) return false; return true; };
    const draw = (bob, lean, sx, sy, ty) => {
      a.style.setProperty('--wx', wx.toFixed(1) + 'px');
      img2.style.transform = `translateY(${(ty + bob).toFixed(1)}px) rotate(${lean.toFixed(1)}deg) scale(${(face * sx).toFixed(3)}, ${sy.toFixed(3)})`;
    };
    const rest = () => { wx = 0; a.style.removeProperty('--wx'); img2.style.transform = ''; a.classList.remove('is-roam'); st = null; nextAt = performance.now() + rnd(8000, 15000); };
    const plan = () => {
      const r = a.getBoundingClientRect(), side = phone() ? -1 : 1, roll = Math.random();           // base is at the right on phones, at the left on desktop: walk toward the middle
      if (roll < .55) {
        let d = phone() ? Math.min(rnd(110, 220), innerWidth * .55) : Math.min(rnd(260, Math.max(300, innerWidth - r.width - 80)), innerWidth - r.width - 80);
        while (d > 70 && !pathFree(side * d, r)) d *= .75;
        if (d <= 70 || !pathFree(side * d, r)) { nextAt = performance.now() + 3000; return; }
        const dur = phone() ? rnd(2000, 3000) : rnd(2400, 4000);
        st = { k: 'walk', legs: [{ f: 0, t: side * d, dur }, { f: side * d, t: side * d, dur: 500 }, { f: side * d, t: 0, dur }], i: 0, t: 0, dir: side };
      } else if (roll < .8) st = { k: 'sit', t: 0, dur: rnd(6000, 10000) };
      else st = { k: 'peek', t: 0, dur: 2400, out: (phone() ? 1 : -1) * (r.width / 2 + 14) };
      a.classList.add('is-roam'); prev = 0; raf = requestAnimationFrame(frame);
    };
    function frame(now) {
      if (!st) return;
      const dt = prev ? Math.min(now - prev, 50) : 0; prev = now;
      if (paused()) { raf = requestAnimationFrame(frame); return; }                                   // freeze in place while typing / dialog / sheet / footer
      st.t += dt;
      if (st.k === 'walk') {
        let g = st.legs[st.i];
        if (st.t >= g.dur) { st.i++; st.t = 0; if (st.i > 2) { rest(); return; } g = st.legs[st.i]; }
        const p = ease(cl(st.t / g.dur, 0, 1)); wx = g.f + (g.t - g.f) * p;
        const moving = g.f !== g.t; if (moving) { phase += dt / 260; face = (g.t - g.f) > 0 ? 1 : -1; }
        draw(moving ? -Math.abs(Math.sin(phase * Math.PI)) * 4 : 0, moving ? face * 3 : 0, 1, 1, 0);
        if (moving && now - chk > 300) { chk = now; const r = a.getBoundingClientRect(), ahead = wx + face * 70; if (st.i === 0 && !spotFree(ahead, r)) { st.legs[2] = { f: wx, t: 0, dur: Math.max(900, Math.abs(wx) / Math.abs(st.legs[0].t) * st.legs[0].dur) }; st.i = 2; st.t = 0; } }
      } else if (st.k === 'sit') {
        const e = Math.min(1, st.t / 300, (st.dur - st.t) / 300);                                        // squash down, swing, stand up
        draw(0, Math.sin(st.t / 650) * 4 * e, 1 + .06 * e, 1 - .12 * e, 4 * e);
        if (st.t >= st.dur) { rest(); play('power'); coin(); return; }
      } else {
        const u = st.t / st.dur, o = u < .19 ? ease(u / .19) : u < .73 ? 1 : 1 - ease((u - .73) / .27);   // slide half off the edge, hold, peek back in
        wx = st.out * o; face = st.out > 0 ? -1 : 1;
        draw(0, (u > .73 ? -st.out / Math.abs(st.out) * 5 * (1 - o) : 0), 1, 1, 0);
        if (st.t >= st.dur) { rest(); return; }
      }
      raf = requestAnimationFrame(frame);
    }
    if (!reduce.matches) setInterval(() => { if (!st && performance.now() >= nextAt) { if (paused() || document.querySelector('.afab-bub') && a.classList.contains('m-say')) { nextAt = performance.now() + 3000; } else plan(); } }, 1000);
    // --- tap: big jump + "Ask me anything!", then open Ask as today ---
    a.addEventListener('click', (e) => {
      if (e.defaultPrevented || e.button || e.metaKey || e.ctrlKey || e.shiftKey || e.altKey || a.dataset.go) return;
      e.preventDefault(); a.dataset.go = '1'; st = null;
      play('big', true); coin(); say(B.any, true);
      setTimeout(() => { location.href = a.href; }, 260);
    });
    addEventListener('pageshow', () => { delete a.dataset.go; });
  })();
  </script>
)}
<style>
.afab { position: fixed; left: 20px; bottom: calc(20px + var(--fab-lift, 0px)); z-index: 8500; display: none; align-items: center; gap: 10px; padding: 6px 18px 6px 6px; border-radius: 999px; background: linear-gradient(180deg, #1f4129 0%, #13301d 100%); color: #f6ecd8; text-decoration: none; box-shadow: 0 14px 30px -14px rgb(10 30 18 / .7), inset 0 0 0 1px rgb(243 197 107 / .35); font: 500 .9rem/1.1 Poppins, system-ui, sans-serif; transform-origin: 50% 100%; transition-property: transform, box-shadow, opacity, translate, visibility; transition-duration: 200ms, 200ms, 300ms, 300ms, 0s; transition-timing-function: cubic-bezier(.23,1,.32,1); -webkit-tap-highlight-color: transparent; }
.afab-img { width: 44px; height: 44px; border-radius: 50%; background: #f6e4c9; object-fit: cover; }
.afab-t b { color: #f3c56b; font-weight: 600; }
.afab-q { display: block; max-width: 0; overflow: hidden; white-space: nowrap; opacity: 0; color: #d9c9a6; font-size: .78rem; transition-property: max-width, opacity, margin; transition-duration: 320ms; transition-timing-function: cubic-bezier(.23,1,.32,1); }
.afab:focus-visible { outline: 3px solid #f3c56b; outline-offset: 3px; }
.afab:active { transform: scale(.96); }
/* phones: the mascot alone, on the right (the left corner is the Instagram button), above the bottom bar */
.afab { display: inline-flex; left: auto; right: 12px; bottom: calc(84px + env(safe-area-inset-bottom) + var(--fab-lift, 0px)); padding: 2px; gap: 0; }
.afab-t, .afab-q { position: absolute; width: 1px; height: 1px; overflow: hidden; clip-path: inset(50%); white-space: nowrap; }
@media (min-width: 768px) { .afab { left: 20px; right: auto; bottom: calc(20px + var(--fab-lift, 0px)); padding: 6px 18px 6px 6px; gap: 10px; } .afab-t { position: static; width: auto; height: auto; overflow: visible; clip-path: none; } .afab-q { position: static; width: auto; height: auto; clip-path: none; } }
/* tablet: just the mascot, so it covers less of the page (the label stays for screen readers) */
@media (min-width: 768px) and (max-width: 1023px) {
  .afab { padding: 4px; gap: 0; }
  .afab-t, .afab-q { position: absolute; width: 1px; height: 1px; overflow: hidden; clip-path: inset(50%); white-space: nowrap; }
}
/* shows once the guest scrolls past the first screen (the InstaFab script sets is-on), so it never covers a hero's buttons; it fades out again while the footer is in view.
   On Home it is live from the end of the intro (data-early) and only steps aside for the footer / a sticky panel (data-hold). */
:global(html.fab-js) .afab:not(.is-on) { opacity: 0; visibility: hidden; pointer-events: none; translate: 0 12px; transition-delay: 0s, 0s, 0s, 0s, 300ms; }
:global(html.fab-js) .afab[data-early]:not([data-hold]) { opacity: 1; visibility: visible; pointer-events: auto; translate: var(--wx, 0px) 0; transition-delay: 0s; }
.afab { translate: var(--wx, 0px) 0; }
.afab.is-roam { transition-property: transform, box-shadow, opacity, visibility; } /* no easing lag on translate while walking */
.afab-img { will-change: auto; transform-origin: 50% 100%; }
@media (hover: hover) and (pointer: fine) {
  .afab:hover { transform: translateY(-2px); box-shadow: 0 18px 34px -14px rgb(10 30 18 / .75), inset 0 0 0 1px rgb(243 197 107 / .55); }
  .afab:hover .afab-q, .afab:focus-visible .afab-q { max-width: 220px; opacity: 1; margin-left: 2px; }
}
@media (hover: hover) and (pointer: fine) and (max-width: 1023px) { .afab:hover .afab-q { max-width: 0; opacity: 0; margin-left: 0; } }

/* ---- in the intro (Home, before the site opens): red pill at the left with the label, above the intro layers; never over Enter / Skip / Sound ---- */
.afab::before { content: ''; position: absolute; inset: 0; z-index: -1; border-radius: inherit; background: #c02a1a; opacity: 0; pointer-events: none; transition: opacity 600ms cubic-bezier(.23,1,.32,1); }
:global(html.fab-js) .afab.is-intro { display: inline-flex; left: 14px; right: auto; bottom: calc(10px + env(safe-area-inset-bottom, 0px)); z-index: 2147482998; padding: 5px 18px 5px 5px; gap: 8px; opacity: 1; visibility: visible; pointer-events: auto; translate: none; color: #f6ecd8; }
@media (max-width: 767px) { :global(html.fab-js) .afab.is-intro { bottom: calc(11svh + 90px + env(safe-area-inset-bottom, 0px)); } } /* phones: in the band above the Enter button, clear of the nav bar */
.afab.is-intro::before { opacity: 1; }
.afab.is-intro { box-shadow: 0 14px 30px -14px rgb(10 0 0 / .7), inset 0 0 0 1.5px rgb(246 236 216 / .6); }
.afab.is-intro .afab-t { position: static; width: auto; height: auto; overflow: visible; clip-path: none; }
.afab.is-intro .afab-t b { color: #f6ecd8; }
.afab.is-intro .afab-q { display: none; }

/* ---- Mario moves: transform only, origin at the feet. Curves from the motion tokens (ease-out; ease-in-out for the fall) ---- */
.afab.m-drop { animation: afab-drop 1150ms both; }
.afab.m-hop { animation: afab-hop 480ms cubic-bezier(.23,1,.32,1) both; }
.afab.m-jump { animation: afab-jump 560ms cubic-bezier(.23,1,.32,1) both; }
.afab.m-big { animation: afab-big 620ms cubic-bezier(.23,1,.32,1) both; }
.afab.m-tilt { animation: afab-tilt 700ms cubic-bezier(.23,1,.32,1) both; }
.afab.m-spin { animation: afab-spin 760ms cubic-bezier(.23,1,.32,1) both; }
.afab.m-flip { animation: afab-flip 820ms cubic-bezier(.23,1,.32,1) both; }
.afab.m-power { animation: afab-power 1100ms cubic-bezier(.23,1,.32,1) both; }
@keyframes afab-drop {
  0% { transform: translateY(calc(-100vh - 120px)) scale(1, 1); animation-timing-function: cubic-bezier(.77,0,.175,1); }
  52% { transform: translateY(0) scale(.9, 1.14); animation-timing-function: cubic-bezier(.23,1,.32,1); }
  62% { transform: translateY(0) scale(1.22, .72); animation-timing-function: cubic-bezier(.23,1,.32,1); }
  74% { transform: translateY(-14px) scale(.93, 1.1); animation-timing-function: cubic-bezier(.23,1,.32,1); }
  84% { transform: translateY(0) scale(1.06, .94) rotate(-7deg); animation-timing-function: cubic-bezier(.23,1,.32,1); }
  92% { transform: translateY(0) scale(1) rotate(7deg); animation-timing-function: cubic-bezier(.23,1,.32,1); }
  100% { transform: translateY(0) scale(1) rotate(0); }
}
@keyframes afab-hop {
  0% { transform: translateY(0) scale(1, 1); }
  18% { transform: translateY(0) scale(1.1, .88); }
  50% { transform: translateY(-26px) scale(.94, 1.1); }
  80% { transform: translateY(0) scale(1.08, .92); }
  100% { transform: translateY(0) scale(1, 1); }
}
@keyframes afab-jump {
  0% { transform: translateY(0) scale(1, 1); }
  16% { transform: translateY(0) scale(1.14, .84); }
  46% { transform: translateY(-40px) scale(.92, 1.14); }
  78% { transform: translateY(0) scale(1.1, .9); }
  100% { transform: translateY(0) scale(1, 1); }
}
@keyframes afab-big {
  0% { transform: translateY(0) scale(1, 1); }
  14% { transform: translateY(0) scale(1.18, .8); }
  46% { transform: translateY(-60px) scale(.9, 1.18); }
  80% { transform: translateY(0) scale(1.12, .88); }
