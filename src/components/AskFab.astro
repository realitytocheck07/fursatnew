---
// AskFab: the "Ask Fursat" mascot, always with the guest (not on /ask). It never hides for a button or a field: it DOCKS (44px avatar) at the nearest free spot,
// and only steps away while a dialog is open. One hint bubble per [data-ask-hint] section (3 s, once per visit). Page-aware: opens /ask with a question that fits.
// Motion: float, blink, hop when scrolling stops, lean while scrolling, wave on a new section, tap sparkles, sleepy after 25 s. WAAPI, transform/opacity only. No sound.
const path = Astro.url.pathname.replace(/\/$/, '') || '/';
const HINTS: Record<string, string> = {
  '/cafe': 'coffee and desserts',
  '/restaurant-bar': 'cocktails and starters',
  '/banquet': 'party starters',
  '/party': 'party starters',
  '/catering': 'biryani for a group',
  '/reserve': 'dinner for two',
  '/order': 'what to order',
};
const q = HINTS[path];
const href = q ? `/ask?q=${encodeURIComponent(q)}` : '/ask';
const show = path !== '/ask' && path !== '/404';
const tip = q ? `Ask Fursat: ${q}` : 'Ask Fursat what to eat or drink';
---
{show && (
  <a class="afab" href={href} aria-label={tip} data-fk-ask data-home={path === '/' ? '' : undefined}>
    <img class="afab-img" src="/assets/ask-mascot-sm.webp" alt="" width="56" height="56" decoding="async" loading="lazy" />
    <span class="afab-eq" aria-hidden="true"><i style="--a:-72deg;--b:var(--fk-b3,0)"></i><i style="--a:-60deg;--b:var(--fk-b1,0)"></i><i style="--a:-48deg;--b:var(--fk-b0,0)"></i><i style="--a:-36deg;--b:var(--fk-b2,0)"></i><i style="--a:-24deg;--b:var(--fk-b4,0)"></i><i style="--a:24deg;--b:var(--fk-b4,0)"></i><i style="--a:36deg;--b:var(--fk-b2,0)"></i><i style="--a:48deg;--b:var(--fk-b0,0)"></i><i style="--a:60deg;--b:var(--fk-b1,0)"></i><i style="--a:72deg;--b:var(--fk-b3,0)"></i></span>
    <span class="afab-t"><b>Ask</b> <span translate="no">Fursat</span></span>
    {q && <span class="afab-q">{q}</span>}
    <span class="afab-spk" aria-hidden="true"><i></i><i></i><i></i><i></i><i></i><i></i></span>
    <span class="afab-bub" aria-hidden="true"></span>
  </a>
  <script is:inline>
  (() => {
    const a = document.querySelector('[data-fk-ask]');
    if (!a) return;
    const R = document.documentElement, img = a.querySelector('.afab-img'), bub = a.querySelector('.afab-bub'), spk = [...a.querySelectorAll('.afab-spk i')];
    const base = a.getAttribute('href'), home = a.hasAttribute('data-home'), ph = () => R.clientWidth < 768, now = () => performance.now();
    const SP = 'cubic-bezier(.34,1.56,.64,1)', OUT = 'cubic-bezier(.19,1,.22,1)';
    const store = (k, v) => { try { if (v === undefined) return sessionStorage.getItem(k); sessionStorage.setItem(k, v); } catch (e) {} };
    const typing = () => { const e = document.activeElement; return !!e && (/^(INPUT|TEXTAREA|SELECT)$/.test(e.tagName) || e.isContentEditable); };
    let live = !home, dock = 0, cur = null, pt = 0, lastPlace = 0, lastHop = -1e9, lastAct = now(), sleep = null, bt = 0, st = 0, tilt = 0, moved = 0, natW = 0, natH = 0, lastSec = '';
    const seen = new Set(), ly = new WeakMap(), pend = new Map();

    // ---- where is Ask free? Hit-test a few points of a box: the top thing there must not be a button, field, tile or bar ----
    const BLK = 'button,input,textarea,select,summary,label,[role=button],[class*=btn],[class*=fl-go],.fe-actions,.mb-bar,#pb-bar,#pb-dock,#fxsticky';
    const hit = (x, y) => { for (const el of document.elementsFromPoint(x, y)) { if (a.contains(el)) continue; const m = el.closest(BLK); if (!m) return false; const q = m.getBoundingClientRect(); return !(q.width > R.clientWidth * .6 && q.height > R.clientHeight * .45); } return false; };   // a "button" as big as the screen (a Menu door) is the page, not a control
    // score = how many sample points of the box hit a button / field / bar. `max` stops the count early (1 = "is anything there?"), so a blocked spot costs one hit-test, not thirty-six.
    const score = (x, y, w, h, max = 1e9) => {
      const W = R.clientWidth, H = R.clientHeight, c = Math.min(9, Math.ceil(w / 14) + 1), r = Math.ceil(h / 14) + 1; let n = 0;   // a point every ~14px, so a thin chip or bar cannot slip between samples
      for (let i = 0; i < c; i++) for (let j = 0; j < r; j++) {
        const px = x - 6 + (w + 12) * i / (c - 1), py = y - 6 + (h + 12) * j / (r - 1);   // 6px safety margin around the box
        if (px >= 0 && py >= 0 && px < W && py < H && hit(px, py) && ++n >= max) return n;
      }
      return n;
    };
    const scan = (list) => { let best = null, bs = 1e9; for (const [x, y] of list) { const s = score(x, y, 44, 44, bs); if (s < bs) { bs = s; best = { x, y }; if (!s) break; } } return best; };
    // a dialog is open (it traps focus): the only time Ask steps away completely
    let modals = null, modalsAt = -1e9;   // [aria-modal] list cached for 1 s (it was queried on every place())
    const hidden = () => {
      if (R.classList.contains('lock') || R.classList.contains('fk-sheet-open') || document.querySelector('dialog[open]')) return true;
      if (now() - modalsAt > 1000) { modals = document.querySelectorAll('[aria-modal="true"]'); modalsAt = now(); }
      for (const e of modals) {   // a closed dialog (WaConcierge's #wac-panel) stays in the DOM: inert + visibility:hidden. Count a dialog only when it is really open and visible.
        if (e.hidden || e.inert || e.closest('[inert]') || !e.getClientRects().length) continue;
        const v = getComputedStyle(e); if (v.visibility === 'hidden' || v.display === 'none') continue;
        return true;
      }
      return false;
    };

    const place = () => {
      pt = 0; if (!live || a.classList.contains('is-intro')) return;
      const off = hidden(); a.toggleAttribute('data-hide', off); if (off) return;
      const W = R.clientWidth, H = R.clientHeight, cs = getComputedStyle(a), P = ph(), vv = window.visualViewport;
      if (!dock) { natW = a.offsetWidth; natH = a.offsetHeight; }
      const nw = natW || (P ? 48 : 190), nh = natH || (P ? 48 : 56), nx = P ? W - parseFloat(cs.right) - nw : parseFloat(cs.left), ny = H - parseFloat(cs.bottom) - nh, by = ny + nh - 44, L = [];
      let t = null;
      if (P && typing()) {                                    // phone + a field has focus: small, top-right edge, away from the keyboard and the field
        const x = (vv ? vv.offsetLeft + vv.width : W) - 52, y0 = (vv ? vv.offsetTop : 0) + 8;
        if (cur && cur.top && !score(cur.x, cur.y, 44, 44, 1)) t = cur;
        else { for (let k = 0; k < 18; k++) L.push([x, y0 + k * 16]); t = scan(L); if (t) t.top = 1; }
      } else if (score(nx, ny, nw, nh, 1)) {                     // the natural corner has a button / field / bar in it: dock
        if (cur && !cur.top && !score(cur.x, cur.y, 44, 44, 1)) t = cur;
        else {
          if (P) for (let k = 0; k < 40; k++) L.push([W - 56, by - k * 16]);                     // up the side edge, just above the bar
          else { for (let k = 1; k < 26; k++) L.push([nx + k * 16, by]); for (let k = 1; k < 40; k++) L.push([nx, by - k * 16]); }
          t = scan(L);
        }
      }
      if (!t) { if (dock) { dock = 0; cur = null; a.removeAttribute('data-dock'); a.style.setProperty('--wx', '0px'); a.style.setProperty('--wy', '0px'); } }
      else { if (!dock) { dock = 1; a.setAttribute('data-dock', ''); } cur = t; a.style.setProperty('--wx', t.x - a.offsetLeft + 'px'); a.style.setProperty('--wy', t.y - a.offsetTop + 'px'); }
    };
    const req = (gap = 140) => { if (!pt) pt = setTimeout(() => { lastPlace = now(); place(); }, Math.max(0, gap - (now() - lastPlace))); };   // while the page scrolls the caller asks for a 320 ms gap

    const tryHints = () => { for (const [el, t0] of pend) { const [t, q] = el.dataset.askHint.split('|'); if (seen.has(t)) pend.delete(el); else if (say(t, q, now() - t0 > 1400)) { pend.delete(el); break; } } };
    // ---- hint bubble: once per section per visit, 3 s, never while typing; the tap opens Ask with that question ----
    const unsay = () => { clearTimeout(bt); a.classList.remove('m-say'); a.setAttribute('href', base); };
    const say = (txt, q, force) => {
      if (seen.has(txt) || typing() || a.hasAttribute('data-hide')) return false;
      const r = a.getBoundingClientRect(), n = Math.ceil((txt.length * 6.8 + 24) / 168), w = n > 1 ? 168 : 24 + txt.length * 6.8, h = 14 + n * 15, P = ph(), W = R.clientWidth;
      // above the avatar first (right-aligned on phones), then the flipped side, then beside it; never over a heading, text or mascot, always inside the viewport
      const H = R.clientHeight, up = [P ? r.right - w : r.left, r.top - 8 - h, 1], flip = [P ? r.left : r.right - w, r.top - 8 - h, 2], side = [P ? r.left - 8 - w : r.right + 10, r.top + (r.height - h) / 2, 0];
      const c = [up, flip, side].filter(([x, y]) => x >= 4 && x + w <= W - 4 && y >= 4 && y + h <= H - 4);
      const TXT = 'h1,h2,h3,h4,h5,h6,p,li,figcaption,blockquote,.fe-masc,.fe-side-m,[class*="masc"]', MASC = '.fe-masc,.fe-side-m,[class*="masc"]';
      const txtHit = (x, y) => {
        const bx = x - 6, by = y - 6, bw = w + 12, bh = h + 12;
        for (const m of document.querySelectorAll(MASC)) { if (a.contains(m)) continue; const q = m.getBoundingClientRect(); if (q.width && q.height && x - 12 < q.right && x + w + 12 > q.left && y - 12 < q.bottom && y + h + 12 > q.top) return true; }
        const c2 = Math.min(9, Math.ceil(bw / 14) + 1), r2 = Math.ceil(bh / 14) + 1;
        for (let i = 0; i < c2; i++) for (let j = 0; j < r2; j++) {
          const px = bx + bw * i / (c2 - 1), py = by + bh * j / (r2 - 1); if (px < 0 || py < 0 || px >= W || py >= H) continue;
          for (const el of document.elementsFromPoint(px, py)) { if (a.contains(el)) continue; if (el.closest(TXT)) return true; }
        }
        return false;
      };
      let s = c.find(([x, y]) => !txtHit(x, y) && !score(x, y, w, h, 1)), soft = 0;
      if (!s && force) { s = c.find(([x, y]) => !txtHit(x, y)); soft = 1; }    // no free strip after ~1.4 s: show it click-through, but only where it covers no heading, text or mascot
      if (!s) return false;
      seen.add(txt); bub.textContent = txt; a.classList.toggle('m-up', s[2] > 0); a.classList.toggle('m-flip', s[2] === 2); a.classList.toggle('m-soft', !!soft); a.setAttribute('href', '/ask?q=' + encodeURIComponent(q || txt));
      a.classList.add('m-say'); clearTimeout(bt); bt = setTimeout(unsay, 3000); wave(); return true;
    };

    // ---- motion (Web Animations: transform / rotate / scale / opacity only; no layout) ----
    const wake = () => { lastAct = now(); if (sleep) { sleep.cancel(); sleep = null; } };
    const wave = () => { wake(); img.animate([{ rotate: '0deg' }, { rotate: '-10deg', offset: .3 }, { rotate: '8deg', offset: .65 }, { rotate: '0deg' }], { duration: 600, easing: SP }); };
    const hop = () => { lastHop = now(); a.animate([{ transform: 'translateY(0) scale(1,1)' }, { transform: 'translateY(-8px) scale(.96,1.06)', offset: .35 }, { transform: 'translateY(0) scale(1.06,.94)', offset: .7 }, { transform: 'translateY(0) scale(1,1)' }], { duration: 420, easing: SP }); };
    const blink = () => img.animate([{ scale: '1 1' }, { scale: '1.03 .94' }, { scale: '1 1' }], { duration: 190, easing: OUT });
    const SK = [[-30, -34], [0, -46], [30, -34], [-42, -8], [42, -8], [0, -24]];
    const spark = () => spk.forEach((i, k) => i.animate([{ opacity: 1, transform: 'translate(0,0) scale(.4)' }, { opacity: 0, transform: `translate(${SK[k][0]}px,${SK[k][1]}px) scale(1.2) rotate(90deg)` }], { duration: 700, delay: k * 20, easing: OUT }));
    const live2 = () => live && !document.hidden && !a.hasAttribute('data-hide');
    (function bl() { setTimeout(() => { if (live2() && !sleep) blink(); bl(); }, 5000 + Math.random() * 2000); })();
    setInterval(() => { if (live2() && !sleep && now() - lastAct > 25000) sleep = img.animate([{ rotate: '-5deg', translate: '0 1px' }, { rotate: '5deg', translate: '0 3px' }], { duration: 2600, direction: 'alternate', iterations: Infinity, easing: 'ease-in-out' }); }, 3000);
    addEventListener('visibilitychange', () => { a.classList.toggle('is-paused', document.hidden); if (sleep) document.hidden ? sleep.pause() : sleep.play(); });
    ['pointerdown', 'keydown'].forEach((e) => addEventListener(e, wake, { passive: true, capture: true }));

    // ONE passive scroll listener (capture: the desktop pages scroll the BODY). It only notes the scroller; the work runs once per frame (rAF), and re-placing the pill
    // (hit-tests) runs at most every 320 ms while scrolling, then once more when the scroll stops.
    let sTgt = null, sRaf = 0;
    const onFrame = () => {
      sRaf = 0; const t = sTgt; sTgt = null; if (!t) return;
      const y = t.scrollTop, p = ly.get(t); ly.set(t, y);
      if (p === undefined || p === y) return;
      wake(); moved += Math.abs(y - p);
      const d = y > p ? 1 : -1; if (d !== tilt) { tilt = d; img.style.setProperty('--tl', d * 4 + 'deg'); }
      req(320); clearTimeout(st);
      st = setTimeout(() => { img.style.setProperty('--tl', '0deg'); tilt = 0; if (live2() && moved > 160 && now() - lastHop > 1200 && !typing()) hop(); moved = 0; req(); }, 160);
    };
    document.addEventListener('scroll', (e) => { sTgt = e.target.scrollingElement || e.target; if (!sRaf) sRaf = requestAnimationFrame(onFrame); }, { passive: true, capture: true });
    addEventListener('resize', () => req(), { passive: true });
    addEventListener('focusin', () => { unsay(); req(); }); addEventListener('focusout', () => setTimeout(req, 60));
    if (window.visualViewport) visualViewport.addEventListener('resize', () => req());
    setInterval(() => { if (!document.hidden) { req(); if (pend.size) tryHints(); } }, 700);          // catches bars and dialogs that open on their own

    // ---- a new section arrives: wave, and its hint bubble if it has one ([data-ask-hint="line|question to pre-fill"]) ----
    if ('IntersectionObserver' in window) {
      const io = new IntersectionObserver((es) => es.forEach((e) => {
        if (!e.isIntersecting) { pend.delete(e.target); return; }
        if (!live) return;
        const el = e.target, id = el.id || el.className, h = el.dataset.askHint;
        if (h) { if (!pend.has(el)) pend.set(el, now()); setTimeout(tryHints, 420); }   // after the dock spring settles; retried while the section stays in view
