        if (!first && live2()) wave();
      }), { rootMargin: '-35% 0px -35% 0px' });
      document.querySelectorAll('main > section, main section[id], [data-ask-hint]').forEach((s) => io.observe(s));
    }

    // ---- tap: press (css .94), sparkles, then open Ask ----
    a.addEventListener('click', (e) => {
      if (e.defaultPrevented || e.button || e.metaKey || e.ctrlKey || e.shiftKey || e.altKey || a.dataset.go) return;
      e.preventDefault(); a.dataset.go = '1'; wake(); spark(); setTimeout(() => { location.href = a.href; }, 240);
    });
    addEventListener('pageshow', () => { delete a.dataset.go; });

    // ---- Home: the pill is red at the left during the intro; when the intro ends it hops to its place (FLIP, transform only) ----
    const introOn = () => R.classList.contains('lock') || ['heli', 'intro', 'gate', 'lcap'].some((i) => document.getElementById(i));
    const inIntro = home && introOn();
    if (inIntro) a.classList.add('is-intro');
    const enter = () => {
      const f = a.getBoundingClientRect(); a.classList.remove('is-intro'); live = true; const l = a.getBoundingClientRect();
      const dx = f.left - l.left, dy = f.top - l.top;
      if (inIntro && (dx || dy)) a.animate([
        { transform: `translate(${dx}px, ${dy}px) scale(1, 1)`, offset: 0 },
        { transform: `translate(${dx * .5}px, ${dy * .5 - 70}px) scale(.94, 1.08)`, offset: .45, easing: 'cubic-bezier(.77,0,.175,1)' },
        { transform: 'translate(0, 0) scale(1.1, .88)', offset: .85, easing: OUT },
        { transform: 'translate(0, 0) scale(1, 1)', offset: 1 },
      ], { duration: 950, easing: OUT });
      place();
    };
    if (home) { const iv = setInterval(() => { if (!introOn()) { clearInterval(iv); enter(); } }, 400); } else place();
  })();
  </script>
)}
<style>
/* Ask Fursat: tokens from the F2c motion spec; transform / opacity / rotate / scale only */
.afab { --ease: cubic-bezier(.25,1,.5,1); --out: cubic-bezier(.19,1,.22,1); --spring: cubic-bezier(.34,1.56,.64,1);
  position: fixed; right: 12px; bottom: calc(84px + env(safe-area-inset-bottom) + var(--fab-lift, 0px)); z-index: 8500; display: inline-flex; align-items: center; gap: 0; padding: 2px; border-radius: 999px; background: linear-gradient(180deg, #1f4129 0%, #13301d 100%); color: #f6ecd8; text-decoration: none; box-shadow: 0 14px 30px -14px rgb(10 30 18 / .7), inset 0 0 0 1px rgb(243 197 107 / .35); font: 500 .9rem/1.1 Rupee,Poppins, system-ui, sans-serif; transform-origin: 50% 100%; touch-action: manipulation; -webkit-tap-highlight-color: transparent;
  translate: var(--wx, 0px) var(--wy, 0px);
  transition: translate 200ms var(--out), scale 120ms ease-out, box-shadow 200ms ease-out, opacity 200ms ease-out, visibility 0s linear 0s; }
/* docked: a 44px round avatar that springs to the free spot (entry 360 ms); leaving the dock and hiding are faster (200 ms) */
.afab[data-dock] { padding: 0; gap: 0; box-shadow: 0 10px 22px -10px rgb(10 30 18 / .7), 0 0 0 1.5px rgb(243 197 107 / .6); transition-duration: 360ms, 120ms, 200ms, 200ms, 0s; transition-timing-function: var(--spring), ease-out, ease-out, ease-out, linear; }
.afab[data-hide] { opacity: 0; visibility: hidden; pointer-events: none; transition-delay: 0s, 0s, 0s, 0s, 200ms; }
.afab:active { scale: .94; }
.afab:focus-visible { outline: 3px solid #f3c56b; outline-offset: 3px; }
.afab-img { width: 44px; height: 44px; border-radius: 50%; background: #f6e4c9; object-fit: cover; flex: none; transform-origin: 50% 100%; rotate: var(--tl, 0deg); transition: rotate 320ms var(--ease); animation: afab-float 3.2s ease-in-out infinite; }
@keyframes afab-float { 0%, 100% { translate: 0 -3px; } 50% { translate: 0 3px; } }
.afab.is-paused .afab-img { animation-play-state: paused; }
.afab-t b { color: #f3c56b; font-weight: 600; }
.afab-t, .afab-q { position: absolute; width: 1px; height: 1px; overflow: hidden; clip-path: inset(50%); white-space: nowrap; }
.afab-q { display: block; color: #d9c9a6; font-size: .78rem; }
/* desktop: the full pill (label shows); tablet keeps the mascot alone */
@media (min-width: 1024px) {
  .afab { left: 20px; right: auto; bottom: calc(20px + var(--fab-lift, 0px)); padding: 6px 18px 6px 6px; gap: 10px; }
  .afab[data-dock] { padding: 0; gap: 0; }
  .afab-t { position: static; display: block; width: auto; height: auto; max-width: 140px; overflow: hidden; clip-path: none; transition: max-width 360ms var(--ease), opacity 200ms ease-out; }
  .afab[data-dock] .afab-t { max-width: 0; opacity: 0; }
  .afab-q { position: static; width: auto; height: auto; clip-path: none; max-width: 0; opacity: 0; transition: max-width 320ms var(--out), opacity 200ms ease-out; }
}
@media (min-width: 768px) and (max-width: 1023px) { .afab { left: 20px; right: auto; bottom: calc(20px + var(--fab-lift, 0px)); padding: 4px; } .afab[data-dock] { padding: 0; } }
@media (hover: hover) and (pointer: fine) {
  .afab:hover { box-shadow: 0 18px 34px -14px rgb(10 30 18 / .75), inset 0 0 0 1px rgb(243 197 107 / .55); }
  .afab:not([data-dock]):hover .afab-q, .afab:not([data-dock]):focus-visible .afab-q { max-width: 220px; opacity: 1; margin-left: 2px; }
}
@media (hover: hover) and (pointer: fine) and (max-width: 1023px) { .afab:hover .afab-q { max-width: 0; opacity: 0; margin-left: 0; } }

/* ---- in the intro (Home, before the site opens): red pill at the left with the label, above the intro layers; never over Enter / Skip / Sound ---- */
:global(html.fab-js) .afab.is-intro { display: inline-flex; left: 14px; right: auto; bottom: calc(10px + env(safe-area-inset-bottom, 0px)); z-index: 2147482998; padding: 5px 18px 5px 5px; gap: 8px; opacity: 1; visibility: visible; pointer-events: auto; translate: none; box-shadow: 0 14px 30px -14px rgb(10 0 0 / .7), inset 0 0 0 1.5px rgb(246 236 216 / .6); }
@media (max-width: 767px) { :global(html.fab-js) .afab.is-intro { bottom: calc(11svh + 90px + env(safe-area-inset-bottom, 0px)); } } /* phones: in the band above the Enter button, clear of the nav bar */
.afab.is-intro .afab-t { position: static; display: block; width: auto; height: auto; max-width: none; overflow: visible; clip-path: none; }
.afab.is-intro .afab-t b { color: #f6ecd8; }
.afab.is-intro .afab-q { display: none; }

/* sparkle burst on tap: six small gold diamonds (animated from the script) */
.afab-spk { position: absolute; left: 50%; top: 30%; width: 0; height: 0; pointer-events: none; }
.afab-spk i { position: absolute; left: -4px; top: -4px; width: 8px; height: 8px; background: #f3c56b; clip-path: polygon(50% 0, 62% 38%, 100% 50%, 62% 62%, 50% 100%, 38% 62%, 0 50%, 38% 38%); opacity: 0; }
/* hint bubble: beside the mascot (left of it on phones), or above it when the side is busy; tapping it opens Ask with that question */
.afab-bub { position: absolute; top: 50%; left: calc(100% + 10px); display: block; padding: 7px 12px; border-radius: 14px; background: #fff8e8; color: #13301d; font: 600 .78rem/1.2 Rupee,Poppins, system-ui, sans-serif; width: max-content; max-width: 168px; box-shadow: 0 8px 20px -10px rgb(10 30 18 / .6), inset 0 0 0 1px rgb(243 197 107 / .7); opacity: 0; pointer-events: none; transform: translate(-6px, -50%) scale(.9); transform-origin: 0 50%; transition: opacity 160ms var(--out), transform 200ms var(--out); }
.afab.m-say .afab-bub { opacity: 1; pointer-events: auto; transform: translate(0, -50%) scale(1); }
@media (max-width: 767px) { .afab-bub { left: auto; right: calc(100% + 8px); transform-origin: 100% 50%; transform: translate(6px, -50%) scale(.9); } .afab.m-say .afab-bub { transform: translate(0, -50%) scale(1); } }
