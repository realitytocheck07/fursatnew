    });
  };
  const start = () => {
    if (started) return; started = true;
    bot('Hi, welcome to <b>Fursat</b>');
    if (lead && (lead.name || lead.phone)) { setTimeout(() => { bot(lead.name ? 'Good to see you, ' + esc(lead.name) + '. What would you like to do?' : 'Good to see you. What would you like to do?'); setTimeout(showMenu, 200); }, 320); }
