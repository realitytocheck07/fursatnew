---
// WaAgent: "Fursat Connect". A WhatsApp-green floating button (bottom-right on desktop; on phones the bottom nav's WhatsApp tab opens it,
// the floating button stays hidden there as before). Tap = speed dial of 5 pills fanning upward: Chat on WhatsApp (opens the chat agent
// panel below), Call, Email, Ask Fursat (page-aware start question, same map as AskFab) and See the menu.
// Chat agent: greets the guest, name + phone are OPTIONAL (Skip), then the routes. Nothing is stored on a server: the optional name/phone
// live in sessionStorage for this visit and are used only inside the WhatsApp message the guest chooses to send.
// Motion: drop from the top edge with a gold light trail + one gentle shine (one shine at a time across both buttons), scroll progress ring,
// breathing green glow while the restaurant is open now (India time, same hours as the header badge). Owner rule: all motion runs for every visitor.
import site from '../data/site.json';
const wa = site.whatsapp;
const path = Astro.url.pathname.replace(/\/$/, '') || '/';
const home = path === '/';
// same small map AskFab uses (copied, not imported): the page-aware starting question for /ask
const HINTS: Record<string, string> = {
  '/cafe': 'coffee and desserts',
  '/restaurant-bar': 'cocktails and starters',
  '/banquet': 'party starters',
  '/party': 'party starters',
  '/catering': 'biryani for a group',
  '/reserve': 'dinner for two',
  '/order': 'what to order',
};
const q = HINTS[path];
const askHref = q ? `/ask?q=${encodeURIComponent(q)}` : '/ask';
const hours = JSON.stringify(site.hours.schedule.map((s) => ({ d: s.dayOfWeek, o: s.opens, c: s.closes, ol: s.open, cl: s.close })));
const WA_PATH = 'M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z';
const PI: Record<string, string> = {
  call: '<path d="M5 4h4l2 5-2.5 1.5a11 11 0 005 5L15 13l5 2v4a2 2 0 01-2 2A16 16 0 013 6a2 2 0 012-2z"/>',
  mail: '<rect x="3" y="5" width="18" height="14" rx="3"/><path d="M3.5 7.5l8.5 6 8.5-6"/>',
  ask: '<path d="M12 3l1.8 4.7L18.5 9.5l-4.7 1.8L12 16l-1.8-4.7L5.5 9.5l4.7-1.8z"/><path d="M18.5 16l.8 2 2 .8-2 .8-.8 2-.8-2-2-.8 2-.8z"/>',
  menu: '<path d="M5 4h11a3 3 0 013 3v13H8a3 3 0 01-3-3z"/><path d="M8 8h7M8 12h7"/>',
};
type Item = { k: string; t: string; s: string; href?: string };
const ITEMS: Item[] = [
  { k: 'chat', t: 'Chat on WhatsApp', s: 'Pick what you need' },
  { k: 'call', t: 'Call', s: site.phone, href: `tel:+${site.phonePlain}` },
  { k: 'mail', t: 'Email', s: site.email, href: `mailto:${site.email}?subject=${encodeURIComponent('Enquiry from fursat website')}` },
  ...(path !== '/ask' ? [{ k: 'ask', t: 'Ask Fursat', s: q ? `Start with ${q}` : 'What to eat or drink', href: askHref }] : []),
  { k: 'menu', t: 'See the menu', s: 'Food, bar and cafe', href: '/menu/' },
];
---
<div class="waf" data-waf data-wa={wa} data-home={home ? '' : undefined} data-hours={hours}>
  <div class="waf-scrim" aria-hidden="true"></div>
  <button class="waf-fab" type="button" aria-label="Fursat Connect: chat, call, email or ask Fursat" aria-haspopup="menu" aria-expanded="false" aria-controls="waf-dial">
    <span class="waf-ring" aria-hidden="true"></span>
    <span class="waf-trail" aria-hidden="true"></span>
    <span class="waf-face" aria-hidden="true">
      <span class="waf-ic waf-ic--wa"><svg viewBox="0 0 24 24"><path fill="currentColor" d={WA_PATH}/></svg></span>
      <span class="waf-ic waf-ic--x"><svg viewBox="0 0 24 24"><path d="M6 6l12 12M18 6L6 18" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round"/></svg></span>
      <span class="waf-shine"></span>
    </span>
    <span class="waf-badge" aria-hidden="true"><img src="/assets/ask-mascot-sm.webp" alt="" width="20" height="20" decoding="async" loading="lazy" /></span>
    <span class="waf-dot" aria-hidden="true"></span>
  </button>
  <span class="waf-tease" aria-hidden="true">Hi, vibe with us</span>
  <div class="waf-sd" role="dialog" aria-labelledby="waf-sdh-t">
    <div class="waf-sdh">
      <img class="waf-sdh-i" src="/assets/ask-mascot-sm.webp" alt="" width="36" height="36" decoding="async" loading="lazy" />
      <div class="waf-sdh-b"><p class="waf-sdh-t" id="waf-sdh-t">Fursat Connect</p><p class="waf-sdh-s" data-waf-st>{site.hours.display}</p></div>
    </div>
    <ul class="waf-dial" id="waf-dial" role="menu" aria-label="Fursat Connect">
      {ITEMS.map((it, i) => (
        <li role="none" style={`--n:${i}`}>
          {it.href
            ? <a class="waf-pill" role="menuitem" href={it.href}><span class="waf-pi" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" set:html={PI[it.k]}></svg></span><span class="waf-pt"><b>{it.t}</b><small>{it.s}</small></span></a>
            : <button class="waf-pill waf-pill--wa" type="button" role="menuitem" data-act="chat"><span class="waf-pi" aria-hidden="true"><svg viewBox="0 0 24 24"><path fill="currentColor" d={WA_PATH}/></svg></span><span class="waf-pt"><b>{it.t}</b><small>{it.s}</small></span></button>}
        </li>
      ))}
    </ul>
  </div>
  <section class="waf-panel" id="waf-panel" role="dialog" aria-modal="false" aria-labelledby="waf-t" tabindex="-1" hidden>
    <header class="waf-h">
      <img class="waf-av" src="/assets/ask-mascot-sm.webp" alt="" width="44" height="44" decoding="async" loading="lazy" />
      <div class="waf-hd">
        <h2 id="waf-t">Fursat Kitchen | Bar</h2>
        <p><i class="waf-on" aria-hidden="true"></i><span data-waf-st>{site.hours.display}</span></p>
      </div>
      <button class="waf-x" type="button" aria-label="Close chat"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M6 6l12 12M18 6L6 18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"/></svg></button>
    </header>
    <div class="waf-log" aria-live="polite"></div>
  </section>
</div>

<script is:inline>
(() => {
  const root = document.querySelector('[data-waf]');
  if (!root) return;
  const $ = (s) => root.querySelector(s);
  const WA = root.dataset.wa, home = root.hasAttribute('data-home'), de = document.documentElement;
  const fab = $('.waf-fab'), sd = $('.waf-sd'), scrim = $('.waf-scrim'), panel = $('.waf-panel'), log = $('.waf-log'), tease = $('.waf-tease'), face = $('.waf-face'), ring = $('.waf-ring');
  const pills = [].slice.call(root.querySelectorAll('.waf-pill'));
  root.classList.add('js');
  const store = (k, v) => { try { if (v === undefined) return sessionStorage.getItem(k); if (v === null) sessionStorage.removeItem(k); else sessionStorage.setItem(k, v); } catch (e) {} return null; };
  const esc = (s) => String(s).replace(/[&<>"]/g, (c) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;' }[c]));
  let dialOpen = false, chatOpen = false, opener = null, dropped = false, closeT = 0;

  // ---------- open now (India time; same hours and rule as the header's "Open now" badge) ----------
  let HOURS = []; try { HOURS = JSON.parse(root.dataset.hours || '[]'); } catch (e) {}
  const DAYS = ['Sunday', 'Monday', 'Tuesday', 'Wednesday', 'Thursday', 'Friday', 'Saturday'];
  const toM = (s) => { const a = s.split(':'); return parseInt(a[0], 10) * 60 + parseInt(a[1], 10); };
  const status = () => {
    const parts = new Intl.DateTimeFormat('en-GB', { timeZone: 'Asia/Kolkata', weekday: 'long', hour: '2-digit', minute: '2-digit', hourCycle: 'h23' }).formatToParts(new Date());
    const g = (t) => { const p = parts.find((x) => x.type === t); return p ? p.value : ''; };
    const day = g('weekday'), mins = parseInt(g('hour'), 10) * 60 + parseInt(g('minute'), 10);
    const rule = (d) => HOURS.find((r) => r.d.indexOf(d) > -1);
    const today = rule(day), yest = rule(DAYS[(DAYS.indexOf(day) + 6) % 7]);
    if (yest && toM(yest.c) < toM(yest.o) && mins < toM(yest.c)) return { open: true, until: yest.cl };
    if (today) { const o = toM(today.o); let c = toM(today.c); if (c <= o) c += 1440; if (mins >= o && mins < c) return { open: true, until: today.cl }; }
    return { open: false };
  };
  const paint = () => {
    if (!HOURS.length) return;
    const s = status(), t = s.open ? 'Open now · until ' + s.until : 'We’re closed now · we’ll reply when we open';
    root.classList.toggle('is-live', s.open); root.classList.toggle('is-closed', !s.open);
    root.querySelectorAll('[data-waf-st]').forEach((el) => { el.textContent = t; });
  };
  paint(); setInterval(paint, 60000);

  // ---------- one shine at a time (shared lock with the Instagram button), paused when hidden / open / off screen ----------
  const S = (window.__fkShine = window.__fkShine || { busy: false });
  const canShine = () => !document.hidden && root.classList.contains('is-on') && !dialOpen && !chatOpen && !fab.classList.contains('is-drop') && fab.getBoundingClientRect().width > 0 && getComputedStyle(fab).visibility !== 'hidden';
  const shine = () => {
    if (S.busy) return false;
    S.busy = true; face.classList.remove('is-shine'); void face.offsetWidth; face.classList.add('is-shine');
    setTimeout(() => { S.busy = false; }, 1400); return true;
  };
  face.addEventListener('animationend', (e) => { if (/waf-shine/.test(e.animationName)) { face.classList.remove('is-shine'); S.busy = false; } });
  const tryShine = (n) => { if (canShine() && shine()) return; if (n < 4) setTimeout(() => tryShine(n + 1), 1200); };
  setInterval(() => { if (canShine()) shine(); }, 9000);
  document.addEventListener('visibilitychange', () => { de.classList.toggle('waf-pause', document.hidden); });
  fab.addEventListener('animationend', (e) => { if (e.target === fab && /waf-drop/.test(e.animationName)) { fab.classList.remove('is-drop'); setTimeout(() => tryShine(0), 120); } });

  // ---------- scroll progress ring: CSS scroll() timeline, rAF fallback ----------
  if (ring && !(window.CSS && CSS.supports && CSS.supports('animation-timeline: scroll()'))) {
    ring.classList.add('is-js');
    let rq = 0;
    const upd = () => { rq = 0; const h = de.scrollHeight - innerHeight; ring.style.setProperty('--waf-p', (h > 0 ? Math.min(1, Math.max(0, scrollY / h)) * 360 : 0) + 'deg'); };
    const req = () => { if (!rq) rq = requestAnimationFrame(upd); };
    addEventListener('scroll', req, { passive: true }); addEventListener('resize', req, { passive: true }); upd();
  }

  // ---------- when the button shows: Home after the intro; never over the party plan bar / menu table in its corner ----------
  const introOn = () => home && (de.classList.contains('lock') || ['heli', 'intro', 'gate', 'lcap'].some((id) => document.getElementById(id)));
  const phone = () => innerWidth < 768;
  let raf = 0;
  const tick = () => {
    raf = 0;
    let on = !introOn();
    if (on && !phone()) for (const el of document.querySelectorAll('[data-fab-avoid], #pa-plan')) {
      const r = el.getBoundingClientRect();
      if (r.right > innerWidth - 260 && r.bottom > innerHeight - 170 && r.top < innerHeight) { on = false; break; }
    }
    root.classList.toggle('is-on', on);
    if (on && !dropped && !phone()) {
      dropped = true;
      fab.style.setProperty('--waf-drop', Math.round(fab.getBoundingClientRect().bottom + 10) + 'px');
      fab.classList.add('is-drop');
    }
    if (!on && dialOpen && !phone()) closeDial(false);
    if (dialOpen) lay();
  };
  const req = () => { if (!raf) raf = requestAnimationFrame(tick); };
  addEventListener('scroll', req, { passive: true }); addEventListener('resize', req, { passive: true }); addEventListener('pageshow', req);
  new MutationObserver(req).observe(de, { attributes: true, attributeFilter: ['class'] });
  if (introOn()) { const iv = setInterval(() => { if (!introOn()) { clearInterval(iv); tick(); } }, 400); }

  // ---------- speed dial ----------
  // place the stack: desktop = just above the button; phone = above the bottom nav and anything fixed in the corner (Ask, party bar, dock)
  const lay = () => {
    const ph = phone(), W = Math.min(272, innerWidth - 24), right = ph ? 12 : 20, spL = innerWidth - right - W, spR = innerWidth - right;
    let top = innerHeight;
    if (ph) { const nav = document.querySelector('.mb-bar'); top = nav ? nav.getBoundingClientRect().top : innerHeight - 76; }
    else { const fr = fab.getBoundingClientRect(); if (fr.width) top = fr.top; }
    for (const el of document.querySelectorAll('.afab, .ifab.is-on, #pb-bar.is-in, #pb-dock:not([hidden]), #fxsticky.on, [data-fab-avoid], #pa-plan')) {
      if (root.contains(el)) continue;
      const cs = getComputedStyle(el); if (cs.display === 'none' || cs.visibility === 'hidden' || +cs.opacity === 0) continue;
      const r = el.getBoundingClientRect();
      if (r.width && r.top < innerHeight && r.bottom > innerHeight - 340 && r.right > spL && r.left < spR) top = Math.min(top, r.top);
    }
    sd.style.setProperty('--waf-sd-b', Math.max(12, Math.round(innerHeight - top + 12)) + 'px');
  };
  const focusBack = () => { const t = opener && opener.isConnected && opener.getClientRects().length ? opener : fab; if (t.getClientRects().length) t.focus({ preventScroll: true }); };
  const openDial = () => {
    if (dialOpen) return;
    if (chatOpen) setChat(false, false);
    dialOpen = true; opener = document.activeElement; lay();
    root.classList.add('is-dial'); fab.setAttribute('aria-expanded', 'true'); sd.setAttribute('aria-modal', 'true');
    tease.classList.remove('is-on'); store('fk-wa-teased', '1');
    if (pills[0]) pills[0].focus({ preventScroll: true });
  };
  function closeDial(restore) {
    if (!dialOpen) return;
    dialOpen = false; root.classList.remove('is-dial'); fab.setAttribute('aria-expanded', 'false'); sd.removeAttribute('aria-modal');
    if (restore !== false) focusBack();
  }
  fab.addEventListener('click', () => { if (chatOpen) setChat(false, true); else if (dialOpen) closeDial(true); else openDial(); });
  scrim.addEventListener('click', () => closeDial(true));
  sd.addEventListener('click', (e) => {
    const p = e.target.closest('.waf-pill'); if (!p) return;
    if (p.dataset.act === 'chat') { closeDial(false); setChat(true); } else setTimeout(() => closeDial(true), 0);
  });
  sd.addEventListener('keydown', (e) => {
    if (!dialOpen) return;
    const i = pills.indexOf(document.activeElement), n = pills.length; let j = -1;
    if (e.key === 'Tab') j = e.shiftKey ? (i <= 0 ? n - 1 : i - 1) : (i === n - 1 || i < 0 ? 0 : i + 1);
    else if (e.key === 'ArrowUp') j = (i + 1) % n;          // stack grows upward: next item is visually higher
    else if (e.key === 'ArrowDown') j = (i - 1 + n) % n;
    else if (e.key === 'Home') j = 0; else if (e.key === 'End') j = n - 1;
    if (j > -1) { e.preventDefault(); pills[j].focus({ preventScroll: true }); }
  });

  // ---------- chat agent (routes kept; name and phone optional) ----------
  const IC = {
    ask: '<path d="M12 3l1.8 4.7L18.5 9.5l-4.7 1.8L12 16l-1.8-4.7L5.5 9.5l4.7-1.8z"/><path d="M18.5 16l.8 2 2 .8-2 .8-.8 2-.8-2-2-.8 2-.8z"/>',
    reserve: '<rect x="3.5" y="5" width="17" height="15" rx="3"/><path d="M3.5 10h17M8 3v4M16 3v4"/>',
    party: '<path d="M4 20l5-12 7 7z"/><path d="M13 5l1-2M17 8l2-1M16 3.5v.01M20 11v.01"/>',
    banquet: '<path d="M3 20h18M5 20V9l7-5 7 5v11M9 20v-6h6v6"/>',
    catering: '<path d="M4 15a8 8 0 0116 0z"/><path d="M3 19h18M12 7V5"/>',
    order: '<path d="M6 8h12l-1 12H7z"/><path d="M9 8a3 3 0 016 0"/>',
    menu: '<path d="M5 4h11a3 3 0 013 3v13H8a3 3 0 01-3-3z"/><path d="M8 8h7M8 12h7"/>',
    arrow: '<path d="M5 12h14M13 6l6 6-6 6"/>'
  };
  const ico = (k) => '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">' + IC[k] + '</svg>';
  const ROUTES = [
    { k: 'ask', t: 'Ask Fursat', s: 'What to eat or drink', href: '/ask' },
    { k: 'reserve', t: 'Reserve a table', s: 'Dinner, drinks, brunch', href: '/reserve', wa: 'reserve a table', book: 1 },
    { k: 'party', t: 'Plan a party', s: 'Birthdays, kitty, corporate', href: '/party', wa: 'plan a party', book: 1 },
    { k: 'banquet', t: 'Banquet booking', s: 'Hall for events', href: '/banquet', wa: 'book the banquet', book: 1 },
    { k: 'catering', t: 'Catering and buffet', s: 'Biryani for a group', href: '/catering', wa: 'plan catering', book: 1 },
    { k: 'order', t: 'Order online', s: 'Swiggy and Zomato', href: '/order' },
    { k: 'menu', t: 'See the menu', s: 'Food, bar and cafe', href: '/menu' }
  ];
  let lead = null; try { lead = JSON.parse(store('fk-wa-lead') || 'null'); } catch (e) {}
  let n = 0, started = false;
  // plain message unless the guest chose to add a name and/or number
  const link = (about) => {
    let who = '';
    if (lead && (lead.name || lead.phone)) who = (lead.name ? "I'm " + lead.name + (lead.phone ? ' (+91 ' + lead.phone + ')' : '') : 'My number is +91 ' + lead.phone) + '. ';
    const msg = 'Hi Fursat! ' + who + (about ? "I'd like to " + about + '.' : 'I have a question.');
    return 'https://wa.me/' + WA + '?text=' + encodeURIComponent(msg) + '&utm_source=website&utm_medium=chat_widget&utm_campaign=whatsapp';
  };
  const add = (html, cls) => {
    const d = document.createElement('div'); d.className = 'waf-m ' + cls; d.style.setProperty('--i', Math.min(n++, 8)); d.innerHTML = html; log.appendChild(d);
    log.scrollTo({ top: log.scrollHeight, behavior: 'smooth' }); return d;
  };
  const bot = (t) => add(t, 'waf-b');
  const me = (t) => add(esc(t), 'waf-u');
  const waBtn = (about, label) => '<a class="waf-wa" href="' + link(about) + '" target="_blank" rel="noopener">' + label + '</a>';
  const showMenu = () => {
    const html = '<ul class="waf-menu">' + ROUTES.map((r, i) =>
      '<li style="--j:' + i + '"><' + (r.book ? 'button type="button" data-k="' + r.k + '"' : 'a href="' + r.href + '"') + ' class="waf-opt">' +
      '<span class="waf-oi">' + ico(r.k) + '</span><span class="waf-ot"><b>' + r.t + '</b><small>' + r.s + '</small></span><span class="waf-oa">' + ico('arrow') + '</span></' + (r.book ? 'button' : 'a') + '></li>').join('') + '</ul>' +
      waBtn('', 'Chat on WhatsApp');
    const d = add(html, 'waf-c');
    d.querySelectorAll('button[data-k]').forEach((b) => b.addEventListener('click', () => {
      const r = ROUTES.find((x) => x.k === b.dataset.k);
      me(r.t);
      setTimeout(() => {
        bot('Lovely. I can open the page for you, or send a plain message to our team on WhatsApp so they confirm it personally.');
        add('<a class="waf-pg" href="' + r.href + '">Open page ' + ico('arrow') + '</a>' + waBtn(r.wa, 'Send on WhatsApp'), 'waf-c waf-row');
      }, 260);
    }));
  };
  const skip = (d) => { d.remove(); store('fk-wa-skip', '1'); bot('No problem. What would you like to do?'); setTimeout(showMenu, 200); };
  const askLead = () => {
    const d = add('<form class="waf-form" novalidate><p class="waf-ft"><b>Add your name &amp; number</b> <span>(optional)</span></p>' +
      '<label>Your name<input name="n" type="text" autocomplete="name" maxlength="40"></label>' +
      '<label>Phone number<span class="waf-ph"><span class="waf-pre">+91</span><input name="p" type="tel" inputmode="numeric" autocomplete="tel-national" maxlength="12" placeholder="10-digit mobile"></span></label>' +
      '<p class="waf-err" role="alert"></p><div class="waf-fr"><button class="waf-go" type="submit">Continue</button><button class="waf-sk" type="button">Skip</button></div>' +
      '<p class="waf-note">Optional. Used only so the team can reply to you on WhatsApp.</p></form>', 'waf-c');
    const f = d.querySelector('form'), err = f.querySelector('.waf-err');
    f.querySelector('.waf-sk').addEventListener('click', () => skip(d));
    f.addEventListener('submit', (e) => {
      e.preventDefault();
      const name = f.elements.n.value.trim().replace(/\s+/g, ' ');
      let ph = f.elements.p.value.replace(/\D/g, ''); if (ph.length === 12 && ph.startsWith('91')) ph = ph.slice(2); if (ph.length === 11 && ph[0] === '0') ph = ph.slice(1);
      if (ph && !/^[6-9]\d{9}$/.test(ph)) { err.textContent = 'Please enter a 10-digit mobile number, or leave it empty.'; f.elements.p.focus(); return; }
      if (!name && !ph) { skip(d); return; }
      lead = { name, phone: ph }; store('fk-wa-lead', JSON.stringify(lead));
