---
// CornerHero — cream plaster hero with the gold corner art. The real Fursat photo is already baked into the art's
// window (scripts/make-heroes.py), so the page loads ONE image: no empty brown window while photos load.
// A tiny blurred copy (LQIP) shows instantly, the sharp image fades over it. Text sits on the calm side of the art.
import heroes from '../data/heroes.json';
import sharp from 'sharp';
import { readFile } from 'node:fs/promises';
interface Cta { label: string; href: string; primary?: boolean; book?: boolean; external?: boolean; film?: boolean }
// Optional props (party page): sub = italic line under the h1 (subHl = the word in it that gets the highlight colour),
// hlColor = highlight colour for the h1 word, labels = small pills under the rings, one list per photo set, one name per ring.
// ss (kit HS, optional): iris slideshow inside the photo window. See the SlideShow type below. Pages that do not pass it render exactly as before.
type Box = [number, number, number, number];
interface Slide { cap: [string, string]; alt: string; full: string; fw: number; fh: number; d?: string; p?: string; cat?: string }
interface SS { label: string; mask: { d: string; p: string }; win: { d: Box; p: Box }; ui: { d: Box; p: Box }; ui_pos?: 'top' | 'bottom'; slides: Slide[]; cats?: { id: string; label: string }[]; chipsAt?: number }
interface Props { page: 'cafe' | 'bar' | 'party' | 'banquet'; kicker: string; h1a: string; h1b?: string; lead: string; ctas: Cta[]; alt: string; id?: string; sub?: string; subHl?: string; hlColor?: string; labels?: string[][]; manual?: boolean; ss?: SS }
// manual (banquet): the page runs its own rotation (4 slides incl. the sneak-peek loop); slots 'art' (inside the art) and 'after' (under the buttons) are optional.
const { page, kicker, h1a, h1b, lead, ctas, alt, id = 'ch-h1', sub, subHl, hlColor, labels, manual, ss } = Astro.props;
const h = (heroes as any)[page];
const textRight = h.windows[0][0] < 20; // window on the left (banquet art) -> text on the right
const src = (w: number, n = 1) => `/assets/heroes/${page}${n > 1 ? '-' + n : ''}-${w}.webp`;
// phone art (v5.97, kit 49): finished phone images made by the lead dev, used as they are. Real sizes of the 1080 files.
const phoneWH: Record<string, [number, number]> = { party: [1080, 785], banquet: [1080, 785], bar: [1080, 667], cafe: [1080, 691] };
const [pw, ph] = phoneWH[page];
const phoneSrc = (w: number, n = 1) => `/assets/heroes/${page}${n > 1 ? '-' + n : ''}-phone-${w}.webp`;
const phoneSrcset = (n: number) => `${phoneSrc(780, n)} 780w, ${phoneSrc(1080, n)} 1080w`;
const sets = Array.from({ length: ss ? 1 : (h.sets || 1) }, (_, i) => i + 1);
const bx = (b: number[]) => `${b[0]},${b[1]},${b[2]},${b[3]}`;
const ssVars = ss ? (['d', 'p'] as const).map((k) => { const w = ss.win[k], u = ss.ui[k]; return `--${k}wx:${w[0]};--${k}wy:${w[1]};--${k}ww:${+(w[2] - w[0]).toFixed(2)};--${k}wh:${+(w[3] - w[1]).toFixed(2)};--${k}ux:${u[0]};--${k}uy:${u[1]};--${k}uw:${+(u[2] - u[0]).toFixed(2)};--${k}uh:${+(u[3] - u[1]).toFixed(2)};`; }).join('') : '';
const chipY = ss ? Math.max(ss.win.d[3], 0) + 2.4 : 0;
const srcset = (n: number) => `${src(768, n)} 768w, ${src(1024, n)} 1024w, ${src(1536, n)} 1536w`;
// label pill under ring k: centred on the ring, just below the lowest ring edge (percent of the art)
const labY = Math.max(...h.windows.map((w: number[]) => w[3])) + 2.4;
const labX = (k: number) => Math.min(90, (h.windows[k][0] + h.windows[k][2]) / 2);
// LQIP per slide (U2): a 20 px webp (~200 B) of the real photo, inlined, so a slide never shows an empty frame while its big image decodes
const lq = async (path?: string) => { if (!path) return ''; try { const b = await sharp(await readFile('public' + path)).resize(20).webp({ quality: 35 }).toBuffer(); return 'data:image/webp;base64,' + b.toString('base64'); } catch { return ''; } };
const lqs: string[][] = ss ? await Promise.all(ss.slides.map(async (sl) => [await lq(sl.d || sl.full), await lq(sl.p || sl.full)])) : [];
const subParts = sub ? (subHl && sub.includes(subHl) ? [sub.slice(0, sub.indexOf(subHl)), subHl, sub.slice(sub.indexOf(subHl) + subHl.length)] : [sub]) : null;
---
<section class:list={['ch', { 'ch--right': textRight }]} aria-labelledby={id} data-set="0" data-labelled={labels ? '' : undefined} data-manual={manual ? '' : undefined} data-ss={ss ? '' : undefined} style={`--ch-ar:${h.w}/${h.h};--ch-par:${pw}/${ph};--ch-lqip:url('${h.lqip}');${hlColor ? `--ch-hl:${hlColor};` : ''}`}>
  <div class="ch-art">
    <picture class="ch-pic">
    <source media="(max-width: 820px)" srcset={phoneSrcset(1)} sizes="100vw" width={pw} height={ph} />
    <img class="ch-img" src={src(1024)} srcset={`${src(768)} 768w, ${src(1024)} 1024w, ${src(1536)} 1536w`} sizes="100vw"
      width={h.w} height={h.h} alt={alt} fetchpriority="high" loading="eager" decoding="async"
      onload="this.classList.add('is-in')" />
    </picture>
    {sets.slice(1).map((n) => <img class="ch-img ch-alt" data-srcset={srcset(n)} data-srcset-phone={phoneSrcset(n)} sizes="100vw" width={h.w} height={h.h} alt="" aria-hidden="true" decoding="async" />)}
    <slot name="art" />
    {ss && (
      <div class="ch-sb" style={`${ssVars}--ch-mask-d:url('${ss.mask.d}');--ch-mask-p:url('${ss.mask.p}');`} data-n={ss.slides.length}>
        <div class="ch-ss" aria-hidden="true">
          <div class="ch-win">
            {ss.slides.map((sl, i) => (
              <div class="ch-sl" data-i={i} style={i > 0 && lqs[i] && lqs[i][0] ? `--lqd:url('${lqs[i][0]}');--lqp:url('${lqs[i][1] || lqs[i][0]}')` : undefined}>
                {i === 0 ? <img class="ch-s0" alt="" decoding="async" /> : <img alt="" decoding="async" fetchpriority="low" data-d={sl.d} data-p={sl.p} />}
              </div>
            ))}
            <i class={`ch-shade ch-shade--${ss.ui_pos || 'bottom'}`}></i>
          </div>
        </div>
        <button type="button" class="ch-hit" aria-label="Open this photo full screen" tabindex="-1"></button>
        <div class="ch-ui" role="region" aria-roledescription="carousel" aria-label={ss.label}>
          <div class={`ch-cap ch-cap--${ss.ui_pos || 'bottom'}`} aria-hidden="true">
            {ss.slides.map((sl, i) => <p class={`ch-ci${i === 0 ? ' is-on' : ''}`}><span class="ch-ct">{sl.cap[0]}</span><span class="ch-cn">{sl.cap[1]}</span></p>)}
          </div>
          <div class={`ch-pg ch-pg--${ss.ui_pos || 'bottom'}`} role="group" aria-label="Choose a photo">
            {ss.slides.map((sl, i) => <button type="button" class="ch-pd" data-i={i} aria-label={`Show photo ${i + 1} of ${ss.slides.length}: ${sl.cap[1]}`}><span aria-hidden="true"><b></b></span></button>)}
          </div>
          <p class="ch-live" aria-live="off" aria-atomic="true">{ss.slides[0].cap[1]}</p>
          <div class="ch-cvs" data-cv-group="hero-slides">
            {ss.slides.map((sl) => <button type="button" class="ch-cvb" data-cv-full={sl.full} data-cv-alt={sl.alt} data-cv-w={sl.fw} data-cv-h={sl.fh} data-cat={sl.cat || ''} aria-haspopup="dialog" tabindex="-1">{`View photo: ${sl.cap[1]}`}</button>)}
          </div>
        </div>
        {ss.cats && (
          <div class="ch-chips" role="group" aria-label="Celebration types" style={`--chy:${chipY.toFixed(1)}`}>
            {ss.cats.map((c) => <button type="button" class="ch-chip" data-cat={c.id} aria-pressed="false">{c.label}</button>)}
          </div>
        )}
      </div>
    )}
    {!manual && sets.length > 1 && <div class="ch-dots" aria-hidden="true">{sets.map(() => <span class="ch-dot"><i></i></span>)}</div>}
    {labels && (
      <div class="ch-labs">
        {labels.map((set, si) => set.map((t, k) => <span class={`ch-lab ch-lab--${k}`} data-set={si} style={`left:${labX(k)}%;top:${labY}%`}>{t}</span>))}
      </div>
    )}
  </div>
  <div class="ch-copy">
    <p class="fk-ty-label ch-kick">{kicker}</p>
    <h1 class="fk-ty-hero ch-h1" id={id}>{h1a}{h1b && <> <span class="ch-hl">{h1b}</span></>}</h1>
    {subParts && <p class="ch-sub">{subParts[0]}{subParts.length > 1 && <em class="ch-sub-hl">{subParts[1]}</em>}{subParts[2]}</p>}
    <svg class="ch-orn" viewBox="0 0 260 24" aria-hidden="true"><path d="M2 12 H104" /><path d="M156 12 H258" /><path d="M130 3 C122 9 122 15 130 21 C138 15 138 9 130 3 Z" /></svg>
    <p class="ch-lead">{lead}</p>
    <div class="ch-btns">
      {ctas.map((c) => (
        <a class:list={['fk-btn', c.primary ? 'fk-btn--primary' : 'fk-btn--secondary', { 'ch-film': c.film }]} href={c.href} data-open={c.book ? 'book' : undefined}
          target={c.external ? '_blank' : undefined} rel={c.external ? 'noopener' : undefined}>
          {c.film && <i class="ch-play" aria-hidden="true"><svg viewBox="0 0 24 24"><path d="M9 6.5v11l9-5.5z" /></svg></i>}<span>{c.label}</span>{!c.film && <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6" /></svg>}
        </a>
      ))}
    </div>
    <slot name="after" />
  </div>
</section>
<script is:inline>
(function () {
  document.querySelectorAll('.ch-img:not(.ch-alt)').forEach(function (i) { if (i.complete && i.naturalWidth) i.classList.add('is-in'); });
  /* rotate the photo sets: extra images load when the browser is idle, then cross-fade every 6 s.
     Paused off-screen and in background tabs. Under reduced motion only a labelled hero (party) rotates, as an instant swap. */
  /* phones (<= 820 px): the rotating photos and the banquet script's Ken-Burns layers read data-srcset / srcset, so on a phone point both at the phone files */
  var phoneMQ = matchMedia('(max-width: 820px)');
  document.querySelectorAll('.ch').forEach(function (hero) {
    if (!phoneMQ.matches) return;
    hero.querySelectorAll('.ch-alt').forEach(function (im) { if (im.dataset.srcsetPhone) im.dataset.srcset = im.dataset.srcsetPhone; });
    var first = hero.querySelector('.ch-img:not(.ch-alt)'), so = first && first.parentNode.querySelector('source');
    if (first && so && so.getAttribute('srcset')) first.setAttribute('srcset', so.getAttribute('srcset'));
  });
  var calm = matchMedia('(prefers-reduced-motion: reduce)').matches;
  document.querySelectorAll('.ch').forEach(function (hero) {
    if (hero.hasAttribute('data-manual')) return;   /* banquet drives its own 4-slide rotation */
    if (calm && !hero.hasAttribute('data-labelled')) return;
    var alts = [].slice.call(hero.querySelectorAll('.ch-alt')); if (!alts.length) return;
    var all = [hero.querySelector('.ch-img:not(.ch-alt)')].concat(alts), cur = 0, vis = true, timer = 0;
    function load() { alts.forEach(function (im) { im.srcset = im.dataset.srcset; im.src = im.dataset.srcset.split(' ')[0]; }); }
    (window.requestIdleCallback || function (f) { setTimeout(f, 1500); })(load);
    function next() {
      var n = (cur + 1) % all.length, im = all[n];
      if (!im.complete || !im.naturalWidth) return;           // not loaded yet: try next tick
      all[cur].classList.remove('is-top'); im.classList.add('is-in', 'is-top');
      if (cur) all[cur].classList.remove('is-in');
      cur = n; hero.setAttribute('data-set', String(n));
    }
    function run() { clearInterval(timer); if (vis && !document.hidden) timer = setInterval(next, 6000); }
    if ('IntersectionObserver' in window) new IntersectionObserver(function (e) { vis = e[0].isIntersecting; run(); }).observe(hero);
    document.addEventListener('visibilitychange', run); run();
  });
})();
</script>
<script is:inline>
/* kit HS: iris slideshow inside the hero photo window. First slide = the baked photo (LCP untouched). The rest load after window load + idle.
   3.2 s per slide, 700 ms iris (clip-path circle 0 -> 75 % from the window centre, photo settles 1.08 -> 1, old one eases to .98), slow drift 1 -> 1.04.
   Paused: hero off screen (IntersectionObserver on the HERO), hidden tab, hover on laptop. Dots jump, chips jump, swipe on phone, tap opens the viewer. */
(function () {
  var HOLD = 3200, IRIS = 700, EASE = 'cubic-bezier(.22,1,.36,1)';
  document.querySelectorAll('.ch[data-ss]').forEach(function (hero) {
    var sb = hero.querySelector('.ch-sb'); if (!sb || !hero.animate) return;
    var phone = matchMedia('(max-width: 820px)').matches;
    var slides = [].slice.call(sb.querySelectorAll('.ch-sl')), n = slides.length;
    var dots = [].slice.call(sb.querySelectorAll('.ch-pd')), caps = [].slice.call(sb.querySelectorAll('.ch-ci'));
    var chips = [].slice.call(sb.querySelectorAll('.ch-chip')), cvb = [].slice.call(sb.querySelectorAll('.ch-cvb'));
    var hit = sb.querySelector('.ch-hit'), live = sb.querySelector('.ch-live'), ss = sb.querySelector('.ch-ss'), ui = sb.querySelector('.ch-ui');
    var dec = [], bad = [], pend = [], cats = [], cur = 0, z = 1, ready = false, vis = true, hov = false, held = false, want = -1, user = false, fillA = null, tick = 0;
    slides.forEach(function (sl, i) { cats[i] = (cvb[i] && cvb[i].getAttribute('data-cat')) || ''; });
    function pauseAll() { ss.getAnimations({ subtree: true }).concat(ui.getAnimations({ subtree: true })).forEach(function (a) { if (a.playState === 'running') a.pause(); }); }
    function playAll() { ss.getAnimations({ subtree: true }).concat(ui.getAnimations({ subtree: true })).forEach(function (a) { if (a.playState === 'paused') a.play(); }); }
    function sync() { if (!ready) return; if (vis && !document.hidden && !hov && !held) playAll(); else pauseAll(); }
    function drift(sl, withSettle) {
      var img = sl.firstElementChild;
      img.getAnimations().forEach(function (a) { a.cancel(); });
      if (withSettle) img.animate([{ transform: 'scale(1.08)', offset: 0, easing: EASE }, { transform: 'scale(1)', offset: IRIS / (IRIS + HOLD), easing: 'linear' }, { transform: 'scale(1.04)', offset: 1 }], { duration: IRIS + HOLD, fill: 'forwards' });
      else img.animate([{ transform: 'scale(1)' }, { transform: 'scale(1.04)' }], { duration: HOLD + IRIS, easing: 'linear', fill: 'forwards' });
    }
    function bar(i) {
      if (fillA) { fillA.onfinish = null; fillA.cancel(); fillA = null; }
      dots.forEach(function (d, k) { d.classList.toggle('is-done', k < i); d.classList.toggle('is-act', k === i); if (k === i) d.setAttribute('aria-current', 'true'); else d.removeAttribute('aria-current'); });
      var b = dots[i].querySelector('b');
      fillA = b.animate([{ transform: 'scaleX(0)' }, { transform: 'scaleX(1)' }], { duration: HOLD, easing: 'linear', fill: 'forwards' });
      fillA.onfinish = function () { go((cur + 1) % n, false); };
      sync();
    }
    function chipState() { chips.forEach(function (c) { c.setAttribute('aria-pressed', String(cats[cur] === c.getAttribute('data-cat'))); }); }
    function roll(from, to) {
      var o = caps[from], w = caps[to];
      o.getAnimations().forEach(function (a) { a.cancel(); }); w.getAnimations().forEach(function (a) { a.cancel(); });
      o.animate([{ transform: 'translateY(0)', opacity: 1 }, { transform: 'translateY(-110%)', opacity: 0 }], { duration: 260, easing: 'ease', fill: 'forwards' }).onfinish = function () { o.classList.remove('is-on'); this.cancel(); };
      w.classList.add('is-on'); w.animate([{ transform: 'translateY(110%)', opacity: 0 }, { transform: 'translateY(0)', opacity: 1 }], { duration: 260, easing: 'ease' });
    }
    function loaded(i) { return i === 0 || !!dec[i]; }
    /* U2: a slide is only swapped to after img.decode() has resolved (never just 'complete'), so the iris never opens on a blank frame.
       One retry (re-request), then the slide is marked bad and skipped. */
    function fetchSlide(i) {
      if (pend[i]) return pend[i];
      var im = slides[i].firstElementChild, u = phone ? im.getAttribute('data-p') : im.getAttribute('data-d');
      if (!u) { bad[i] = true; return (pend[i] = Promise.resolve(false)); }
      if (!im.getAttribute('src')) im.src = u;
      var d = function () { return im.decode ? im.decode() : new Promise(function (ok, no) { if (im.complete && im.naturalWidth) ok(); else { im.onload = ok; im.onerror = no; } }); };
      pend[i] = d().then(function () { dec[i] = true; return true; }, function () {
        return new Promise(function (r) { setTimeout(r, 800); }).then(function () { im.removeAttribute('src'); im.src = u; return d(); })
          .then(function () { dec[i] = true; return true; }, function () { bad[i] = true; return false; });
      });
      return pend[i];
    }
    function go(i, byUser) {
      if (i === cur) return;
      if (!ready) { if (byUser) want = i; return; }
      if (bad[i]) { if (byUser) return; go((i + 1) % n, false); return; }
      if (!loaded(i)) {
        fetchSlide(i);
        if (!byUser) { clearTimeout(tick); tick = setTimeout(function () { go(i, false); }, 400); return; }
        /* a dot, chip or swipe asked for a photo that is not decoded yet: fetch it now, keep showing the current slide, start the iris once decode() has resolved */
        want = i;
        fetchSlide(i).then(function (ok) { if (ok && want === i) { want = -1; go(i, true); } });
        return;
      }
      want = -1;
      var from = slides[cur], to = slides[i], old = cur;
      slides.forEach(function (s, k) { if (k !== old && k !== i) { s.classList.remove('is-on'); s.getAnimations().forEach(function (a) { a.cancel(); }); } });
      to.getAnimations().forEach(function (a) { a.cancel(); }); to.style.transform = '';
      to.style.zIndex = ++z; to.classList.add('is-on');
      to.animate([{ clipPath: 'circle(0% at 50% 50%)' }, { clipPath: 'circle(75% at 50% 50%)' }], { duration: IRIS, easing: EASE, fill: 'forwards' });
      drift(to, true);
      var fa = from.animate([{ transform: 'scale(1)' }, { transform: 'scale(.98)' }], { duration: IRIS, easing: EASE, fill: 'forwards' });
      fa.onfinish = function () { if (cur !== old) { from.classList.remove('is-on'); fa.cancel(); from.firstElementChild.getAnimations().forEach(function (a) { a.cancel(); }); } };
      cur = i; roll(old, i); bar(i); chipState();
      if (byUser) { user = true; live.setAttribute('aria-live', 'polite'); }
      live.textContent = caps[i].querySelector('.ch-cn').textContent;
    }
    function start() {
      var base = hero.querySelector('.ch-img:not(.ch-alt)'), s0 = slides[0].firstElementChild;
      s0.src = base.currentSrc || base.src;
      var begin = function () {
        hero.classList.add('is-ssr'); slides[0].classList.add('is-on'); slides[0].style.zIndex = 1; drift(slides[0], false);
        ready = true; chipState(); bar(0); if (want > -1) go(want, true);
      };
      /* U2: the slideshow layer only appears once the first photo has decoded; if it cannot, the baked hero stays (never an empty window) */
      if (s0.decode) s0.decode().then(begin, function () { setTimeout(function () { s0.decode().then(begin, function () {}); }, 1000); }); else if (s0.complete && s0.naturalWidth) begin(); else s0.addEventListener('load', begin, { once: true });
    }
    function load() {
      start();
      /* the other photos preload one at a time in the background after window load, each decoded off-screen */
      var k = 1, idle = window.requestIdleCallback || function (f) { setTimeout(f, 300); };
      (function nxt() { if (k >= n) return; fetchSlide(k++).then(function () { idle(nxt, { timeout: 1500 }); }); })();
    }
    function whenIdle() { (window.requestIdleCallback || function (f) { setTimeout(f, 1500); })(load, { timeout: 4000 }); }
    if (document.readyState === 'complete') whenIdle(); else addEventListener('load', whenIdle);
    /* controls */
    dots.forEach(function (d) { d.addEventListener('click', function () { go(+d.getAttribute('data-i'), true); }); });
    chips.forEach(function (c) { c.addEventListener('click', function () { var k = cats.indexOf(c.getAttribute('data-cat')); if (k > -1) go(k, true); }); });
    var sx = 0, sy = 0, sid = -1, moved = false;
    hit.addEventListener('pointerdown', function (e) { sx = e.clientX; sy = e.clientY; sid = e.pointerId; moved = false; });
    hit.addEventListener('pointermove', function (e) { if (e.pointerId === sid && Math.abs(e.clientX - sx) > 10) moved = true; });
    hit.addEventListener('pointerup', function (e) {
      if (e.pointerId !== sid) return; sid = -1; var dx = e.clientX - sx, dy = e.clientY - sy;
      if (Math.abs(dx) > 40 && Math.abs(dx) > Math.abs(dy) * 1.3) { moved = true; go((cur + (dx < 0 ? 1 : n - 1)) % n, true); }
    });
    hit.addEventListener('pointercancel', function () { sid = -1; });
    hit.addEventListener('click', function (e) { if (moved) { moved = false; e.preventDefault(); return; } if (ready && cvb[cur]) cvb[cur].click(); });
    sb.addEventListener('keydown', function (e) { if (e.key === 'ArrowRight') go((cur + 1) % n, true); else if (e.key === 'ArrowLeft') go((cur + n - 1) % n, true); });
    sb.addEventListener('mouseenter', function (e) { if (matchMedia('(hover: hover)').matches) { hov = true; sync(); } });
    sb.addEventListener('mouseleave', function () { hov = false; sync(); });
    if ('IntersectionObserver' in window) new IntersectionObserver(function (e) { vis = e[0].isIntersecting; sync(); }).observe(hero);
    document.addEventListener('visibilitychange', sync);
    hero.addEventListener('bq:hold', function () { held = true; sync(); }); hero.addEventListener('bq:release', function () { held = false; sync(); });
    hero.__ss = { go: go, state: function () { return { cur: cur, ready: ready }; } };
  });
})();
</script>
<style>
.ch { position: relative; display: grid; align-items: center; min-height: min(100svh, calc(var(--sh-h, 84px) + 100vw * 941 / 1672)); padding-top: var(--sh-h, 84px); overflow: hidden; background: #f6e4c9 var(--ch-lqip) center / cover no-repeat; isolation: isolate; }
.ch-art { position: absolute; inset: var(--sh-h, 84px) 0 0 0; z-index: -1; }
.ch-img { width: 100%; height: 100%; object-fit: cover; object-position: right center; display: block; opacity: 0; transition: opacity 600ms cubic-bezier(.23,1,.32,1); }
.ch--right .ch-img { object-position: left center; }
.ch-img.is-in { opacity: 1; }
.ch-alt { position: absolute; inset: 0; transition-duration: 1200ms; }
.ch-alt.is-top { z-index: 1; }
.ch-copy { width: min(52%, 640px); margin-left: clamp(20px, 6vw, 96px); padding: clamp(24px, 4vw, 48px) 0; color: #1f2a1a; }
.ch--right .ch-copy { margin-left: auto; margin-right: clamp(20px, 6vw, 96px); width: min(50%, 600px); }
.ch-kick { margin: 0 0 12px; color: #8a5a22; }
.ch-h1 { color: #18301f; }
.ch-hl { color: var(--ch-hl, #9c4f1c); font-style: italic; }
