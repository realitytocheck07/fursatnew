---
import site from '../data/site.json';
// SiteHeader.astro - Fursat Luxury Hospitality Navigation
// One cream header for every page. Home keeps it in the page flow (its 07.css layout is sized to it); all other pages overlay it (position: fixed).
// Height is the CSS variable --sh-h (fk-tokens.css), constant while scrolling, so first sections can use padding-top: var(--sh-h).
interface Props {
  active?: string;
  /** Ignored. Older pages still pass variant="plaster"; there is only one header now. */
  variant?: string;
}
const { active = 'home' } = Astro.props;
// live "Open now" badge: hours come only from site.json (schedule with dayOfWeek/opens/closes, IST)
const phone = site.phone, phonePlain = site.phonePlain;
const hoursData = JSON.stringify(site.hours.schedule.map((s) => ({ d: s.dayOfWeek, o: s.opens, c: s.closes, ol: s.open, cl: s.close })));
---
<header class:list={["sh-header", "sh-plaster", { "sh-flow": active === 'home' }]} id="site-header">
  <!-- Info strip: hours come from site.json; the live badge fills in the open/closed state -->
  <div class="sh-strip">
    <span class="sh-st sh-st--hours"><span class="sh-open" data-hours={hoursData} hidden></span><span class="sh-st-hours">{site.hours.display}</span></span>
    <span class="sh-st-sep" aria-hidden="true"></span>
    <a class="sh-st sh-st--map" href={site.address.googleMaps} target="_blank" rel="noopener"><svg class="sh-sic" viewBox="0 0 24 24" aria-hidden="true"><path d="M12 21s-7-6.2-7-11a7 7 0 0 1 14 0c0 4.8-7 11-7 11Z"/><circle cx="12" cy="10" r="2.5"/></svg>Capital Park, Madhapur</a>
    <span class="sh-st-sep" aria-hidden="true"></span>
    <a class="sh-st sh-st--call" href={`tel:+${phonePlain}`}><svg class="sh-sic" viewBox="0 0 24 24" aria-hidden="true"><path d="M5 4h4l2 5-2.5 1.5a11 11 0 0 0 5 5L15 13l5 2v4a2 2 0 0 1-2 2A16 16 0 0 1 3 6a2 2 0 0 1 2-2Z"/></svg><span class="sh-st-call-n">Call {phone}</span><span class="sh-st-call-s">Call</span></a>
  </div>
  <div class="sh-inner">
    <a href="/" class="sh-logo" aria-label="Fursat Kitchen | Bar Home">
      <span class="sh-lg-el" aria-hidden="true">
        <img class="sh-lg-el-img" src="/assets/brand/fursat-elephant-3d-v1.webp" srcset="/assets/brand/fursat-elephant-3d-v1.webp 1x, /assets/brand/fursat-elephant-3d-v1@2x.webp 2x" data-fallback="/assets/brand/fursat-elephant.webp" alt="" width="36" height="46" decoding="async" fetchpriority="high" />
        <span class="sh-lg-shine"><i></i></span>
      </span>
      <img class="sh-lg-word" src="/assets/brand/fursat-wordmark.svg" alt="Fursat Kitchen | Bar" width="441" height="88" />
    </a>

    <nav class="sh-nav" aria-label="Main Navigation">
      <span class="sh-pill" aria-hidden="true"><i class="l"></i><i class="m"></i><i class="r"></i></span>
      <a href="/" class:list={["sh-link", { active: active === 'home' }]} aria-current={active === 'home' ? 'page' : undefined}>Home</a>
      <div class="sh-drop">
        <button class:list={["sh-link", "sh-drop-btn", { active: active === 'menu' }]} type="button" aria-expanded="false" aria-controls="sh-menu-menu"><span>Menu</span><svg class="sh-arr" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m6 9 6 6 6-6"/></svg></button>
        <div class="sh-menu" id="sh-menu-menu">
          <a href="/menu" class="sh-card" style="--i:0"><span class="sh-card-img"><img data-src="/assets/nav/menu-all.webp" alt="" width="112" height="112" decoding="async" /></span><span class="sh-card-t">All Categories</span><small>North Indian, Asian, Continental &amp; Kebabs</small></a>
          <a href="/restaurant-bar#cocktails" class="sh-card" style="--i:1"><span class="sh-card-img"><img data-src="/assets/nav/bar.webp" alt="" width="112" height="112" decoding="async" /></span><span class="sh-card-t">Bar &amp; Mixology</span><small>Artisanal Cocktails, Single Malts &amp; Beers</small></a>
          <a href="/menu?menu=cafe" class="sh-card" style="--i:2"><span class="sh-card-img"><img data-src="/assets/nav/cafe.webp" alt="" width="112" height="112" decoding="async" /></span><span class="sh-card-t">Café &amp; Coffee</span><small>Specialty Brews, Shakes &amp; Bakes</small></a>
          <a href="/menu?tab=craft" class="sh-card" style="--i:3"><span class="sh-card-img"><img data-src="/assets/nav/craft.webp" alt="" width="112" height="112" decoding="async" /></span><span class="sh-card-t">Craft Your Plate</span><small>Customize your feast step-by-step</small></a>
        </div>
      </div>

      <div class="sh-drop">
        <button class:list={["sh-link", "sh-drop-btn", { active: active === 'celebrate' || active === 'banquet' || active === 'party' || active === 'catering' }]} type="button" aria-expanded="false" aria-controls="sh-menu-celebrate"><span>Celebrate</span><svg class="sh-arr" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m6 9 6 6 6-6"/></svg></button>
        <div class="sh-menu" id="sh-menu-celebrate">
          <a href="/party" class="sh-card" style="--i:0"><span class="sh-card-img"><img data-src="/assets/nav/party.webp" alt="" width="112" height="112" decoding="async" /></span><span class="sh-card-t">Parties &amp; Events</span><small>Birthdays, kitty parties, bar bashes and packages</small></a>
          <a href="/banquet" class="sh-card" style="--i:1"><span class="sh-card-img"><img data-src="/assets/nav/banquet.webp" alt="" width="112" height="112" decoding="async" /></span><span class="sh-card-t">The Grand Banquet Hall</span><small>Capacity 50–350 guests with AV &amp; live stage</small></a>
          <a href="/catering" class="sh-card" style="--i:2"><span class="sh-card-img"><img data-src="/assets/nav/catering.webp" alt="" width="112" height="112" decoding="async" /></span><span class="sh-card-t">Outdoor Catering</span><small>Fursat royal dining delivered to your venue</small></a>
        </div>
      </div>

      <a href="/restaurant-bar" class:list={["sh-link", { active: active === 'restaurant-bar' }]} aria-current={active === 'restaurant-bar' ? 'page' : undefined}>Bar &amp; Kitchen</a>
      <a href="/cafe" class:list={["sh-link", { active: active === 'cafe' }]} aria-current={active === 'cafe' ? 'page' : undefined}>Café</a>
      <a href="/ask" class:list={["sh-link", { active: active === 'ask' }]} aria-current={active === 'ask' ? 'page' : undefined}>Ask Fursat</a>
      <a href="/story" class:list={["sh-link", { active: active === 'story' }]} aria-current={active === 'story' ? 'page' : undefined}>Story</a>
    </nav>

    <div class="sh-actions">
      <a href="/reserve" class:list={["sh-reserve-btn", { "is-current": active === 'reserve' }]} data-open="book" aria-label="Reserve a table" aria-current={active === 'reserve' ? 'page' : undefined}><span class="sh-rs-txt">Reserve</span><span class="sh-rs-shine" aria-hidden="true"><i></i></span></a>
      <button class="sh-burger" id="sh-burger" type="button" aria-label="Open navigation menu" aria-expanded="false" aria-controls="sh-mobile-panel"><span></span><span></span><span></span></button>
    </div>
  </div>

  <!-- Phone menu: full-screen sheet, 3D elephant on top, 56px rows rise in 50ms apart, Reserve + WhatsApp + Call pinned at the bottom -->
  <div class="sh-mobile-panel" id="sh-mobile-panel" role="dialog" aria-modal="true" aria-label="Site menu" hidden>
    <div class="sh-mp-top">
      <span class="sh-mp-brand" aria-hidden="true">
        <img class="sh-mp-el" src="/assets/brand/fursat-elephant-3d-v1@3x.webp" alt="" width="60" height="77" decoding="async" />
        <img class="sh-mp-word" src="/assets/brand/fursat-wordmark.svg" alt="" width="150" height="30" decoding="async" />
      </span>
      <button class="sh-mp-close" type="button" aria-label="Close navigation menu"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" aria-hidden="true"><path d="M6 6l12 12M18 6 6 18"/></svg></button>
    </div>
    <nav class="sh-mp-scroll" aria-label="Site menu">
      <a href="/" class="sh-mp-link" style="--i:0" aria-current={active === 'home' ? 'page' : undefined}>Home</a>
      <a href="/menu" class="sh-mp-link" style="--i:1" aria-current={active === 'menu' ? 'page' : undefined}>Explore Menu</a>
      <a href="/restaurant-bar" class="sh-mp-link" style="--i:2" aria-current={active === 'restaurant-bar' ? 'page' : undefined}>Restaurant &amp; Bar (21+)</a>
      <a href="/cafe" class="sh-mp-link" style="--i:3" aria-current={active === 'cafe' ? 'page' : undefined}>Fursat Café &amp; Shakes</a>
      <a href="/ask" class="sh-mp-link" style="--i:4" aria-current={active === 'ask' ? 'page' : undefined}>Ask Fursat</a>
      <a href="/story" class="sh-mp-link" style="--i:5" aria-current={active === 'story' ? 'page' : undefined}>Our Story &amp; Heritage</a>
      <span class="sh-mp-label" style="--i:6">Celebrate</span>
      <a href="/party" class="sh-mp-link" style="--i:7" aria-current={active === 'party' ? 'page' : undefined}>Parties &amp; Events</a>
      <a href="/banquet" class="sh-mp-link" style="--i:8" aria-current={active === 'banquet' ? 'page' : undefined}>The Banquet Hall</a>
      <a href="/catering" class="sh-mp-link" style="--i:9" aria-current={active === 'catering' ? 'page' : undefined}>Outdoor Catering</a>
      <a href="/terms" class="sh-mp-link" style="--i:10">Offers &amp; Terms</a>
    </nav>
    <div class="sh-mp-pin">
      <a href="/reserve" class="sh-mp-reserve" data-open="book" aria-current={active === 'reserve' ? 'page' : undefined}>Reserve</a>
      <a href={`https://wa.me/${site.whatsapp}`} class="sh-mp-wa" target="_blank" rel="noopener">WhatsApp</a>
      <a href={`tel:+${phonePlain}`} class="sh-mp-call">Call</a>
    </div>
  </div>
</header>
<script is:inline>
  // Open-now badge + time-of-day mood, both in India time (Asia/Kolkata) whatever the visitor's clock says.
  (function () {
    var now = new Date();
    var parts = new Intl.DateTimeFormat('en-GB', { timeZone: 'Asia/Kolkata', weekday: 'long', hour: '2-digit', minute: '2-digit', hourCycle: 'h23' }).formatToParts(now);
    var get = function (t) { var p = parts.find(function (x) { return x.type === t; }); return p ? p.value : ''; };
    var day = get('weekday'), mins = parseInt(get('hour'), 10) * 60 + parseInt(get('minute'), 10);
    var h = Math.floor(mins / 60);
    document.documentElement.dataset.daypart = h >= 6 && h < 12 ? 'morning' : h >= 12 && h < 17 ? 'day' : 'evening';
    var badges = document.querySelectorAll('.sh-open[data-hours]');
    if (!badges.length) return;
    var sched = JSON.parse(badges[0].getAttribute('data-hours'));
    var DAYS = ['Sunday', 'Monday', 'Tuesday', 'Wednesday', 'Thursday', 'Friday', 'Saturday'];
    var toM = function (s) { var a = s.split(':'); return parseInt(a[0], 10) * 60 + parseInt(a[1], 10); };
    var ruleFor = function (d) { return sched.find(function (r) { return r.d.indexOf(d) > -1; }); };
    var today = ruleFor(day), yest = ruleFor(DAYS[(DAYS.indexOf(day) + 6) % 7]);
    var open = false, until = '';
    if (yest && toM(yest.c) < toM(yest.o) && mins < toM(yest.c)) { open = true; until = yest.cl; }
    else if (today) {
      var o = toM(today.o), c = toM(today.c);
      if (c <= o) c += 1440;
      if (mins >= o && mins < c) { open = true; until = today.cl; }
    }
    var text = open ? 'Open now · until ' + until : 'Closed · opens ' + (today && mins < toM(today.o) ? today.ol : (ruleFor(DAYS[(DAYS.indexOf(day) + 1) % 7]) || {}).ol || '');
    badges.forEach(function (b) { b.textContent = text; b.classList.toggle('is-open', open); b.hidden = false; });
  })();
</script>

<style is:global>
  /* Header: green info strip + cream bar. Layout height is constant (--sh-h = strip + 76px bar), so nothing ever shifts.
     On scroll the bar shrinks 76 -> 60px with transforms only (background layers scaleY, content translateY), no layout change. */
  .sh-header { --sh-ease: cubic-bezier(.23,1,.32,1); --sh-k: .789; --sh-dy: -8px; position: fixed; top: 0; left: 0; right: 0; z-index: 100; color: #1c2a18;
    transition: transform .32s cubic-bezier(.16,1,.3,1), opacity .32s ease; }
  .sh-header.sh-flow { position: sticky; }
  /* the page scripts add .sf-curtain-lift (z-index 1) and an inline cream background to the header on Home: keep the header above the page (mega panels hang below it)
     and let the bar layers below paint the background, so the shrink + frosted state can show through */
  #site-header.sh-header { z-index: 100; background: transparent !important; }
  .sh-header.sh-hidden { transform: translateY(-110%); opacity: 0; pointer-events: none; }
  .sh-header.sh-hidden:focus-within { transform: none !important; opacity: 1 !important; pointer-events: auto !important; }
  /* nothing animates off screen: ambient shines pause while the header is tucked away */
  .sh-header.sh-hidden i { animation-play-state: paused; }

  .sh-strip { height: 36px; display: flex; align-items: center; justify-content: center; gap: 20px; padding: 0 16px; overflow: hidden; white-space: nowrap;
    background: #2a5019; color: #f6ecd6; font: 400 .8125rem/1 var(--fk-sans, Rupee,Poppins, system-ui, sans-serif); letter-spacing: .02em; }
  .sh-st { display: inline-flex; align-items: center; gap: 8px; color: inherit; text-decoration: none; min-height: 36px; }
  a.sh-st:hover { color: #fff; text-decoration: underline; text-underline-offset: 3px; }
  .sh-st-sep { width: 1px; height: 14px; background: rgba(230,194,122,.5); }
  .sh-sic { width: 15px; height: 15px; fill: none; stroke: #e6c27a; stroke-width: 1.7; stroke-linecap: round; stroke-linejoin: round; flex: none; }
  .sh-open { display: inline-flex; align-items: center; gap: 7px; font-weight: 600; color: #fff; font-variant-numeric: tabular-nums; }
  .sh-open::before { content: ""; width: 8px; height: 8px; border-radius: 50%; background: #e6c27a; }
  .sh-open.is-open::before { background: #6fd08c; }
  .sh-open[hidden] { display: none !important; }
  .sh-st-call-s { display: none; }

  .sh-inner { position: relative; max-width: 1600px; margin: 0 auto; height: 76px; padding: 0 clamp(20px, 4vw, 56px); display: flex; align-items: center; gap: 30px; }
  /* bar background: a solid cream layer and a frosted layer that swap on scroll (both scaleY from the top edge) */
  .sh-inner::before, .sh-inner::after { content: ""; position: absolute; inset: 0; z-index: -2; pointer-events: none; transform-origin: 50% 0;
    transition: transform .25s var(--sh-ease), opacity .25s var(--sh-ease); }
  .sh-inner::before { background: #fbf1e2; box-shadow: inset 0 -1px 0 rgba(201,154,67,.45); }
  .sh-inner::after { opacity: 0; background: rgba(251,241,226,.78); -webkit-backdrop-filter: blur(12px) saturate(1.2); backdrop-filter: blur(12px) saturate(1.2);
    box-shadow: inset 0 -1px 0 rgba(201,154,67,.4), 0 12px 24px -14px rgba(43,36,22,.5); }
  .sh-scrolled .sh-inner::before { opacity: 0; transform: scaleY(var(--sh-k)); }
  .sh-scrolled .sh-inner::after { opacity: 1; transform: scaleY(var(--sh-k)); }
  .sh-logo, .sh-actions, .sh-link, .sh-pill { transition: transform .25s var(--sh-ease), color .2s var(--sh-ease); }
  .sh-scrolled :is(.sh-actions, .sh-link, .sh-pill) { transform: translateY(var(--sh-dy)); }

  .sh-logo { display: flex; align-items: center; gap: 12px; flex: none; min-height: 44px; text-decoration: none; transform-origin: 0 50%; }
  .sh-scrolled .sh-logo { transform: translateY(var(--sh-dy)) scale(.86); }
  /* the logo scales to .86 on scroll: an invisible extension keeps the tap area at 44px or more */
  .sh-logo { position: relative; }
  .sh-logo::after { content: ""; position: absolute; inset: -6px -4px; }
  .sh-logo img { display: block; width: auto; }
  /* wordmark: exact brand shape and green, plus a carved look (1px top highlight, soft shadow under). No gradient on the letters. */
  .sh-lg-word { height: 30px; filter: drop-shadow(0 -1px 0 rgba(255,251,242,.9)) drop-shadow(0 1.5px 1.5px rgba(16,38,26,.28)); }
  /* 3D elephant: same 36x46 box as the old flat mark (no shift); shine is masked to the elephant's own shape */
  .sh-lg-el { position: relative; display: block; flex: none; width: 36px; height: 46px; transform-origin: 50% 80%; transition: transform .3s var(--sh-ease); }
  .sh-lg-el .sh-lg-el-img { width: 100%; height: 100%; object-fit: contain; }
  .sh-lg-shine { position: absolute; inset: 0; overflow: hidden; pointer-events: none;
    -webkit-mask: url(/assets/brand/fursat-elephant-3d-v1@2x.webp) center / contain no-repeat; mask: url(/assets/brand/fursat-elephant-3d-v1@2x.webp) center / contain no-repeat; }
  .sh-lg-shine i { position: absolute; top: -10%; bottom: -10%; left: 0; width: 55%; transform: translateX(-140%) skewX(-18deg);
    background: linear-gradient(100deg, transparent, rgba(255,226,150,.85) 50%, transparent); animation: sh-shine 8s cubic-bezier(.4,0,.2,1) infinite 1.5s; }
  @keyframes sh-shine { 0% { transform: translateX(-140%) skewX(-18deg); } 14%, 100% { transform: translateX(260%) skewX(-18deg); } }
  @media (hover: hover) and (pointer: fine) { .sh-logo:hover .sh-lg-el { transform: translateY(-2px) rotate(-3deg); } }

  .sh-nav { position: relative; display: flex; align-items: center; gap: 4px; margin: 0 auto; }
  .sh-link { all: unset; cursor: pointer; position: relative; box-sizing: border-box; display: inline-flex; align-items: center; gap: 6px; min-height: 44px; padding: 0 14px;
    font: 500 .9375rem/1 var(--fk-sans, Rupee,Poppins, system-ui, sans-serif); color: #1c2a18; white-space: nowrap; text-decoration: none; transition: transform .25s var(--sh-ease), color .2s var(--sh-ease); }
  /* keyboard focus: the underline draws in (no glide for keyboard) */
  .sh-link::after { content: ""; position: absolute; left: 14px; right: 14px; bottom: 6px; height: 2px; border-radius: 2px; background: #14301c; transform: scaleX(0); transform-origin: 0 50%; transition: transform .24s var(--sh-ease); }
  .sh-link:focus-visible { outline: none; }
  .sh-link:focus-visible::after { transform: scaleX(1); }
  /* active page: red dot on a cream pill */
  .sh-link.active, .sh-link[aria-current="page"] { color: #14301c; font-weight: 600; }
  .sh-link.active::before, .sh-link[aria-current="page"]::before { content: ""; position: absolute; inset: 4px 2px; z-index: -1; border-radius: 999px;
    background: radial-gradient(circle at 8px 50%, #c0291f 0 2.5px, transparent 3px), #fff8ec; box-shadow: inset 0 0 0 1px rgba(201,154,67,.45), 0 1px 2px rgba(43,36,22,.08); }
  /* sliding gold pill: one element, three parts so the rounded ends never stretch (transforms only) */
  .sh-pill { position: absolute; left: 0; top: 50%; height: 36px; margin-top: -18px; z-index: -1; pointer-events: none; opacity: 0; transition: opacity .15s ease-out, transform .25s var(--sh-ease); }
  .sh-pill.on { opacity: 1; }
  .sh-pill i { position: absolute; left: 0; top: 0; height: 36px; background: rgba(201,154,67,.26); box-shadow: inset 0 0 0 1px rgba(201,154,67,.5); transition: transform 260ms cubic-bezier(.34,1.4,.64,1); }
  .sh-pill .l { width: 18px; border-radius: 18px 0 0 18px; transform: translateX(calc(var(--x, 0) * 1px)); }
  .sh-pill .m { width: 1px; box-shadow: inset 0 1px 0 rgba(201,154,67,.5), inset 0 -1px 0 rgba(201,154,67,.5); transform: translateX(calc(var(--x, 0) * 1px + 18px)) scaleX(calc(var(--w, 72) - 36)); transform-origin: 0 50%; }
  .sh-pill .r { width: 18px; border-radius: 0 18px 18px 0; transform: translateX(calc(var(--x, 0) * 1px + var(--w, 72) * 1px - 18px)); }
  .sh-pill.jump i { transition: none; }
  .sh-arr { width: 14px; height: 14px; transition: transform .25s ease; }
  .sh-drop { position: static; }
  .sh-drop:hover .sh-arr, .sh-drop-btn[aria-expanded="true"] .sh-arr { transform: rotate(180deg); }

  /* mega panels: a photo card per item, cards stagger in 40ms apart, panel fades and slides 8px */
  .sh-menu { position: absolute; top: 100%; left: 50%; width: max-content; max-width: 94vw; margin-top: 6px; padding: 14px; z-index: 105; display: flex; gap: 10px;
    background: #fbf1e2; border: 1px solid rgba(201,154,67,.45); border-radius: 20px; box-shadow: 0 24px 48px -24px rgba(43,36,22,.5);
    opacity: 0; transform: translate(-50%, 8px); visibility: hidden; pointer-events: none;
    transition: opacity .22s var(--sh-ease), transform .22s var(--sh-ease), visibility 0s linear .22s; }
  .sh-menu::before { content: ""; position: absolute; left: 0; right: 0; top: -8px; height: 8px; }
  .sh-drop.is-open .sh-menu { opacity: 1; visibility: visible; pointer-events: auto; transform: translate(-50%, 0); transition-delay: 0s; }
  @media (hover: hover) and (pointer: fine) { .sh-drop:hover .sh-menu { opacity: 1; visibility: visible; pointer-events: auto; transform: translate(-50%, 0); transition-delay: 0s; } }
  .sh-scrolled .sh-menu { margin-top: -10px; }
  .sh-card { position: relative; flex: 0 0 168px; width: 168px; display: flex; flex-direction: column; gap: 3px; padding: 8px 8px 12px; border-radius: 14px; text-decoration: none; color: #14301c;
    opacity: 0; transform: translateY(8px); transition: opacity .15s ease-out, transform .15s ease-out, background-color .2s; }
  .sh-drop.is-open .sh-card { opacity: 1; transform: none; transition: opacity .28s var(--sh-ease) calc(var(--i) * 40ms + 40ms), transform .28s var(--sh-ease) calc(var(--i) * 40ms + 40ms), background-color .2s; }
  @media (hover: hover) and (pointer: fine) { .sh-drop:hover .sh-card { opacity: 1; transform: none; transition: opacity .28s var(--sh-ease) calc(var(--i) * 40ms + 40ms), transform .28s var(--sh-ease) calc(var(--i) * 40ms + 40ms), background-color .2s; }
    .sh-card:hover { background: rgba(201,154,67,.16); } .sh-card:hover .sh-card-img img { transform: scale(1.05); } }
  .sh-card-img { position: relative; display: block; aspect-ratio: 1 / .78; margin-bottom: 8px; border-radius: 10px; overflow: hidden; background: #f3e2c6; }
  .sh-card-img::after { content: ""; position: absolute; inset: 0; border-radius: inherit; box-shadow: inset 0 0 0 1px rgba(0,0,0,.1); pointer-events: none; }
  .sh-card-img img { width: 100%; height: 100%; object-fit: cover; display: block; transition: transform .35s var(--sh-ease); }
  .sh-card-t { font: 600 1rem/1.2 var(--fk-serif, "Playfair Display", Georgia, serif); letter-spacing: -.01em; }
  .sh-card small { font: 400 .8125rem/1.4 var(--fk-sans, Rupee,Poppins, sans-serif); color: #5a5040; text-wrap: pretty; }
  .sh-card:focus-visible { outline: 2px solid #14301c; outline-offset: -2px; background: rgba(201,154,67,.16); }

  .sh-header :is(a, button):focus-visible { outline: 2px solid #14301c; outline-offset: 3px; border-radius: 999px; }
  .sh-header .sh-card:focus-visible { border-radius: 14px; outline-offset: -2px; }

  .sh-actions { display: flex; align-items: center; gap: 8px; flex: none; }
  .sh-reserve-btn { position: relative; overflow: hidden; display: inline-flex; align-items: center; justify-content: center; min-height: 48px; padding: 0 28px; border-radius: 999px; text-decoration: none;
    font: 600 .9375rem/1 var(--fk-sans, Rupee,Poppins, sans-serif); letter-spacing: .02em; color: #fff; background: var(--fk-red, #c0291f); box-shadow: 0 6px 16px -8px rgba(192,41,31,.7);
    transform: translate(var(--mx, 0px), var(--my, 0px)) scale(var(--s, 1)); transition: transform .2s var(--sh-ease), background-color .2s; }
  .sh-rs-txt { position: relative; }
  .sh-rs-shine { position: absolute; inset: 0; overflow: hidden; border-radius: inherit; pointer-events: none; }
  .sh-rs-shine i { position: absolute; top: 0; bottom: 0; left: 0; width: 40%; transform: translateX(-160%) skewX(-18deg);
    background: linear-gradient(100deg, transparent, rgba(255,226,170,.5) 50%, transparent); animation: sh-rshine 10s cubic-bezier(.4,0,.2,1) infinite 3s; }
  @keyframes sh-rshine { 0% { transform: translateX(-160%) skewX(-18deg); } 12%, 100% { transform: translateX(420%) skewX(-18deg); } }
  .sh-reserve-btn:hover { background: #a82219; }
  .sh-reserve-btn:active { --s: .96; transition-duration: .15s; }
  .sh-reserve-btn.is-current { box-shadow: 0 0 0 3px rgba(192,41,31,.2); }
  .sh-header .sh-reserve-btn:focus-visible { outline-color: #14301c; }

  .sh-burger { all: unset; cursor: pointer; display: none; flex-direction: column; justify-content: center; gap: 5px; width: 44px; height: 44px; padding: 10px; box-sizing: border-box; -webkit-tap-highlight-color: transparent; }
  .sh-burger span { display: block; height: 2.5px; width: 100%; background: #1c2a18; border-radius: 2px; transition: transform .24s ease, opacity .24s ease; }
  .sh-burger[aria-expanded="true"] span:nth-child(1) { transform: translateY(7.5px) rotate(45deg); }
  .sh-burger[aria-expanded="true"] span:nth-child(2) { opacity: 0; }
  .sh-burger[aria-expanded="true"] span:nth-child(3) { transform: translateY(-7.5px) rotate(-45deg); }

  /* phone sheet: full screen, 3D elephant on top, big 56px rows that rise in one by one (50ms), actions pinned at the bottom */
  html.sh-sheet-open, html.sh-sheet-open body { overflow: hidden !important; }
  /* the page's floating buttons sit at z-index 8500+, so the open sheet lifts the header above them */
  html.sh-sheet-open #site-header.sh-header { z-index: 9400; }
  .sh-mobile-panel { position: fixed; inset: 0; z-index: 20; display: flex; flex-direction: column; height: 100dvh; background: #fbf1e2; padding-top: env(safe-area-inset-top, 0px);
    opacity: 0; transition: opacity .2s ease-out; }
  .sh-mobile-panel.is-open { opacity: 1; }
  .sh-mobile-panel[hidden] { display: none; }
  .sh-mp-top { position: relative; flex: none; display: flex; align-items: center; justify-content: center; height: 108px; }
  .sh-mp-brand { display: flex; align-items: center; gap: 12px; transform: scale(.95); opacity: 0; transition: transform .3s var(--sh-ease), opacity .3s var(--sh-ease); }
  .is-open .sh-mp-brand { transform: none; opacity: 1; transition-delay: .05s; }
  .sh-mp-el { width: 60px; height: 77px; display: block; }
  .sh-mp-word { height: 30px; width: auto; display: block; filter: drop-shadow(0 -1px 0 rgba(255,251,242,.9)) drop-shadow(0 1.5px 1.5px rgba(16,38,26,.28)); }
  .sh-mp-close { all: unset; cursor: pointer; position: absolute; right: 12px; top: 12px; width: 44px; height: 44px; box-sizing: border-box; display: grid; place-items: center; border-radius: 50%; color: #1c2a18; -webkit-tap-highlight-color: transparent; }
  .sh-mp-close svg { width: 24px; height: 24px; }
  .sh-mp-scroll { flex: 1; min-height: 0; overflow-y: auto; overscroll-behavior: contain; padding: 0 20px 16px; }
  .sh-mp-link { display: flex; align-items: center; justify-content: space-between; box-sizing: border-box; min-height: 56px; padding: 0 4px; border-bottom: 1px solid rgba(201,154,67,.4);
    font: 600 1.5rem/1.1 var(--fk-serif, "Playfair Display", Georgia, serif); letter-spacing: -.01em; color: #1c2a18; text-decoration: none; -webkit-tap-highlight-color: transparent;
    opacity: 0; transform: translateY(14px); }
  .sh-mp-link::after { content: ""; width: 8px; height: 8px; border: solid currentColor; border-width: 2px 2px 0 0; transform: rotate(45deg); opacity: .45; flex: none; }
  .sh-mp-link[aria-current="page"] { color: var(--fk-red, #c0291f); }
  .sh-mp-label { display: block; margin: 18px 0 2px; font: 600 .75rem/1 var(--fk-sans, Rupee,Poppins, sans-serif); letter-spacing: .05em; text-transform: uppercase; color: #6b5324; opacity: 0; transform: translateY(14px); }
  .is-open .sh-mp-link, .is-open .sh-mp-label { opacity: 1; transform: none; transition: opacity .3s var(--sh-ease) calc(var(--i) * 50ms + 80ms), transform .3s var(--sh-ease) calc(var(--i) * 50ms + 80ms); }
  .sh-mp-link:active { background: rgba(201,154,67,.14); }
  .sh-mp-pin { flex: none; display: flex; gap: 8px; padding: 12px 16px calc(12px + env(safe-area-inset-bottom, 0px)); background: #fbf1e2; border-top: 1px solid rgba(201,154,67,.45); }
  .sh-mp-reserve, .sh-mp-wa, .sh-mp-call { display: grid; place-items: center; min-height: 48px; border-radius: 999px; font: 600 .9375rem/1 var(--fk-sans, Rupee,Poppins, sans-serif); text-decoration: none; -webkit-tap-highlight-color: transparent; transition: transform .15s ease-out; }
  .sh-mp-reserve:active, .sh-mp-wa:active, .sh-mp-call:active { transform: scale(.96); }
  .sh-mp-reserve { flex: 1.3; background: var(--fk-red, #c0291f); color: #fff; }
  .sh-mp-wa { flex: 1.2; background: #2a5019; color: #fff; }
  .sh-mp-call { flex: 1; border: 1.5px solid #c99a43; color: #1c2a18; }
  .sh-mp-link:focus-visible, .sh-mp-close:focus-visible { border-radius: 12px; outline-offset: -3px; }
  /* the open sheet owns the bottom edge: hide the quick-nav bar so Reserve + WhatsApp + Call stay reachable */
  html:has(#sh-mobile-panel:not([hidden])) .mb-bar { display: none; }

  @media (max-width: 1160px) { .sh-nav { gap: 0; } .sh-link { padding: 0 10px; font-size: .9rem; } .sh-link::after { left: 10px; right: 10px; } .sh-inner { gap: 16px; } .sh-st-hours { display: none; } }
  @media (max-width: 1040px) { .sh-nav { display: none; } .sh-burger { display: flex; } .sh-actions { margin-left: auto; } }
  @media (max-width: 820px) {
    .sh-header { --sh-k: .867; --sh-dy: -4px; }
    .sh-strip { height: 34px; justify-content: space-between; gap: 10px; font-size: .75rem; }
    .sh-st--map, .sh-st-sep { display: none; }
    .sh-st-call-n { display: none; } .sh-st-call-s { display: inline; }
    .sh-inner { height: 60px; gap: 8px; padding: 0 12px; }
    .sh-lg-el { width: 30px; height: 38px; } .sh-lg-word { height: 24px; }
    .sh-reserve-btn { min-height: 44px; padding: 0 20px; }
  }
  /* kit 47 bug 5: 320px phones: the burger ended 18px past the screen edge */
  @media (max-width: 359px) {
    .sh-inner { gap: 6px; padding: 0 8px; }
    .sh-logo { gap: 8px; min-width: 0; }
    .sh-lg-el { height: 32px; } .sh-lg-word { height: 20px; }
    .sh-reserve-btn { padding: 0 14px; }
  }
</style>

<script is:inline>
  function initHeader() {
    const header = document.getElementById('site-header');
    if (!header) return;
    const burger = document.getElementById('sh-burger');
    const panel = document.getElementById('sh-mobile-panel');
    const finePointer = matchMedia('(hover: hover) and (pointer: fine)').matches;

    // 3D elephant: if the new file ever fails, fall back to the old flat mark (same box, no shift)
    const el = header.querySelector('.sh-lg-el-img');
    if (el && !el.dataset.fb) {
      el.dataset.fb = '1';
      const fallback = () => { el.removeAttribute('srcset'); el.src = el.dataset.fallback; const s = header.querySelector('.sh-lg-shine'); if (s) s.remove(); };
      el.addEventListener('error', fallback, { once: true });
      if (el.complete && el.naturalWidth === 0) fallback();
    }

    if (burger && panel && !burger.dataset.init) {
      burger.dataset.init = '1';
      const closeBtn = panel.querySelector('.sh-mp-close');
      const root = document.documentElement;
      let closeTimer = 0;
      const focusables = () => Array.from(panel.querySelectorAll('a[href], button:not([disabled])'));
      // Phone sheet: opening locks the page and moves focus to the first link; closing (X, burger, Esc, or widening past the burger breakpoint) puts focus back on the burger.
      const setPanel = (open, restore) => {
        clearTimeout(closeTimer);
        burger.setAttribute('aria-expanded', String(open));
        burger.setAttribute('aria-label', open ? 'Close navigation menu' : 'Open navigation menu');
        root.classList.toggle('sh-sheet-open', open);
        if (open) {
          panel.hidden = false;
          void panel.offsetWidth;
          panel.classList.add('is-open');
          const first = panel.querySelector('.sh-mp-link');
          if (first) first.focus({ preventScroll: true });
        } else {
          panel.classList.remove('is-open');
          closeTimer = setTimeout(() => { panel.hidden = true; }, 180);
          if (restore) burger.focus();
        }
      };
      burger.addEventListener('click', () => setPanel(burger.getAttribute('aria-expanded') !== 'true', true));
      if (closeBtn) closeBtn.addEventListener('click', () => setPanel(false, true));
      panel.addEventListener('keydown', (e) => {
        if (e.key === 'Escape') { e.stopPropagation(); setPanel(false, true); return; }
        if (e.key !== 'Tab') return;
        // focus trap: Tab and Shift+Tab wrap inside the sheet
        const list = focusables(); if (!list.length) return;
        const first = list[0], last = list[list.length - 1];
        if (e.shiftKey && document.activeElement === first) { e.preventDefault(); last.focus(); }
        else if (!e.shiftKey && document.activeElement === last) { e.preventDefault(); first.focus(); }
      });
      burger.addEventListener('keydown', (e) => {
        if (e.key === 'Escape' && burger.getAttribute('aria-expanded') === 'true') setPanel(false, true);
      });
      panel.querySelectorAll('a').forEach((a) => a.addEventListener('click', () => { if (a.getAttribute('data-open') !== 'book') return; setPanel(false, false); }));
      matchMedia('(min-width: 1041px)').addEventListener('change', (m) => { if (m.matches && !panel.hidden) setPanel(false, false); });
    }

    // Nothing below is needed for first paint (dropdowns, gold pill, magnetic button): set it up when the browser is idle.
    const idle = (fn) => ('requestIdleCallback' in window) ? requestIdleCallback(fn, { timeout: 1200 }) : setTimeout(fn, 200);
    idle(function setupDesktop() {
    // Desktop dropdowns: button toggles, Esc closes and returns focus to the button, focus leaving the group closes it.
    document.querySelectorAll('.sh-drop').forEach((drop) => {
      if (drop.dataset.init) return;
      drop.dataset.init = '1';
      const btn = drop.querySelector('.sh-drop-btn');
      const items = () => Array.from(drop.querySelectorAll('.sh-menu a'));
      const set = (open) => { drop.classList.toggle('is-open', open); btn.setAttribute('aria-expanded', String(open)); };
      // the card photos load the first time a panel is touched, not at page load
      const loadImgs = () => drop.querySelectorAll('img[data-src]').forEach((im) => { im.src = im.dataset.src; im.removeAttribute('data-src'); });
      ['pointerenter', 'focusin', 'click'].forEach((ev) => drop.addEventListener(ev, loadImgs, { once: true }));
      btn.addEventListener('click', () => set(btn.getAttribute('aria-expanded') !== 'true'));
      btn.addEventListener('keydown', (e) => {
        if (e.key === 'ArrowDown') { e.preventDefault(); e.stopPropagation(); set(true); const f = items()[0]; if (f) f.focus(); }
      });
      drop.addEventListener('keydown', (e) => {
        const list = items(), i = list.indexOf(document.activeElement);
        if (e.key === 'Escape' && btn.getAttribute('aria-expanded') === 'true') { e.stopPropagation(); set(false); btn.focus(); }
        else if ((e.key === 'ArrowDown' || e.key === 'ArrowRight') && i > -1) { e.preventDefault(); list[(i + 1) % list.length].focus(); }
        else if ((e.key === 'ArrowUp' || e.key === 'ArrowLeft') && i > -1) { e.preventDefault(); if (i === 0) btn.focus(); else list[i - 1].focus(); }
      });
      drop.addEventListener('focusout', (e) => { if (!drop.contains(e.relatedTarget)) set(false); });
      // opening one closes the other
      btn.addEventListener('click', () => document.querySelectorAll('.sh-drop').forEach((o) => { if (o !== drop) { o.classList.remove('is-open'); o.querySelector('.sh-drop-btn').setAttribute('aria-expanded', 'false'); } }));
    });
    // click outside closes any open dropdown
    if (!window.__shOutside) {
      window.__shOutside = true;
      document.addEventListener('click', (e) => {
        document.querySelectorAll('.sh-drop.is-open').forEach((d) => { if (!d.contains(e.target)) { d.classList.remove('is-open'); d.querySelector('.sh-drop-btn').setAttribute('aria-expanded', 'false'); } });
      });
    }

    // Sliding gold pill (mouse only): one element glides between the links. Keyboard gets the underline instead, no glide.
    const nav = header.querySelector('.sh-nav'), pill = nav && nav.querySelector('.sh-pill');
    if (nav && pill && finePointer && !nav.dataset.init) {
      nav.dataset.init = '1';
      const place = (link) => {
        const r = link.getBoundingClientRect(), n = nav.getBoundingClientRect();
        const first = !pill.classList.contains('on');
        if (first) pill.classList.add('jump');
        pill.style.setProperty('--x', (r.left - n.left).toFixed(1));
        pill.style.setProperty('--w', r.width.toFixed(1));
        if (first) { void pill.offsetWidth; pill.classList.remove('jump'); }
        pill.classList.add('on');
      };
      nav.addEventListener('pointerover', (e) => { if (e.pointerType === 'touch') return; const l = e.target.closest && e.target.closest('.sh-link'); if (l) place(l); });
      nav.addEventListener('pointerleave', () => pill.classList.remove('on'));
    }

    // Reserve button: magnetic pull (max 6px), mouse only
    const rb = header.querySelector('.sh-reserve-btn');
    if (rb && finePointer && !rb.dataset.init) {
      rb.dataset.init = '1';
      let mx = 0, my = 0;
      const set = (x, y) => { mx = x; my = y; rb.style.setProperty('--mx', x.toFixed(2) + 'px'); rb.style.setProperty('--my', y.toFixed(2) + 'px'); };
      rb.addEventListener('pointermove', (e) => {
        const r = rb.getBoundingClientRect();
        const cx = r.left - mx + r.width / 2, cy = r.top - my + r.height / 2;
        const dx = Math.max(-1, Math.min(1, (e.clientX - cx) / (r.width / 2)));
        const dy = Math.max(-1, Math.min(1, (e.clientY - cy) / (r.height / 2)));
        set(dx * 6, dy * 6);
      });
      rb.addEventListener('pointerleave', () => set(0, 0));
    }

    });

    /* ── Shrink after 40px + hide-on-down / show-on-up ───────────────────────
       The page may scroll the window, <html> or <body> (desktop 07.css), so listen on the document in the capture phase
       (scroll events do not bubble) and read whichever scroller moved. */
    if (header.dataset.init) return;
    header.dataset.init = '1';
    header.addEventListener('focusin', () => { header.classList.remove('sh-hidden'); });
    const root = document.documentElement;
    const readY = () => Math.max(window.scrollY || 0, root.scrollTop || 0, document.body ? document.body.scrollTop : 0);
    let lastY = readY(), ticking = false;
    function onScroll() {
      ticking = false;
      const y = readY();
      if (y > 40) header.classList.add('sh-scrolled'); else if (y < 24) header.classList.remove('sh-scrolled');
      if (y < 20) { header.classList.remove('sh-hidden'); lastY = y; return; }
      if (y > lastY + 4 && (!panel || panel.hidden)) header.classList.add('sh-hidden');
      else if (y < lastY - 4) header.classList.remove('sh-hidden');
      lastY = y;
    }
    document.addEventListener('scroll', (e) => {
      const t = e.target;
      if (t !== document && t !== root && t !== document.body) return; // ignore inner scrollers (carousels, the sheet)
      if (!ticking) { ticking = true; requestAnimationFrame(onScroll); }
    }, { passive: true, capture: true });
    onScroll();
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initHeader);
  } else {
    initHeader();
  }
  document.addEventListener('astro:page-load', initHeader);
</script>
