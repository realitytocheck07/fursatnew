<script is:inline>
  function initHeader() {
    const burger = document.getElementById('sh-burger');
    const panel = document.getElementById('sh-mobile-panel');
    if (burger && panel && !burger.dataset.init) {
      burger.dataset.init = '1';
      // Phone menu: opening moves focus to the first link; closing (button, Esc, or widening past the burger breakpoint) puts it back on the burger.
      const setPanel = (open, restore) => {
        burger.setAttribute('aria-expanded', String(open));
        burger.setAttribute('aria-label', open ? 'Close navigation menu' : 'Open navigation menu');
        panel.hidden = !open;
        if (open) { const first = panel.querySelector('a'); if (first) first.focus(); }
        else if (restore) burger.focus();
      };
      burger.addEventListener('click', () => setPanel(burger.getAttribute('aria-expanded') !== 'true', true));
      panel.addEventListener('keydown', (e) => {
        if (e.key === 'Escape') { e.stopPropagation(); setPanel(false, true); return; }
        if (e.key !== 'Tab') return;
        // keep Tab inside the open panel + burger: last link -> burger, burger -> first link handled by order
        const links = panel.querySelectorAll('a');
        const last = links[links.length - 1];
        if (!e.shiftKey && document.activeElement === last) { e.preventDefault(); burger.focus(); }
      });
      burger.addEventListener('keydown', (e) => {
        if (e.key === 'Escape' && burger.getAttribute('aria-expanded') === 'true') setPanel(false, true);
      });
      matchMedia('(min-width: 1041px)').addEventListener('change', (m) => { if (m.matches && !panel.hidden) setPanel(false, false); });
    }

    // Desktop dropdowns: button toggles, Esc closes and returns focus to the button, focus leaving the group closes it.
    document.querySelectorAll('.sh-drop').forEach((drop) => {
      if (drop.dataset.init) return;
      drop.dataset.init = '1';
      const btn = drop.querySelector('.sh-drop-btn');
      const items = () => Array.from(drop.querySelectorAll('.sh-menu a'));
      const set = (open) => { drop.classList.toggle('is-open', open); btn.setAttribute('aria-expanded', String(open)); };
      btn.addEventListener('click', () => set(btn.getAttribute('aria-expanded') !== 'true'));
      btn.addEventListener('keydown', (e) => {
        if (e.key === 'ArrowDown') { e.preventDefault(); e.stopPropagation(); set(true); const f = items()[0]; if (f) f.focus(); }
      });
      drop.addEventListener('keydown', (e) => {
        const list = items(), i = list.indexOf(document.activeElement);
        if (e.key === 'Escape' && btn.getAttribute('aria-expanded') === 'true') { e.stopPropagation(); set(false); btn.focus(); }
        else if (e.key === 'ArrowDown' && i > -1) { e.preventDefault(); list[(i + 1) % list.length].focus(); }
        else if (e.key === 'ArrowUp' && i > -1) { e.preventDefault(); if (i === 0) btn.focus(); else list[i - 1].focus(); }
      });
      drop.addEventListener('focusout', (e) => { if (!drop.contains(e.relatedTarget)) set(false); });
      // opening one closes the other
      btn.addEventListener('click', () => document.querySelectorAll('.sh-drop').forEach((o) => { if (o !== drop) { o.classList.remove('is-open'); o.querySelector('.sh-drop-btn').setAttribute('aria-expanded', 'false'); } }));
    });
    // click outside closes any open dropdown
    if (!window.__shOutside) {
      window.__shOutside = true;
      document.addEventListener('click', (e) => {
        document.querySelectorAll('.sh-drop.is-open').forEach((d) => { if (!d.contains(e.target)) { d.classList.remove('is-open'); d.querySelector('.sh-drop-btn').setAttribute('aria-expanded', 'false'); } });
      });
    }

    /* ── Scroll shrink + hide-on-down / show-on-up ───────────────────────── */
    const header = document.getElementById('site-header');
    if (!header || header.dataset.init) return;
    header.dataset.init = '1';

    // Show header immediately on focus-within (keyboard Tab navigation)
    header.addEventListener('focusin', () => {
      header.classList.remove('sh-hidden');
    });

    let lastY = window.scrollY;
    let ticking = false;

    function onScroll() {
      const y = window.scrollY;

      /* Near top: always show, unshrink */
      if (y < 20) {
        header.classList.remove('sh-scrolled', 'sh-hidden');
        lastY = y;
        ticking = false;
        return;
      }

      /* Shrink after 40px */
      if (y > 40) {
        header.classList.add('sh-scrolled');
      } else {
        header.classList.remove('sh-scrolled');
      }

      /* Hide on scroll-down, show on scroll-up (never while the phone menu is open) */
      if (y > lastY + 4 && (!panel || panel.hidden)) {
        header.classList.add('sh-hidden');
      } else if (y < lastY - 4) {
        header.classList.remove('sh-hidden');
      }

      lastY = y;
      ticking = false;
    }

    window.addEventListener('scroll', () => {
      if (!ticking) {
        requestAnimationFrame(onScroll);
        ticking = true;
      }
    }, { passive: true });
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initHeader);
  } else {
    initHeader();
  }
  document.addEventListener('astro:page-load', initHeader);
</script>

<script is:inline>
  /* HEADER-MOTION: the gold line glides to the hovered / focused nav link and rests on the current page */
  (() => {
    const nav = document.querySelector('.sh-nav'), ind = nav && nav.querySelector('.sh-ind');
    if (!nav || !ind || ind.dataset.init) return;
    ind.dataset.init = '1';
    let raf = 0;
    const rest = () => nav.querySelector('.sh-link.active, .sh-link[aria-current="page"]');
    const to = (el, instant) => {
      if (!el) { ind.classList.remove('is-on'); return; }
      const r = el.getBoundingClientRect(), n = nav.getBoundingClientRect();
      if (!r.width) { ind.classList.remove('is-on'); return; }
      const first = !ind.classList.contains('is-on');
      if (instant || first) ind.style.transition = 'none';
      ind.style.setProperty('--ix', (r.left - n.left + 14).toFixed(1) + 'px');
      ind.style.setProperty('--iw', (Math.max(0, r.width - 28) / 100).toFixed(3));
      if (instant || first) { void ind.offsetWidth; ind.style.transition = ''; }
      ind.classList.add('is-on');
    };
    const home = (instant) => to(rest(), instant);
    nav.addEventListener('pointerover', (e) => { const l = e.target.closest && e.target.closest('.sh-link'); if (l && e.pointerType !== 'touch') to(l); });
    nav.addEventListener('focusin', (e) => { const l = e.target.closest && e.target.closest('.sh-link'); if (l) to(l); });
    nav.addEventListener('pointerleave', () => home());
    nav.addEventListener('focusout', (e) => { if (!nav.contains(e.relatedTarget)) home(); });
    const again = () => { cancelAnimationFrame(raf); raf = requestAnimationFrame(() => home(true)); };
    addEventListener('resize', again);
    addEventListener('load', again);
    if (document.fonts && document.fonts.ready) document.fonts.ready.then(again);
    home(true);
  })();
</script>
