---
import site from '../data/site.json';
// SiteHeader.astro - Fursat Luxury Hospitality Navigation
// One cream header for every page. Home keeps it in the page flow (its 07.css layout is sized to it); all other pages overlay it (position: fixed).
// Height is the CSS variable --sh-h (fk-tokens.css), constant while scrolling, so first sections can use padding-top: var(--sh-h).
interface Props {
  active?: string;
  /** Ignored. Older pages still pass variant="plaster"; there is only one header now. */
  variant?: string;
}
const { active = 'home' } = Astro.props;
// live "Open now" badge: hours come only from site.json (schedule with dayOfWeek/opens/closes, IST)
const phone = site.phone, phonePlain = site.phonePlain;
const hoursData = JSON.stringify(site.hours.schedule.map((s) => ({ d: s.dayOfWeek, o: s.opens, c: s.closes, ol: s.open, cl: s.close })));
---
<header class:list={["sh-header", "sh-plaster", { "sh-flow": active === 'home' }]} id="site-header">
  <!-- Info strip: hours come from site.json; the live badge fills in the open/closed state -->
  <div class="sh-strip">
    <span class="sh-st sh-st--hours"><span class="sh-open" data-hours={hoursData} hidden></span><span class="sh-st-hours">{site.hours.display}</span></span>
    <span class="sh-st-sep" aria-hidden="true"></span>
    <a class="sh-st sh-st--map" href={site.address.googleMaps} target="_blank" rel="noopener"><svg class="sh-sic" viewBox="0 0 24 24" aria-hidden="true"><path d="M12 21s-7-6.2-7-11a7 7 0 0 1 14 0c0 4.8-7 11-7 11Z"/><circle cx="12" cy="10" r="2.5"/></svg>Capital Park, Madhapur</a>
    <span class="sh-st-sep" aria-hidden="true"></span>
    <a class="sh-st sh-st--call" href={`tel:+${phonePlain}`}><svg class="sh-sic" viewBox="0 0 24 24" aria-hidden="true"><path d="M5 4h4l2 5-2.5 1.5a11 11 0 0 0 5 5L15 13l5 2v4a2 2 0 0 1-2 2A16 16 0 0 1 3 6a2 2 0 0 1 2-2Z"/></svg><span class="sh-st-call-n">Call {phone}</span><span class="sh-st-call-s">Call</span></a>
  </div>
  <div class="sh-inner">
    <a href="/" class="sh-logo" aria-label="Fursat Kitchen | Bar Home">
      <img class="sh-lg-word" src="/assets/brand/fursat-wordmark.svg" alt="Fursat Kitchen | Bar" width="441" height="88" />
      <img class="sh-lg-el" src="/assets/brand/fursat-elephant.webp" alt="" aria-hidden="true" width="135" height="172" />
    </a>

    <nav class="sh-nav" aria-label="Main Navigation">
      <a href="/" class:list={["sh-link", { active: active === 'home' }]} aria-current={active === 'home' ? 'page' : undefined}>Home</a>
      <div class="sh-drop">
        <button class:list={["sh-link", "sh-drop-btn", { active: active === 'menu' }]} type="button" aria-expanded="false" aria-controls="sh-menu-menu"><span>Menu</span><svg class="sh-arr" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="m6 9 6 6 6-6"/></svg></button>
        <div class="sh-menu" id="sh-menu-menu">
          <a href="/menu" class="sh-sub-item"><img class="sh-thumb" src="/assets/nav/menu-all.webp" alt="" width="56" height="56" loading="lazy" decoding="async" /><span class="sh-si-body"><span class="sh-si-t">All Categories</span><small>North Indian, Asian, Continental & Kebabs</small></span></a>
          <a href="/restaurant-bar#cocktails" class="sh-sub-item"><img class="sh-thumb" src="/assets/nav/bar.webp" alt="" width="56" height="56" loading="lazy" decoding="async" /><span class="sh-si-body"><span class="sh-si-t">Bar & Mixology</span><small>Artisanal Cocktails, Single Malts & Beers</small></span></a>
          <a href="/menu?menu=cafe" class="sh-sub-item"><img class="sh-thumb" src="/assets/nav/cafe.webp" alt="" width="56" height="56" loading="lazy" decoding="async" /><span class="sh-si-body"><span class="sh-si-t">Café & Coffee</span><small>Specialty Brews, Shakes & Bakes</small></span></a>
          <a href="/menu?tab=craft" class="sh-sub-item"><img class="sh-thumb" src="/assets/nav/craft.webp" alt="" width="56" height="56" loading="lazy" decoding="async" /><span class="sh-si-body"><span class="sh-si-t">Craft Your Plate</span><small>Customize your feast step-by-step</small></span></a>
        </div>
      </div>

      <div class="sh-drop sh-drop--mega">
        <button class:list={["sh-link", "sh-drop-btn", { active: active === 'celebrate' || active === 'banquet' || active === 'party' || active === 'catering' }]} type="button" aria-expanded="false" aria-controls="sh-menu-celebrate"><span>Celebrate</span><svg class="sh-arr" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="m6 9 6 6 6-6"/></svg></button>
        <div class="sh-menu sh-mega" id="sh-menu-celebrate">
          <a href="/party" class="sh-tile" style="--tile:url(/assets/venue/interior/mural-booths-720.webp)"><span class="sh-tile-t">Parties &amp; Events</span><small>Birthdays, kitty parties, bar bashes and packages</small></a>
          <a href="/banquet" class="sh-tile" style="--tile:url(/assets/venue/banquet/banquet-hall-02-720.webp)"><span class="sh-tile-t">The Grand Banquet Hall</span><small>Capacity 50–350 guests with AV &amp; live stage</small></a>
          <a href="/catering" class="sh-tile" style="--tile:url(/assets/venue/banquet/banquet-tables-02.webp)"><span class="sh-tile-t">Outdoor Catering</span><small>Fursat royal dining delivered to your venue</small></a>
        </div>
      </div>

      <a href="/restaurant-bar" class:list={["sh-link", { active: active === 'restaurant-bar' }]} aria-current={active === 'restaurant-bar' ? 'page' : undefined}>Bar & Kitchen</a>
      <a href="/cafe" class:list={["sh-link", { active: active === 'cafe' }]} aria-current={active === 'cafe' ? 'page' : undefined}>Café</a>
      <a href="/ask" class:list={["sh-link", { active: active === 'ask' }]} aria-current={active === 'ask' ? 'page' : undefined}>Ask Fursat</a>
      <a href="/story" class:list={["sh-link", { active: active === 'story' }]} aria-current={active === 'story' ? 'page' : undefined}>Story</a>
    </nav>

    <div class="sh-actions">
      <a href="/reserve" class:list={["sh-reserve-btn", { "is-current": active === 'reserve' }]} data-open="book" aria-label="Reserve a table" aria-current={active === 'reserve' ? 'page' : undefined}>Reserve</a>
      <button class="sh-burger" id="sh-burger" type="button" aria-label="Open navigation menu" aria-expanded="false" aria-controls="sh-mobile-panel"><span></span><span></span><span></span></button>
    </div>
  </div>

  <!-- Phone menu sheet: Celebrate as photo rows, Reserve + Call pinned at the bottom -->
  <div class="sh-mobile-panel" id="sh-mobile-panel" hidden>
    <div class="sh-mp-scroll">
      <span class="sh-mp-label">Celebrate</span>
      <div class="sh-mp-rows">
        <a href="/party" class="sh-mp-row" style="--tile:url(/assets/venue/interior/mural-booths-480.webp)"><span>Parties &amp; Events</span></a>
        <a href="/banquet" class="sh-mp-row" style="--tile:url(/assets/venue/banquet/banquet-hall-02-480.webp)"><span>The Banquet Hall</span><small>50–350 guests</small></a>
        <a href="/catering" class="sh-mp-row" style="--tile:url(/assets/venue/banquet/banquet-tables-02.webp)"><span>Outdoor Catering</span></a>
      </div>
      <a href="/" class="sh-mp-link" aria-current={active === 'home' ? 'page' : undefined}>Home</a>
      <a href="/menu" class="sh-mp-link">Explore Menu</a>
      <a href="/restaurant-bar" class="sh-mp-link">Restaurant & Bar (21+)</a>
      <a href="/cafe" class="sh-mp-link">Fursat Café & Shakes</a>
      <a href="/ask" class="sh-mp-link">Ask Fursat</a>
      <a href="/story" class="sh-mp-link">Our Story & Heritage</a>
      <a href="/terms" class="sh-mp-link">Offers & Terms</a>
    </div>
    <div class="sh-mp-pin">
      <a href="/reserve" class="sh-mp-reserve" data-open="book" aria-current={active === 'reserve' ? 'page' : undefined}>Reserve a Table</a>
      <a href={`tel:+${phonePlain}`} class="sh-mp-call">Call</a>
    </div>
  </div>
</header>
<script is:inline>
  // Open-now badge + time-of-day mood, both in India time (Asia/Kolkata) whatever the visitor's clock says.
  (function () {
    var now = new Date();
    var parts = new Intl.DateTimeFormat('en-GB', { timeZone: 'Asia/Kolkata', weekday: 'long', hour: '2-digit', minute: '2-digit', hourCycle: 'h23' }).formatToParts(now);
    var get = function (t) { var p = parts.find(function (x) { return x.type === t; }); return p ? p.value : ''; };
    var day = get('weekday'), mins = parseInt(get('hour'), 10) * 60 + parseInt(get('minute'), 10);
    var h = Math.floor(mins / 60);
    document.documentElement.dataset.daypart = h >= 6 && h < 12 ? 'morning' : h >= 12 && h < 17 ? 'day' : 'evening';
    var badges = document.querySelectorAll('.sh-open[data-hours]');
    if (!badges.length) return;
    var sched = JSON.parse(badges[0].getAttribute('data-hours'));
    var DAYS = ['Sunday', 'Monday', 'Tuesday', 'Wednesday', 'Thursday', 'Friday', 'Saturday'];
    var toM = function (s) { var a = s.split(':'); return parseInt(a[0], 10) * 60 + parseInt(a[1], 10); };
    var ruleFor = function (d) { return sched.find(function (r) { return r.d.indexOf(d) > -1; }); };
    var today = ruleFor(day), yest = ruleFor(DAYS[(DAYS.indexOf(day) + 6) % 7]);
    var open = false, until = '';
    if (yest && toM(yest.c) < toM(yest.o) && mins < toM(yest.c)) { open = true; until = yest.cl; }
    else if (today) {
      var o = toM(today.o), c = toM(today.c);
      if (c <= o) c += 1440;
      if (mins >= o && mins < c) { open = true; until = today.cl; }
    }
    var text = open ? 'Open now · until ' + until : 'Closed · opens ' + (today && mins < toM(today.o) ? today.ol : (ruleFor(DAYS[(DAYS.indexOf(day) + 1) % 7]) || {}).ol || '');
    badges.forEach(function (b) { b.textContent = text; b.classList.toggle('is-open', open); b.hidden = false; });
  })();
</script>

<style is:global>
  /* Header C: green info strip + cream bar (elephant mark, red Reserve) + Celebrate photo mega-menu.
     Height is constant (--sh-h: strip + bar), so nothing shifts while scrolling. */
  .sh-header { position: fixed; top: 0; left: 0; right: 0; z-index: 100; background: var(--fk-cream, #fbf1e2); color: #1c2a18;
    transition: transform .32s cubic-bezier(.16,1,.3,1), opacity .32s ease, box-shadow .3s ease; }
  .sh-header.sh-flow { position: sticky; }
  .sh-header.sh-scrolled { box-shadow: 0 12px 24px -20px rgba(43,36,22,.5); }
  .sh-header.sh-hidden { transform: translateY(-110%); opacity: 0; pointer-events: none; }
  .sh-header.sh-hidden:focus-within { transform: none !important; opacity: 1 !important; pointer-events: auto !important; }

  .sh-strip { height: 36px; display: flex; align-items: center; justify-content: center; gap: 20px; padding: 0 16px; overflow: hidden; white-space: nowrap;
    background: #2a5019; color: #f6ecd6; font: 400 .8125rem/1 var(--fk-sans, Rupee,Poppins, system-ui, sans-serif); letter-spacing: .02em; }
  .sh-st { display: inline-flex; align-items: center; gap: 8px; color: inherit; text-decoration: none; min-height: 36px; }
  a.sh-st:hover { color: #fff; text-decoration: underline; text-underline-offset: 3px; }
  .sh-st-sep { width: 1px; height: 14px; background: rgba(230,194,122,.5); }
  .sh-sic { width: 15px; height: 15px; fill: none; stroke: #e6c27a; stroke-width: 1.7; stroke-linecap: round; stroke-linejoin: round; flex: none; }
  .sh-open { display: inline-flex; align-items: center; gap: 7px; font-weight: 600; color: #fff; font-variant-numeric: tabular-nums; }
  .sh-open::before { content: ""; width: 8px; height: 8px; border-radius: 50%; background: #e6c27a; }
  .sh-open.is-open::before { background: #6fd08c; }
  .sh-open[hidden] { display: none !important; }
  .sh-st-call-s { display: none; }

  .sh-inner { position: relative; max-width: 1600px; margin: 0 auto; height: 76px; padding: 0 clamp(20px, 4vw, 56px); display: flex; align-items: center; gap: 30px;
    border-bottom: 1px solid rgba(201,154,67,.45); }
  .sh-logo { display: flex; align-items: center; gap: 12px; flex: none; text-decoration: none; }
  .sh-logo img { display: block; width: auto; }
  .sh-lg-word { height: 30px; order: 2; }
  .sh-lg-el { height: 46px; order: 1; transform-origin: 50% 80%; transition: transform .45s cubic-bezier(.34,1.56,.64,1); }
  @media (hover: hover) { .sh-logo:hover .sh-lg-el { transform: translateY(-2px) rotate(-6deg); } }

  .sh-nav { display: flex; align-items: center; gap: 4px; margin: 0 auto; }
  .sh-link { all: unset; cursor: pointer; position: relative; box-sizing: border-box; display: inline-flex; align-items: center; gap: 6px; min-height: 44px; padding: 0 14px;
    font: 500 .9375rem/1 var(--fk-sans, Rupee,Poppins, system-ui, sans-serif); color: #1c2a18; white-space: nowrap; text-decoration: none; transition: color .2s cubic-bezier(.23,1,.32,1); }
  .sh-link::after { content: ""; position: absolute; left: 14px; right: 14px; bottom: 6px; height: 2px; border-radius: 2px; background: var(--fk-red, #c0291f);
    transform: scaleX(0); transition: transform .24s cubic-bezier(.23,1,.32,1); }
  .sh-link.active, .sh-link[aria-current="page"] { color: var(--fk-red, #c0291f); font-weight: 600; }
  .sh-link.active::after, .sh-link[aria-current="page"]::after { transform: scaleX(1); }
  @media (hover: hover) { .sh-link:hover:not(.active) { color: #2a5019; } .sh-link:hover:not(.active)::after { transform: scaleX(1); background: #2a5019; } }
  .sh-arr { width: 14px; height: 14px; transition: transform .25s ease; }
  .sh-drop { position: relative; }
  .sh-drop:hover .sh-arr, .sh-drop-btn[aria-expanded="true"] .sh-arr { transform: rotate(180deg); }

  .sh-menu { position: absolute; top: 100%; left: 0; margin-top: 6px; min-width: 320px; padding: 10px; z-index: 105; display: flex; flex-direction: column; gap: 4px;
    background: #fbf1e2; border: 1px solid rgba(201,154,67,.45); border-radius: 18px; box-shadow: 0 24px 48px -24px rgba(43,36,22,.5);
    opacity: 0; transform: translateY(10px); visibility: hidden; pointer-events: none;
    transition: opacity .22s cubic-bezier(.16,1,.3,1), transform .22s cubic-bezier(.16,1,.3,1), visibility 0s linear .22s; }
  .sh-menu::before { content: ""; position: absolute; left: 0; right: 0; top: -8px; height: 8px; }
  .sh-drop:hover .sh-menu, .sh-drop.is-open .sh-menu { opacity: 1; visibility: visible; pointer-events: auto; transform: none; transition-delay: 0s; }
  .sh-sub-item { display: flex; align-items: center; gap: 12px; padding: 8px 14px 8px 8px; border-radius: 14px; text-decoration: none; transition: background-color .2s; }
  .sh-si-body { display: flex; flex-direction: column; gap: 3px; min-width: 0; }
  .sh-thumb { width: 56px; height: 56px; flex: none; border-radius: 10px; object-fit: cover; background: #f3e2c6; }
  .sh-si-t { font: 500 .9375rem/1.2 var(--fk-sans, Rupee,Poppins, sans-serif); color: #14301c; }
  .sh-sub-item small { font: 400 .8125rem/1.35 var(--fk-sans, Rupee,Poppins, sans-serif); color: #5a5040; text-wrap: pretty; }
  @media (hover: hover) { .sh-sub-item:hover { background: rgba(201,154,67,.16); } }

  /* Celebrate mega-menu: three photo tiles */
  .sh-mega { left: 50%; width: min(860px, 92vw); flex-direction: row; gap: 14px; padding: 16px; transform: translate(-50%, 10px); }
  .sh-drop:hover .sh-mega, .sh-drop.is-open .sh-mega { transform: translate(-50%, 0); }
  .sh-tile { position: relative; flex: 1 1 0; min-width: 0; height: 230px; border-radius: 14px; overflow: hidden; color: #fff; text-decoration: none; display: flex; flex-direction: column; justify-content: flex-end; gap: 4px; padding: 14px;
    background: var(--tile) center / cover no-repeat, #2a5019; }
  .sh-tile::before { content: ""; position: absolute; inset: 0; background: linear-gradient(180deg, rgba(20,12,4,0) 30%, rgba(20,12,4,.88)); }
  .sh-tile > * { position: relative; }
  .sh-tile-t { font: 600 1.375rem/1.15 var(--fk-serif, "Playfair Display", Georgia, serif); }
  .sh-tile small { font: 400 .8125rem/1.35 var(--fk-sans, Rupee,Poppins, sans-serif); opacity: .95; }
  .sh-tile:hover, .sh-tile:focus-visible { outline: 2px solid #e6c27a; outline-offset: -2px; }

  .sh-header :is(a, button):focus-visible { outline: 2px solid #14301c; outline-offset: 3px; border-radius: 999px; }
  .sh-header .sh-tile:focus-visible, .sh-header .sh-sub-item:focus-visible { border-radius: 14px; outline-offset: -3px; }
  .sh-header .sh-tile:focus-visible { outline-color: #e6c27a; }

  .sh-actions { display: flex; align-items: center; gap: 8px; flex: none; }
  .sh-reserve-btn { display: inline-flex; align-items: center; justify-content: center; min-height: 48px; padding: 0 28px; border-radius: 999px; text-decoration: none;
    font: 600 .9375rem/1 var(--fk-sans, Rupee,Poppins, sans-serif); letter-spacing: .02em; color: #fff; background: var(--fk-red, #c0291f); box-shadow: 0 6px 16px -8px rgba(192,41,31,.7); transition: transform .16s ease, background-color .2s; }
  .sh-reserve-btn:hover { background: #a82219; }
  .sh-reserve-btn:active { transform: scale(.96); }
  .sh-reserve-btn.is-current { box-shadow: 0 0 0 3px rgba(192,41,31,.2); }
  .sh-header .sh-reserve-btn:focus-visible { outline-color: #14301c; }

  .sh-burger { all: unset; cursor: pointer; display: none; flex-direction: column; justify-content: center; gap: 5px; width: 44px; height: 44px; padding: 10px; box-sizing: border-box; }
  .sh-burger span { display: block; height: 2.5px; width: 100%; background: #1c2a18; border-radius: 2px; transition: transform .24s ease, opacity .24s ease; }
  .sh-burger[aria-expanded="true"] span:nth-child(1) { transform: translateY(7.5px) rotate(45deg); }
  .sh-burger[aria-expanded="true"] span:nth-child(2) { opacity: 0; }
  .sh-burger[aria-expanded="true"] span:nth-child(3) { transform: translateY(-7.5px) rotate(-45deg); }

  /* phone sheet */
  .sh-mobile-panel { position: fixed; left: 0; right: 0; top: var(--sh-h); bottom: 0; z-index: 99; display: flex; flex-direction: column; background: #fbf1e2; animation: sh-slide .28s cubic-bezier(.16,1,.3,1); }
  .sh-mobile-panel[hidden] { display: none; }
  @keyframes sh-slide { from { opacity: 0; transform: translateY(12px); } to { opacity: 1; transform: none; } }
  .sh-mp-scroll { flex: 1; overflow-y: auto; overscroll-behavior: contain; padding: 14px 16px 20px; }
  .sh-mp-label { display: block; font: 600 .75rem/1 var(--fk-sans, Rupee,Poppins, sans-serif); letter-spacing: .16em; text-transform: uppercase; color: #6b5324; margin: 4px 0 10px; }
  .sh-mp-rows { display: grid; gap: 10px; margin-bottom: 12px; }
  .sh-mp-row { position: relative; display: flex; align-items: center; justify-content: space-between; gap: 12px; height: 84px; padding: 0 16px; border-radius: 16px; overflow: hidden; color: #fff; text-decoration: none;
    background: var(--tile) center / cover no-repeat, #2a5019; font: 600 1.25rem/1.1 var(--fk-serif, "Playfair Display", Georgia, serif); }
  .sh-mp-row::before { content: ""; position: absolute; inset: 0; background: linear-gradient(90deg, rgba(20,12,4,.8), rgba(20,12,4,.15)); }
  .sh-mp-row > * { position: relative; }
  .sh-mp-row small { font: 500 .8125rem/1 var(--fk-sans, Rupee,Poppins, sans-serif); }
  .sh-mp-link { display: flex; align-items: center; min-height: 48px; padding: 0 4px; border-bottom: 1px solid rgba(201,154,67,.45); font: 500 1rem/1 var(--fk-sans, Rupee,Poppins, sans-serif); color: #1c2a18; text-decoration: none; }
  .sh-mp-link[aria-current="page"] { color: var(--fk-red, #c0291f); font-weight: 600; }
  .sh-mp-pin { display: flex; gap: 10px; padding: 12px 16px calc(12px + env(safe-area-inset-bottom)); background: #fbf1e2; border-top: 1px solid rgba(201,154,67,.45); }
  .sh-mp-reserve, .sh-mp-call { display: grid; place-items: center; min-height: 48px; border-radius: 999px; font: 600 .9375rem/1 var(--fk-sans, Rupee,Poppins, sans-serif); text-decoration: none; }
  .sh-mp-reserve { flex: 1; background: var(--fk-red, #c0291f); color: #fff; }
  .sh-mp-call { padding: 0 26px; border: 1.5px solid #c99a43; color: #1c2a18; }
  .sh-mp-row:focus-visible, .sh-mp-link:focus-visible { border-radius: 12px; }
  /* the open sheet owns the bottom edge: hide the quick-nav bar so Reserve + Call stay reachable */
  html:has(#sh-mobile-panel:not([hidden])) .mb-bar { display: none; }

  @media (max-width: 1160px) { .sh-nav { gap: 0; } .sh-link { padding: 0 10px; font-size: .9rem; } .sh-link::after { left: 10px; right: 10px; } .sh-inner { gap: 16px; } .sh-st-hours { display: none; } }
  @media (max-width: 1040px) { .sh-nav { display: none; } .sh-burger { display: flex; } .sh-actions { margin-left: auto; } }
  @media (max-width: 820px) {
    .sh-strip { height: 34px; justify-content: space-between; gap: 10px; font-size: .75rem; }
    .sh-st--map, .sh-st-sep { display: none; }
    .sh-st-call-n { display: none; } .sh-st-call-s { display: inline; }
    .sh-inner { height: 60px; gap: 8px; padding: 0 12px; }
    .sh-lg-el { height: 38px; } .sh-lg-word { height: 24px; }
    .sh-reserve-btn { min-height: 44px; padding: 0 20px; }
  }
  @media (prefers-reduced-motion: reduce) {
    .sh-header, .sh-link, .sh-link::after, .sh-menu, .sh-arr, .sh-lg-el, .sh-burger span, .sh-reserve-btn, .sh-sub-item { transition: none; }
    .sh-mobile-panel { animation: none; }
    .sh-logo:hover .sh-lg-el { transform: none; }
    .sh-header.sh-hidden { transform: none; }
  }
</style>

<script is:inline>
  function initHeader() {
    const burger = document.getElementById('sh-burger');
    const panel = document.getElementById('sh-mobile-panel');
    if (burger && panel && !burger.dataset.init) {
      burger.dataset.init = '1';
      // Phone menu: opening moves focus to the first link; closing (button, Esc, or widening past the burger breakpoint) puts it back on the burger.
      const setPanel = (open, restore) => {
        burger.setAttribute('aria-expanded', String(open));
        burger.setAttribute('aria-label', open ? 'Close navigation menu' : 'Open navigation menu');
        panel.hidden = !open;
        if (open) { const first = panel.querySelector('a'); if (first) first.focus(); }
        else if (restore) burger.focus();
      };
      burger.addEventListener('click', () => setPanel(burger.getAttribute('aria-expanded') !== 'true', true));
      panel.addEventListener('keydown', (e) => {
        if (e.key === 'Escape') { e.stopPropagation(); setPanel(false, true); return; }
        if (e.key !== 'Tab') return;
        // keep Tab inside the open panel + burger: last link -> burger, burger -> first link handled by order
        const links = panel.querySelectorAll('a');
        const last = links[links.length - 1];
        if (!e.shiftKey && document.activeElement === last) { e.preventDefault(); burger.focus(); }
      });
      burger.addEventListener('keydown', (e) => {
        if (e.key === 'Escape' && burger.getAttribute('aria-expanded') === 'true') setPanel(false, true);
      });
      matchMedia('(min-width: 1041px)').addEventListener('change', (m) => { if (m.matches && !panel.hidden) setPanel(false, false); });
    }

    // Desktop dropdowns: button toggles, Esc closes and returns focus to the button, focus leaving the group closes it.
    document.querySelectorAll('.sh-drop').forEach((drop) => {
      if (drop.dataset.init) return;
      drop.dataset.init = '1';
      const btn = drop.querySelector('.sh-drop-btn');
      const items = () => Array.from(drop.querySelectorAll('.sh-menu a'));
      const set = (open) => { drop.classList.toggle('is-open', open); btn.setAttribute('aria-expanded', String(open)); };
      btn.addEventListener('click', () => set(btn.getAttribute('aria-expanded') !== 'true'));
      btn.addEventListener('keydown', (e) => {
        if (e.key === 'ArrowDown') { e.preventDefault(); e.stopPropagation(); set(true); const f = items()[0]; if (f) f.focus(); }
      });
      drop.addEventListener('keydown', (e) => {
        const list = items(), i = list.indexOf(document.activeElement);
        if (e.key === 'Escape' && btn.getAttribute('aria-expanded') === 'true') { e.stopPropagation(); set(false); btn.focus(); }
        else if (e.key === 'ArrowDown' && i > -1) { e.preventDefault(); list[(i + 1) % list.length].focus(); }
        else if (e.key === 'ArrowUp' && i > -1) { e.preventDefault(); if (i === 0) btn.focus(); else list[i - 1].focus(); }
      });
      drop.addEventListener('focusout', (e) => { if (!drop.contains(e.relatedTarget)) set(false); });
      // opening one closes the other
      btn.addEventListener('click', () => document.querySelectorAll('.sh-drop').forEach((o) => { if (o !== drop) { o.classList.remove('is-open'); o.querySelector('.sh-drop-btn').setAttribute('aria-expanded', 'false'); } }));
    });
    // click outside closes any open dropdown
    if (!window.__shOutside) {
      window.__shOutside = true;
      document.addEventListener('click', (e) => {
        document.querySelectorAll('.sh-drop.is-open').forEach((d) => { if (!d.contains(e.target)) { d.classList.remove('is-open'); d.querySelector('.sh-drop-btn').setAttribute('aria-expanded', 'false'); } });
      });
    }

    /* ── Scroll shrink + hide-on-down / show-on-up ───────────────────────── */
    const header = document.getElementById('site-header');
    if (!header || header.dataset.init) return;
    header.dataset.init = '1';

    // Show header immediately on focus-within (keyboard Tab navigation)
    header.addEventListener('focusin', () => {
      header.classList.remove('sh-hidden');
    });

    let lastY = window.scrollY;
    let ticking = false;

    function onScroll() {
      const y = window.scrollY;

      /* Near top: always show, unshrink */
      if (y < 20) {
        header.classList.remove('sh-scrolled', 'sh-hidden');
        lastY = y;
        ticking = false;
        return;
      }

      /* Shrink after 40px */
      if (y > 40) {
        header.classList.add('sh-scrolled');
      } else {
        header.classList.remove('sh-scrolled');
      }

      /* Hide on scroll-down, show on scroll-up (never while the phone menu is open) */
      if (y > lastY + 4 && (!panel || panel.hidden)) {
        header.classList.add('sh-hidden');
      } else if (y < lastY - 4) {
        header.classList.remove('sh-hidden');
      }

      lastY = y;
      ticking = false;
    }

    window.addEventListener('scroll', () => {
      if (!ticking) {
        requestAnimationFrame(onScroll);
        ticking = true;
      }
    }, { passive: true });
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initHeader);
  } else {
    initHeader();
  }
  document.addEventListener('astro:page-load', initHeader);
</script>
