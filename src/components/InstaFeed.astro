---
// InstaFeed: a section's own Instagram strip, for that section's own account (Banquets, Bites & Buffet, Social Club, Kitchen | Bar).
// Today every tile is a placeholder that opens the account. When the Instagram sync runs (see HANDOFF "Instagram auto-sync") it writes
// src/data/ig-<handle>.json = { "posts": [{ "img": "/assets/ig/<handle>/1.webp", "href": "https://www.instagram.com/p/...", "alt": "..." }] }
// and this component shows those posts instead, with no other change. Nothing is invented: no fake photos, captions or counts.
interface Props { handle: 'fursatind.in' | 'fursatbanquets' | 'fursat_bitesandbuffet' | 'fursatsocialclub'; tone?: 'light' | 'dark'; label?: string; count?: number }
const NAMES = { 'fursatind.in': 'Kitchen | Bar', fursatbanquets: 'Banquets', fursat_bitesandbuffet: 'Bites & Buffet', fursatsocialclub: 'Social Club' } as const;
const { handle, tone = 'light', label, count = 6 } = Astro.props;
const files = import.meta.glob('../data/ig-*.json', { eager: true }) as Record<string, { default?: { posts?: { img: string; href: string; alt?: string }[] }; posts?: { img: string; href: string; alt?: string }[] }>;
const f = files[`../data/ig-${handle}.json`];
const posts = ((f?.default?.posts ?? f?.posts) || []).slice(0, count);
const url = `https://www.instagram.com/${handle}/`;
const slots = Array.from({ length: count }, (_, i) => posts[i] ?? null);
const hasPosts = posts.length > 0;
---
{!hasPosts ? (
  <div class={`igf-solo igf-solo--${tone}`} data-igf={handle}>
    <a class="igf-round" href={url} target="_blank" rel="noopener" aria-label={`${label ?? NAMES[handle]} on Instagram, @${handle} (opens in a new tab)`}>
      <svg viewBox="0 0 24 24" aria-hidden="true"><rect x="3" y="3" width="18" height="18" rx="5.5"/><circle cx="12" cy="12" r="4.2"/><circle cx="17.4" cy="6.6" r="1.1" class="igf-dot"/></svg>
    </a>
  </div>
) : (
<aside class={`igf igf--${tone}`} style={`--n:${Math.min(count, 6)}`} aria-label={`${label ?? NAMES[handle]} on Instagram`} data-igf={handle}>
  <div class="igf-h">
    <span class="igf-ico" aria-hidden="true"><svg viewBox="0 0 24 24"><rect x="3" y="3" width="18" height="18" rx="5.5"/><circle cx="12" cy="12" r="4.2"/><circle cx="17.4" cy="6.6" r="1.1" class="igf-dot"/></svg></span>
    <span class="igf-t"><b>{label ?? NAMES[handle]}</b><span>@{handle}</span></span>
    <a class="igf-f" href={url} target="_blank" rel="noopener" aria-label={`Follow @${handle} on Instagram (opens in a new tab)`}>Follow</a>
  </div>
  <ul class="igf-row">
    {slots.map((p, i) => (
      <li>
        {p
          ? <a class="igf-tile igf-tile--post" href={p.href} target="_blank" rel="noopener" aria-label={p.alt ?? `Post ${i + 1} by @${handle}`}><img src={p.img} alt={p.alt ?? ''} loading="lazy" decoding="async" width="320" height="320" /></a>
          : <a class="igf-tile" href={url} target="_blank" rel="noopener" aria-label={`Open @${handle} on Instagram (opens in a new tab)`}>
              <svg viewBox="0 0 24 24" aria-hidden="true"><rect x="3" y="3" width="18" height="18" rx="5.5"/><circle cx="12" cy="12" r="4.2"/><circle cx="17.4" cy="6.6" r="1.1" class="igf-dot"/></svg>
              <span>View on Instagram</span>
            </a>}
      </li>
    ))}
  </ul>
</aside>
)}
<style>
.igf-solo { margin: 18px 0 0; display: flex; }
.igf-round { position: relative; flex: none; display: grid; place-items: center; width: 56px; height: 56px; border-radius: 50%; color: #fff; text-decoration: none; overflow: hidden;
  background: radial-gradient(circle at 30% 107%, #fdf497 0%, #fdf497 5%, #fd5949 45%, #d6249f 60%, #285AEB 90%);
  box-shadow: inset 0 0 0 1px rgb(255 255 255 / .35), 0 10px 20px -10px rgb(120 30 80 / .65), 0 2px 4px rgb(0 0 0 / .18);
  transition: transform .2s cubic-bezier(.16, 1, .3, 1), box-shadow .2s; }
.igf-round::before { content: ""; position: absolute; left: 10%; right: 10%; top: 4%; height: 46%; border-radius: 50% 50% 60% 60% / 80% 80% 40% 40%; background: linear-gradient(180deg, rgb(255 255 255 / .55), rgb(255 255 255 / 0)); pointer-events: none; }
.igf-round svg { position: relative; width: 28px; height: 28px; fill: none; stroke: currentColor; stroke-width: 1.8; }
.igf-round:active { scale: .94; }
.igf-round:focus-visible { outline: 3px solid #e6b85c; outline-offset: 3px; }
@media (hover: hover) and (pointer: fine) { .igf-round:hover { transform: translateY(-2px); box-shadow: inset 0 0 0 1px rgb(255 255 255 / .5), 0 16px 24px -12px rgb(120 30 80 / .7), 0 2px 4px rgb(0 0 0 / .18); } }
@media (prefers-reduced-motion: reduce) { .igf-round, .igf-round:hover { transition: none; transform: none; } }
.igf { margin: 18px 0 0; min-width: 0; }
.igf-h { display: flex; align-items: center; gap: 10px; margin-bottom: 10px; }
.igf-ico { flex: none; width: 36px; height: 36px; border-radius: 11px; display: grid; place-items: center; color: #fff; background: radial-gradient(circle at 30% 107%, #fdf497 0%, #fdf497 5%, #fd5949 45%, #d6249f 60%, #285AEB 90%); }
.igf-ico svg { width: 20px; height: 20px; fill: none; stroke: currentColor; stroke-width: 1.8; }
.igf-dot { fill: currentColor; stroke: none; }
.igf-t { display: grid; min-width: 0; line-height: 1.25; color: #1f2a1a; }
.igf-t b { font: 600 1rem/1.2 'Playfair Display', Georgia, serif; }
.igf-t span { font: 400 .8125rem/1.3 Poppins, system-ui, sans-serif; color: #5b5240; overflow-wrap: anywhere; }
.igf--dark .igf-t { color: #f6ecd8; } .igf--dark .igf-t span { color: #d9c9a6; }
.igf-f { margin-left: auto; display: inline-flex; align-items: center; min-height: 44px; padding: 0 18px; border-radius: 999px; background: #16301a; color: #fbf5e6; font: 600 .8125rem/1 Poppins, system-ui, sans-serif; text-decoration: none; box-shadow: inset 0 0 0 1px rgb(230 184 92 / .6); }
.igf-f:active, .igf-tile:active { scale: .96; }
.igf-row { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(var(--n, 6), minmax(0, 1fr)); gap: 8px; }
.igf-tile { position: relative; display: grid; place-items: center; align-content: center; gap: 6px; aspect-ratio: 1; overflow: hidden; border-radius: 14px; text-decoration: none; text-align: center; padding: 8px; color: #e6b85c; background: radial-gradient(120% 90% at 50% 10%, #2c4b2d 0%, #16301a 70%); box-shadow: inset 0 0 0 1px rgb(230 184 92 / .45); }
.igf-tile svg { width: 26px; height: 26px; fill: none; stroke: currentColor; stroke-width: 1.7; }
.igf-tile span { font: 500 .75rem/1.2 Poppins, system-ui, sans-serif; color: #f6ecd8; }
.igf-tile--post { padding: 0; } .igf-tile--post img { width: 100%; height: 100%; object-fit: cover; display: block; }
.igf-f:focus-visible, .igf-tile:focus-visible { outline: 3px solid #e6b85c; outline-offset: 3px; }
@media (hover: hover) and (pointer: fine) { .igf-tile:hover { transform: translateY(-2px); box-shadow: inset 0 0 0 1px #e6b85c, 0 12px 22px -14px rgb(10 30 18 / .7); } }
@media (max-width: 767px) {
  .igf-row { display: flex; overflow-x: auto; scroll-snap-type: x mandatory; scrollbar-width: none; overscroll-behavior-x: contain; gap: 8px; padding-bottom: 4px; }
  .igf-row::-webkit-scrollbar { display: none; }
  .igf-row > li { flex: 0 0 34vw; scroll-snap-align: start; }
}
@media (prefers-reduced-motion: reduce) { .igf-tile, .igf-tile:hover { transition: none; transform: none; } }
</style>

<style is:global>
.igf-page { max-width: 1300px; margin: clamp(24px, 3.5vw, 40px) auto 0; padding: 0 clamp(16px, 4vw, 40px); }
.igf-page .igf { margin: 0; }
</style>
