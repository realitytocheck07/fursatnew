---
import Base from '../layouts/Base.astro';
import '../styles/fk-tokens.css';
import SiteHeader from '../components/SiteHeader.astro';
import SiteFooter from '../components/SiteFooter.astro';
import MobileBar from '../components/MobileBar.astro';
import EnquiryHub from '../components/ask/EnquiryHub.astro';
import '../styles/ask-host.css';
import site from '../data/site.json';
import MascotOfferModal from '../components/MascotOfferModal.astro';
import menuJson from '../../public/data/menu.json';
import foodJson from '../data/food.json';
import drinksJson from '../data/drinks.json';
// Menu names and prices come only from food.json / drinks.json. A result is shown only when its name and price
// match them (same spelling rules as the printed menu), and it is shown under the food.json / drinks.json name.
// Photo captions use a food.json name only where one matches; otherwise a plain label (no dish name is invented).
const norm = (t: string) => t.toLowerCase().normalize('NFD').replace(/[^a-z0-9]/g, '');
const nice = (t: string) => (t === t.toUpperCase() ? t.toLowerCase().replace(/(^|[\s&(/-])([a-z])/g, (_m, a, b) => a + b.toUpperCase()) : t);
const src = new Map<string, { name: string; prices: number[] }>();
const walk = (x: any) => {
  if (Array.isArray(x)) x.forEach(walk);
  else if (x && typeof x === 'object') {
    if (typeof x.name === 'string') {
      const prices = Object.entries(x).filter(([k, v]) => /^price/i.test(k) && typeof v === 'number').map(([, v]) => v as number);
      // same name can appear in more than one section (CANNED JUICE: Soft Drinks ₹99, Tea ₹119): keep every price, not just the last row
      if (prices.length) { const k = norm(x.name), prev = src.get(k); src.set(k, { name: x.name, prices: prev ? [...prev.prices, ...prices] : prices }); }
    }
    Object.values(x).forEach(walk);
  }
};
walk(foodJson); walk(drinksJson);
// "from" rows in menu.json that group several food.json rows (cheapest price shown).
const groups: Record<string, string[]> = {
  'Chilli Chicken/ Fish/ Prawns': ['Chilli Chicken', 'Chilli Fish', 'Chilli Prawns'],
  'Schezwan Chicken/ Fish/ Prawns': ['Schezwan Chicken', 'Schezwan Fish', 'Schezwan Prawns'],
  'Rice or Noodles': ['Rice / Noodles (Veg)', 'Rice / Noodles (Egg)', 'Rice / Noodles (Chicken)', 'Rice / Noodles (Mix)']
};
const spell: Record<string, string> = { 'Créme Brulee': 'Creme Brulee', 'Virgin Pina Colada': 'VIRGIN PINACOLADO', 'Mixed Berry Smoothie': 'MIX BERRY SMOOTHIE', 'Vietnamese Coffee': 'VIETNAMESE' };
const okMap: Record<string, string> = {};
const dropped: string[] = [];
for (const it of menuJson as any[]) {
  const key = it.n + '|' + it.p;
  const own = src.get(norm(spell[it.n] ?? it.n));
  if (own && own.prices.includes(it.p)) { okMap[key] = nice(own.name); continue; }
  const kids = (groups[it.n] ?? []).map((g) => src.get(norm(g))).filter(Boolean) as { name: string; prices: number[] }[];
  if (it.f && kids.length && Math.min(...kids.flatMap((k) => k.prices)) === it.p) { okMap[key] = it.n; continue; }
  const base = [...src.values()].filter((v) => norm(v.name.replace(/\(.*?\)/g, '')) === norm(it.n));
  if (it.f && base.length && Math.min(...base.flatMap((k) => k.prices)) === it.p) { okMap[key] = it.n; continue; }
  dropped.push(`${it.n} ${it.p}`);
}
if (dropped.length) console.warn('[ask] hidden (not in food.json/drinks.json at this name and price):', dropped.join('; '));
const chips = {
  food: [
    ['I’m hungry', 'i-utensils'],
    ['It’s raining', 'i-rain'],
    ['Something spicy under 400', 'i-chilli']
  ],
  drinks: [['Something refreshing'], ['Coffee'], ['Milk shake under 250'], ['Tea']]
};
// Reception desk data: confirmed values only (hours, phone and area from site.json; the unit number is TODO(client), so it is left out).
const host = {
  schedule: site.hours.schedule,
  hours: site.hours.display,
  phone: site.phone,
  whatsapp: site.whatsapp,
  address: `Capital Park, ${site.address.line2} ${site.address.pin}`,
  maps: site.address.googleMaps,
};
