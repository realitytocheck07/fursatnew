<script is:inline>
/* Answers panel: rows auto-fit the panel height (no scrolling). "More picks" pages through the rest; X closes and brings the photos back. */
(function(){var a=document.getElementById('ah-ans'),r=document.getElementById('as-results'),x=document.getElementById('ah-ans-x');if(!a||!r)return;
 var N=6,pg=0;
 function over(){return r.scrollHeight>r.clientHeight+1}
 function page(){var li=r.querySelectorAll('.rs-list>li');if(!li.length)return;var tot=Math.ceil(li.length/N);li.forEach(function(el,k){el.classList.toggle('pg',Math.floor(k/N)===pg);el.style.setProperty('--j',k%N)});var m=r.querySelector('.rs-more');if(m){var left=li.length-(pg+1)*N;m.textContent=left>0?'More picks ('+left+')':'Back to the first picks';m.hidden=tot<2}}
 /* try 6 rows, then fewer; at 3 rows switch to the tighter row, then go down to 1 */
 function fit(){r.classList.remove('tight');N=6;pg=0;page();var g=0;while(over()&&g++<14){if(N>3)N--;else if(!r.classList.contains('tight'))r.classList.add('tight');else if(N>1)N--;else break;page()}}
 function build(){var li=r.querySelectorAll('.rs-list>li');if(!li.length||r.querySelector('.rs-foot'))return;var f=document.createElement('div');f.className='rs-foot';var m=document.createElement('button');m.type='button';m.className='fk-btn fk-btn--md fk-btn--secondary fk-btn--on-dark rs-more';m.addEventListener('click',function(){var t=Math.ceil(r.querySelectorAll('.rs-list>li').length/N);pg=(pg+1)%t;page()});f.appendChild(m);var wa=r.querySelector('.rs-wa');if(wa)f.appendChild(wa);var fine=r.querySelector('.rs-fine');r.querySelector('.rs-list').after(f);if(fine)f.after(fine);fit()}
 addEventListener('resize',function(){if(!a.hidden&&r.querySelector('.rs-foot'))fit()});
 new MutationObserver(function(){a.hidden=r.hidden;if(!r.hidden)build()}).observe(r,{attributes:true,attributeFilter:['hidden'],childList:true});
 x.addEventListener('click',function(){r.hidden=true;a.hidden=true;var q=document.getElementById('af-q');q&&q.focus()});})();
</script>
<script is:inline>
/* Ask hero photos: the elephant scene, then dish photos, one after another. Pauses on hover/focus; no auto-play with reduced motion. */
(function(){var f=document.getElementById('ah-hero');if(!f)return;var sl=f.querySelectorAll('.ah-sl'),dots=f.querySelectorAll('.ah-dots button'),i=0,t=null,calm=matchMedia('(prefers-reduced-motion: reduce)').matches;
 function go(n){sl[i].classList.remove('on');dots[i]&&dots[i].removeAttribute('aria-current');i=(n+sl.length)%sl.length;var el=sl[i];var im=el.tagName==='IMG'?el:null;if(im&&im.loading==='lazy')im.loading='eager';el.classList.add('on');dots[i]&&dots[i].setAttribute('aria-current','true');var b=document.getElementById('ah-bubble');if(b)b.style.visibility=i===0?'':'hidden'}
 function play(){if(calm)return;stop();t=setInterval(function(){go(i+1)},4500)}function stop(){if(t){clearInterval(t);t=null}}
 dots.forEach(function(d,k){d.addEventListener('click',function(){go(k);play()})});
 f.addEventListener('mouseenter',stop);f.addEventListener('mouseleave',play);f.addEventListener('focusin',stop);f.addEventListener('focusout',play);
 document.addEventListener('visibilitychange',function(){document.hidden?stop():play()});play();})();
</script>

<style is:global>
:root{--as-ink:#1f2a21;--as-mute:#5f5a49;--as-green:#1b3a26;--as-brand:#2a5019;--as-gold:#c99a43;--as-gold-hi:#f3c56b;--as-gold-lo:#a97c2c;--as-gold-ink:#8f6516;--as-leaf:#5c6b2e;--as-chip:#efe3c9;--as-field:#fffaf2;--as-ivory:#fffaf2;--as-rim:#d4a64c;--as-on-green:#f8ecd2}
html:has(.ah),body:has(.ah){overflow-x:clip}
body:has(.ah){background:var(--fk-plaster);background-blend-mode:multiply}
a.skip{min-height:44px;display:inline-flex;align-items:center;box-sizing:border-box}
.brand-t{color:var(--as-brand);font-weight:600}
.as-main{position:relative;z-index:2;outline:0;background:var(--fk-plaster);background-blend-mode:multiply}

/* ---------- hero: cream plaster left, gold wave lines, deep-green organic area behind the right column ---------- */
.ah{position:relative;overflow:hidden;isolation:isolate;background:var(--fk-plaster);background-blend-mode:multiply;padding-top:var(--sh-h,84px);color:var(--as-ink);font-family:var(--fk-sans)}
.ah-bg{position:absolute;inset:0;z-index:0;pointer-events:none}
.ah-bg-w{position:absolute;left:0;right:0;bottom:0;width:100%;height:56px;display:block}
.ah-bg-w path{fill:none;vector-effect:non-scaling-stroke;stroke-linecap:round}
.ah-bg-w .w1{stroke:rgba(201,154,67,.62);stroke-width:1.6}
.ah-bg-w .w2{stroke:rgba(201,154,67,.3);stroke-width:1}
.ah-bg-g{position:absolute;top:0;bottom:0;right:0;left:calc(50% + min(100vw,1320px)*.03)}
.ah-bg-g svg{display:block;width:100%;height:100%;overflow:visible}
.ah-bg-g .rim,.ah-bg-g .rim-g{fill:none;vector-effect:non-scaling-stroke;stroke-linecap:round}
.ah-bg-g .rim{stroke:#d9ae5a;stroke-width:2}
.ah-bg-g .rim-g{stroke:rgba(243,197,107,.25);stroke-width:10}
.ah-in{position:relative;z-index:2;width:100%;max-width:1320px;margin:0 auto;padding:clamp(14px,2.2vw,30px) clamp(16px,4vw,48px) clamp(22px,3vw,40px);display:grid;grid-template-columns:minmax(0,6fr) minmax(0,5fr);grid-template-areas:"copy frame" "search frame";grid-template-rows:auto 1fr;column-gap:clamp(24px,4vw,64px);align-items:start}
.ah-copy{grid-area:copy}
.ah-search{grid-area:search;min-width:0}

/* title: "Ask" + the Fursat wordmark (the h1 still reads "Ask Fursat") */
.ah .ah-h1{margin:2px 0 0;font-family:var(--fk-serif);font-weight:400;font-size:clamp(3rem,1.3rem + 5vw,5.5rem);line-height:1.02;letter-spacing:-.02em;color:var(--as-green);white-space:nowrap;text-wrap:nowrap}
.brand-wm{display:inline-block;margin-left:.04em}
.brand-wm img{display:inline-block;height:.78em;width:auto;vertical-align:-.04em}
.ah-flour{display:inline-block;width:.86em;height:.54em;margin-left:.08em;vertical-align:.34em}
.ah-lead{margin:10px 0 0;max-width:36em;font:400 clamp(1.05rem,.95rem + .45vw,1.35rem)/1.5 var(--fk-serif);color:#3b3326;text-wrap:pretty}
.ah-lead a{position:relative;color:var(--as-brand);font-weight:500;text-decoration:underline;text-decoration-thickness:1px;text-underline-offset:4px}
.ah-lead a::before{content:"";position:absolute;inset:-14px -8px}
.ah-lead a:focus-visible{outline:2px solid var(--as-green);outline-offset:3px;border-radius:4px}
@media(min-width:901px) and (max-height:760px){.ah .ah-h1{font-size:clamp(3rem,1rem + 3.9vw,4.4rem)}.ah-status{margin-bottom:8px}.ah-chips{margin-top:10px}.ah-in{padding-top:14px;padding-bottom:14px}}

/* hero photo frame: elephant scene + dish photos in a gold arch */
.ah-hero{grid-area:frame;position:relative;z-index:1;align-self:stretch;min-height:clamp(300px,calc(100svh - var(--sh-h,104px) - 72px),540px);max-height:calc(100svh - var(--sh-h,104px) - 40px);border-radius:999px 999px 36px 36px / 46% 46% 36px 36px;overflow:hidden;background:#2a1d12;box-shadow:0 0 0 3px #d4a64c,0 0 0 9px rgba(212,166,76,.2),0 30px 60px -26px rgba(0,0,0,.6)}
.ah-sl{position:absolute;inset:0;display:block;opacity:0;transform:scale(1.06);transition:opacity 1s ease,transform 6s ease}
.ah-sl.on{opacity:1;transform:none}
.ah-sl img,img.ah-sl{width:100%;height:100%;object-fit:cover}
picture.ah-sl img{display:block;object-position:34% 55%}
.ah-dots{position:absolute;z-index:4;left:50%;bottom:16px;translate:-50% 0;display:flex;gap:2px;padding:4px 8px;border-radius:999px;background:rgba(20,32,22,.45)}
.ah-dots button{all:unset;cursor:pointer;width:24px;height:24px;display:grid;place-items:center}
.ah-dots button::before{content:"";width:8px;height:8px;border-radius:50%;background:rgba(255,248,232,.55);transition:width .3s ease,background-color .3s}
.ah-dots button[aria-current=true]::before{width:20px;border-radius:5px;background:#f3c56b}
.ah-dots button:focus-visible{outline:2px solid #f3c56b;border-radius:6px}
.ah-hero .ah-bubble{left:auto;right:7%;bottom:22%;max-width:min(240px,60%)}

/* search: tabs, field, chips, desk links */
.ah-tabs{display:inline-flex;max-width:100%;margin:12px 0 0;padding:0;border:1px solid rgba(201,154,67,.7);border-radius:999px;background:var(--as-ivory);box-shadow:0 4px 12px -8px rgba(74,48,16,.4);overflow:hidden}
.ah-tabs button{min-height:44px;padding:0 22px;border:0;border-radius:999px;background:transparent;color:var(--as-green);font:500 .9rem/1 var(--fk-sans);white-space:nowrap;cursor:pointer;touch-action:manipulation;transition:background-color .2s,color .2s}
.ah-tabs button[aria-pressed=true]{background:var(--as-green);color:#fff;font-weight:600}
.ah-lbl{display:block;margin:12px 0 8px;font:500 .95rem/1.3 var(--fk-sans);color:var(--as-brand)}
.ah-pill{display:flex;align-items:center;gap:10px;min-height:58px;padding:0 7px 0 20px;border-radius:999px;background:var(--as-field);border:1px solid rgba(201,154,67,.65);box-shadow:0 8px 20px rgba(74,48,16,.14)}
.ah-pill:focus-within{box-shadow:0 0 0 3px var(--as-gold),0 8px 20px rgba(74,48,16,.14)}
.ah-lead-i{flex:none;width:24px;height:24px;color:var(--as-green)}
.ah-input{flex:1;min-width:0;height:54px;padding:0;border:0;outline:0;background:none;color:var(--as-ink);font:400 16px/1.2 var(--fk-sans)}
.ah-input::placeholder{color:var(--as-mute);opacity:1}
.fk-btn.fk-btn--md.ah-mic,.fk-btn.fk-btn--md.ah-go{flex:none;width:44px;padding:0;touch-action:manipulation}
.ah-mic[hidden]{display:none}.ah-mic svg{width:19px;height:19px}.ah-mic[aria-pressed=true]{background:var(--as-chip)}
.ah-go svg{width:20px;height:20px}
.ah :is(button,input,a):focus-visible{outline:2px solid var(--as-green);outline-offset:3px}
.ah-pill .ah-input:focus-visible{outline:0}
.ah-sr{position:absolute;width:1px;height:1px;overflow:hidden;clip:rect(0 0 0 0);white-space:nowrap;margin:0}
.ah-chips{list-style:none;margin:14px 0 0;padding:0;display:flex;flex-wrap:wrap;gap:10px}
.ah-chips[hidden]{display:none}
.ah-chips button{display:inline-flex;align-items:center;gap:8px;min-height:44px;padding:0 18px;border:1px solid rgba(201,154,67,.7);border-radius:999px;background:var(--as-ivory);color:var(--as-ink);font:400 .9rem/1 var(--fk-sans);box-shadow:0 4px 12px -8px rgba(74,48,16,.45);cursor:pointer;touch-action:manipulation}
.ah-chips svg{flex:none;width:18px;height:18px;color:var(--as-gold-ink)}
@media(hover:hover){.ah-chips button:hover{background:#fff;border-color:var(--as-gold)}.ah-tabs button:not([aria-pressed=true]):hover{background:#f6ecd8}}
/* "At the desk": small gold icon before each label */
.ah-desk .fk-btn.fk-btn--ghost.fk-btn--md{gap:7px;padding:0 6px 0 4px;font:500 .8125rem/1 var(--fk-sans);color:#2f3a1f}
.ah-desk .fk-btn::after{color:var(--as-gold-ink)}
.ah-desk .fk-btn .ah-di{flex:none;width:20px;height:20px;color:var(--as-gold-ink);transform:none}

/* phone / tablet: photo frame (or answers panel) on top, then title, search, chips */
@media(max-width:900px){
  .ah-bg-g{display:none}
  .ah-in{grid-template-columns:minmax(0,1fr);grid-template-areas:"frame" "copy" "search";grid-template-rows:auto;row-gap:14px}
  .ah-hero{min-height:0;aspect-ratio:4/3;border-radius:36px 36px 36px 96px}
}
@media(max-width:700px){
  .ah-hero{aspect-ratio:16/11}
  .ah-lead{max-width:none}
  .ah-tabs button{padding:0 16px}
}
@media(max-width:520px){.ah-flour{display:none}.ah-tabs button{padding:0 12px;font-size:.85rem}}

/* ---------- answers: a deep-green panel with a gold rim, opens in place of the photo frame ---------- */
.ah-ans{grid-area:frame;position:relative;z-index:3;align-self:stretch;min-height:clamp(300px,calc(100svh - var(--sh-h,104px) - 72px),540px);max-height:calc(100svh - var(--sh-h,104px) - 40px);border-radius:32px;background:linear-gradient(160deg,#1f3d22,#2f4f26);box-shadow:0 0 0 2px var(--as-rim),0 0 0 8px rgba(212,166,76,.16),0 0 36px 6px rgba(243,197,107,.2),0 30px 60px -26px rgba(0,0,0,.65);overflow:hidden;contain:size;display:flex;flex-direction:column;color:var(--as-on-green)}
.ah-ans[hidden]{display:none}
.ah-ans{scroll-margin-top:calc(var(--sh-h,80px) + 12px)}
.ah-in:has(.ah-ans:not([hidden])) .ah-hero{display:none}
.ah-ans-x{position:absolute;z-index:4;top:14px;right:14px;width:44px;height:44px;display:grid;place-items:center;border:1.5px solid var(--as-rim);border-radius:50%;background:rgba(255,250,242,.06);color:var(--as-gold-hi);cursor:pointer;transition:background-color .2s,color .2s}
.ah-ans-x svg{width:18px;height:18px;fill:none;stroke:currentColor;stroke-width:2;stroke-linecap:round}
@media(hover:hover){.ah-ans-x:hover{background:var(--as-rim);color:#1b3a26}}
.ah-ans :is(a,button):focus-visible,.ah-ans-x:focus-visible{outline:2px solid var(--as-gold-hi);outline-offset:3px}
/* the elephant host presents the answers */
.ah-ans-av{position:absolute;z-index:4;left:16px;top:14px;width:72px;height:72px;border-radius:50%;object-fit:cover;background:#f3e3c4;box-shadow:0 0 0 2px var(--as-rim),0 8px 18px -8px rgba(0,0,0,.6);animation:ah-av-in .5s cubic-bezier(.34,1.56,.64,1) both}
@keyframes ah-av-in{from{opacity:0;transform:translateY(8px) scale(.85) rotate(-8deg)}}
.ah-ans .rs{flex:1;min-height:0;max-width:none;margin:0;padding:14px 18px 16px;overflow:hidden;display:flex;flex-direction:column}
.ah-ans .rs-h{display:flex;align-items:center;min-height:72px;margin:0 58px 12px 88px;padding:0;background:none;box-shadow:none;border-radius:0;font:500 clamp(1.3rem,1rem + 1vw,1.95rem)/1.15 var(--fk-serif);letter-spacing:-.005em;color:#fbf1dc;text-wrap:balance;scroll-margin-top:0;outline:0}
.ah-ans .rs-h svg{display:none}
.ah-ans .brand-t{color:var(--as-gold-hi)}
/* answer rows: cream, rounded, no photos. Gold icon tile | name + category | price | round green arrow */
.ah-ans .rs-list{list-style:none;margin:0;padding:0;display:flex;flex-direction:column;justify-content:space-evenly;gap:10px;flex:1 0 auto}
.ah-ans .rs-list>li{display:none}
.ah-ans .rs-list>li.pg{display:block;animation:ar-rise .35s cubic-bezier(.2,0,0,1) both;animation-delay:calc(var(--j,0)*45ms)}
@keyframes ar-rise{from{opacity:0;transform:translateY(14px)}}
.ah-ans .fk-card.ar{-webkit-mask:none;mask:none;min-height:0;border-radius:22px;background:linear-gradient(180deg,#fffaf0,#f8ecd6);border:1px solid rgba(201,154,67,.5);box-shadow:inset 0 1px 0 #fff,0 8px 18px -10px rgba(0,0,0,.55)}
.ah-ans .fk-card.ar::before,.ah-ans .fk-card.ar::after{display:none}
.ah-ans .fk-card__b{display:grid;grid-template-columns:auto minmax(0,1fr) auto;grid-template-areas:"i t f" "i p f";align-items:center;column-gap:14px;row-gap:1px;padding:9px 12px 9px 10px}
.ar-ic{grid-area:i;display:grid;place-items:center;width:60px;height:60px;border-radius:16px;background:linear-gradient(145deg,#fbeab9,#f0d28a);box-shadow:inset 0 0 0 1px rgba(201,154,67,.6);color:var(--as-gold-ink)}
.ar-ic svg{width:30px;height:30px}
.ah-ans .fk-card__t{grid-area:t;align-self:end;margin:0;padding:0;font:500 clamp(1.05rem,.95rem + .35vw,1.25rem)/1.2 var(--fk-serif);color:#1f2a1a;text-wrap:balance}
.ah-ans .fk-card__p{grid-area:p;align-self:start;margin:0;font:400 .8125rem/1.35 var(--fk-sans);color:#5a4d36}
.ah-ans .fk-card__foot{grid-area:f;display:flex;align-items:center;gap:12px;margin:0;padding:0}
.ah-ans .fk-card__price{font:500 1.3rem/1 var(--fk-serif);color:#2b2416}
.ah-ans .fk-card__go{width:44px;height:44px}
.ar .fk-card__t a{color:inherit;text-decoration:none}
.ar .fk-card__t a::after{content:"";position:absolute;inset:0;z-index:2;border-radius:inherit}
.ar:focus-within{outline:2px solid var(--as-gold-hi);outline-offset:3px}
.ar .fk-card__t a:focus-visible{outline:0}
.ar-vg{display:inline-grid;place-items:center;width:13px;height:13px;margin-right:8px;border:1.5px solid currentColor;border-radius:3px;vertical-align:.1em}
.ar-vg::after{content:"";width:5px;height:5px;border-radius:50%;background:currentColor}
.ar-vg.is-veg{color:#2e7d32}.ar-vg.is-nv{color:#b3261e}
/* tighter rows when the panel is short (small phones, short laptops) */
.ah-ans .rs.tight .rs-list{gap:7px}
.ah-ans .rs.tight .ar-ic{width:46px;height:46px;border-radius:13px}
.ah-ans .rs.tight .ar-ic svg{width:24px;height:24px}
.ah-ans .rs.tight .fk-card__b{padding:6px 10px 6px 8px;column-gap:12px}
.ah-ans .rs.tight .rs-h{min-height:64px;margin-bottom:8px}
/* footer: more picks + WhatsApp, fine print */
.ah-ans .rs-foot{display:flex;flex-wrap:wrap;align-items:center;gap:10px;margin-top:auto;padding-top:12px}
.ah-ans .rs-more{min-height:44px}
.rs-wa{width:max-content;max-width:100%;margin:0}
.rs-wa>svg:first-child{fill:currentColor;stroke:none}
.ah-ans .rs-fine{margin:8px 0 0;max-width:none;text-align:left;font:400 .75rem/1.4 var(--fk-sans);color:rgba(248,236,210,.82)}
.ah-ans .rs-none{margin:0 0 12px;font:400 1.05rem/1.55 var(--fk-serif);color:var(--as-on-green)}
.ah-ans .rs-menu{margin:0 12px 8px 0}
.rs[hidden]{display:none}
@media(max-width:900px){.ah-ans{contain:none;min-height:0;max-height:calc(100svh - var(--sh-h,74px) - 16px - 84px);border-radius:26px}}
@media(max-width:560px){.ah-ans-av{width:56px;height:56px;left:12px;top:12px}.ah-ans-x{top:12px;right:12px}.ah-ans .rs{padding:12px 12px 14px}.ah-ans .rs-h{min-height:56px;margin:0 54px 10px 70px;font-size:1.2rem}.ar-ic{width:52px;height:52px}.ar-ic svg{width:26px;height:26px}.ah-ans .fk-card__b{column-gap:12px;padding:8px 10px 8px 8px}.ah-ans .fk-card__price{font-size:1.15rem}.ah-ans .fk-card__foot{gap:8px}}
@media(prefers-reduced-motion:reduce){.ah-sl{transition:none;transform:none}.ah-ans-av,.ah-ans .rs-list>li.pg{animation:none}}

/* owner pass: lighter ivory cream like the reference, "Ask" in elephant red, larger pill type */

.ah .ah-h1{color:#c02a1a}
.ah-tabs button{font:500 1.05rem/1 var(--fk-sans);color:#1f2a1a;padding:0 24px;min-height:48px}
.ah-tabs button[aria-pressed=true]{font-weight:600;color:#fff}
.ah-chips button{font:500 1rem/1 var(--fk-sans);color:#1f2a1a;min-height:48px;padding:0 20px;background:linear-gradient(#fffdf9,#fff6e8)}
.ah-desk .fk-btn.fk-btn--ghost.fk-btn--md{font:500 .95rem/1 var(--fk-sans);color:#1f2a1a}
.ah-lbl{font-size:1rem;color:#1f2a1a}
.ah-input{font-size:17px}
@media(max-width:520px){.ah-tabs button{font-size:.95rem;padding:0 14px}.ah-chips button{font-size:.95rem}}

/* owner layout art for the Ask hero: cream blob left, Fursat forest green right, gold rims + leaves (recoloured) */
@media(min-width:901px){
 .ah{background:url(/assets/ask/ask-bg-1366.webp) center calc(var(--sh-h,104px) - 6vw)/100% auto no-repeat,#fbe9cc}
 .ah .ah-in{padding-left:max(48px,calc(9vw - (100vw - min(100vw,1180px))/2));padding-bottom:clamp(56px,8vh,96px)}
 .ah .ah-hero,.ah .ah-ans{margin-right:max(0px,calc(3vw - (100vw - min(100vw,1180px))/2))}
 .ah-bg{display:none}
}
@media(min-width:1500px){.ah{background-image:url(/assets/ask/ask-bg-1920.webp)}}
</style>
