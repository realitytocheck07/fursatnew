---
import Base from '../layouts/Base.astro';
import '../styles/fk-tokens.css';
import SiteHeader from '../components/SiteHeader.astro';
import SiteFooter from '../components/SiteFooter.astro';
import MobileBar from '../components/MobileBar.astro';
import EnquiryHub from '../components/ask/EnquiryHub.astro';
import '../styles/ask-host.css';
import site from '../data/site.json';
import MascotOfferModal from '../components/MascotOfferModal.astro';
import menuJson from '../../public/data/menu.json';
import foodJson from '../data/food.json';
import drinksJson from '../data/drinks.json';
// Menu names and prices come only from food.json / drinks.json. A result is shown only when its name and price
// match them (same spelling rules as the printed menu), and it is shown under the food.json / drinks.json name.
// Photo captions use a food.json name only where one matches; otherwise a plain label (no dish name is invented).
const norm = (t: string) => t.toLowerCase().normalize('NFD').replace(/[^a-z0-9]/g, '');
const nice = (t: string) => (t === t.toUpperCase() ? t.toLowerCase().replace(/(^|[\s&(/-])([a-z])/g, (_m, a, b) => a + b.toUpperCase()) : t);
const src = new Map<string, { name: string; prices: number[] }>();
const walk = (x: any) => {
  if (Array.isArray(x)) x.forEach(walk);
  else if (x && typeof x === 'object') {
    if (typeof x.name === 'string') {
      const prices = Object.entries(x).filter(([k, v]) => /^price/i.test(k) && typeof v === 'number').map(([, v]) => v as number);
      // same name can appear in more than one section (CANNED JUICE: Soft Drinks ₹99, Tea ₹119): keep every price, not just the last row
      if (prices.length) { const k = norm(x.name), prev = src.get(k); src.set(k, { name: x.name, prices: prev ? [...prev.prices, ...prices] : prices }); }
    }
    Object.values(x).forEach(walk);
  }
};
walk(foodJson); walk(drinksJson);
// "from" rows in menu.json that group several food.json rows (cheapest price shown).
const groups: Record<string, string[]> = {
  'Chilli Chicken/ Fish/ Prawns': ['Chilli Chicken', 'Chilli Fish', 'Chilli Prawns'],
  'Schezwan Chicken/ Fish/ Prawns': ['Schezwan Chicken', 'Schezwan Fish', 'Schezwan Prawns'],
  'Rice or Noodles': ['Rice / Noodles (Veg)', 'Rice / Noodles (Egg)', 'Rice / Noodles (Chicken)', 'Rice / Noodles (Mix)']
};
const spell: Record<string, string> = { 'Créme Brulee': 'Creme Brulee', 'Virgin Pina Colada': 'VIRGIN PINACOLADO', 'Mixed Berry Smoothie': 'MIX BERRY SMOOTHIE', 'Vietnamese Coffee': 'VIETNAMESE' };
const okMap: Record<string, string> = {};
const dropped: string[] = [];
for (const it of menuJson as any[]) {
  const key = it.n + '|' + it.p;
  const own = src.get(norm(spell[it.n] ?? it.n));
  if (own && own.prices.includes(it.p)) { okMap[key] = nice(own.name); continue; }
  const kids = (groups[it.n] ?? []).map((g) => src.get(norm(g))).filter(Boolean) as { name: string; prices: number[] }[];
  if (it.f && kids.length && Math.min(...kids.flatMap((k) => k.prices)) === it.p) { okMap[key] = it.n; continue; }
  const base = [...src.values()].filter((v) => norm(v.name.replace(/\(.*?\)/g, '')) === norm(it.n));
  if (it.f && base.length && Math.min(...base.flatMap((k) => k.prices)) === it.p) { okMap[key] = it.n; continue; }
  dropped.push(`${it.n} ${it.p}`);
}
if (dropped.length) console.warn('[ask] hidden (not in food.json/drinks.json at this name and price):', dropped.join('; '));
const chips = {
  food: [
    ['I’m hungry', 'i-utensils'],
    ['It’s raining', 'i-rain'],
    ['Something spicy under 400', 'i-chilli']
  ],
  drinks: [['Something refreshing'], ['Coffee'], ['Milk shake under 250'], ['Tea']]
};
// Reception desk data: confirmed values only (hours, phone and area from site.json; the unit number is TODO(client), so it is left out).
const host = {
  schedule: site.hours.schedule,
  hours: site.hours.display,
  phone: site.phone,
  whatsapp: site.whatsapp,
  address: `Capital Park, ${site.address.line2} ${site.address.pin}`,
  maps: site.address.googleMaps,
};
---
<Base
  title="Ask Fursat — Find Dishes by Mood & Plan an Event | Fursat Kitchen | Bar"
  description="Tell Fursat what you feel like eating or drinking, or plan a birthday, corporate event, kitty, bar party or catering in three short steps. Capital Park, Madhapur."
  canonical="https://fursatind.in/ask/"
  ogImage="https://fursatind.in/og-image.jpg"
  ogImageAlt="Ask Fursat — the elephant mascot helps you pick your meal"
>
<SiteHeader active="ask" variant="plaster" />
<a class="skip" href="#ask-main">Skip to main content</a>
<svg width="0" height="0" style="position:absolute" aria-hidden="true" focusable="false"><symbol id="i-leaf" viewBox="0 0 24 24"><path d="M11 20A7 7 0 0 1 9.8 6.1C15.5 5 17 4.5 19 2c1 2 2 4.2 2 8 0 5.5-4.8 10-10 10Z" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linejoin="round"/><path d="M2 21c0-3 1.9-5.4 5.1-6C9.5 14.5 12 13 13 12" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"/></symbol><symbol id="i-mark" viewBox="0 0 24 24"><path d="M12 2.2c1.9 2.1 2.7 3.9 2.7 5.8 0 1.9-1.1 3.3-2.7 4.2-1.6-.9-2.7-2.3-2.7-4.2 0-1.9.8-3.7 2.7-5.8Z" fill="var(--as-gold,#C9983F)"/><path d="M3.6 8.2c2.6-.5 4.8.4 5.8 2.6-.4 1.7-1.8 2.8-3.7 2.9-1.6-.2-2.6-2.2-2.1-5.5ZM20.4 8.2c-2.6-.5-4.8.4-5.8 2.6.4 1.7 1.8 2.8 3.7 2.9 1.6-.2 2.6-2.2 2.1-5.5Z" fill="var(--as-gold-lo,#A97C2C)"/><path d="M11.4 21.6c-.3-3.3-2.2-5.4-7-5.6.2 3.4 2.9 5.4 7 5.6ZM12.6 21.6c.3-3.3 2.2-5.4 7-5.6-.2 3.4-2.9 5.4-7 5.6Z" fill="currentColor"/><path d="M12 12.4V22.4" stroke="currentColor" stroke-width="1.2" stroke-linecap="round"/></symbol><symbol id="i-spice" viewBox="0 0 24 24"><path d="M3 22 15.2 8.2" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round"/><path transform="translate(15.2 8.2) rotate(-48)" d="M0 0C2.2-2.9 6.3-3.1 9.5 0 6.3 3.1 2.2 2.9 0 0Z" fill="currentColor"/><path transform="translate(11.6 12.3) rotate(-115)" d="M0 0C2.2-2.9 6.3-3.1 9.5 0 6.3 3.1 2.2 2.9 0 0Z" fill="currentColor"/><path transform="translate(11.6 12.3) rotate(-5)" d="M0 0C2.2-2.9 6.3-3.1 9.5 0 6.3 3.1 2.2 2.9 0 0Z" fill="currentColor" opacity="0.85"/><path transform="translate(7.6 16.8) rotate(-125)" d="M0 0C2.2-2.9 6.3-3.1 9.5 0 6.3 3.1 2.2 2.9 0 0Z" fill="currentColor" opacity="0.9"/><path transform="translate(7.6 16.8) rotate(-15)" d="M0 0C2.2-2.9 6.3-3.1 9.5 0 6.3 3.1 2.2 2.9 0 0Z" fill="currentColor" opacity="0.7"/></symbol><symbol id="i-sprig" viewBox="0 0 24 24"><path d="M3 22 15.2 8.2" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round"/><path transform="translate(15.2 8.2) rotate(-48)" d="M0 0C2.2-2.9 6.3-3.1 9.5 0 6.3 3.1 2.2 2.9 0 0Z" fill="var(--as-gold,#C9983F)"/><path transform="translate(11.6 12.3) rotate(-115)" d="M0 0C2.2-2.9 6.3-3.1 9.5 0 6.3 3.1 2.2 2.9 0 0Z" fill="currentColor"/><path transform="translate(11.6 12.3) rotate(-5)" d="M0 0C2.2-2.9 6.3-3.1 9.5 0 6.3 3.1 2.2 2.9 0 0Z" fill="currentColor" opacity="0.85"/><path transform="translate(7.6 16.8) rotate(-125)" d="M0 0C2.2-2.9 6.3-3.1 9.5 0 6.3 3.1 2.2 2.9 0 0Z" fill="currentColor" opacity="0.9"/><path transform="translate(7.6 16.8) rotate(-15)" d="M0 0C2.2-2.9 6.3-3.1 9.5 0 6.3 3.1 2.2 2.9 0 0Z" fill="currentColor" opacity="0.7"/></symbol><symbol id="i-utensils" viewBox="0 0 24 24"><path d="M3.6 2.2h1.6v6.6h1.2V2.2H8v6.6h1.2V2.2h1.6v7.3c0 1.6-1 2.8-2.6 3.1v9.2H6.4v-9.2c-1.6-.3-2.8-1.5-2.8-3.1V2.2Z" fill="currentColor"/><path d="M18 2c-2.2 0-3.7 2.8-3.7 6.1 0 2.1.9 3.6 2.2 4v9.9h3V12.1c1.3-.4 2.2-1.9 2.2-4C21.7 4.8 20.2 2 18 2Z" fill="currentColor"/></symbol><symbol id="i-rain" viewBox="0 0 24 24"><path d="M7 15a4.6 4.6 0 0 1-.4-9.2A6 6 0 0 1 18 7.2 4 4 0 0 1 17.4 15" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/><path d="M8.5 18v2M12 17v3M15.5 18v2" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"/></symbol><symbol id="i-party" viewBox="0 0 24 24"><path d="M3 21.4 6.6 9.8c.2-.6.9-.8 1.4-.4l6.6 6.6c.4.5.2 1.2-.4 1.4L3 21.4Z" fill="currentColor"/><path d="M11.5 4.5v.01M18.5 6.5v.01M20 12v.01M15 2.5l.4 2M20.8 3.8l-2.2 1.8M21.2 9.2l-2.2-.4" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" fill="none"/><path d="M12.5 8.8c1.3-1.5 1.6-3.2 2.8-3.2M17.8 11.8c-1.4.4-2.8 1.8-4.2 1.8" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" fill="none"/></symbol><symbol id="i-chilli" viewBox="0 0 24 24"><path d="M15.2 6.6c-5.4.2-11 4.5-12.4 14.2 6.2-1.4 12.8-4.6 13.8-10.8.3-1.6 0-2.7-1.4-3.4Z" fill="currentColor"/><path d="M15.6 6.8c-.1-1.8.6-3 2.4-3.8M17.4 3.2c1.6-.4 2.9.2 3.6 1.6" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/></symbol><symbol id="i-arrow" viewBox="0 0 24 24"><path d="M4 12h15M13 6l6 6-6 6" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/></symbol></svg>

<main id="ask-main" tabindex="-1" class="as-main">
<section class="ah" aria-labelledby="ah-h1">
  <div class="ah-hero">
    <picture>
      <source media="(max-width:640px)" srcset="/assets/ask/hero-m640.webp" width="640" height="426">
      <source media="(max-width:900px)" srcset="/assets/ask/hero-m900.webp" width="900" height="600">
      <img src="/assets/ask/hero.webp" width="2124" height="1065" alt="Fursat’s elephant host in a gold crown and sunglasses, resting at a marble table in the café" fetchpriority="high" decoding="async">
    </picture>
    <button class="ah-bubble" id="ah-bubble" type="button" hidden><svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><use href="#i-mark"/></svg><span></span></button>
  </div>
  <div class="ah-in">
    <div class="ah-copy">
      <p class="ah-status" id="ah-status" data-open="1"><span class="ah-dot" aria-hidden="true"></span><span id="ah-open">Open daily from 12 PM</span></p>
      <p class="ah-kick">Good food <i aria-hidden="true">&bull;</i> Slow moments <i aria-hidden="true">&bull;</i> Together</p>
      <h1 class="fk-ty-hero ah-h1" id="ah-h1">Ask <span>Fursat</span></h1>
      <svg class="ah-orn" viewBox="0 0 260 24" aria-hidden="true"><path d="M2 12 H104" /><path d="M156 12 H258" /><path d="M130 3 C122 9 122 15 130 21 C138 15 138 9 130 3 Z" /></svg>
      <p class="ah-lead">Tell us what you feel like eating or drinking and we will find the dish. Planning an event? <a href="#plan">Start here</a>.</p>
    </div>

    <div class="ah-search" id="ask-fursat">
      <label class="ah-lbl" for="af-q">What do you feel like eating?</label>
      <div class="ah-pill" role="search">
        <svg class="ah-lead-i" viewBox="0 0 24 24" aria-hidden="true"><use href="#i-mark"/></svg>
        <input class="ah-input" id="af-q" type="text" placeholder="Something spicy under 400" enterkeyhint="search" maxlength="120" autocomplete="off">
        <button class="fk-btn fk-btn--secondary fk-btn--md ah-mic" id="af-mic" type="button" aria-label="Speak your mood" hidden><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 2a3 3 0 0 0-3 3v7a3 3 0 0 0 6 0V5a3 3 0 0 0-3-3ZM19 10v2a7 7 0 0 1-14 0v-2M12 19v3"/></svg></button>
        <button class="fk-btn fk-btn--primary fk-btn--md ah-go" id="af-send" type="button" aria-label="Ask"><svg viewBox="0 0 24 24" aria-hidden="true"><use href="#i-arrow"/></svg></button>
      </div>
      <p class="ah-sr" id="as-status" role="status" aria-live="polite" aria-atomic="true"></p>
      <ul class="ah-chips" data-for="food" aria-label="Try one of these">
        {chips.food.map(([t, ic]) => <li><button type="button" class="fk-press" data-mood={t}><svg viewBox="0 0 24 24" aria-hidden="true"><use href={'#' + ic}/></svg>{t}</button></li>)}
      </ul>
      <ul class="ah-chips" data-for="drinks" aria-label="Try one of these" hidden>{chips.drinks.map(([t]) => <li><button type="button" class="fk-press" data-mood={t}>{t}</button></li>)}</ul>
      <ul class="ah-desk" aria-label="Reception desk"><li class="ah-desk-l" aria-hidden="true">At the desk</li><li><button type="button" class="fk-btn fk-btn--ghost fk-btn--md" data-desk="reserve">Reserve a table</button></li><li><button type="button" class="fk-btn fk-btn--ghost fk-btn--md" data-desk="hours">Hours</button></li><li><button type="button" class="fk-btn fk-btn--ghost fk-btn--md" data-desk="where">Find us</button></li><li><button type="button" class="fk-btn fk-btn--ghost fk-btn--md" data-desk="party">Parties</button></li><li><button type="button" class="fk-btn fk-btn--ghost fk-btn--md" data-desk="call">Call</button></li></ul>
    </div>
  </div>
</section>

  <div class="as-tabs">
    <div class="ah-tabs" role="group" aria-label="Choose a menu">
        <button type="button" data-tab="food" aria-pressed="true">Food</button>
        <button type="button" data-tab="drinks" aria-pressed="false">Drinks</button>
        <button type="button" data-tab="sree" aria-pressed="false">Sreemukhi’s Special</button>
      </div>
  </div>
  <section class="rs" id="as-results" aria-labelledby="as-rh" hidden></section>

<EnquiryHub />
</main>

<style is:global>
:root{--as-ink:#1f2a21;--as-mute:#5f5a49;--as-green:#1b3a26;--as-gold:#c99a43;--as-gold-hi:#f3c56b;--as-gold-lo:#a97c2c;--as-leaf:#5c6b2e;--as-chip:#efe3c9;--as-field:#fffaf2}
html:has(.ah),body:has(.ah){overflow-x:clip}
body:has(.ah){background:var(--fk-plaster);background-blend-mode:multiply}
a.skip{min-height:44px;display:inline-flex;align-items:center;box-sizing:border-box}
.ah{position:relative;overflow:hidden;background:var(--fk-plaster);background-blend-mode:multiply;padding-top:var(--sh-h,84px);color:var(--as-ink);font-family:var(--fk-sans)}
.ah::before,.ah::after{content:"";position:absolute;border-radius:50%;pointer-events:none;border:1px solid rgba(201,154,67,.5)}
.ah::before{right:-150px;top:-150px;width:460px;height:460px;box-shadow:0 0 0 22px rgba(201,154,67,.07),inset 0 0 0 22px rgba(201,154,67,.05)}
.ah::after{left:-110px;bottom:-130px;width:300px;height:300px;border-color:rgba(201,154,67,.32)}
.ah-in{position:relative;z-index:2;width:100%;max-width:1180px;margin:clamp(-56px,-4svh,-24px) auto 0;padding:0 clamp(16px,4vw,48px) clamp(26px,3.5vw,44px);display:grid;grid-template-columns:minmax(0,5fr) minmax(0,6fr);grid-template-areas:"copy search";column-gap:clamp(24px,4vw,64px);align-items:start}
.ah-copy{grid-area:copy}
.ah-kick{margin:0;font:600 .75rem/1.4 var(--fk-sans);letter-spacing:.16em;text-transform:uppercase;color:#8a5a22}
.ah-kick i{font-style:normal;margin:0 .4em}
.ah-h1{margin:8px 0 0;color:var(--as-green)}
.ah-h1 span{color:var(--as-gold-lo);font-style:italic}
.ah-orn{display:block;width:150px;height:14px;margin:10px 0;fill:none;stroke:var(--as-gold);stroke-width:1.4}
.ah-lead{margin:0;max-width:46ch;font:400 clamp(.95rem,.9rem + .2vw,1.05rem)/1.6 var(--fk-sans);color:#3b3326}
.ah-lead a{color:var(--as-green);font-weight:500;text-decoration:underline;text-underline-offset:3px;display:inline-flex;align-items:center;min-height:44px;padding-inline:4px}
.ah-lead a:focus-visible{outline:2px solid var(--as-green);outline-offset:3px;border-radius:4px}
/* the big scene: wide band under the header, fading into the plaster; title, search and chips come right under it */
.ah-hero{position:relative;z-index:1;height:clamp(250px,52svh,500px);overflow:hidden}
.ah-hero picture{display:block;width:100%;height:100%}
.ah-hero img{display:block;width:100%;height:100%;object-fit:cover;object-position:50% 56%}
.ah-hero::after{content:"";position:absolute;inset:auto 0 0;height:26%;pointer-events:none;background:linear-gradient(180deg,rgb(246 228 201 / 0),var(--fk-plaster-base,#f6e4c9) 94%)}
.ah-search{grid-area:search;min-width:0}
.ah-lbl{display:block;margin:0 0 8px;font:500 .9rem/1.3 var(--fk-sans);color:var(--as-green)}
.ah-pill{display:flex;align-items:center;gap:10px;min-height:58px;padding:0 8px 0 20px;border-radius:999px;background:var(--as-field);border:1px solid rgba(201,154,67,.5);box-shadow:0 8px 20px rgba(74,48,16,.14)}
.ah-pill:focus-within{box-shadow:0 0 0 3px var(--as-gold),0 8px 20px rgba(74,48,16,.14)}
.ah-lead-i{flex:none;width:24px;height:24px;color:var(--as-green)}
.ah-input{flex:1;min-width:0;height:54px;padding:0;border:0;outline:0;background:none;color:var(--as-ink);font:400 16px/1.2 var(--fk-sans)}
.ah-input::placeholder{color:var(--as-mute);opacity:1}
.fk-btn.fk-btn--md.ah-mic,.fk-btn.fk-btn--md.ah-go{flex:none;width:44px;padding:0;touch-action:manipulation}
.ah-mic[hidden]{display:none}.ah-mic svg{width:19px;height:19px}.ah-mic[aria-pressed=true]{background:var(--as-chip)}
.ah-go svg{width:20px;height:20px}
.ah :is(button,input,a):focus-visible,.as-tabs button:focus-visible{outline:2px solid var(--as-green);outline-offset:3px}
.ah-pill .ah-input:focus-visible{outline:0}
.ah-sr{position:absolute;width:1px;height:1px;overflow:hidden;clip:rect(0 0 0 0);white-space:nowrap;margin:0}
.ah-chips{list-style:none;margin:14px 0 0;padding:0;display:flex;flex-wrap:wrap;gap:10px}
.ah-chips[hidden]{display:none}
.ah-chips button{display:inline-flex;align-items:center;gap:8px;min-height:44px;padding:0 18px;border:1px solid rgba(201,154,67,.4);border-radius:999px;background:var(--as-chip);color:var(--as-ink);font:400 .9rem/1 var(--fk-sans);cursor:pointer;touch-action:manipulation}
.ah-chips svg{flex:none;width:18px;height:18px;color:var(--as-green)}
.ah-tabs{display:flex;flex-wrap:wrap;gap:4px;margin-top:10px}
.ah-tabs button{min-height:44px;padding:0 14px;border:0;border-bottom:2px solid transparent;background:none;color:var(--as-mute);font:400 .9rem/1 var(--fk-sans);cursor:pointer;touch-action:manipulation}
.ah-tabs button[aria-pressed=true]{color:var(--as-green);border-bottom-color:var(--as-gold);font-weight:500}
@media(hover:hover){.ah-chips button:hover{background:#e6d7b4}.ah-tabs button:hover{color:var(--as-green)}}
@media(max-width:900px){
  .ah-in{grid-template-columns:minmax(0,1fr);grid-template-areas:"copy" "search";row-gap:14px}
}
@media(max-width:700px){
  .ah-hero{height:clamp(200px,30svh,280px)}
  .ah-hero img{object-position:36% 50%}
  .ah-h1{margin-bottom:6px}
  .ah-kick{font-size:.75rem;letter-spacing:.08em}
  .ah-lead{grid-column:1/-1;max-width:none}
  .ah-chips{flex-wrap:nowrap;overflow-x:auto;scrollbar-width:none;margin-inline:-16px;padding-inline:16px}
  .ah-chips::-webkit-scrollbar{display:none}
  .ah-chips li{flex:none}
  .ah-orn{display:none}
}
/* tabs sit right above their results */
.as-tabs{width:100%;max-width:1180px;margin:0 auto;padding:clamp(18px,3vw,32px) clamp(16px,4vw,48px) 0}
.as-tabs .ah-tabs{margin-top:0}
/* results */
.as-main{position:relative;z-index:2;outline:0;background:var(--fk-plaster);background-blend-mode:multiply}
.rs{width:100%;max-width:1180px;margin:0 auto;padding:clamp(16px,2.5vw,28px) clamp(16px,4vw,48px) clamp(40px,5vw,72px)}
.rs[hidden]{display:none}
.rs-h{scroll-margin-top:calc(var(--sh-h,84px) + 16px);display:flex;align-items:flex-start;gap:12px;margin:0 0 20px;color:var(--as-green);outline:0}
.rs-h svg{flex:none;width:26px;height:26px;margin-top:.15em;color:var(--as-leaf)}
.rs-list{list-style:none;margin:0;padding:0;display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:clamp(14px,2vw,24px)}
.ar{animation:ar-rise .5s cubic-bezier(.2,0,0,1) both;animation-delay:calc(var(--k,0)*60ms)}
@keyframes ar-rise{from{opacity:0;transform:translateY(14px)}}
.ar .fk-card__ph{aspect-ratio:10/8}
.ar.fk-card--text{min-height:120px}
.rs-menu{margin:0 12px 8px 0}
.ar .fk-card__t a{color:inherit;text-decoration:none}
.ar .fk-card__t a::after{content:"";position:absolute;inset:0;z-index:2;border-radius:inherit}
.ar:focus-within{outline:2px solid var(--as-green);outline-offset:3px}
.ar .fk-card__t a:focus-visible{outline:0}
.ar-vg{display:inline-grid;place-items:center;width:13px;height:13px;margin-right:8px;border:1.5px solid currentColor;border-radius:3px;vertical-align:.1em}
.ar-vg::after{content:"";width:5px;height:5px;border-radius:50%;background:currentColor}
.ar-vg.is-veg{color:#2e7d32}.ar-vg.is-nv{color:#b3261e}
.ar-w{list-style:none;display:flex;flex-wrap:wrap;gap:6px;margin:0;padding:0}
.ar-w li{padding:4px 10px;border-radius:999px;background:var(--as-chip);color:var(--as-green);font:500 .75rem/1.2 var(--fk-sans)}
.rs-none{margin:0 0 8px;font:400 1rem/1.6 var(--fk-sans);color:#3b3326}
.rs-sep{display:flex;align-items:center;justify-content:center;gap:14px;margin:26px auto 14px;max-width:340px;color:var(--as-gold-lo)}
.rs-sep::before,.rs-sep::after{content:"";flex:1;border-top:1px solid rgba(201,154,67,.5)}
.rs-sep svg{width:22px;height:22px}
/* WhatsApp button in the results: look comes from fk-btn; only layout here (its first svg is the filled WhatsApp glyph, which fk-btn svg would outline) */
.rs-wa{width:max-content;max-width:100%;margin:0 auto}
.rs-wa>svg:first-child{fill:currentColor;stroke:none}
.rs-fine{margin:14px auto 0;max-width:42ch;text-align:center;font:400 .78rem/1.5 var(--fk-sans);color:var(--as-mute)}
@media(max-width:900px){.rs-list{grid-template-columns:repeat(2,minmax(0,1fr))}}
@media(max-width:560px){.rs-list{grid-template-columns:minmax(0,1fr)}}
@media(prefers-reduced-motion:reduce){.ar{animation:none}}
</style>
