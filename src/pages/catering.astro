  /* Quote Form */
  .ct-quote {
    padding: clamp(60px, 8vw, 100px) 0;
    background: #efd8b8}
  .ct-quote-wrap {
    max-width: 820px}
  .ct-form-card {
    background: transparent;
    border: 2px solid rgba(201,154,67,0.60);
    border-radius: 28px;
    padding: clamp(28px, 5vw, 48px)}
  .ct-fc-head {
    margin-bottom: 28px}
  
  .ct-fc-head p {
    font-size: 0.95rem;
    color: #4a4232;
    margin: 0}
  .ct-form {
    display: flex;
    flex-direction: column;
    gap: 18px}
  .ct-row {
    display: grid;
    grid-template-columns: 1fr;
    gap: 18px}
  @media (min-width: 640px) {
    .ct-row { grid-template-columns: 1fr 1fr}
  }
  .ct-field {
    display: flex;
    flex-direction: column;
    gap: 6px}
  .ct-field label {
    font-size: 0.8125rem;
    font-weight: 700;
    color: #74501a}
  .ct-field input, .ct-field select {
    background: #e9cfab;
    border: 1px solid rgba(201,154,67,0.50);
    border-radius: 10px;
    padding: 12px 14px;
    color: #1f2a1a;
    font-family:var(--fk-sans);
    font-size: 0.9375rem}
  .ct-field input:focus, .ct-field select:focus {
    outline: none;
    border-color: #d6aa5a}
  
  

  /* Scale / Stats Section */
  .ct-scale {
    padding: clamp(50px, 7vw, 90px) 0;
    background: #efd8b8;
    border-top: 1px solid rgba(201,154,67,0.35);
    border-bottom: 1px solid rgba(201,154,67,0.35)}
  .ct-sec-head {
    margin-bottom: 40px}
  
  
  
  
  

  /* Gallery Strip */
  .ct-gallery-strip {
    --ct-gx: clamp(16px, 4vw, 40px);
    --ct-gw: clamp(260px, 30vw, 420px);
    padding: clamp(40px, 6vw, 70px) 0;
    overflow: hidden}
  .ct-gallery-scroll {
    display: flex;
    gap: 20px;
    overflow-x: auto;
    padding: 0 var(--ct-gx) 16px;
    scroll-padding-inline: var(--ct-gx);
    scrollbar-width: thin;
    scrollbar-color: rgba(201,154,67,.5) transparent}
  .ct-gallery-scroll::-webkit-scrollbar {
    height: 4px}
  .ct-gallery-scroll::-webkit-scrollbar-thumb {
    background: rgba(214,170,90,0.35);
    border-radius: 999px}
  .ct-gallery-item {
    margin: 0;
    flex: 0 0 var(--ct-gw);
    scroll-snap-align: start;
    aspect-ratio: 4/3;
    overflow: hidden;
    border-radius: 64px 8px 64px 8px;
    box-shadow: 0 12px 40px rgba(90,60,20,0.20)}
  .ct-gallery-item img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    transition: transform 0.5s ease}
  .ct-gallery-item:hover img {
    transform: scale(1.06)}
  /* object-position per photo now set inline by StoryRail (frame shows a 50%-tall window: plate stays inside) */
  /* below 1200px the strip scrolls: snap every slide to the gutter, the trailing spacer lets the last one reach it too */
  @media (max-width: 1199px) {
    .ct-gallery-scroll { scroll-snap-type: x mandatory }
    .ct-gallery-scroll::after { content: ""; flex: 0 0 max(0px, calc(100% - var(--ct-gw) - 20px)) }
  }

  .ct-req { margin: 0 0 4px; font-size: 0.8125rem; color: #74501a}
  .ct-field input, .ct-field select { min-height: 48px; font-size: 1rem}
  .ct-field input:focus-visible, .ct-field select:focus-visible { outline: 3px solid #12803C; outline-offset: 2px}
  .ct-field [aria-invalid="true"] { border-color: #C4161C; box-shadow: 0 0 0 3px rgba(196,22,28,0.14)}
  .ct-err { margin: 0; min-height: 0; font-size: 0.8125rem; font-weight: 700; line-height: 1.4; color: #A8141A}
  
/* Phase 4B: layout + colour only. Type = fk-ty-*, buttons = fk-btn, cards = fk-card. */
  .ct-kicker { display: block; margin-bottom: 10px; color: #74501a }
  .ct-sec-title { margin: 0 0 40px; color: #1f2a1a }
  .ct-fc-head h2 { margin: 6px 0 10px; color: #1f2a1a }
  .ct-form .fk-btn { width: 100% }
  .ct-scale-grid.fk-rail--m { display: flex; grid-template-columns: none; gap: 12px}
  @media (min-width: 768px) {
    .ct-scale-grid.fk-rail--m { display: grid; grid-template-columns: repeat(auto-fit, minmax(220px, 1fr)); gap: 24px}
  }
  .ct-stat-card .fk-card__b { align-items: center; text-align: center; gap: 6px; margin: 0; padding: 40px 28px 32px }
  .ct-stat-number { color: #74501a }
  .ct-stat-unit { color: #4a4232 }
  .ct-stat-label { font-weight: 600; color: #1f2a1a; margin-top: 4px }
  .ct-gallery-cap { margin: 8px 0 0; padding: 0 clamp(16px, 4vw, 40px); font-size: 0.875rem; color: #4a4232 }
  .ct-field select { text-overflow: ellipsis }
  /* 38c "From our kitchen" strip (prefix bwk-; tile styles come from InstaPostTile) */
  .bwk { padding: clamp(36px, 5vw, 64px) 0 clamp(8px, 2vw, 24px) }
  .bwk-h { margin: 0 0 8px; text-align: center; color: #1f2a1a }
  .bwk-sub { margin: 0 auto clamp(20px, 3vw, 32px); max-width: 40ch; text-align: center; font-size: .9375rem; line-height: 1.5; color: #4a4232; text-wrap: balance; overflow-wrap: anywhere }
  .bwk-grid { list-style: none; margin: 0 auto; padding: 0; max-width: 1100px; display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 16px }
  @media (max-width: 767px) { .bwk-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 10px } }
