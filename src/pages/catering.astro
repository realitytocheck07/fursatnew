<style is:global>
  .ct-page {
    background: transparent;
    color: #1f2a1a;
    font-family:var(--fk-sans)}
  .ct-container {
    max-width: 1300px;
    margin: 0 auto;
    padding: 0 clamp(16px, 4vw, 40px)}
  /* ===== Catering hero (kit 43, prefix ch-): the Banquet look, mirrored. Plaster + gold frame art (transparent window) over rotating real photos. ===== */
  .ct-hero { box-sizing: border-box; --ch-cx: 82%; --ch-cy: 47%; margin-top: calc(-1 * clamp(92px, 9.5vw, 148px)); position: relative; isolation: isolate; display: grid; align-items: center; min-height: min(100svh, calc(var(--sh-h, 84px) + 100vw * 941 / 1672)); padding-top: var(--sh-h, 84px); overflow: hidden; background: #f6e4c9; border-bottom: 1px solid rgba(201,154,67,.40) }
  .ch-art { position: absolute; inset: var(--sh-h, 84px) 0 0 0; z-index: -1; container-type: size }
  /* the box copies how the art is cropped (cover, right-aligned): the percentages below land on the art window */
  .ch-box { position: absolute; right: 0; top: 47%; translate: 0 -47%; width: max(100cqw, 100cqh * 1672 / 941); height: max(100cqh, 100cqw * 941 / 1672); animation: ch-iris 1600ms cubic-bezier(.16, 1, .3, 1) 60ms both }
  @keyframes ch-iris { from { clip-path: circle(0% at var(--ch-cx) var(--ch-cy)) } to { clip-path: circle(150% at var(--ch-cx) var(--ch-cy)) } }
  .ch-frame { position: absolute; inset: 0; z-index: 1; width: 100%; height: 100%; display: block; pointer-events: none }
  /* photo stack: a bit larger than the window; the frame art hides the overhang */
  .ch-win { z-index: 0; isolation: isolate; position: absolute; left: 62%; top: 13%; width: 38%; height: 69%; overflow: hidden; background: #2b1d10 }
  .ch-ph { position: absolute; inset: 0; opacity: 0; transition: opacity 1200ms cubic-bezier(.2, 0, 0, 1) }
  .ch-ph.is-on { opacity: 1; z-index: 2 }
  .ch-ph.is-out { opacity: 1; z-index: 1 }
  .ch-ph img { display: block; width: 100%; height: 100%; object-fit: cover; object-position: var(--pd, 50% 80%); transform-origin: 55% 72%; filter: saturate(1.08) contrast(1.05) }
  @keyframes ch-kb { from { transform: scale(1) } to { transform: scale(1.09) } }
  .ch-ph.is-on img, .ch-ph.is-out img { animation: ch-kb 7s linear both }
  .ch-leaf { display: none }
  .ch-badge { display: none }
  /* caption on the photo: words rise in, 60 ms apart */
  /* caption = cream tab on the window's bottom edge (half on the photo), so it never hides the dish */
  .ch-cap { position: absolute; z-index: 3; left: 66%; top: 78%; width: auto; margin: 0; padding: .45em .9em .5em; border-radius: 12px; background: #f8ecd8; border: 1px solid #c99a43; box-shadow: 0 8px 18px -8px rgba(60,38,8,.45); font: italic 500 clamp(1.05rem, 1.9vw, 1.75rem)/1.2 var(--fk-serif, 'Playfair Display', Georgia, serif); color: #1b3a26; white-space: nowrap; animation: ch-rise 720ms cubic-bezier(.16, 1, .3, 1) 840ms both }
  .ch-w { display: inline-block; animation: ch-rise 720ms cubic-bezier(.16, 1, .3, 1) both; animation-delay: calc(240ms + var(--i, 0) * 60ms) }
  .ch-h1 .ch-w { animation-delay: calc(120ms + var(--i, 0) * 60ms) }
  .ch-cap .ch-w { animation-delay: calc(900ms + var(--i, 0) * 60ms) }
  .ch-in { animation: ch-rise 720ms cubic-bezier(.16, 1, .3, 1) both; animation-delay: var(--d, 0ms) }
  @keyframes ch-rise { from { opacity: 0; transform: translate3d(0, 16px, 0) } to { opacity: 1; transform: none } }
  /* progress segments: 3 thin gold bars, each button is a 44 px target */
  .ch-segs { position: absolute; z-index: 3; left: 68.5%; top: 21%; display: flex }
  .ch-seg { display: grid; place-items: center; width: 44px; height: 44px; padding: 0; border: 0; background: none; cursor: pointer; -webkit-tap-highlight-color: transparent }
  .ch-seg span { display: block; width: 34px; height: 3px; border-radius: 3px; overflow: hidden; background: rgba(251,240,222,.45); box-shadow: 0 0 6px rgba(0,0,0,.35) }
  .ch-seg b { display: block; height: 100%; background: #e8c27a; transform: scaleX(0); transform-origin: left center }
  .ch-seg.is-done b { transform: scaleX(1) }
  .ch-seg.is-act b { animation: ch-fill 5s linear both }
  @keyframes ch-fill { to { transform: scaleX(1) } }
  .ch-seg:focus-visible { outline: 2px solid #e8c27a; outline-offset: -6px; border-radius: 8px }
  .ch-hero.is-paused .ch-ph img, .ch-hero.is-paused .ch-seg b { animation-play-state: paused }
  /* text column */
  .ch-copy { position: relative; z-index: 2; width: min(54%, 720px); margin-left: clamp(20px, 6vw, 120px); padding: clamp(16px, 2.4vw, 32px) 0; color: #1f2a1a; text-align: left }
  .ch-kick { margin: 0 0 12px; color: #74501a }
  .ch-h1 { color: #18301f; font-size: clamp(2.5rem, 4.5vw, 4.9rem); line-height: 1.05; letter-spacing: -.015em; text-wrap: balance; margin: 0 }
  .ch-orn { display: block; width: 180px; height: 18px; margin: 14px 0 10px; fill: none; stroke: #c99a43; stroke-width: 1.4 }
  .ch-sub { margin: 0 0 20px; max-width: 46ch; font: 400 clamp(1rem, 1.2vw, 1.12rem)/1.6 var(--fk-sans, Rupee, Poppins, sans-serif); color: #4a4232; text-wrap: pretty }
  .ch-btns { display: flex; flex-wrap: wrap; gap: 12px }
  .ch-btns .fk-btn { gap: 10px; white-space: nowrap }
  .ch-btns .fk-btn:active { transform: scale(.97) }
  .ch-stats { list-style: none; margin: 22px 0 0; padding: 0; display: flex }
  .ch-stats li { flex: 1 1 0; min-width: 0; padding: 0 16px; border-left: 1px solid #c99a43; display: flex; flex-direction: column; gap: 4px }
  .ch-stats li:first-child { padding-left: 0; border-left: 0 }
  .ch-num { font: 700 clamp(1.6rem, 2.4vw, 2.3rem)/1 var(--fk-serif, 'Playfair Display', Georgia, serif); color: #a81f16; font-variant-numeric: tabular-nums; white-space: nowrap }
  .ch-stats span { font: 500 .8125rem/1.35 var(--fk-sans, Rupee, Poppins, sans-serif); color: #4a4232 }
  @media (min-width: 1600px) { .ch-copy { width: min(56%, 900px); margin-left: clamp(80px, 6vw, 140px) } .ch-h1 { font-size: clamp(4.9rem, 4.6vw, 6rem) } .ch-sub { max-width: 50ch; font-size: 1.25rem } .ch-num { font-size: 2.7rem } }
  @media (min-width: 821px) and (max-height: 720px) { .ch-h1 { font-size: clamp(2.4rem, 4vw, 3.3rem) } .ch-orn { margin: 10px 0 8px } .ch-sub { margin-bottom: 16px } .ch-stats { margin-top: 16px } }
  /* phone + small tablet: photo window on top (4:5), then text, full-width buttons, numbers in a row of 3 */
  @media (max-width: 820px) {
    .ct-hero { --ch-cx: 50%; --ch-cy: 50%; display: block; min-height: 0; padding-top: calc(var(--sh-h, 72px) + 14px); background: #f6e4c9 url(/assets/catering/ct-plaster-600.webp) center / cover no-repeat }
    .ch-art { position: relative; inset: auto; z-index: auto; container-type: normal; width: min(calc(100% - 48px), 380px); margin: 0 auto }
    .ch-box { position: relative; right: auto; top: auto; translate: none; width: 100%; height: auto; aspect-ratio: 10 / 11 }
    .ch-frame { display: none }
    /* owner 22 Nov: copy of the owner's reference card (DNA-measured): one cream card, photo on top cut by the
       reference path (wavy top, straight bottom-left, rounded tongue down the right side), text inside the card */
    .ct-hero::before { content: ""; position: absolute; z-index: 0; left: 16px; right: 16px; top: calc(var(--sh-h, 72px) + 14px + 150px); bottom: calc(var(--mb-clear, 76px) - 2px); border-radius: 0 0 25px 25px; background: #f8ecd8; border: 1px solid #e3cfa8; border-top: 0; box-shadow: 0 18px 32px -20px rgba(70,45,10,.35) }
    .ch-art { z-index: 1; width: calc(100% - 32px); max-width: none; margin-top: 0; margin-bottom: 24px }
    .ch-badge { display: grid; place-items: center; position: absolute; z-index: 4; left: 7%; top: 7%; width: 16.7%; aspect-ratio: 1; border-radius: 50%; background: #f8ecd8; box-shadow: 0 2px 8px rgba(40,25,5,.22) }
    .ch-badge img { width: 62%; height: auto }
