---
// catering.astro - Outdoor Catering by Fursat
// TODO(client): guest-count tiers (30–80 / 80–300 / 300–1500), "weddings", "bar service", delivery area and the "Catering Director" role are unconfirmed. Kept as the owner decided.
import Base from '../layouts/Base.astro';
import '../styles/fk-tokens.css';
import SiteHeader from '../components/SiteHeader.astro';
import SiteFooter from '../components/SiteFooter.astro';
import MobileBar from '../components/MobileBar.astro';
import MascotOfferModal from '../components/MascotOfferModal.astro';
import InstagramFeed from '../components/InstagramFeed.astro';
import InstaPostTile from '../components/InstaPostTile.astro';
---
<Base
  title="Catering & Buffets – Fursat Kitchen & Bar, Hyderabad"
  description="Fursat off-site catering for weddings, corporate lunches and private parties. Full buffet setups, live counters, bar service. Hyderabad-wide delivery."
  canonical="https://fursatind.in/catering/"
  ogImage="https://fursatind.in/assets/fursat_space_14.webp"
  ogImageAlt="Fursat catering — buffet and live counter service"
>
  <SiteHeader active="celebrate" variant="plaster" />

  <main class="ct-page" id="main">
    <!-- Hero Section (kit 43): Banquet-style framed photo window, mirrored. Text left, rotating real dish photos right. -->
    <section class="ct-hero ch-hero" aria-labelledby="ch-h1">
      <div class="ch-art">
        <div class="ch-box">
          <div class="ch-win" role="group" aria-label="Dishes from the Fursat kitchen">
            <!-- Photos: Guntur Karam Wings, Classic Paneer Tikka and the veg rice dish, all from public/assets/dishes/new (resized to /assets/catering). No guests, no faces. -->
            <div class="ch-ph is-on"><img src="/assets/catering/ct-hero-wings-800.webp" srcset="/assets/catering/ct-hero-wings-800.webp 800w, /assets/catering/ct-hero-wings-1400.webp 1400w" sizes="(max-width: 820px) 86vw, 38vw" width="800" height="1000" alt="Guntur karam wings on a green leaf with a slice of lime" fetchpriority="high" decoding="async" /></div>
            <div class="ch-ph"><img src="/assets/catering/ct-hero-paneer-800.webp" srcset="/assets/catering/ct-hero-paneer-800.webp 800w, /assets/catering/ct-hero-paneer-1400.webp 1400w" sizes="(max-width: 820px) 86vw, 38vw" width="800" height="1000" alt="Classic paneer tikka with green chutney" fetchpriority="low" decoding="async" /></div>
            <div class="ch-ph"><img src="/assets/catering/ct-hero-rice-800.webp" srcset="/assets/catering/ct-hero-rice-800.webp 800w, /assets/catering/ct-hero-rice-1400.webp 1400w" sizes="(max-width: 820px) 86vw, 38vw" width="800" height="1000" alt="Spicy coriander rice with a flower garnish" fetchpriority="low" decoding="async" /></div>
            <i class="ch-shade" aria-hidden="true"></i>
          </div>
          <img class="ch-frame" src="/assets/catering/ct-frame-1536.webp" srcset="/assets/catering/ct-frame-768.webp 768w, /assets/catering/ct-frame-1536.webp 1536w" sizes="100vw" width="1536" height="864" alt="" aria-hidden="true" fetchpriority="high" decoding="async" />
          <svg class="ch-leaf" viewBox="0 0 96 120" aria-hidden="true">
            <defs><linearGradient id="ch-lg" x1="0" y1="0" x2="1" y2="1"><stop offset="0" stop-color="#4c7a2e" /><stop offset="1" stop-color="#2a5019" /></linearGradient></defs>
            <path d="M12 114 C 30 88 46 58 66 12" fill="none" stroke="#c99a43" stroke-width="2.2" stroke-linecap="round" />
            <path d="M40 74 C 20 70 10 52 14 36 C 32 38 46 54 40 74Z" fill="url(#ch-lg)" />
            <path d="M52 52 C 70 52 84 38 84 22 C 66 22 52 34 52 52Z" fill="url(#ch-lg)" />
            <path d="M28 98 C 14 96 6 84 8 72 C 22 72 32 84 28 98Z" fill="url(#ch-lg)" />
            <path d="M62 14 C 62 4 68 -2 76 -2 C 78 6 72 14 62 14Z" fill="url(#ch-lg)" />
          </svg>
          <span class="ch-badge" aria-hidden="true"><img src="/assets/brand/fursat-elephant.webp" alt="" width="40" height="40" decoding="async" /></span>
          <div class="ch-segs" role="group" aria-label="Choose a photo">
            <button class="ch-seg is-act" type="button" data-i="0" aria-label="Show photo 1 of 3"><span aria-hidden="true"><b></b></span></button>
            <button class="ch-seg" type="button" data-i="1" aria-label="Show photo 2 of 3"><span aria-hidden="true"><b></b></span></button>
            <button class="ch-seg" type="button" data-i="2" aria-label="Show photo 3 of 3"><span aria-hidden="true"><b></b></span></button>
          </div>
          <p class="ch-cap"><span class="ch-w" style="--i:4">Fursat</span> <span class="ch-w" style="--i:5">dining,</span> <span class="ch-w" style="--i:6">at</span> <span class="ch-w" style="--i:7">your</span> <span class="ch-w" style="--i:8">venue</span></p>
        </div>
      </div>

      <div class="ch-copy">
        <p class="fk-ty-label ch-kick ch-in" style="--d:0ms">Outdoor catering · Hyderabad</p>
        <h1 class="fk-ty-hero ch-h1" id="ch-h1"><span class="ch-w" style="--i:0">Fursat</span> <span class="ch-w" style="--i:1">Outdoor</span> <span class="ch-w" style="--i:2">Catering</span></h1>
        <svg class="ch-orn ch-in" style="--d:260ms" viewBox="0 0 260 24" aria-hidden="true"><path d="M2 12 H104" /><path d="M156 12 H258" /><path d="M130 3 C122 9 122 15 130 21 C138 15 138 9 130 3 Z" /></svg>
        <p class="ch-sub ch-in" style="--d:300ms">
          Bring the flavors and hospitality of Fursat to your farmhouse, villa, convention hall, or corporate campus across Hyderabad.
        </p>
        <div class="ch-btns ch-in" style="--d:380ms">
          <a href="#quote" class="fk-btn fk-btn--primary" data-ch-quote><span>Request a quote</span><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6" /></svg></a>
          <a href="tel:+919059670033" class="fk-btn fk-btn--secondary" aria-label="Call us on +91 90596 70033"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M5 4h4l2 5-2.5 1.5a11 11 0 0 0 5 5L15 13l5 2v4a2 2 0 0 1-2 2A16 16 0 0 1 3 6a2 2 0 0 1 2-2z" /></svg><span>Call us</span></a>
        </div>
        <!-- TODO(client): guest-count tiers (30–80 / 80–300 / 300–1500) are client-reviewed numbers; unconfirmed. Same tiers as the scale section below. -->
        <ul class="ch-stats ch-in" style="--d:460ms" role="list">
          <li><b class="ch-num">30–80</b><span>guests</span></li>
          <li><b class="ch-num">80–300</b><span>guests</span></li>
          <li><b class="ch-num">300–1500</b><span>guests</span></li>
        </ul>
      </div>

      <script is:inline>
      (function () {
        var hero = document.querySelector('.ch-hero'); if (!hero) return;
        var ph = [].slice.call(hero.querySelectorAll('.ch-ph')), segs = [].slice.call(hero.querySelectorAll('.ch-seg'));
        var DUR = 5000, cur = 0, timer = 0, t0 = 0, remain = DUR, running = false, vis = true, started = false;
        function paint(n) { segs.forEach(function (s, i) { s.classList.toggle('is-done', i < n); s.classList.remove('is-act'); void s.offsetWidth; if (i === n) s.classList.add('is-act'); }); }
        function go(n) {
          if (n === cur) return;
          var out = ph[cur], inn = ph[n];
          ph.forEach(function (p) { if (p !== out && p !== inn) p.classList.remove('is-on', 'is-out'); });
          out.classList.remove('is-on'); out.classList.add('is-out');
          inn.classList.remove('is-out'); inn.classList.add('is-on');
          setTimeout(function () { out.classList.remove('is-out'); }, 1300);
          cur = n; paint(n); remain = DUR; t0 = performance.now();
        }
        function tick() { go((cur + 1) % ph.length); clearTimeout(timer); timer = setTimeout(tick, DUR); t0 = performance.now(); }
        function pause() { if (!running) return; remain = Math.max(0, remain - (performance.now() - t0)); running = false; clearTimeout(timer); hero.classList.add('is-paused'); }
        function play() { if (running || !started) return; running = true; hero.classList.remove('is-paused'); t0 = performance.now(); clearTimeout(timer); timer = setTimeout(tick, remain); }
        function sync() { if (vis && !document.hidden) play(); else pause(); }
        started = ph.length > 1; paint(0);
        segs.forEach(function (s) { s.addEventListener('click', function () { pause(); go(+s.dataset.i); remain = DUR; sync(); }); });
        if ('IntersectionObserver' in window) new IntersectionObserver(function (e) { vis = e[0].isIntersecting; sync(); }).observe(hero);
        document.addEventListener('visibilitychange', sync);
        sync();
        var q = hero.querySelector('[data-ch-quote]');
        if (q) q.addEventListener('click', function (e) { var t = document.getElementById('quote'); if (!t) return; e.preventDefault(); t.style.scrollMarginTop = 'calc(var(--sh-h, 84px) + 12px)'; t.scrollIntoView({ behavior: 'smooth', block: 'start' }); });
      })();
      </script>
    </section>
    <!-- 38c: kitchen strip goes here -->

    <!-- 38c step 9: "From our kitchen" (4 posts from @fursat_bitesandbuffet). The 38c comment wasn't in this code, so it sits right after the .ct-hero closing tag. -->
    <section class="bwk" aria-labelledby="bwk-h">
      <div class="ct-container">
        <h2 class="fk-ty-h2 bwk-h" id="bwk-h">From our kitchen</h2>
        <p class="bwk-sub">Dishes from our Instagram, @fursat_bitesandbuffet.</p>
        <ul class="bwk-grid">
          {(['12', '14', '15', '19'] as const).map((n) => <InstaPostTile n={n} sizes="(max-width: 767px) 46vw, 260px" />)}
        </ul>
      </div>
    </section>

    <!-- TODO(client): 4 live-counter cards (tandoor, biryani handis, mixology bar, chaat & dessert) removed until the client confirms them; restore from git history (v5.17) if confirmed. -->
    <!-- Service Scale Section -->
    <section class="ct-scale">
      <div class="ct-container">
        <div class="ct-sec-head text-center">
          <span class="fk-ty-label ct-kicker">OUR CATERING SCALE</span>
          <h2 class="fk-ty-h2 ct-sec-title">From Intimate Dinners to Grand Weddings</h2>
        </div>
        <div class="ct-scale-grid fk-rail fk-rail--cards fk-rail--m" data-dots>
          <div class="fk-card fk-card--glass ct-stat-card">
            <div class="fk-card__b">
              <p class="fk-ty-h2 ct-stat-number">30–80</p>
              <p class="fk-ty-label ct-stat-unit">Guests</p>
              <p class="fk-ty-body ct-stat-label">Intimate Gatherings</p>
            </div>
          </div>
          <div class="fk-card fk-card--glass ct-stat-card">
            <div class="fk-card__b">
              <p class="fk-ty-h2 ct-stat-number">80–300</p>
              <p class="fk-ty-label ct-stat-unit">Guests</p>
              <p class="fk-ty-body ct-stat-label">Corporate &amp; Social Events</p>
            </div>
          </div>
          <div class="fk-card fk-card--glass ct-stat-card">
            <div class="fk-card__b">
              <p class="fk-ty-h2 ct-stat-number">300–1500</p>
              <p class="fk-ty-label ct-stat-unit">Guests</p>
              <p class="fk-ty-body ct-stat-label">Grand Weddings &amp; Conventions</p>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- Gallery strip: dishes from our kitchen (real photos; no outdoor catering photos exist yet: TODO(client)) -->
    <section class="ct-gallery-strip" aria-label="From our kitchen at Capital Park">
      <div class="ct-gallery-scroll">
        <figure class="ct-gallery-item">
          <img src="/assets/dishes/new/nalli-gosht-biryani-half-720.webp" srcset="/assets/dishes/new/nalli-gosht-biryani-half-480.webp 480w, /assets/dishes/new/nalli-gosht-biryani-half-720.webp 720w, /assets/dishes/new/nalli-gosht-biryani-half.webp 1067w" sizes="(max-width: 1023px) 260px, (max-width: 1400px) 30vw, 420px" alt="Nalli gosht biryani" width="1067" height="1600" loading="lazy" decoding="async" />
        </figure>
        <figure class="ct-gallery-item">
          <img src="/assets/dishes/new/chicken-tikka-angara-720.webp" srcset="/assets/dishes/new/chicken-tikka-angara-480.webp 480w, /assets/dishes/new/chicken-tikka-angara-720.webp 720w, /assets/dishes/new/chicken-tikka-angara.webp 1067w" sizes="(max-width: 1023px) 260px, (max-width: 1400px) 30vw, 420px" alt="Chicken tikka angara" width="1067" height="1600" loading="lazy" decoding="async" />
        </figure>
        <figure class="ct-gallery-item">
          <img src="/assets/dishes/new/nalla-karam-kodi-vepudu-720.webp" srcset="/assets/dishes/new/nalla-karam-kodi-vepudu-480.webp 480w, /assets/dishes/new/nalla-karam-kodi-vepudu-720.webp 720w, /assets/dishes/new/nalla-karam-kodi-vepudu.webp 1067w" sizes="(max-width: 1023px) 260px, (max-width: 1400px) 30vw, 420px" alt="Nalla karam kodi vepudu" width="1067" height="1600" loading="lazy" decoding="async" />
        </figure>
      </div>
      <p class="ct-gallery-cap">From our kitchen at Capital Park</p>
    </section>

    <!-- Catering Quote Form -->
    <section class="ct-quote" id="quote">
      <div class="ct-container ct-quote-wrap">
        <div class="ct-form-card">
          <div class="ct-fc-head">
            <span class="fk-ty-label ct-kicker">GET AN ESTIMATE</span>
            <h2 class="fk-ty-h2">Book Fursat Outdoor Catering</h2>
            <p>Provide your event details below. Our Catering Director will connect with a curated sample menu and per-head pricing.</p>
          </div>

          <form class="ct-form" action="https://wa.me/919059670033" target="_blank" data-wa-form data-wa-intro="Hi Fursat! 👋 I would like a catering quote:" novalidate>
            <input type="checkbox" name="botcheck" tabindex="-1" autocomplete="off" aria-hidden="true" style="position:absolute;left:-9999px;width:1px;height:1px;opacity:0">
            <p class="ct-req">Fields marked * are required.</p>
            <div class="ct-row">
              <div class="ct-field">
                <label for="ct-f1">Host name <span aria-hidden="true">*</span></label>
                <input type="text" id="ct-f1" name="name" autocomplete="name" maxlength="40" data-l="Name" data-v="text" aria-required="true" aria-describedby="ct-f1-e" data-msg="Please enter your name." placeholder="e.g. Dr. S. Rao" />
                <p class="ct-err" id="ct-f1-e" role="alert"></p>
              </div>
              <div class="ct-field">
                <label for="ct-f2">Contact number <span aria-hidden="true">*</span></label>
                <input type="tel" id="ct-f2" name="phone" autocomplete="tel-national" inputmode="numeric" maxlength="14" data-l="Phone" data-v="phone" aria-required="true" aria-describedby="ct-f2-e" placeholder="Your phone number" />
                <p class="ct-err" id="ct-f2-e" role="alert"></p>
              </div>
              <div class="ct-field">
                <label for="ct-email">Email <span class="opt">(optional)</span></label>
                <input type="email" id="ct-email" name="email" autocomplete="email" data-l="Email" placeholder="you@example.com" />
              </div>
            </div>
            <div class="ct-row">
              <div class="ct-field">
                <label for="ct-f3">Event area in Hyderabad <span aria-hidden="true">*</span></label>
                <input type="text" id="ct-f3" name="area" maxlength="80" data-l="Area" data-v="text" aria-required="true" aria-describedby="ct-f3-e" data-msg="Please enter the event area." placeholder="e.g. Moinabad Farmhouse / Jubilee Hills" />
                <p class="ct-err" id="ct-f3-e" role="alert"></p>
              </div>
              <div class="ct-field">
                <label for="ct-f4">Guest count (minimum 30) <span aria-hidden="true">*</span></label>
                <input type="number" id="ct-f4" name="guests" inputmode="numeric" min="30" max="1500" data-l="Guests" data-v="count" aria-required="true" aria-describedby="ct-f4-e" placeholder="e.g. 75" />
                <p class="ct-err" id="ct-f4-e" role="alert"></p>
              </div>
            </div>
            <div class="ct-row">
              <div class="ct-field">
                <label for="ct-f5">Event date <span aria-hidden="true">*</span></label>
                <input type="date" id="ct-f5" name="date" data-l="Date" data-v="date" aria-required="true" aria-describedby="ct-f5-e" />
                <p class="ct-err" id="ct-f5-e" role="alert"></p>
              </div>
              <div class="ct-field">
                <label for="ct-f6">Preferred cuisine mix (optional)</label>
                <select id="ct-f6" name="cuisine" data-l="Cuisine" data-fk-sheet>
                  <option value="North Indian + Royal Hyderabadi">North Indian + Royal Hyderabadi</option>
                  <option value="Pan-Asian + Continental">Pan-Asian + Continental</option>
                  <option value="Pure Vegetarian Feast">Pure Vegetarian Feast</option>
                  <option value="Barbecue & Kebabs Special">Barbecue & Kebabs Special</option>
                </select>
              </div>
            </div>
            <button type="submit" class="fk-btn fk-btn--primary">
              <span>Request a proposal</span>
            </button>
          </form>
        </div>
      </div>
    </section>
  </main>

<InstagramFeed account="bites" layout="page" title="Latest from Bites & Buffet" />
  <MascotOfferModal />
  <SiteFooter />
<MobileBar active="celebrate" />
<script is:inline src="/js/motion-kit.js"></script>
<script>
  const form = document.querySelector('form[data-wa-form]');
  if (form) {
    const fields = Array.from(form.querySelectorAll('input:not([name=botcheck]), select'));
    const digits = (v) => { let x = v.replace(/\D/g, ''); if (x.length > 10 && x.startsWith('91')) x = x.slice(2); if (x.length === 11 && x[0] === '0') x = x.slice(1); return x; };
    const today = () => { const d = new Date(); d.setMinutes(d.getMinutes() - d.getTimezoneOffset()); return d.toISOString().slice(0, 10); };
    const errOf = (el) => document.getElementById(el.getAttribute('aria-describedby') || '');
    const check = (el) => {
      const v = el.value.trim(), t = el.dataset.v;
      if (t === 'text') return v.length < 2 ? el.dataset.msg : '';
      if (t === 'phone') return /^[6-9]\d{9}$/.test(digits(v)) ? '' : 'Please enter a valid 10-digit mobile number.';
      if (t === 'count') { const n = Number(v), lo = Number(el.min), hi = Number(el.max); return n >= lo && n <= hi ? '' : 'Please enter ' + lo + ' to ' + hi + ' guests.'; }
      if (t === 'date') return v && v >= today() ? '' : 'Please choose today or a later date.';
      return '';
    };
    const show = (el, msg) => { const e = errOf(el); if (msg) el.setAttribute('aria-invalid', 'true'); else el.removeAttribute('aria-invalid'); if (e) e.textContent = msg; };
    const dateEl = form.querySelector('input[type="date"]');
    if (dateEl) dateEl.min = today();
    fields.forEach((el) => {
      if (!el.dataset.v) return;
      el.addEventListener('input', () => { if (el.hasAttribute('aria-invalid')) show(el, ''); });
      el.addEventListener('change', () => { if (el.hasAttribute('aria-invalid')) show(el, ''); });
    });
    form.addEventListener('submit', (e) => {
      e.preventDefault();
      let first = null;
      fields.forEach((el) => { if (!el.dataset.v) return; const m = check(el); show(el, m); if (m && !first) first = el; });
      if (first) { first.focus(); return; }
      const lines = [form.dataset.waIntro], sent = {};
      fields.forEach((el) => {
        const t = el.dataset.v; let v = el.value.trim();
        if (el.type === 'email' && !v) return; // optional: only sent when filled
        if (t === 'phone') { const x = digits(v); v = '+91 ' + x.slice(0, 5) + ' ' + x.slice(5); }
        else if (t === 'date') v = new Date(v + 'T00:00').toLocaleDateString('en-IN', { weekday: 'short', day: 'numeric', month: 'short', year: 'numeric' });
        else if (el.tagName === 'SELECT') v = el.selectedOptions[0].textContent.trim();
        lines.push('\u2022 ' + el.dataset.l + ': ' + v);
        sent[el.dataset.l] = v;
      });
      window.fkForm?.send('events', 'Catering enquiry', sent, form.querySelector('[name=botcheck]'));
      window.open('https://wa.me/919059670033?text=' + encodeURIComponent(lines.join('\n')), '_blank', 'noopener');
    });
  }
</script>
</Base>

<style is:global>
  .ct-page {
    background: transparent;
    color: #1f2a1a;
    font-family:var(--fk-sans)}
  .ct-container {
    max-width: 1300px;
    margin: 0 auto;
    padding: 0 clamp(16px, 4vw, 40px)}
  /* ===== Catering hero (kit 43, prefix ch-): the Banquet look, mirrored. Plaster + gold frame art (transparent window) over rotating real photos. ===== */
  .ct-hero { box-sizing: border-box; --ch-cx: 82%; --ch-cy: 47%; margin-top: calc(-1 * clamp(92px, 9.5vw, 148px)); position: relative; isolation: isolate; display: grid; align-items: center; min-height: min(100svh, calc(var(--sh-h, 84px) + 100vw * 941 / 1672)); padding-top: var(--sh-h, 84px); overflow: hidden; background: #f6e4c9; border-bottom: 1px solid rgba(201,154,67,.40) }
  .ch-art { position: absolute; inset: var(--sh-h, 84px) 0 0 0; z-index: -1; container-type: size }
  /* the box copies how the art is cropped (cover, right-aligned): the percentages below land on the art window */
  .ch-box { position: absolute; right: 0; top: 47%; translate: 0 -47%; width: max(100cqw, 100cqh * 1672 / 941); height: max(100cqh, 100cqw * 941 / 1672); animation: ch-iris 1600ms cubic-bezier(.16, 1, .3, 1) 60ms both }
  @keyframes ch-iris { from { clip-path: circle(0% at var(--ch-cx) var(--ch-cy)) } to { clip-path: circle(150% at var(--ch-cx) var(--ch-cy)) } }
  .ch-frame { position: absolute; inset: 0; z-index: 1; width: 100%; height: 100%; display: block; pointer-events: none }
  /* photo stack: a bit larger than the window; the frame art hides the overhang */
  .ch-win { z-index: 0; isolation: isolate; position: absolute; left: 62%; top: 13%; width: 38%; height: 69%; overflow: hidden; background: #2b1d10 }
  .ch-ph { position: absolute; inset: 0; opacity: 0; transition: opacity 1200ms cubic-bezier(.2, 0, 0, 1) }
  .ch-ph.is-on { opacity: 1; z-index: 2 }
  .ch-ph.is-out { opacity: 1; z-index: 1 }
  .ch-ph img { display: block; width: 100%; height: 100%; object-fit: cover; object-position: 50% 80%; transform-origin: 55% 72%; filter: saturate(1.08) contrast(1.05) }
  @keyframes ch-kb { from { transform: scale(1) } to { transform: scale(1.09) } }
  .ch-ph.is-on img, .ch-ph.is-out img { animation: ch-kb 7s linear both }
  .ch-shade { position: absolute; inset: 0; z-index: 3; background: linear-gradient(to top, rgba(8,20,13,.92) 0%, rgba(8,20,13,.88) 30%, rgba(8,20,13,.55) 46%, rgba(8,20,13,0) 64%) }
  .ch-leaf { display: none }
  .ch-badge { display: none }
  /* caption on the photo: words rise in, 60 ms apart */
