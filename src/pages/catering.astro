---
// catering.astro - Outdoor Catering by Fursat
// TODO(client): guest-count tiers (30–80 / 80–300 / 300–1500), "weddings", "bar service", delivery area and the "Catering Director" role are unconfirmed. Kept as the owner decided.
import Base from '../layouts/Base.astro';
import '../styles/fk-tokens.css';
import '../styles/fe-form.css';
import FeGo from '../components/FeGo.astro';
import slotsData from '../data/slots.json';
import SiteHeader from '../components/SiteHeader.astro';
import SiteFooter from '../components/SiteFooter.astro';
import MobileBar from '../components/MobileBar.astro';
import MascotOfferModal from '../components/MascotOfferModal.astro';
import InstagramFeed from '../components/InstagramFeed.astro';
import InstaPostTile from '../components/InstaPostTile.astro';
// last slot start hour (24h) from slots.json: after it, the date strip starts at Tomorrow
const lastHour = (() => { const t = String((slotsData as any[]).at(-1)?.time || '11 PM').match(/(\d+)\s*(AM|PM)/i); return t ? (Number(t[1]) % 12) + (/pm/i.test(t[2]) ? 12 : 0) : 23; })();
// Catering step 1: the four existing cuisine mixes as photo tiles. v = exact text sent on WhatsApp (unchanged). Real Fursat dish photos.
const D = '/assets/dishes/new/';
const cuisines = [
  { v: 'North Indian + Royal Hyderabadi', t: 'North Indian', sub: '+ Royal Hyderabadi', img: D + 'nalli-gosht-biryani-half-480.webp', img2: D + 'nalli-gosht-biryani-half-720.webp' },
  { v: 'Pan-Asian + Continental', t: 'Pan-Asian', sub: '+ Continental', img: D + 'korean-bun-480.webp', img2: D + 'korean-bun-720.webp' },
  { v: 'Pure Vegetarian Feast', t: 'Pure Vegetarian', sub: 'Feast', img: D + 'classic-paneer-tikka-480.webp', img2: D + 'classic-paneer-tikka-720.webp' },
  { v: 'Barbecue & Kebabs Special', t: 'Barbecue & Kebabs', sub: 'Special', img: D + 'chicken-tikka-angara-480.webp', img2: D + 'chicken-tikka-angara-720.webp' },
];
import StoryRail from '../components/StoryRail.astro';
const gs = '(max-width: 1023px) 260px, (max-width: 1400px) 30vw, 420px';
const gi = (f: string) => ({ src: D + f + '-720.webp', srcset: D + f + '-480.webp 480w, ' + D + f + '-720.webp 720w, ' + D + f + '.webp 1067w', sizes: gs });
const railItems = [
  { ...gi('nalli-gosht-biryani-half'), alt: 'Nalli gosht biryani', pos: '50% 95%', eyebrow: 'North Indian', title: 'Nalli gosht biryani' },
  { ...gi('chicken-tikka-angara'), alt: 'Chicken tikka angara', pos: '50% 80%', eyebrow: 'Barbecue & Kebabs', title: 'Chicken tikka angara' },
  { ...gi('nalla-karam-kodi-vepudu'), alt: 'Nalla karam kodi vepudu', pos: '50% 88%', title: 'Nalla karam kodi vepudu' },
];
import { existsSync as feHas } from 'node:fs';
const FE_TIC = ['<svg viewBox="0 0 24 24" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M4 11h16v2.5a6.5 6.5 0 0 1-6.5 6.5h-3A6.5 6.5 0 0 1 4 13.5V11ZM2 11h20M9 7.5c0-1.6 1.2-1.6 1.2-3.5M14 7.5c0-1.6 1.2-1.6 1.2-3.5"/></svg>', '<svg viewBox="0 0 24 24" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M3 12h18a9 9 0 0 1-18 0ZM13.5 3 10 11M19.5 4l-6 7"/></svg>', '<svg viewBox="0 0 24 24" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M5 19C5 10.5 10 5.2 20 4.2 19 14 14 19 5 19ZM5 19l8.5-8.5"/></svg>', '<svg viewBox="0 0 24 24" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M12 21c-4 0-6.2-2.7-6.2-6 0-4 4.2-6 4.2-10 3 2 4 4.2 4 6.2 1-.8 1.5-2 1.5-3.2 2.2 1.6 2.7 4.2 2.7 7 0 3.3-2.2 6-6.2 6Z"/></svg>'];
const FE_M = '/assets/brand/mascot/';
const FE_W = feHas('public' + FE_M + 'welcome-720.webp');
const FE_N = feHas('public' + FE_M + 'namaste-720.webp');
const FE_T = feHas('public' + FE_M + 'thumbs-480.webp');
---
<Base
  title="Catering & Buffets – Fursat Kitchen & Bar, Hyderabad"
  description="Fursat off-site catering for weddings, corporate lunches and private parties. Full buffet setups, live counters, bar service. Hyderabad-wide delivery."
  canonical="https://fursatind.in/catering/"
  ogImage="https://fursatind.in/assets/fursat_space_14.webp"
  ogImageAlt="Fursat catering — buffet and live counter service"
>
  <SiteHeader active="celebrate" variant="plaster" />

  <main class="ct-page" id="main">
    <!-- Hero Section (kit 43): Banquet-style framed photo window, mirrored. Text left, rotating real dish photos right. -->
    <section class="ct-hero ch-hero" aria-labelledby="ch-h1">
      <div class="ch-art">
        <div class="ch-box">
          <div class="ch-win" role="group" aria-label="Dishes from the Fursat kitchen">
            <!-- Photos: Guntur Karam Wings, Classic Paneer Tikka and the veg rice dish, all from public/assets/dishes/new (resized to /assets/catering). No guests, no faces. -->
            <div class="ch-ph is-on"><img src="/assets/catering/ct-hero-wings-800.webp" srcset="/assets/catering/ct-hero-wings-800.webp 800w, /assets/catering/ct-hero-wings-1400.webp 1400w" sizes="(max-width: 820px) 86vw, 38vw" width="800" height="1000" alt="Guntur karam wings on a green leaf with a slice of lime" style="--pd:50% 80%;--pp:50% 78%" fetchpriority="high" decoding="async" /></div>
            <div class="ch-ph"><img src="/assets/catering/ct-hero-paneer-800.webp" srcset="/assets/catering/ct-hero-paneer-800.webp 800w, /assets/catering/ct-hero-paneer-1400.webp 1400w" sizes="(max-width: 820px) 86vw, 38vw" width="800" height="1000" alt="Classic paneer tikka with green chutney" style="--pd:50% 96%;--pp:50% 94%" fetchpriority="low" decoding="async" /></div>
            <div class="ch-ph"><img src="/assets/catering/ct-hero-rice-800.webp" srcset="/assets/catering/ct-hero-rice-800.webp 800w, /assets/catering/ct-hero-rice-1400.webp 1400w" sizes="(max-width: 820px) 86vw, 38vw" width="800" height="1000" alt="Spicy coriander rice with a flower garnish" style="--pd:50% 80%;--pp:50% 84%" fetchpriority="low" decoding="async" /></div>
          </div>
          <img class="ch-frame" src="/assets/catering/ct-frame-1536.webp" srcset="/assets/catering/ct-frame-768.webp 768w, /assets/catering/ct-frame-1536.webp 1536w" sizes="100vw" width="1536" height="864" alt="" aria-hidden="true" fetchpriority="high" decoding="async" />
          <svg class="ch-leaf" viewBox="0 0 96 120" aria-hidden="true">
            <defs><linearGradient id="ch-lg" x1="0" y1="0" x2="1" y2="1"><stop offset="0" stop-color="#4c7a2e" /><stop offset="1" stop-color="#2a5019" /></linearGradient></defs>
            <path d="M12 114 C 30 88 46 58 66 12" fill="none" stroke="#c99a43" stroke-width="2.2" stroke-linecap="round" />
            <path d="M40 74 C 20 70 10 52 14 36 C 32 38 46 54 40 74Z" fill="url(#ch-lg)" />
            <path d="M52 52 C 70 52 84 38 84 22 C 66 22 52 34 52 52Z" fill="url(#ch-lg)" />
            <path d="M28 98 C 14 96 6 84 8 72 C 22 72 32 84 28 98Z" fill="url(#ch-lg)" />
            <path d="M62 14 C 62 4 68 -2 76 -2 C 78 6 72 14 62 14Z" fill="url(#ch-lg)" />
          </svg>
          <span class="ch-badge" aria-hidden="true"><img src="/assets/brand/fursat-elephant.webp" alt="" width="40" height="40" decoding="async" /></span>
          <div class="ch-segs" role="group" aria-label="Choose a photo">
            <button class="ch-seg is-act" type="button" data-i="0" aria-label="Show photo 1 of 3"><span aria-hidden="true"><b></b></span></button>
            <button class="ch-seg" type="button" data-i="1" aria-label="Show photo 2 of 3"><span aria-hidden="true"><b></b></span></button>
            <button class="ch-seg" type="button" data-i="2" aria-label="Show photo 3 of 3"><span aria-hidden="true"><b></b></span></button>
          </div>
          <p class="ch-cap"><span class="ch-w" style="--i:4">Fursat</span> <span class="ch-w" style="--i:5">dining,</span> <span class="ch-w" style="--i:6">at</span> <span class="ch-w" style="--i:7">your</span> <span class="ch-w" style="--i:8">venue</span></p>
        </div>
      </div>

      <div class="ch-copy">
        <p class="fk-ty-label ch-kick ch-in" style="--d:0ms">Outdoor catering · Hyderabad</p>
        <h1 class="fk-ty-hero ch-h1" id="ch-h1"><span class="ch-w" style="--i:0">Fursat</span> <span class="ch-w" style="--i:1">Outdoor</span> <span class="ch-w" style="--i:2">Catering</span></h1>
        <svg class="ch-orn ch-in" style="--d:260ms" viewBox="0 0 260 24" aria-hidden="true"><path d="M2 12 H104" /><path d="M156 12 H258" /><path d="M130 3 C122 9 122 15 130 21 C138 15 138 9 130 3 Z" /></svg>
        <p class="ch-sub ch-in" style="--d:300ms">
          Bring the flavors and hospitality of Fursat to your farmhouse, villa, convention hall, or corporate campus across Hyderabad.
        </p>
        <div class="ch-btns ch-in" style="--d:380ms">
          <a href="#quote" class="fk-btn fk-btn--primary" data-ch-quote><span>Request a quote</span><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6" /></svg></a>
          <a href="tel:+919059670033" class="fk-btn fk-btn--secondary" aria-label="Call us on +91 90596 70033"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M5 4h4l2 5-2.5 1.5a11 11 0 0 0 5 5L15 13l5 2v4a2 2 0 0 1-2 2A16 16 0 0 1 3 6a2 2 0 0 1 2-2z" /></svg><span>Call us</span></a>
        </div>
        <!-- TODO(client): guest-count tiers (30–80 / 80–300 / 300–1500) are client-reviewed numbers; unconfirmed. Same tiers as the scale section below. -->
        <ul class="ch-stats ch-in" style="--d:460ms" role="list">
          <li><b class="ch-num">30–80</b><span>guests</span></li>
          <li><b class="ch-num">80–300</b><span>guests</span></li>
          <li><b class="ch-num">300–1500</b><span>guests</span></li>
        </ul>
      </div>

      <script is:inline>
      (function () {
        var hero = document.querySelector('.ch-hero'); if (!hero) return;
        var ph = [].slice.call(hero.querySelectorAll('.ch-ph')), segs = [].slice.call(hero.querySelectorAll('.ch-seg'));
        var DUR = 5000, cur = 0, timer = 0, t0 = 0, remain = DUR, running = false, vis = true, started = false;
        function paint(n) { segs.forEach(function (s, i) { s.classList.toggle('is-done', i < n); s.classList.remove('is-act'); void s.offsetWidth; if (i === n) s.classList.add('is-act'); }); }
        function go(n) {
          if (n === cur) return;
          var out = ph[cur], inn = ph[n];
          ph.forEach(function (p) { if (p !== out && p !== inn) p.classList.remove('is-on', 'is-out'); });
          out.classList.remove('is-on'); out.classList.add('is-out');
          inn.classList.remove('is-out'); inn.classList.add('is-on');
          setTimeout(function () { out.classList.remove('is-out'); }, 1300);
          cur = n; paint(n); remain = DUR; t0 = performance.now();
        }
        function tick() { go((cur + 1) % ph.length); clearTimeout(timer); timer = setTimeout(tick, DUR); t0 = performance.now(); }
        function pause() { if (!running) return; remain = Math.max(0, remain - (performance.now() - t0)); running = false; clearTimeout(timer); hero.classList.add('is-paused'); }
        function play() { if (running || !started) return; running = true; hero.classList.remove('is-paused'); t0 = performance.now(); clearTimeout(timer); timer = setTimeout(tick, remain); }
        function sync() { if (vis && !document.hidden) play(); else pause(); }
        started = ph.length > 1; paint(0);
        segs.forEach(function (s) { s.addEventListener('click', function () { pause(); go(+s.dataset.i); remain = DUR; sync(); }); });
        if ('IntersectionObserver' in window) new IntersectionObserver(function (e) { vis = e[0].isIntersecting; sync(); }).observe(hero);
        document.addEventListener('visibilitychange', sync);
        sync();
        var q = hero.querySelector('[data-ch-quote]');
        if (q) q.addEventListener('click', function (e) { var t = document.getElementById('quote'); if (!t) return; e.preventDefault(); t.style.scrollMarginTop = 'calc(var(--sh-h, 84px) + 12px)'; t.scrollIntoView({ behavior: 'smooth', block: 'start' }); });
      })();
      </script>
    </section>
    <!-- 38c: kitchen strip goes here -->

    <!-- 38c step 9: "From our kitchen" (4 posts from @fursat_bitesandbuffet). The 38c comment wasn't in this code, so it sits right after the .ct-hero closing tag. -->
    <section class="bwk" aria-labelledby="bwk-h">
      <div class="ct-container">
        <h2 class="fk-ty-h2 bwk-h" id="bwk-h">From our kitchen</h2>
        <p class="bwk-sub">Dishes from our Instagram, @fursat_bitesandbuffet.</p>
        <ul class="bwk-grid">
          {(['12', '14', '15', '19'] as const).map((n) => <InstaPostTile n={n} sizes="(max-width: 767px) 46vw, 260px" />)}
        </ul>
      </div>
    </section>

    <!-- TODO(client): 4 live-counter cards (tandoor, biryani handis, mixology bar, chaat & dessert) removed until the client confirms them; restore from git history (v5.17) if confirmed. -->
    <!-- Service Scale Section -->
    <section class="ct-scale">
      <div class="ct-container">
        <div class="ct-sec-head text-center">
          <span class="fk-ty-label ct-kicker">OUR CATERING SCALE</span>
          <h2 class="fk-ty-h2 ct-sec-title">From Intimate Dinners to Grand Weddings</h2>
        </div>
        <div class="ct-scale-grid fk-rail fk-rail--cards fk-rail--m" data-dots>
          <div class="fk-card fk-card--glass ct-stat-card">
            <div class="fk-card__b">
              <p class="fk-ty-h2 ct-stat-number">30–80</p>
              <p class="fk-ty-label ct-stat-unit">Guests</p>
              <p class="fk-ty-body ct-stat-label">Intimate Gatherings</p>
            </div>
          </div>
          <div class="fk-card fk-card--glass ct-stat-card">
            <div class="fk-card__b">
              <p class="fk-ty-h2 ct-stat-number">80–300</p>
              <p class="fk-ty-label ct-stat-unit">Guests</p>
              <p class="fk-ty-body ct-stat-label">Corporate &amp; Social Events</p>
            </div>
          </div>
          <div class="fk-card fk-card--glass ct-stat-card">
            <div class="fk-card__b">
              <p class="fk-ty-h2 ct-stat-number">300–1500</p>
              <p class="fk-ty-label ct-stat-unit">Guests</p>
              <p class="fk-ty-body ct-stat-label">Grand Weddings &amp; Conventions</p>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- Gallery strip: dishes from our kitchen (real photos; no outdoor catering photos exist yet: TODO(client)) -->
    <section class="ct-gallery-strip" aria-label="From our kitchen at Capital Park">
      <StoryRail label="Dishes from our kitchen, swipe or drag sideways" items={railItems} railClass="ct-gallery-scroll" itemClass="ct-gallery-item" />
      <p class="ct-gallery-cap">From our kitchen at Capital Park</p>
    </section>

    <!-- Catering quote: 3-step flow (F2), same look as Banquet "Lock your date" -->
    <section class="ct-quote fe-sec" id="quote" aria-labelledby="ct-q-h" data-ask-hint="Ask me about menus for your event|Which menu suits my catering event">
      <div class="fe-wrap">
        <div class="fe-stage">
        {FE_W && <img class="fe-side-m" src={FE_M + "welcome-720.webp"} width="720" height="720" alt="" aria-hidden="true" loading="lazy" decoding="async" />}
        <p class="fe-script" aria-hidden="true">Let’s make it <span>special</span></p>
        <div class="fk-f-card fe-card" data-step="1" style="--fe-tk-photo:url(/assets/dishes/new/chicken-tikka-angara-720.webp)">
          <h2 class="fe-h2" id="ct-q-h">Book outdoor <em>catering</em></h2>

          <form class="fe-form" action="https://wa.me/919059670033" target="_blank" rel="noopener noreferrer" data-wa-form data-wa-intro="Hi Fursat! 👋 I would like a catering quote:" data-last-hour={lastHour} novalidate>
            <input type="checkbox" name="botcheck" tabindex="-1" autocomplete="off" aria-hidden="true" style="position:absolute;left:-9999px;width:1px;height:1px;opacity:0">

            <p class="fk-f-steplabel fe-steplabel fe-sr" id="fe-steplabel" aria-live="polite">Step 1 of 3 · Cuisine</p>
            <ol class="fe-steps" aria-hidden="true"><li data-n="1"><i><b>1</b><svg viewBox="0 0 24 24"><path d="m5 12.5 4.5 4.5L19 7.5" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"/></svg></i><span>Cuisine</span></li><li data-n="2"><i><b>2</b><svg viewBox="0 0 24 24"><path d="m5 12.5 4.5 4.5L19 7.5" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"/></svg></i><span>Date &amp; Area</span></li><li data-n="3"><i><b>3</b><svg viewBox="0 0 24 24"><path d="m5 12.5 4.5 4.5L19 7.5" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"/></svg></i><span>Details</span></li></ol>
            <div class="fk-f-progress fe-prog" aria-hidden="true"><i id="fe-bar"></i></div>

            <div class="fe-vp">
              <!-- 1 · cuisine mix (the existing four options) -->
              <section class="fe-step is-active" data-step="1" aria-labelledby="fe-s1-h">
                <h3 class="fe-q" id="fe-s1-h" tabindex="-1">What should we <em>serve?</em></h3>
                <p class="fe-qsub">Pick a cuisine mix, or skip.</p>
                <div class="fe-tiles fe-tiles--4" role="radiogroup" aria-labelledby="fe-s1-h" id="fe-tiles">
                  {cuisines.map((o, i) => (
                    <label class="fe-tile" style={`--i:${i}`}>
                      <input type="radio" name="fe-occ" value={o.v} data-t={o.t} />
                      <img src={o.img} srcset={`${o.img} 480w, ${o.img2} 720w`} sizes="(max-width: 700px) 46vw, 200px" width="720" height="1080" alt="" loading="lazy" decoding="async" />
                      <span class="fe-tile-txt"><b><span class="fe-tic" set:html={FE_TIC[i]} />{o.t}</b>{o.sub && <small>{o.sub}</small>}</span>
                      <span class="fe-tile-ring" aria-hidden="true"></span>
                      <span class="fe-tile-ck" aria-hidden="true"><svg viewBox="0 0 24 24"><path d="m5 12.5 4.5 4.5L19 7.5" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"/></svg></span>
                    </label>
                  ))}
                  {FE_W && <img class="fe-masc fe-masc-w fe-masc--row" src={FE_M + "welcome-480.webp"} srcset={`${FE_M}welcome-480.webp 480w, ${FE_M}welcome-720.webp 720w`} sizes="(max-width: 700px) 46vw, 260px" width="720" height="720" alt="" aria-hidden="true" loading="lazy" decoding="async" />}
                </div>
                <input type="hidden" id="fe-occ" name="cuisine" data-l="Cuisine" value="" />
                <div class="fe-actions" data-fab-avoid>
                  <button type="button" class="fk-f-btn fk-f-btn--ghost fe-sec2 fe-skip" data-go="2" data-skip>Skip</button>
                  <FeGo tone="red" label="Next" id="fe-next1" data-go="2" aria-disabled="true" aria-describedby="fe-nudge" />
                </div>
              </section>

              <!-- 2 · live ticket, date, guests, area -->
              <section class="fe-step" data-step="2" aria-label="Date, guests and area" inert>
                <div class="fe-tk-slot"></div>

                <div class="fe-sechead">
                  <span class="fe-lab" id="ct-date-l">Event date <span aria-hidden="true">*</span></span>
                  <span class="fe-weeknav"><button type="button" class="fe-link" id="fe-week-prev" hidden><span aria-hidden="true">←</span> Earlier</button><button type="button" class="fe-link" id="fe-week-next">Next week <span aria-hidden="true">→</span></button></span>
                </div>
                <div class="fe-days" role="group" aria-labelledby="ct-date-l" id="fe-days"></div>
                <button type="button" class="fe-pick" id="fe-pick" aria-expanded="false" aria-controls="ct-f5">
                  <svg viewBox="0 0 24 24" aria-hidden="true"><rect x="3.5" y="5" width="17" height="15.5" rx="3" fill="none" stroke="currentColor" stroke-width="2"/><path d="M3.5 10h17M8 3v4M16 3v4" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"/></svg>
                  Pick a date
                </button>
                <input type="date" id="ct-f5" name="date" class="fk-f-field fe-date" data-l="Date" data-v="date" aria-required="true" aria-labelledby="ct-date-l" aria-describedby="ct-f5-e" hidden />
                <p class="fk-f-err fe-err" id="ct-f5-e" role="alert"></p>

                <div class="fe-sechead fe-gap">
                  <label class="fe-lab" for="ct-f4">Guest count <span aria-hidden="true">*</span></label>
                  <span class="fe-hint">Minimum 30</span>
                </div>
                <div class="fk-f-panel fe-guests">
                  <div class="fk-f-step fe-step-g">
                    <button type="button" id="fe-minus" aria-label="Fewer guests">−</button>
                    <input type="number" id="ct-f4" name="guests" inputmode="numeric" min="30" max="1500" data-l="Guests" data-v="count" aria-required="true" aria-describedby="ct-f4-e" placeholder="100" />
                    <button type="button" id="fe-plus" aria-label="More guests">+</button>
                  </div>
                </div>
                <p class="fk-f-err fe-err fe-guests-err" id="ct-f4-e" role="alert"></p>

                <div class="fe-gap">
                <div>
                  <div class="fe-fl">
                    <input type="text" id="ct-f3" name="area" class="fk-f-field" placeholder=" " maxlength="80" data-l="Area" data-v="text" aria-required="true" aria-describedby="ct-f3-e" data-msg="Please enter the event area." />
                    <label class="fe-fl-lab" for="ct-f3">Event area in Hyderabad <span aria-hidden="true">*</span></label>
                    <svg class="fe-ok" viewBox="0 0 24 24" aria-hidden="true"><path d="m5 12.5 4.5 4.5L19 7.5" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"/></svg>
                  </div>
                  <p class="fk-f-err fe-err" id="ct-f3-e" role="alert"></p>
                </div>
                </div>

