---
// reserve.astro — Fursat /reserve (P3 restyle: embossed cream, forest and gold). Logic unchanged: booking flow, slots.json, WhatsApp message, success screen.
import Base from '../layouts/Base.astro';
import SiteHeader from '../components/SiteHeader.astro';
import SiteFooter from '../components/SiteFooter.astro';
import MobileBar from '../components/MobileBar.astro';
import HyWindows from '../components/hybrid/HyWindows.astro';
// wide desktop hero: the plain middle of the cream panel is stretched so the whole booking form fits a laptop screen
import rDesk from '../../scripts/bg-specs/reserve-deskw.out.json';
import rPhone from '../../scripts/bg-specs/reserve-phone.out.json';
import OrganicClip from '../components/fx/OrganicClip.astro';
import ReserveBand from '../components/reserve/ReserveBand.astro';
import ReserveHero from '../components/reserve/ReserveHero.astro';
import ExperienceCards from '../components/reserve/ExperienceCards.astro';
import BookingPanel from '../components/reserve/BookingPanel.astro';
import MoreAtFursat from '../components/reserve/MoreAtFursat.astro';
import '../styles/fk-tokens.css';
import '../styles/reserve.css';
const heroPhoto = { src: '/assets/tour/img/lounge.webp', alt: 'The lounge at Fursat', w: 780, h: 1040, pos: '50% 60%', eager: true };
---
<Base
  title="Reserve a Table – Fursat Kitchen & Bar, Madhapur"
  description="Request a table at Fursat Kitchen | Bar, Capital Park, Madhapur. Date nights, groups and celebrations. We confirm on WhatsApp."
  canonical="https://fursatind.in/reserve/"
  ogImage="https://fursatind.in/assets/fursat_space_01.webp"
  ogImageAlt="Reserve a table at Fursat Kitchen | Bar"
  preloadImage={{ href: '/assets/tour/img/lounge.webp', type: 'image/webp' }}
>
  <SiteHeader active="reserve" variant="plaster" />
  <OrganicClip />
  <script is:inline>if (!matchMedia('(prefers-reduced-motion: reduce)').matches) { document.documentElement.classList.add('fx-pre'); setTimeout(function () { document.documentElement.classList.remove('fx-pre'); }, 3500); }</script>
  <main class="rs-page" id="main">
    <div class="hy rs-hy">
      <section class="hy-flow rs-seg rs-seg--top">
        <HyWindows data={rDesk} slice={0} photos={[heroPhoto]} view="d" />
        <HyWindows data={rPhone} slice={0} photos={[heroPhoto]} view="m" />
        <div class="rs-stage">
          <ReserveBand />
          <ReserveHero />
          <BookingPanel />
        </div>
      </section>
      <section class="hy-flow rs-seg rs-seg--mid">
        <div class="rs-wrap">
          <ExperienceCards />
          <MoreAtFursat />
        </div>
      </section>
      <div class="hy-flow rs-seg rs-seg--bot">
        <p class="rs-close" data-fx-reveal>Good Food. <em>Great Company.</em></p>
      </div>
    </div>
  </main>
  <style is:global>
    /* first section starts below the fixed header (--sh-h, set in fk-tokens.css) */
    .rs-page { padding-top: var(--sh-h); }
  </style>
  <!-- phone only: shows the picked table and scrolls to the form -->
  <div class="bk3d-sticky" id="bk3d-sticky" hidden>
    <p class="bk3d-sticky-t" id="bk3d-sticky-t" aria-live="polite"></p>
    <button type="button" class="fk-btn fk-btn--book fk-btn--md" id="bk3d-sticky-go"><span>Book</span><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6" /></svg></button>
  </div>
  <SiteFooter />
  <MobileBar active="reserve" />
  <script>import '../scripts/fk-motion';</script>
  <script>
    // Pick your spot: the form's "Pick your spot" tab calls window.fkPickSpot.open() (set by mount.ts, which is tiny: three.js loads only when the room opens).
    // This page keeps only the phone sticky bar that shows the picked table.
    import '../components/booking3d/mount';
    (() => {
      const bar = document.getElementById('bk3d-sticky')!, txt = document.getElementById('bk3d-sticky-t')!;
      addEventListener('fk:table', (e) => { const d = (e as CustomEvent).detail; bar.hidden = !d; txt.textContent = d ? d.line : ''; });
      addEventListener('fk:table-clear', () => { bar.hidden = true; });
      document.getElementById('bk3d-sticky-go')!.addEventListener('click', () => {
        const f = document.querySelector<HTMLElement>('.rs-hy .rs-panel'); f?.scrollIntoView({ behavior: 'smooth', block: 'start' });
      });
    })();
  </script>
  <script is:inline>
    (function () {
      // fit the live booking form inside the carved cream blob of the desktop art (zoom, never above 1)
      // zoom the form INSIDE the positioned frame: zoom on the frame itself also scales its left/top and drifts it over the headline
      var seg = document.querySelector('.rs-seg--top'), f = document.querySelector('.rs-hy .rs-panel-frame');
      var p = f && f.querySelector('.rs-panel');
      if (!seg || !p) return;
      var fit = function () {
        if (seg.clientWidth < 1180) { p.style.zoom = ''; p.style.removeProperty('--rs-z'); return; }
        var avail = seg.clientWidth * 0.312;   // cream panel height below the header (wide art)
        // zoom is measured with normal target sizes (same as before); --rs-z then lifts the targets so they still render at 45px
        p.style.setProperty('--rs-z', '1');
        var z = parseFloat(p.style.zoom) || 1;
        var natural = p.getBoundingClientRect().height / z;
        var nz = Math.min(1, avail / natural);
        if (Math.abs(nz - z) > 0.005) p.style.zoom = nz.toFixed(3);
        p.style.setProperty('--rs-z', (parseFloat(p.style.zoom) || 1).toFixed(3));
      };
      fit(); addEventListener('resize', fit);
      if ('ResizeObserver' in window) new ResizeObserver(fit).observe(p);
    })();
  </script>
</Base>
