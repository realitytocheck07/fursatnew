---
import InstaFollow from '../components/InstaFollow.astro';
// story.astro v5 - About / Our Story. Plain layout: two real photos beside the text, no baked art, no icon circles.
// TODO(client): founder / story line (2-3 true sentences: who opened it, why Capital Park, what the elephant means). Not shown until provided.
// The business details (address, hours, phone, FSSAI, GSTIN) live in the footer only (one source).
import Base from '../layouts/Base.astro';
import SiteHeader from '../components/SiteHeader.astro';
import SiteFooter from '../components/SiteFooter.astro';
import MobileBar from '../components/MobileBar.astro';
import MascotOfferModal from '../components/MascotOfferModal.astro';
import '../styles/fk-tokens.css';

const P = {
  entrance: { src: '/assets/interior/tour-entrance.webp', alt: 'The Fursat entrance corridor: an elephant mural on the wall that reads Fursat, Aur Kuch Nahi, with potted plants along the glass', w: 1050, h: 1400, pos: '50% 62%' },
  dining: { src: '/assets/interior/fursat_space_07-720.webp', alt: 'The Fursat dining hall with dark wood tables, blue velvet chairs and patterned screens', w: 720, h: 960, pos: '50% 60%' },
};
// Our values: kept as one plain line (client reviews the words).
const values = ['Exceptional food', 'Warm hospitality', 'Memorable experiences', 'Togetherness'];
---

<Base
  title="Our Story — Fursat Kitchen | Bar | Madhapur, Hyderabad"
  description="Fursat is a café, a kitchen, a bar and banquet spaces under one roof at Capital Park, Madhapur. A celebration of food, people and togetherness."
  canonical="https://fursatind.in/story/"
  ogImage="https://fursatind.in/assets/interior/tour-entrance.webp"
  ogImageAlt="The entrance corridor at Fursat with the elephant mural and the Fursat, Aur Kuch Nahi wall"
>
  <SiteHeader active="story" variant="plaster" />

  <main class="st" id="main">
    <section class="st-hero" aria-labelledby="st-h1">
      <div class="st-hero-tx">
        <p class="fk-ty-label st-kick">About Us</p>
        <h1 class="fk-ty-hero st-h1" id="st-h1">Our <span class="hl">Story</span></h1>
        <svg class="st-rule" viewBox="0 0 260 24" aria-hidden="true"><path d="M2 12 H104" /><path d="M156 12 H258" /><path d="M130 3 C122 9 122 15 130 21 C138 15 138 9 130 3 Z" /></svg>
      </div>
      <figure class="st-ph st-ph--a"><img src={P.entrance.src} alt={P.entrance.alt} width={P.entrance.w} height={P.entrance.h} style={`object-position:${P.entrance.pos}`} fetchpriority="high" decoding="async" /></figure>
    </section>

    <section class="st-craft" aria-labelledby="st-h2">
      <figure class="st-ph st-ph--b"><img src={P.dining.src} alt={P.dining.alt} width={P.dining.w} height={P.dining.h} style={`object-position:${P.dining.pos}`} loading="lazy" decoding="async" /></figure>
      <div class="st-craft-tx">
        <h2 class="fk-ty-h2 st-h2" id="st-h2">Crafted for <span class="hl">Good Times</span></h2>
        <p>FURSAT is more than a restaurant. It&rsquo;s a place where flavours, conversations and celebrations come together.</p>
        <p>A café, a kitchen, a bar and banquet spaces under one roof at Capital Park, Madhapur. Come for a coffee, stay for dinner, bring everyone for the celebration.</p>
        <p class="st-tag">Fursat, aur kuch nahi!</p>
      </div>
    </section>

    <section class="st-values" aria-labelledby="st-vh">
      <h2 class="fk-ty-label st-vh" id="st-vh">Our values</h2>
      <p class="st-vline">{values.join(' \u00b7 ')}</p>
    </section>
  </main>

<InstaFollow handle="fursatind.in" />
  <MascotOfferModal />
  <SiteFooter />
  <MobileBar active="story" />
</Base>

<style is:global>
  .st { background: var(--fk-plaster); background-blend-mode: multiply; color: var(--fk-ink); font-family: var(--fk-sans); overflow-x: clip; padding-top: var(--sh-h, 84px); }
  .st :where(h1, h2, p, figure) { margin: 0; padding: 0; }
  .st-hero, .st-craft { max-width: 1180px; margin: 0 auto; padding: clamp(24px, 5vw, 64px) clamp(16px, 5vw, 48px); display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1fr); gap: clamp(24px, 5vw, 72px); align-items: center; }
  .st-hero-tx { display: grid; gap: 14px; justify-items: start; }
  .st-kick { color: #74501a; }
  .st-h1 { color: #18301f; }
  .st .hl { color: #9c4f1c; font-style: italic; }
  .st-rule { width: 180px; height: 18px; fill: none; stroke: #c99a43; stroke-width: 1.4; stroke-linecap: round; }
  .st-ph { overflow: hidden; border-radius: 28px; box-shadow: 0 0 0 1px rgba(201,154,67,.55), 0 0 0 6px #f6ead8, 0 22px 40px rgba(42,27,8,.16); aspect-ratio: 4 / 5; max-height: 70svh; justify-self: center; width: min(100%, 460px); }
  .st-ph img { width: 100%; height: 100%; object-fit: cover; display: block; }
  .st-craft-tx { display: grid; gap: 16px; justify-items: start; }
  .st-h2 { color: #18301f; }
  .st-craft-tx p { font: 400 1.0625rem/1.65 var(--fk-sans); color: #3b3326; max-width: 52ch; }
  .st-craft-tx .st-tag { font: italic 500 var(--fk-fs-5, 1.75rem)/1.2 var(--fk-serif); color: #1b3a26; margin-top: 8px; }
  .st-values { max-width: 1180px; margin: 0 auto; padding: 8px clamp(16px, 5vw, 48px) clamp(48px, 7vw, 96px); text-align: center; }
  .st-vh { color: #74501a; margin-bottom: 8px !important; }
  .st-vline { font: 500 1.125rem/1.6 var(--fk-serif); color: #1b3a26; }
  @media (max-width: 820px) {
    .st-hero, .st-craft { grid-template-columns: 1fr; }
    .st-hero .st-ph { order: 2; }
    .st-ph { aspect-ratio: 4 / 3; max-height: none; width: 100%; }
  }
</style>
