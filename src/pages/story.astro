---
import InstaFollow from '../components/InstaFollow.astro';
// story.astro v4 — About / Our Story (mock-about.png). Hybrid: textless background art (public/assets/bg/about-*,
// scripts/prep-bg.py) carries the carved plaster, frames, plates and green band; live HTML on top in stage units.
// Real photos clipped into the traced frame holes. Motion: src/scripts/fk-motion.ts (Anime.js + Motion).
import Base from '../layouts/Base.astro';
import SiteHeader from '../components/SiteHeader.astro';
import SiteFooter from '../components/SiteFooter.astro';
import MobileBar from '../components/MobileBar.astro';
import MascotOfferModal from '../components/MascotOfferModal.astro';
import HyWindows from '../components/hybrid/HyWindows.astro';
import aDesk from '../../scripts/bg-specs/about-desk.out.json';
import aPhone from '../../scripts/bg-specs/about-phone.out.json';
import '../styles/fk-tokens.css';
import '../styles/mx-mascot.css';

// TODO(client): founder / story line (not shown until the client provides one).
// Business details (address, hours, phone, FSSAI, GSTIN) live in SiteFooter and the LocalBusiness JSON-LD in Base.astro; the Story page no longer repeats them.

// Red elephant silhouette traced from the real logo (/assets/c86f49db5a.webp), viewBox 0 0 140 176
const elephant = 'M109.5 10.2 L108.2 10.8 L100.2 6.0 L94.5 5.0 L93.2 4.0 L81.5 4.0 L70.5 8.0 L64.0 13.2 L61.0 18.5 L60.0 24.2 L62.8 30.5 L66.5 33.8 L68.2 33.8 L69.5 34.8 L76.2 34.8 L81.8 31.2 L83.5 27.2 L81.2 24.0 L79.5 24.0 L76.2 27.0 L73.5 27.0 L71.8 25.2 L71.8 22.5 L75.5 18.8 L79.5 16.8 L88.2 16.8 L92.5 18.8 L98.0 25.5 L98.0 32.2 L95.0 37.5 L88.2 44.0 L73.5 52.0 L68.2 56.0 L65.0 56.5 L64.5 58.0 L55.0 67.5 L54.0 71.2 L52.0 72.5 L51.0 74.5 L51.0 76.2 L48.0 83.5 L48.0 98.2 L50.8 104.2 L50.2 105.5 L52.0 106.2 L52.8 107.2 L52.2 108.5 L57.5 112.8 L69.5 118.8 L72.2 118.8 L73.5 119.8 L80.2 119.8 L81.5 118.8 L84.5 119.5 L85.5 117.8 L88.2 116.8 L91.8 113.2 L91.8 111.5 L92.8 110.2 L92.8 105.5 L94.5 104.0 L96.0 106.5 L96.0 114.2 L95.0 115.5 L95.0 117.2 L89.2 123.0 L85.5 124.0 L82.2 126.0 L66.5 126.0 L65.2 125.0 L62.5 125.0 L56.5 122.0 L55.5 120.2 L54.2 120.8 L50.2 118.0 L43.8 110.2 L40.2 102.0 L38.5 102.0 L29.5 107.0 L24.2 112.0 L20.2 114.2 L20.5 116.0 L14.0 123.5 L5.2 139.2 L7.2 140.8 L13.2 138.0 L14.0 138.5 L12.2 141.2 L13.0 142.5 L13.0 150.2 L12.0 151.5 L12.0 160.2 L13.0 161.5 L13.0 166.2 L12.2 167.5 L14.0 168.5 L14.5 170.8 L35.2 170.8 L35.8 163.5 L36.8 162.2 L36.8 160.5 L39.8 157.2 L41.5 157.5 L42.5 155.8 L48.2 155.8 L53.0 160.5 L52.2 162.5 L54.0 163.5 L54.5 170.8 L74.2 170.8 L74.8 161.5 L76.8 158.2 L78.2 157.0 L79.5 157.5 L80.5 155.8 L86.2 155.8 L90.0 158.2 L92.0 161.5 L92.5 170.8 L117.8 170.2 L117.8 168.5 L116.8 167.2 L116.8 159.5 L115.8 158.2 L115.8 142.5 L116.8 141.2 L116.8 133.5 L117.8 132.2 L117.8 127.5 L119.8 125.2 L119.2 122.8 L125.8 114.2 L128.8 108.2 L128.8 106.5 L130.8 103.2 L130.8 101.5 L133.8 94.2 L133.8 90.5 L135.5 89.5 L134.8 88.2 L134.8 84.5 L136.5 82.5 L135.8 81.2 L135.8 64.5 L136.5 63.2 L134.8 61.2 L134.8 57.5 L135.5 56.2 L133.8 55.2 L132.8 48.5 L128.8 39.2 L129.5 37.2 L127.8 36.2 L121.8 24.5Z';

// "Inside Fursat" plays in the big hero window (index 1). The 16:9 file is a blurred pillarbox of this same vertical shot, so both views use the vertical file.
// The words "Inside Fursat" are baked into the video's title card (video-src/inside-fursat/index.html, plaque ~90% of the frame width). The oval window is a diagonal blob, so a full-width video cuts the plaque at its edge.
// Fix (sp- block in the style below): the video sits in the part of the oval that is wide at every row the plaque covers, with soft edges. pos 50% 50% puts the plaque in the middle of the window.
const heroVid = {
  // s: the dining-room frame on phones and tablets (<=820px, video fills the wavy frame). l: the entrance frame, desktop (>=821px) exactly as before. m kept for the phone art.
  s: { vcls: 'hy-vs', mp4: '/assets/video/inside-fursat-720.mp4', webm: '/assets/video/inside-fursat-720.webm', pos: '50% 50%', credit: { label: 'Video: @framesofhyd', href: 'https://instagram.com/framesofhyd' } },
  d: { vcls: 'hy-vl', mp4: '/assets/video/inside-fursat-720.mp4', webm: '/assets/video/inside-fursat-720.webm', pos: '50% 50%', credit: { label: 'Video: @framesofhyd', href: 'https://instagram.com/framesofhyd' } },
};
const P = {
  entrance: { src: '/assets/interior/tour-entrance.webp', alt: 'The Fursat entrance corridor: an elephant mural on the wall that reads Fursat, Aur Kuch Nahi, with potted plants along the glass', w: 1050, h: 1400, pos: '50% 62%', eager: true, prio: 'auto' as const },
  // C-01: the dining photo is the phone LCP. Eager + high priority + a real srcset (the source file is 1280x1706, so the top step is the original, not an upscale). The entrance photo stays eager but no longer competes for priority.
  dining: { src: '/assets/interior/fursat_space_07.webp', srcset: '/assets/interior/fursat_space_07-720.webp 720w, /assets/interior/fursat_space_07-1080.webp 1080w, /assets/interior/fursat_space_07.webp 1280w', sizes: '(max-width: 767px) 66vw, 50vw', alt: 'The Fursat dining hall with dark wood tables, blue velvet chairs and patterned screens', w: 1280, h: 1706, pos: '50% 60%', eager: true, prio: 'high' as const },
  lounge: { src: '/assets/interior/tour-lounge.webp', alt: 'The lounge seating at Fursat', w: 1050, h: 1400, pos: '50% 45%' },
};
// Photo wall: venue + food photos only, no guests/faces (owner rule). Natural ratios give the mixed heights.
const wall = [
  { src: '/assets/interior/fursat_space_06-720.webp', w: 720, h: 960, alt: 'High tables and bar stools in the Fursat dining hall' },
  { src: '/assets/dishes/new/nalli-gosht-biryani-half-720.webp', w: 720, h: 1080, alt: 'Nalli Gosht Biryani served at Fursat' },
  { src: '/assets/interior/fursat_space_17-720.webp', w: 720, h: 540, alt: 'A sofa and orange chairs in the Fursat lounge' },
  { src: '/assets/interior/fursat_space_04-720.webp', w: 720, h: 900, alt: 'A red sofa and blue chair against a patterned wall at Fursat' },
  { src: '/assets/interior/bar-back-720.webp', w: 720, h: 960, alt: 'The back bar at Fursat with the lit logo' },
  { src: '/assets/dishes/new/gongura-muchatlu-720.webp', w: 720, h: 1080, alt: 'Gongura Muchatlu cocktail' },
  { src: '/assets/venue/interior/long-table-dining-720.webp', w: 720, h: 960, alt: 'The long dining table with a blue banquette at Fursat' },
  { src: '/assets/dishes/new/chicken-tikka-angara-720.webp', w: 720, h: 1080, alt: 'Chicken Tikka Angara' },
  { src: '/assets/interior/fursat_space_14-720.webp', w: 720, h: 540, alt: 'Cane chairs and indoor plants by the window at Fursat' },
];
// sp-: split the wall into equal-height columns (3 desktop, 2 phone) so no column ends short; tiles stretch a little (object-fit: cover) to close the last gap.
const split = (n: number) => {
  let best: number[] = []; let bestSpread = Infinity;
  const total = wall.length; const assign: number[] = new Array(total).fill(0);
  const hs = wall.map((ph) => ph.h / ph.w);
  const rec = (i: number) => {
    if (i === total) {
      const sums = new Array(n).fill(0); const cnt = new Array(n).fill(0);
      assign.forEach((c, k) => { sums[c] += hs[k]; cnt[c]++; });
      const gaps = cnt.map((c) => c - 1); // one gap between tiles; compare in tile-height units plus ~0.05 per gap
      const eff = sums.map((v, c) => v + gaps[c] * 0.04);
      const spread = Math.max(...eff) - Math.min(...eff);
      if (spread < bestSpread - 1e-9) { bestSpread = spread; best = [...assign]; }
      return;
    }
    for (let c = 0; c < n; c++) { assign[i] = c; rec(i + 1); }
  };
  rec(0);
  return Array.from({ length: n }, (_, c) => wall.filter((_, k) => best[k] === c));
};
const wall3 = split(3);
const wall2 = split(2);
const values = [
  { c: 'green', t: 'Exceptional Food', l: 'Authentic flavours, crafted with care.', i: '<path d="M3 20a1 1 0 0 1-1-1v-1a1 1 0 0 1 1-1h18a1 1 0 0 1 1 1v1a1 1 0 0 1-1 1Z"/><path d="M20 16a8 8 0 1 0-16 0"/><path d="M12 4v4"/><path d="M10 4h4"/>' },
  { c: 'terra', t: 'Warm Hospitality', l: 'A welcoming space for everyone.', i: '<path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M22 21v-2a4 4 0 0 0-3-3.87"/><path d="M16 3.13a4 4 0 0 1 0 7.75"/>' },
  { c: 'cream', t: 'Memorable Experiences', l: 'Dining, celebrations and more.', i: '<path d="M11.525 2.295a.53.53 0 0 1 .95 0l2.31 4.679a2.123 2.123 0 0 0 1.595 1.16l5.166.756a.53.53 0 0 1 .294.904l-3.736 3.638a2.123 2.123 0 0 0-.611 1.878l.882 5.14a.53.53 0 0 1-.771.56l-4.618-2.428a2.122 2.122 0 0 0-1.973 0L6.396 21.01a.53.53 0 0 1-.77-.56l.881-5.139a2.122 2.122 0 0 0-.611-1.879L2.16 9.795a.53.53 0 0 1 .294-.906l5.165-.755a2.122 2.122 0 0 0 1.597-1.16z"/>' },
  { c: 'olive', t: 'Togetherness', l: 'Good food brings us closer.', i: '<path d="M19 14c1.49-1.46 3-3.21 3-5.5A5.5 5.5 0 0 0 16.5 3c-1.76 0-3 .5-4.5 2-1.5-1.5-2.74-2-4.5-2A5.5 5.5 0 0 0 2 8.5c0 2.3 1.5 4.05 3 5.5l7 7Z"/>' },
];
// Ring centres and radii measured from the baked gold rings in about-desk-0 / about-phone-0 (circle fit), in stage units. The colour discs sit exactly inside them.
const plateD = [{ x: 144.2, y: 1077.6, r: 99 }, { x: 379.8, y: 1078.1, r: 100.4 }, { x: 619.9, y: 1077.9, r: 101 }, { x: 857.6, y: 1078.9, r: 101 }];
const plateM = [{ x: 301.9, y: 2120.6, r: 142 }, { x: 701.7, y: 2119.9, r: 142 }, { x: 302.2, y: 2119.5 + 295, r: 144 }, { x: 701.6, y: 2119.5 + 295, r: 144 }];
import InstagramFeed from '../components/InstagramFeed.astro';
---

<Base
  title="Our Story – Fursat Kitchen & Bar, Madhapur, Hyderabad"
  description="Fursat is a café, a kitchen, a bar and banquet spaces under one roof at Capital Park, Madhapur. A celebration of food, people and togetherness."
  canonical="https://fursatind.in/story/"
  ogImage="https://fursatind.in/assets/interior/tour-entrance.webp"
  ogImageAlt="The entrance corridor at Fursat with the elephant mural and the Fursat, Aur Kuch Nahi wall"
>
  <SiteHeader active="story" variant="plaster" />
  <script is:inline>if (!matchMedia('(prefers-reduced-motion: reduce)').matches) { document.documentElement.classList.add('fx-pre'); setTimeout(function () { document.documentElement.classList.remove('fx-pre'); }, 3500); }</script>

  <main class="st" id="main">
    <section class="hy st-stage" aria-labelledby="st-h1">
      <HyWindows data={aDesk} photos={[{ ...P.dining, video: heroVid.s }, { ...P.entrance, video: heroVid.d }, P.lounge]} view="d" />
      <HyWindows data={aPhone} photos={[{ ...P.dining, video: heroVid.s }, P.entrance, P.lounge]} view="m" />

      <div class="st-hero" data-fx-hero>
        <p class="hy-kicker" data-fx-step>About Us</p>
        <h1 class="fk-ty-hero hy-h1 st-h1" id="st-h1" data-fx-step data-fx-words>Our <span class="hl">Story</span></h1>
        <p class="st-sub" data-fx-step>A celebration of food, people and togetherness.</p>
        <div class="hy-orn st-orn" data-fx-step aria-hidden="true"><i></i><svg viewBox="0 0 140 176"><path d={elephant} /></svg><i></i></div>
      </div>

      <div class="st-craft" data-fx-reveal>
        <span class="st-craft-gap" aria-hidden="true"></span>
        <h2 class="fk-ty-h2 hy-h2 st-h2"><span>Crafted for</span> <span class="hl">Good Times</span></h2>
        <p class="hy-lead">FURSAT is more than a restaurant. It&rsquo;s a place where flavours, conversations and celebrations come together.</p>
        <p class="hy-lead">A café, a kitchen, a bar and banquet spaces under one roof at Capital Park, Madhapur. Come for a coffee, stay for dinner, bring everyone for the celebration.</p>
        <svg class="hy-orn--draw st-rule" viewBox="0 0 260 24" aria-hidden="true" data-fx-draw><path d="M2 12 H120" /><path d="M128 12 C132 6 138 6 142 12 C138 18 132 18 128 12 Z" /></svg>
        <p class="st-tag">Fursat, aur kuch nahi!</p>
      </div>

      {/* Chapter 1 mascot (MX engine, public/js/mx-mascot.js): namaste, bow, then welcome (mirrored to face the text) */}
      <span class="mx-m mx-ch st-mx1" data-mx="ch" data-ch="1" data-flip data-base="/assets/brand/mascot/" data-sizes="(max-width: 767px) 40vw, 22vw" data-poses="welcome" aria-hidden="true"><img src="/assets/brand/mascot/namaste-480.webp" srcset="/assets/brand/mascot/namaste-480.webp 480w, /assets/brand/mascot/namaste-720.webp 720w" sizes="(max-width: 767px) 40vw, 22vw" width="720" height="720" alt="" loading="lazy" decoding="async" draggable="false"></span>

      <h2 class="fk-ty-h2 st-vh">Our Values</h2>
      <ul class="st-values" data-st-values aria-label="Our values">
        {values.map((v, i) => (
          <li class={`st-val st-val--${v.c}`} style={`--i:${i};--x:${plateD[i].x};--y:${plateD[i].y};--r:${plateD[i].r};--mx:${plateM[i].x};--my:${plateM[i].y};--mr:${plateM[i].r}`}>
            <div class="st-lift">
              <span class="st-disc"></span>
              <span class="st-sheen" aria-hidden="true"><i></i></span>
              <div class="st-val-in">
                <svg viewBox="0 0 24 24" aria-hidden="true" set:html={v.i} />
                <h3 class="fk-ty-h4">{v.t}</h3>
                <p>{v.l}</p>
              </div>
            </div>
          </li>
        ))}
      </ul>

      <div class="st-band" data-fx-reveal>
        <h2 class="fk-ty-h2 st-bh">FURSAT &mdash; Where Good Food<br />Creates <em>Great Memories.</em></h2>
        <svg class="hy-orn--draw st-band-orn" viewBox="0 0 260 24" aria-hidden="true" data-fx-draw>
          <path d="M2 12 H104" /><path d="M156 12 H258" /><path d="M130 3 C122 9 122 15 130 21 C138 15 138 9 130 3 Z" /><path d="M110 12 C116 6 122 6 126 12 M150 12 C144 6 138 6 134 12" />
        </svg>
      </div>
    </section>

    <section class="st-brand" aria-label="The Fursat wall">
      <span class="mx-m mx-ch st-mx2" data-mx="ch" data-ch="2" data-first="welcome" data-flip data-base="/assets/brand/mascot/" data-sizes="(max-width: 767px) 92px, 156px" aria-hidden="true"><img src="/assets/brand/mascot/welcome-480.webp" srcset="/assets/brand/mascot/welcome-480.webp 480w, /assets/brand/mascot/welcome-720.webp 720w" sizes="(max-width: 767px) 92px, 156px" width="720" height="720" alt="" loading="lazy" decoding="async" draggable="false"></span>
      <div class="st-cta" data-fx-reveal>
        <a class="fk-btn fk-btn--primary" href="/reserve/">Reserve a table</a>
        <a class="fk-btn fk-btn--secondary" href="/menu/">See the menu</a>
      </div>
      <figure class="st-wall" data-fx-reveal>
        <img src="/assets/celebrations/brand-wall-group-640.webp" srcset="/assets/celebrations/brand-wall-group-360.webp 360w, /assets/celebrations/brand-wall-group-640.webp 640w" sizes="(max-width: 767px) 62vw, 300px" alt="A group of friends in blue t-shirts standing in front of the Fursat wall with the brand slogan" width="640" height="853" loading="lazy" decoding="async" />
        <figcaption>Fursat, <em>aur kuch nahi</em></figcaption>
      </figure>
    </section>

    <section class="sw" aria-labelledby="sw-h">
      <h2 class="fk-ty-h2 sw-h" id="sw-h" data-fx-reveal>A look <em>around</em></h2>
      <div class="sw-grid sw-grid--3">
        {wall3.map((col) => (
          <ul class="sw-col">
            {col.map((ph) => (
              <li class="sw-tile" style={`aspect-ratio:${ph.w} / ${ph.h};flex-grow:${(ph.h / ph.w).toFixed(3)}`}><img src={ph.src} alt={ph.alt} width={ph.w} height={ph.h} loading="lazy" decoding="async" /></li>
            ))}
          </ul>
        ))}
      </div>
      <div class="sw-grid sw-grid--2" aria-hidden="true">
        {wall2.map((col) => (
          <ul class="sw-col">
            {col.map((ph) => (
              <li class="sw-tile" style={`aspect-ratio:${ph.w} / ${ph.h};flex-grow:${(ph.h / ph.w).toFixed(3)}`}><img src={ph.src} alt="" width={ph.w} height={ph.h} loading="lazy" decoding="async" /></li>
            ))}
          </ul>
        ))}
      </div>
    </section>

    <section class="st-go" aria-labelledby="st-go-h">
      <span class="mx-m mx-ch st-mx3" data-mx="ch" data-ch="3" data-first="thumbs" data-base="/assets/brand/mascot/" data-sizes="(max-width: 767px) 80px, 140px" aria-hidden="true"><img src="/assets/brand/mascot/thumbs-480.webp" srcset="/assets/brand/mascot/thumbs-480.webp 480w, /assets/brand/mascot/thumbs-720.webp 720w" sizes="(max-width: 767px) 80px, 140px" width="720" height="720" alt="" loading="lazy" decoding="async" draggable="false"></span>
      <h2 class="fk-ty-h2 st-go-h" id="st-go-h" data-fx-reveal>Your <em>Fursat</em> starts here</h2>
      <ul class="st-go-list" role="list" data-fx-reveal>
        <li><a class="st-go-card" href="/reserve/"><b>Reserve a table</b><span>Pick a date and time; we confirm on WhatsApp.</span></a></li>
        <li><a class="st-go-card" href="/menu/"><b>Explore the menu</b><span>Kitchen, café and bar, with photos.</span></a></li>
        <li><a class="st-go-card" href="/party/"><b>Plan a celebration</b><span>Birthdays, corporate, kitty and bar parties.</span></a></li>
        <li><a class="st-go-card" href="/banquet/"><b>The banquet hall</b><span>Up to 350 guests, packages and date check.</span></a></li>
        <li><a class="st-go-card" href="/order/"><b>Order online</b><span>Swiggy, Zomato or pick-up.</span></a></li>
        <li><a class="st-go-card" href="/ask/"><b>Ask Fursat</b><span>Tell us your mood; we suggest dishes.</span></a></li>
      </ul>
    </section>

  </main>

<InstagramFeed account="main" layout="page" title="Latest from Fursat" />
<InstaFollow handle="fursatind.in" />
  <MascotOfferModal />
  <SiteFooter />
  <MobileBar active="story" />
  <script>import '../scripts/fk-motion';</script>
  <script>import '../scripts/story-values';</script>
  <script is:inline src="/js/story-hero.js" defer></script>
  <script is:inline src="/js/mx-mascot.js" defer></script>
</Base>

<style is:global>
  .st { background: #10261a; color: var(--fk-ink); font-family: var(--fk-sans); overflow-x: clip; }
  .st :where(h1, h2, h3, p, ul, dl, dd, figure) { margin: 0; padding: 0; }
  .st :where(ul) { list-style: none; }
  .st-stage { aspect-ratio: 1000 / 1500; background: url(/assets/bg/about-desk-0.webp) top / 100% auto no-repeat #f6e6d1; }

  .st-hero { z-index: 3; left: calc(72 * var(--u)); top: calc(168 * var(--u)); width: calc(390 * var(--u)); display: grid; gap: calc(16 * var(--u)); }
  .st-h1 { white-space: nowrap; }
  .st-sub { font: 400 calc(25 * var(--u)) / 1.3 var(--fk-serif); color: #1b3a26; max-width: calc(330 * var(--u)); }
  .st-orn { width: calc(270 * var(--u)); margin-top: calc(8 * var(--u)); }
  .st-orn svg { fill: #c0291f; }

  /* Crafted for Good Times: text on the left, the mascot (.st-mx1) stands at its right. .st-craft-gap is a float that holds the mascot's place so the text wraps around it and never runs under it. */
  .st-craft { z-index: 3; left: calc(548 * var(--u)); top: calc(552 * var(--u)); width: calc(436 * var(--u)); display: block; }
  .st-craft > * + * { margin-top: calc(14 * var(--u)); }
  .st-craft > .st-craft-gap { float: right; width: calc(196 * var(--u)); height: calc(226 * var(--u)); margin: 0 0 0 calc(10 * var(--u)); shape-outside: inset(0); }
  .st-craft > .st-craft-gap + * { margin-top: 0; }
  .st-craft .hy-lead { max-width: none; }
  /* The stage is art that scales with the page width. fk-ty-* gives the scale step; the min() keeps the heading inside the art when the stage is small (tablet, small phones). */
  .st .st-h2 { font-size: min(var(--fk-fs-6), calc(40 * var(--u))); margin-bottom: calc(6 * var(--u)); }
  .st-h2 span { display: block; }
  /* sp-: 11u gives 60-70 characters a line at 1366-1920 (measured); the clamp keeps tablets readable */
  .st-craft .hy-lead { font-size: clamp(13px, calc(11 * var(--u)), 1.35rem); line-height: 1.6; }
  @media (min-width: 1024px) { .st-craft .hy-lead { font-size: clamp(16px, calc(11.5 * var(--u)), 1.35rem); } } /* body text never under 16px on laptop */
  .st-rule { width: calc(150 * var(--u)); min-width: 100px; margin-top: calc(4 * var(--u)); }
  .st-tag { font: italic 500 calc(25 * var(--u)) / 1.2 var(--fk-serif); color: #1b3a26; }

  .st-vh { z-index: 3; left: 0; width: 100%; top: calc(918 * var(--u)); text-align: center; color: #1b3a26; }
