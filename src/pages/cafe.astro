---
import site from '../data/site.json';
// cafe.astro — Fursat Café (P6 restyle: shared ExperienceLayout on the baked plaster stage, mock "Café + Restaurant + Bar").
// Content is the page's existing copy, items, prices and photos; only the design changed.
// Wi-Fi: confirmed by the client. TODO(client): confirm Café featured items and the power-plug claim (moments text + FAQ). Pillars use menu counts only.
import Base from '../layouts/Base.astro';
import ExperienceLayout from '../components/experience/ExperienceLayout.astro';
import InstaPostTile from '../components/InstaPostTile.astro';
// kit 38c step 8: the post wall. Order = reading order down the columns; the square post (20) sits mid-wall so the shapes mix.
const WALL = ['01', '02', '04', '05', '20', '06', '09', '10', '12', '14', '15', '16'] as const;
---
<Base
  title="Café Lounge – Fursat Kitchen & Bar, Madhapur"
  description="Fursat Café Lounge in Madhapur, Hyderabad — coffees, teas, milk shakes, desserts and all-day breakfast. Work, unwind or catch up with friends."
  canonical="https://fursatind.in/cafe/"
  ogImage="https://fursatind.in/assets/fursat_space_09.webp"
  ogImageAlt="Fursat Café Lounge interior — cosy seating and warm lighting"
>
  <ExperienceLayout
    /* insta removed on purpose (38c): the Café's Instagram is now the Bites & Buffet wall below, so Instagram shows once. */
    active="cafe"
    kicker="Slow mornings · Coffee & shakes"
    h1a="Coffee, Shakes &"
    h1b="Slow Mornings"
    lead="Coffees, teas, milk shakes, desserts and all-day breakfast, ordered from the same menu as the rest of Fursat."
    ctas={[
      { label: 'Explore Café Menu', href: '/menu?menu=cafe', primary: true },
      { label: 'Book a Café Booth', href: '/reserve', book: true },
    ]}
    hero={{ src: '/assets/dishes/new/cappuccino.webp', alt: 'Cappuccino at Fursat Café', w: 1067, h: 1600, pos: '50% 50%' }}
    pillars={[
      { icon: 'coffee', title: 'Coffee', href: '/menu/?menu=cafe#go=d-coffee', line: '27 coffees on the menu.' },
      { icon: 'leaf', title: 'Tea', href: '/menu/?menu=cafe#go=d-coffee', line: '10 teas, from chai to green tea.' },
      { icon: 'bake', title: 'Desserts & Cookies', href: '/menu/?menu=cafe#go=f-desserts', line: 'Cheesecakes, tiramisu, cookies.' },
      { icon: 'shake', title: 'Shakes & Smoothies', href: '/menu/?menu=cafe#go=d-shakes', line: '8 milk shakes, 4 smoothies.' },
    ]}
    momentsA="Spaces Designed"
    momentsB="to Unwind"
    momentsText="Quiet lunch breaks, afternoon meetings and evening desserts. Café booths and high tables with free Wi-Fi."
    momentsCta={{ label: 'Book a Café Booth', href: '/reserve', book: true }}
    big={{ src: '/assets/interior/fursat_space_05.webp', alt: 'Café interior with natural light', w: 1920, h: 2560 }}
    top={{ src: '/assets/interior/fursat_space_15.webp', alt: 'Artisan coffee bar counter', w: 1920, h: 2560 }}
    bottom={{ src: '/assets/interior/fursat_space_06.webp', alt: 'Cosy seating corner', w: 1920, h: 2560 }}
    cardsId="cafe-menu"
    cardsKicker="The café selection"
    cardsTitle="Favorites from the Counter"
    cards={[
      { tag: 'Coffee', name: 'Cafe Mocha', price: '₹239', text: 'From our coffee menu.', img: { src: '/assets/dishes/new/cafe-mocha.webp', alt: 'Cafe Mocha' } },
      { tag: 'Coffee', name: 'Cappuccino', price: '₹219', text: 'From our coffee menu.', img: { src: '/assets/dishes/new/cappuccino.webp', alt: 'Cappuccino' } },
      { tag: 'Coffee', name: 'Iced Latte', price: '₹249', text: 'From our coffee menu.', img: { src: '/assets/dishes/new/iced-latte.webp', alt: 'Iced Latte' } },
      { tag: 'All day breakfast', name: 'OG French Toast', price: '₹329', text: 'Vegetarian. From our all day breakfast menu.', img: { src: '/assets/dishes/new/og-french-toast.webp', alt: 'OG French Toast' } },
    ]}
    cardsLink={{ label: 'See the full café menu', href: '/menu?menu=cafe' }}
    faqTitle="Café FAQs"
    faq={[
      { q: 'What are the café opening hours?', a: `Our café is open ${site.hours.display}. Perfect for quiet lunch breaks, afternoon meetings, and evening desserts.` },
      { q: 'Is Wi-Fi available for remote working?', a: 'Yes, our café booths and high-table areas have free Wi-Fi for remote work or meetings.' },
      { q: 'Can I order café items along with the main restaurant menu?', a: 'Yes, all café beverages, shakes, and desserts can be ordered from any table across Fursat.' },
    ]}
  >
    <section class="bw" slot="after-faq" aria-labelledby="bw-h">
      <h2 class="bw-h" id="bw-h">Fresh from <em>@fursat_bitesandbuffet</em></h2>
      <p class="bw-sub">Dishes, drinks and desserts from our Instagram.</p>
      <ul class="bw-wall">
        {WALL.map((n, i) => <InstaPostTile n={n} phoneHide={i >= 6} />)}
      </ul>
      <p class="bw-more">
        <a class="bw-btn" href="https://www.instagram.com/fursat_bitesandbuffet/" target="_blank" rel="noopener">
          <svg viewBox="0 0 24 24" aria-hidden="true"><rect x="3" y="3" width="18" height="18" rx="5.5" /><circle cx="12" cy="12" r="4.2" /><circle cx="17.4" cy="6.6" r="1.1" class="bw-dot" /></svg>
          <span>See more on Instagram</span>
        </a>
      </p>
    </section>
  </ExperienceLayout>
</Base>

<style is:global>
/* ---- Café post wall (38c, prefix bw-) ---- */
.bw { background: #10261a; padding: clamp(36px, 5vw, 72px) clamp(16px, 5vw, 80px) clamp(40px, 5vw, 72px); text-align: center; }
.bw .bw-h { margin: 0; color: #fbf3e6; font: 500 clamp(1.625rem, 3.4vw, 2.5rem)/1.15 "Playfair Display", Georgia, serif; text-wrap: balance; }
.bw-h em { display: block; margin-top: .35em; color: #e8c27a; font: 600 .62em/1.2 Rupee, Poppins, system-ui, sans-serif; font-style: normal; letter-spacing: .01em; overflow-wrap: anywhere; }
.bw .bw-sub { margin: .75rem auto clamp(28px, 4vw, 44px); max-width: 30ch; text-wrap: balance; color: #d9c9a6; font: 400 .9375rem/1.5 Rupee, Poppins, system-ui, sans-serif; }
.bw-wall { list-style: none; margin: 0 auto; padding: 0; max-width: 1200px; column-count: 4; column-gap: 16px; text-align: left; }
.bw-wall .bw-tile { break-inside: avoid; margin-bottom: 16px; }
.bw .bw-more { margin: clamp(14px, 3vw, 32px) 0 0; }
.bw-btn { display: inline-flex; align-items: center; justify-content: center; gap: 10px; min-height: 48px; padding: 0 26px; border-radius: 999px; text-decoration: none; color: #fbf3e6; font: 600 .9375rem/1 Rupee, Poppins, system-ui, sans-serif; background: rgb(255 255 255 / .07); border: 1px solid rgb(232 194 122 / .55); transition-property: transform, background-color; transition-duration: .15s, .2s; transition-timing-function: ease-out; -webkit-tap-highlight-color: transparent; }
.bw-btn svg { width: 20px; height: 20px; fill: none; stroke: currentColor; stroke-width: 1.8; }
.bw-btn:focus-visible { outline: 3px solid #e8c27a; outline-offset: 3px; }
@media (hover: hover) and (pointer: fine) { .bw-btn:hover { background: rgb(255 255 255 / .14); transform: translateY(-2px); } }
.bw-btn:active, .bw-btn:hover:active { transform: scale(.96); } /* after the hover rule on purpose */
@media (max-width: 1099px) { .bw-wall { column-count: 3; } }
@media (max-width: 767px) {
  .bw-wall { column-count: 2; column-gap: 10px; }
  .bw-wall .bw-tile { margin-bottom: 10px; }
  .bw-wall .bw-tile--ph { display: none; } /* phone shows 6, then the Instagram button */
}
</style>
