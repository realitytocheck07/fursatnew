---
import InstaFollow from '../components/InstaFollow.astro';
import Base from '../layouts/Base.astro';
import SiteHeader from '../components/SiteHeader.astro';
import SiteFooter from '../components/SiteFooter.astro';
import MobileBar from '../components/MobileBar.astro';
import HyWindows from '../components/hybrid/HyWindows.astro';
import CornerHero from '../components/CornerHero.astro';
import PartyPackages from '../components/party/PartyPackages.astro';
import PartyBuilder from '../components/party/PartyBuilder.astro';
import CelebrationViewer from '../components/CelebrationViewer.astro';
import pDesk from '../../scripts/bg-specs/party-desk.out.json';
import '../styles/fk-tokens.css';
// v5.36 redesign: hero (CornerHero + labels) -> Our Party Packages (4 cards) -> Build Your Celebration -> closing panel.
// All packages, prices, dishes and add-ons come from src/data/party.json (read by the two party components).
// TODO(client): real banquet-hall and party photos for the closing panel.
const A = '/assets/heroes/slides/', C = '/assets/celebrations/';
// g = graded full-aspect photo (same grade as the old window crops); pos = object-position [laptop, phone] so the faces/dishes stay in the frame; filt = one CSS warm grade for the cold cake
const paSlide = (cap: string, alt: string, full: string, fw: number, fh: number, cat: string, g?: string, pos?: [string, string], filt?: string) => ({ cap: ['Real celebrations at Fursat', cap] as [string, string], alt, full, fw, fh, cat, d: g, p: g, pos, filt });
const paSS = {
  label: 'Photos of celebrations at Fursat',
  mask: { d: '/assets/heroes/pa-hero-window-mask.webp', p: '/assets/heroes/pa-hero-window-mask-phone.webp' },
  win: { d: [56.3, 20.6, 100, 68.8], p: [2, 29.6, 99, 91.3] }, ui: { d: [68.7, 20.6, 100, 63], p: [2, 29.6, 99, 91.3] },
  cats: [{ id: 'birthday', label: 'Birthdays' }, { id: 'kitty', label: 'Kitty parties' }, { id: 'corporate', label: 'Corporate' }, { id: 'cakes', label: 'Cakes' }],
  slides: [
    paSlide('Set for a party', 'High tables at Fursat ready for a party', '/assets/interior/tour-high-tables.webp', 1050, 1400, 'birthday'),
    paSlide('Birthday cake', 'A birthday cake on the table', C + 'birthday-cake-dad-640.webp', 640, 853, 'birthday', `${A}g-birthday-cake.webp`, ['50% 35%', '50% 46%']),
    paSlide('Kitty games', 'Guests playing games at a high table', C + 'kitty-high-table-games-640.webp', 640, 853, 'kitty', `${A}g-kitty-games.webp`, ['50% 25%', '50% 24%']),
    paSlide('Corporate evening', 'A corporate audience seated in the hall facing a lit stage', C + 'corporate-audience-stage-640.webp', 640, 853, 'corporate', `${A}g-corporate.webp`, ['50% 59%', '50% 50%']),
    paSlide('Felicitation', 'A felicitation group photo on the stage at Fursat', C + 'felicitation-group-stage-640.webp', 640, 853, 'corporate', `${A}g-felicitation.webp`, ['50% 41%', '50% 33%']),
    paSlide('Celebration cake', 'A rose celebration cake', '/assets/bites/bw-03-720.webp', 720, 900, 'cakes', `${A}g-cake-rose.webp`, ['50% 90%', '50% 70%']),
    paSlide('Celebration cake', 'A celebration cake with decorations', '/assets/bites/bw-21-720.webp', 720, 900, 'cakes', '/assets/bites/bw-21-720.webp', ['50% 100%', '50% 90%'], 'sepia(.2)'),
  ],
};
const closePhoto = { src: '/assets/interior/tour-high-tables.webp', alt: 'High tables at Fursat ready for a party', w: 1050, h: 1400, pos: '50% 55%' };
const elephant = 'M109.5 10.2 L100.2 6.0 L81.5 4.0 L70.5 8.0 L61.0 18.5 L60.0 24.2 L62.8 30.5 L69.5 34.8 L76.2 34.8 L81.8 31.2 L83.5 27.2 L79.5 24.0 L76.2 27.0 L71.8 25.2 L71.8 22.5 L79.5 16.8 L88.2 16.8 L92.5 18.8 L98.0 25.5 L98.0 32.2 L88.2 44.0 L73.5 52.0 L64.5 58.0 L55.0 67.5 L51.0 74.5 L48.0 83.5 L48.0 98.2 L52.2 108.5 L57.5 112.8 L69.5 118.8 L80.2 119.8 L88.2 116.8 L92.8 110.2 L92.8 105.5 L94.5 104.0 L96.0 106.5 L96.0 114.2 L89.2 123.0 L82.2 126.0 L66.5 126.0 L56.5 122.0 L50.2 118.0 L43.8 110.2 L40.2 102.0 L29.5 107.0 L20.2 114.2 L14.0 123.5 L5.2 139.2 L13.2 138.0 L13.0 150.2 L12.0 160.2 L13.0 166.2 L14.5 170.8 L35.2 170.8 L35.8 163.5 L39.8 157.2 L48.2 155.8 L53.0 160.5 L54.5 170.8 L74.2 170.8 L74.8 161.5 L78.2 157.0 L86.2 155.8 L92.0 161.5 L92.5 170.8 L117.8 170.2 L116.8 159.5 L115.8 142.5 L117.8 127.5 L125.8 114.2 L130.8 103.2 L133.8 94.2 L135.8 81.2 L135.8 64.5 L133.8 55.2 L128.8 39.2 L121.8 24.5Z';
const why = [
  { t: 'Exquisite Cuisine', i: '<path d="M3 20h18"/><path d="M20 16a8 8 0 1 0-16 0"/><path d="M12 4v4M10 4h4"/>' },
  { t: 'Elegant Ambience', i: '<path d="M9 3h6l2 6H7z"/><path d="M12 9v9M8 21h8"/><path d="M5 9h14"/>' },
  { t: 'Warm Hospitality', i: '<path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M22 21v-2a4 4 0 0 0-3-3.87M16 3.13a4 4 0 0 1 0 7.75"/>' },
  { t: 'Prime Location', i: '<path d="M12 21s-7-6.2-7-11a7 7 0 0 1 14 0c0 4.8-7 11-7 11z"/><circle cx="12" cy="10" r="2.5"/>' },
];
const WA = '919059670033';
const waHi = 'https://wa.me/' + WA + '?text=' + encodeURIComponent('Hi Fursat! I would like to plan a party.');
import InstagramFeed from '../components/InstagramFeed.astro';
---
<Base title="Parties & Events – Fursat Kitchen & Bar, Madhapur" description="Birthdays, corporate gatherings, kitty parties and bar bashes at Fursat, Madhapur. Bar party, elite buffet and banquet packages." canonical="https://fursatind.in/party/" preloadImages={[{ href: '/assets/heroes/party-phone-780.webp', imagesrcset: '/assets/heroes/party-phone-780.webp 780w, /assets/heroes/party-phone-1080.webp 1080w', imagesizes: '100vw', media: '(max-width: 820px)', type: 'image/webp' }, { href: '/assets/heroes/party-1024.webp', imagesrcset: '/assets/heroes/party-768.webp 768w, /assets/heroes/party-1024.webp 1024w, /assets/heroes/party-1536.webp 1536w', imagesizes: '100vw', media: '(min-width: 821px)', type: 'image/webp' }]}>
<a class="skip" href="#pk-main">Skip to main content</a>
<div class="pa">
  <SiteHeader active="celebrate" variant="plaster" />
  <script is:inline>if (!matchMedia('(prefers-reduced-motion: reduce)').matches) { document.documentElement.classList.add('fx-pre'); setTimeout(function () { document.documentElement.classList.remove('fx-pre'); }, 3500); }</script>
  <!-- v5.72 stacked sticky sections: the 4 panels are SIBLINGS of one parent (.pa-stack) so position:sticky can layer them -->
  <main id="pk-main" tabindex="-1" class="pa-stack">
    <div class="pa-panel pa-panel--hero" data-pa-panel>
      <CornerHero page="party" id="pa-h1" kicker="Celebrate beautifully at FURSAT"
        h1a="Every Occasion Deserves a Beautiful" h1b="Celebration" hlColor="#c02a1a"
        sub="Make yours unforgettable." subHl="unforgettable"
        lead="Pick a package, tell us how many are coming, and we will confirm the rest on WhatsApp."
        ss={paSS}
        alt="Two oval gold windows with photos of Fursat set for a party"
        ctas={[{ label: 'Plan Your Party', href: '#pa-plan', primary: true }, { label: 'See Packages', href: '#pa-packs' }]} />
    </div>
    <div class="pa-panel pa-panel--plan" data-ask-hint="Not sure which package? Ask me|Which party package should I pick" data-pa-panel data-pa-last>
      <PartyPackages />
      <PartyBuilder />
      <figure class="pa-feast" data-fx-reveal>
        <img src="/assets/feast/feast-table-1200.webp"
          srcset="/assets/feast/feast-table-768.webp 768w, /assets/feast/feast-table-1200.webp 1200w, /assets/feast/feast-table-1600.webp 1600w"
          sizes="(max-width: 767px) 92vw, 1100px" width="1600" height="810"
          alt="A round table filled with plates of food and desserts" loading="lazy" decoding="async" />
        <figcaption>A table for the whole group.</figcaption>
      </figure>
    </div>
  </main>

  <!-- closing art (bottom slice + quote, plates, band) sits after the stack and scrolls normally -->
  <div class="hy pa-hy">
    <div class="hy-slice hy-mid" aria-hidden="true"></div><div class="hy-slice hy-bot" aria-hidden="true"></div>
    <HyWindows data={pDesk} slice={2} photos={[closePhoto]} view="d" anchor="bottom" />
    <div class="hy-flow pa-flow" aria-hidden="true"></div>

<figure class="pa-quote" data-fx-reveal>
      <svg class="pa-qm" viewBox="0 0 40 32" aria-hidden="true"><path d="M0 32V18C0 8 6 2 16 0l2 5c-6 2-9 6-9 11h8v16zm22 0V18c0-10 6-16 16-18l2 5c-6 2-9 6-9 11h8v16z"/></svg>
      <blockquote>Good food, great company and unforgettable moments.</blockquote>
      <div class="hy-orn pa-q-orn" aria-hidden="true"><i></i><svg viewBox="0 0 140 176"><path d={elephant} /></svg><i></i></div>
    </figure>

    <div class="pa-why">
      <h2 class="fk-ty-h2 hy-h2 pa-why-h" data-fx-reveal>Why Choose <span class="pa-fursat">FURSAT</span>?</h2>
      <ul class="pa-plates" data-fx-pop>
        {why.map((w, i) => (
          <li class={`pa-plate pa-plate--${i + 1}`} data-fx-tilt><svg viewBox="0 0 24 24" aria-hidden="true" set:html={w.i} /><span>{w.t}</span></li>
        ))}
      </ul>
    </div>

    <div class="pa-close" data-fx-reveal>
      <h2 id="pa-close-h" class="fk-ty-h2">Let&rsquo;s Celebrate <em>Together</em></h2>
      <p>Pick a package above and send your plan on WhatsApp. We confirm every party personally.</p>
      <a class="fk-btn fk-btn--primary fk-btn--md fk-btn--on-dark" href={waHi} target="_blank" rel="noopener"><span>Plan on WhatsApp</span></a>
    </div>
  </div>
</div>
<InstagramFeed account="banquets" layout="page" title="Latest from Fursat Banquets" />
<InstaFollow handle="fursatbanquets" />
<SiteFooter />
<MobileBar active="celebrate" />
<CelebrationViewer />
<script>import '../scripts/fk-motion';</script>
<style is:global>
/* v5.72 stacked sticky sections: Welcome -> Packages -> Feast -> Plan. Each panel is sticky under the header and covers the one before it. */
.pa-stack{position:relative;isolation:isolate;display:block;background:#f6e6d1}
.pa-panel{position:sticky;top:var(--pa-top,var(--sh-h,104px));z-index:var(--pa-z,1);box-sizing:border-box;min-height:calc(100svh - var(--sh-h,104px));background:var(--fk-plaster);box-shadow:0 -14px 34px -10px rgba(52,32,8,.34);transform-origin:50% 0}
.pa-panel--hero{--pa-z:1;top:var(--pa-top,0px);min-height:0;background:#f6e4c9;box-shadow:none}
.pa-panel--plan{padding-top:clamp(8px,1.5vw,24px)}
.pa-panel--feast{--pa-z:3;display:flex;flex-direction:column;justify-content:center}
.pa-panel--plan{--pa-z:4;position:relative;top:auto}
@media (min-width:768px){
  .pa-panel--plan{display:flex;flex-direction:column;justify-content:center}
}
/* time-of-day tint: it used to sit on the .hy stage; the stage now only holds the closing art, so it moves to the Packages panel */
.pa-panel--plan::before{content:"";position:absolute;left:0;right:0;top:0;height:75vw;z-index:2;pointer-events:none;opacity:0;transition:opacity 1.2s ease;-webkit-mask-image:linear-gradient(180deg,#000 60%,transparent);mask-image:linear-gradient(180deg,#000 60%,transparent)}
html[data-daypart="morning"] .pa-panel--plan::before{opacity:1;background:radial-gradient(120% 70% at 15% 0%,rgba(255,252,240,.22),transparent 60%);mix-blend-mode:screen}
html[data-daypart="evening"] .pa-panel--plan::before{opacity:1;background:radial-gradient(130% 85% at 85% 0%,rgba(214,130,50,.26),transparent 62%),linear-gradient(180deg,rgba(130,70,20,.10),rgba(70,35,10,.06));mix-blend-mode:multiply}
.pa-hy::before{display:none}
/* phone: both hero buttons must sit above the fixed bottom nav bar at scroll 0 (bar = 64px + 12px offset = --pa-bar). The hero keeps its full-screen height (the free space sits below the buttons, behind the bar). Buttons share one row; the hero picture takes whatever height is left (never taller than its normal 16:9). */
@media (max-width:767px){
  .pa{--pa-bar:calc(76px + env(safe-area-inset-bottom,0px))}
  .pa-panel--hero .ch{min-height:100svh;box-sizing:border-box}
}

/* push-back: the panel that gets covered shrinks to .94 and dims (transform + opacity only). Driven by the NEXT panel's view timeline (CSS scroll-driven animations). */
.pa-panel::after,.pa-dim{content:"";position:absolute;inset:0;z-index:30;background:#1d1306;opacity:0;pointer-events:none}
.pa-dim{display:block}
.pa-stack:not(.pa-fb) .pa-dim{display:none}
.pa-fb .pa-panel::after{display:none}
.pa-panel--plan::after{display:none}
@keyframes pa-back{to{transform:scale(.94)}}
@keyframes pa-dim{to{opacity:.4}}
@media (prefers-reduced-motion:no-preference){
  @supports (animation-timeline:view()){
    .pa-stack{timeline-scope:--pa-t1}
    .pa-panel--plan{view-timeline:--pa-t1 block}
    .pa-panel--hero,.pa-panel--hero::after{animation-timeline:--pa-t1}
    .pa-panel--hero{animation-name:pa-back;animation-timing-function:linear;animation-fill-mode:both;animation-duration:1ms;animation-range:cover 0px cover var(--pa-d,calc(100svh - var(--sh-h,104px)))}
    .pa-panel--hero::after{animation-name:pa-dim;animation-timing-function:linear;animation-fill-mode:both;animation-duration:1ms;animation-range:cover 0px cover var(--pa-d,calc(100svh - var(--sh-h,104px)))}
  }
}
/* hybrid stage: textless background art + the closing panel (quote, plates, band) laid over the bottom slice */
.pa{flex:none;background:#f6e6d1;color:var(--fk-ink);font-family:var(--fk-sans)}
.pa-hy{--mid:url(/assets/bg/party-desk-1.webp);--bot:url(/assets/bg/party-desk-2.webp);--th:2;--bh:500;background:#f6e6d1}
.pa-flow{padding:0 0 calc(520 * var(--u));z-index:3}
.pa .pa-stack{outline:0}
/* feast banner: cropped real photo (no other-brand cushions), caption under it so it never covers the food */
.pa-feast{margin:clamp(20px,3vw,44px) auto;max-width:1100px;padding:0 clamp(12px,4vw,24px)}
.pa-feast img{display:block;width:100%;height:auto;border-radius:22px;box-shadow:0 0 0 1px rgba(214,170,90,.55),0 16px 34px rgba(60,40,10,.25)}
.pa-feast figcaption{margin-top:12px;text-align:center;font:italic 500 clamp(18px,2.2vw,26px)/1.25 var(--fk-serif);color:#1b3a26}
.pa-quote{z-index:3;margin:0;left:calc(70 * var(--u));bottom:calc(270 * var(--u));width:calc(340 * var(--u));color:#fbf3e6;display:grid;gap:calc(14 * var(--u))}
.pa-qm{width:calc(34 * var(--u));min-width:22px;height:auto;fill:#e8a85a}
.pa-quote blockquote{margin:0;font:italic 500 calc(31 * var(--u))/1.25 var(--fk-serif);color:#fbf3e6;text-wrap:balance}
.pa-q-orn{width:calc(220 * var(--u))}
.pa-q-orn svg{fill:#e8c27a}
.pa-why{z-index:3;left:calc(520 * var(--u));bottom:calc(270 * var(--u));width:calc(460 * var(--u));height:calc(200 * var(--u))}

.pa-plates{list-style:none;margin:0;padding:0;position:absolute;inset:0}
.pa-plate{position:absolute;top:calc(63 * var(--u));width:calc(104 * var(--u));height:calc(128 * var(--u));translate:-50% 0;display:grid;place-content:center;justify-items:center;gap:calc(8 * var(--u));text-align:center}
.pa-plate--1{left:calc(58 * var(--u))}.pa-plate--2{left:calc(170 * var(--u))}.pa-plate--3{left:calc(280 * var(--u))}.pa-plate--4{left:calc(392 * var(--u))}
.pa-plate svg{width:calc(32 * var(--u));min-width:18px;height:auto;fill:none;stroke:#1b3a26;stroke-width:1.4;stroke-linecap:round;stroke-linejoin:round}
.pa-plate span{font:500 max(12px,calc(14 * var(--u)))/1.15 var(--fk-serif);color:#1b3a26;max-width:calc(84 * var(--u))}
.pa-close{z-index:3;left:calc(60 * var(--u));bottom:calc(46 * var(--u));width:calc(470 * var(--u));display:grid;gap:calc(14 * var(--u));justify-items:start;color:#fbf3e6}

.pa-close p{margin:0;font:400 clamp(12.5px,calc(15 * var(--u)),1.15rem)/1.55 var(--fk-sans);color:rgba(246,234,214,.86);max-width:44ch}
@media(max-width:767px){
  .pa-hy{--mid:url(/assets/bg/party-phone-1.webp);--bot:url(/assets/bg/party-phone-2.webp);--th:2;--bh:878.7}
  .pa-flow{padding:0 0 calc(900 * var(--u))}
  .pa-quote{left:calc(90 * var(--u));right:calc(90 * var(--u));width:auto;bottom:calc(612 * var(--u));justify-items:center;text-align:center;gap:2px}
  .pa-qm{display:none}
  .pa-quote blockquote{font-size:calc(43 * var(--u))}
  .pa-q-orn{width:calc(360 * var(--u))}
  .pa-why{left:0;width:100%;bottom:calc(318 * var(--u));height:calc(222 * var(--u))}
  
  .pa-plate{top:calc(22 * var(--u));width:calc(220 * var(--u));height:calc(190 * var(--u));gap:3px}
  .pa-plate--1{left:calc(157 * var(--u))}.pa-plate--2{left:calc(388 * var(--u))}.pa-plate--3{left:calc(613 * var(--u))}.pa-plate--4{left:calc(840 * var(--u))}
  .pa-plate span{font-size:clamp(10.5px,3.05vw,12px);line-height:1.1;max-width:calc(200 * var(--u))}
  .pa-plate svg{min-width:15px}
  .pa-close{left:0;width:100%;bottom:calc(4 * var(--u));justify-items:center;text-align:center;gap:6px}
  
  .pa-close p{display:none}
}
/* middle slice = plain cream plaster, so cards and the builder sit on the same cream as the hero */
.pa-hy .hy-mid{background:var(--fk-plaster);background-blend-mode:multiply}
.sf-footer{background:var(--fk-forest-900)}
.pa-why-h{position:absolute;left:0;right:0;top:calc(-6 * var(--u));text-align:center;color:#1b3a26}
.pa-fursat{color:#2a5019}
.pa-close .fk-ty-h2{color:#fbf3e6}
.pa-close .fk-ty-h2 em{font-style:normal;color:#eda05a}
@media(max-width:767px){.pa-why-h{position:absolute!important;width:1px;height:1px;overflow:hidden;clip-path:inset(50%)}.pa-close .fk-ty-h2{font-size:var(--fk-fs-4)}}
/* hero: second button = cream with a gold rim */
.pa .ch-btns .fk-btn--secondary{border-color:#c99a43;background:#fcf7f0}
/* phone: leave room for the summary bar so it never covers the footer links */
@media(max-width:767px){.pa{overflow-x:clip}}
</style>
<script is:inline src="/js/party.js"></script>
<script is:inline src="/js/pa-stack.js" defer></script>
</Base>
