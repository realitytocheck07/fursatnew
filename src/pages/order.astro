---
// order.astro - Order at home (Swiggy + Zomato). Links live in site.json -> order.
import Base from '../layouts/Base.astro';
import '../styles/fk-tokens.css';
import site from '../data/site.json';
import SiteHeader from '../components/SiteHeader.astro';
import SiteFooter from '../components/SiteFooter.astro';
import MobileBar from '../components/MobileBar.astro';

const order = site.order;
---
<Base
  title="Order Online — Swiggy & Zomato | Fursat Kitchen | Bar | Madhapur"
  description="Order Fursat Kitchen | Bar at home in Madhapur, Hyderabad, on Swiggy or Zomato."
  canonical="https://fursatind.in/order/"
  ogImage="https://fursatind.in/assets/fursat_space_10.webp"
  ogImageAlt="Fursat Kitchen | Bar — Order online in Madhapur"
>
  <SiteHeader active="order" variant="plaster" />

  <main class="od-page" id="main">
    <section class="od-hero">
      <div class="od-hero-bg" aria-hidden="true"></div>
      <div class="od-hero-inner">
        <span class="fk-ty-label od-pill">ORDER ONLINE</span>
        <h1 class="fk-ty-hero od-hero-title mot-headline">Order Fursat at home</h1>
        <p class="fk-ty-body od-hero-sub">Pick your app and order.</p>

        <div class="od-card">
          <div class="od-actions">
            <a href={order.swiggy} target="_blank" rel="noopener" class="fk-btn od-app od-app--swiggy">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 8h14l-1 12H6L5 8z"/><path d="M9 8a3 3 0 0 1 6 0"/></svg>
              <span>Order on Swiggy</span>
            </a>
            <a href={order.zomato} target="_blank" rel="noopener" class="fk-btn od-app od-app--zomato">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M3 11h18"/><path d="M5 11a7 7 0 0 1 14 0"/><path d="M4 11l1.5 8h13L20 11"/></svg>
              <span>Order on Zomato</span>
            </a>
          </div>
          <p class="od-note">Delivery prices and offers are set on each app.</p>

          {order.pickup && (
            <div class="od-pickup">
              {/* TODO(Rista): pickup + online payment. Build this block when the Rista POS is enabled, then set order.pickup to true in site.json. */}
            </div>
          )}

          <div class="od-links">
            <a href="/menu" class="fk-btn fk-btn--secondary fk-btn--md">See the Menu</a>
            <a href="/reserve" class="fk-btn fk-btn--secondary fk-btn--md">Reserve a Table</a>
          </div>
        </div>
      </div>
    </section>
  </main>

  <SiteFooter />
  <MobileBar active="" />
  <script is:inline src="/js/motion-kit.js"></script>
</Base>

<style is:global>
  .od-page {
    background: transparent;
    color: #1f2a1a;
    min-height: 80vh;
    font-family:var(--fk-sans)}
  .od-hero {
    position: relative;
    min-height: 560px;
    display: flex;
    align-items: center;
    justify-content: center;
    overflow: hidden;
    padding: clamp(60px, 8vw, 100px) clamp(16px, 4vw, 40px)}
  .od-hero-bg {
    position: absolute;
    inset: 0;
    background: linear-gradient(180deg, rgba(238,212,178,.86) 0%, rgba(238,212,178,.93) 100%), url('/assets/interior/fursat_space_10.webp') center/cover no-repeat}
  .od-hero-inner {
    position: relative;
    z-index: 1;
    max-width: 680px;
    margin: 0 auto;
    text-align: center}
  
  
  
  .od-card {
    background: rgba(251,243,231,.94);
    backdrop-filter: blur(12px);
    -webkit-backdrop-filter: blur(12px);
    border: 1.5px solid rgba(201,154,67,0.55);
    border-radius: 24px;
    padding: clamp(28px, 5vw, 44px);
    box-shadow: 0 20px 60px rgba(90,60,20,0.20)}
  
  
  .od-actions {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 14px}
  
  
  
  
  

  @media (max-width: 420px) { .od-hero { min-height: 0; padding-top: 20px; padding-bottom: 40px; } }
/* Phase 4B: layout + colour only. */
  .od-pill { display: inline-block; padding: 6px 16px; border-radius: 999px; background: rgba(214,170,90,0.21); border: 1px solid #d6aa5a; color: #5a3b0f; margin-bottom: 16px }
  .od-hero-title { margin: 0 0 12px; color: #1f2a1a }
  .od-hero-sub { margin: 0 0 32px; color: #4a4232 }
  .od-app { border-radius: 999px; width: 100%; max-width: 440px; min-height: 56px; gap: 12px; border: 0; color: #fff; font-weight: 600; box-shadow: 0 10px 22px -12px rgba(30,20,10,.55) }
  .od-app svg { width: 24px; height: 24px; flex-shrink: 0 }
  .od-app--swiggy { background: #c2560a }
  .od-app--zomato { background: #cb202d }
  .od-app:focus-visible { outline: 3px solid #14301c; outline-offset: 3px }
  @media (hover: hover) { .od-app:hover { filter: brightness(1.08) } }
  .od-note { margin: 16px 0 0; font-size: .875rem; color: #4a4232 }
  .od-links { display: flex; flex-wrap: wrap; justify-content: center; gap: 12px; margin-top: 24px }
</style>
