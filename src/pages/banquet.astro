---
// banquet.astro - The Royal Banquet Hall at Fursat
// Hero, photos, capacity line, event packages, sample menu & enquiry form
// TODO(client): confirm the capacity line (350 floating / 220 round-table, dual 4K laser projection & AV, valet parking & lift access) and the 30% advance deposit in the FAQ. Kept as the owner decided.
import InstaFollow from '../components/InstaFollow.astro';
import Base from '../layouts/Base.astro';
import '../styles/fk-tokens.css';
import '../styles/fe-form.css';
import FeGo from '../components/FeGo.astro';
import SiteHeader from '../components/SiteHeader.astro';
import SiteFooter from '../components/SiteFooter.astro';
import MobileBar from '../components/MobileBar.astro';
import MascotOfferModal from '../components/MascotOfferModal.astro';
import PackageBuilder from '../components/banquet/PackageBuilder.astro';
import CornerHero from '../components/CornerHero.astro';
import CelebrationViewer from '../components/CelebrationViewer.astro';
import InstagramFeed from '../components/InstagramFeed.astro';
const words = (t: string) => t.split(' ');
import partyData from '../data/party.json';
const inr = (n: number) => '₹' + n.toLocaleString('en-IN');
const pkgOpts = (partyData as any).packages.filter((p: any) => p.group === 'banquet').sort((a: any, b: any) => a.price - b.price).map((p: any) => ({ id: p.id, text: `${inr(p.price)} ${p.veg ? 'Veg' : 'Non-veg'} package` }));
import slotsData from '../data/slots.json';
// last slot start hour (24h) from slots.json: after it, the date strip starts at Tomorrow
const lastHour = (() => { const t = String((slotsData as any[]).at(-1)?.time || '11 PM').match(/(\d+)\s*(AM|PM)/i); return t ? (Number(t[1]) % 12) + (/pm/i.test(t[2]) ? 12 : 0) : 23; })();
// Lock your date: occasion tiles. v = exact text sent on WhatsApp (unchanged); t/sub = what the tile shows. Real Fursat photos only.
const occasions = [
  { v: 'Birthday Celebration', t: 'Birthday', sub: '', img: '/assets/celebrations/birthday-cake-dad-360.webp', w: 360, img2: '/assets/celebrations/birthday-cake-dad-640.webp', w2: 640, h2: 853 },
  { v: 'Wedding / Sangeet / Reception', t: 'Wedding', sub: 'Sangeet · Reception', img: '/assets/venue/banquet/banquet-hall-04-480.webp', w: 480, img2: '/assets/venue/banquet/banquet-hall-04-720.webp', w2: 720, h2: 960 },
  { v: 'Corporate Gala / Seminar', t: 'Corporate', sub: 'Gala · Seminar', img: '/assets/celebrations/talk-event-stage-360.webp', w: 360, img2: '/assets/celebrations/talk-event-stage-640.webp', w2: 640, h2: 853 },
  { v: 'Anniversary Celebration', t: 'Anniversary', sub: '', img: '/assets/venue/banquet/banquet-stage-01-480.webp', w: 480, img2: '/assets/venue/banquet/banquet-stage-01-720.webp', w2: 720, h2: 960 },
  { v: 'Kitty Party / Family Reunion', t: 'Family get-together', sub: 'Kitty party · Reunion', img: '/assets/venue/interior/long-table-dining-480.webp', w: 480, img2: '/assets/venue/interior/long-table-dining-720.webp', w2: 720, h2: 960 },
];
// FAQ rendered below and sent to Base for FAQPage JSON-LD (kit 48). TODO(client): confirm the 30% advance deposit
const faq = [
  { q: 'What is the advance payment to lock a banquet date?', a: 'A 30% advance deposit secures your date on the Fursat banquet calendar. The remaining balance is payable on or before the day of the event.' },
  { q: 'Is outside decor or photography permitted?', a: 'Yes, you are welcome to bring your preferred decorator or photographer. We also have seasoned in-house empanelled vendors with attractive bundled pricing.' },
  { q: 'Can alcohol be served at private banquet events?', a: 'Yes! We have full bar license support. For private banquet bookings, we can provide liquor packages or coordinate special event permits (Form-24).' },
];
import { existsSync as feHas } from 'node:fs';
const FE_TIC = ['<svg viewBox="0 0 24 24" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M4 20h16M5 20v-6a2 2 0 0 1 2-2h10a2 2 0 0 1 2 2v6M5 16c2 1.2 3.5 1.2 5 0s3.5-1.2 5 0 3 1.2 4 0M12 12V8M12 5.6c.9-.8.9-1.8 0-2.6-.9.8-.9 1.8 0 2.6Z"/></svg>', '<svg viewBox="0 0 24 24" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><circle cx="9" cy="14.5" r="5"/><circle cx="15" cy="14.5" r="5"/><path d="m7.5 7 1.5-2.5L10.5 7"/></svg>', '<svg viewBox="0 0 24 24" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="7" width="18" height="13" rx="2"/><path d="M9 7V5a1 1 0 0 1 1-1h4a1 1 0 0 1 1 1v2M3 12.5h18"/></svg>', '<svg viewBox="0 0 24 24" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M12 20s-7.5-4.5-7.5-10.2A4.2 4.2 0 0 1 12 7.3a4.2 4.2 0 0 1 7.5 2.5C19.5 15.5 12 20 12 20Z"/></svg>', '<svg viewBox="0 0 24 24" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><circle cx="8" cy="8" r="3"/><circle cx="16.5" cy="8" r="3"/><path d="M2.5 19.5a5.5 5.5 0 0 1 11 0M11 19.5a5.5 5.5 0 0 1 11 0"/></svg>'];
const FE_M = '/assets/brand/mascot/';
const FE_W = feHas('public' + FE_M + 'welcome-720.webp');
const FE_N = feHas('public' + FE_M + 'namaste-720.webp');
---
<Base
  faq={faq}
  title="Banquet Hall – Fursat Kitchen & Bar, Madhapur Events"
  description="Host your wedding, corporate event, or milestone celebration at Fursat's grand banquet hall in Madhapur. Packages from ₹925 per person."
  canonical="https://fursatind.in/banquet/"
  ogImage="https://fursatind.in/assets/venue/banquet/banquet-tables-05.webp"
  ogImageAlt="Fursat Banquet Hall — grand event space in Madhapur Hyderabad"
  preloadImages={[{ href: '/assets/heroes/banquet-phone-780.webp', media: '(max-width: 820px)', type: 'image/webp' }, { href: '/assets/heroes/banquet-1536.webp', media: '(min-width: 821px)', type: 'image/webp' }]}
>
  <SiteHeader active="banquet" variant="plaster" />

  <main class="bq-page" id="main">
    <CornerHero page="banquet" manual id="bq-h1" kicker="Banquet hall · Capital Park"
      h1a="The Grand Banquet" h1b="at Fursat"
      lead="Birthdays, weddings and corporate events in Madhapur, with buffet packages from ₹925 per guest. Craft your feast below and send it on WhatsApp."
      alt="The Fursat banquet hall set with long red and gold tables, framed in gold"
      ctas={[{ label: 'Craft your feast', href: '#feast', primary: true }, { label: 'Lock your date', href: '#lock-date' }, { label: 'See the celebrations at Fursat', href: '#film', film: true }]}>
      <Fragment slot="art">
        {/* 4th slide: the silent banquet loop, shown only inside the hero window (same mask as the art). Loaded when the browser is idle (see the script below). */}
        <div class="bq-sneak" aria-hidden="true">
          <video class="bq-sneak-v" muted loop playsinline preload="none" disablepictureinpicture tabindex="-1" width="1920" height="1080" data-src="/assets/video/banquet-loop-v1.mp4" data-poster="/assets/video/banquet-loop-poster-v1.jpg"></video>
        </div>
        <div class="bq-box">
          <div class="bq-sweep" aria-hidden="true"><i></i></div>
          <div class="bq-shade"></div>
          <button class="bq-hit" type="button" tabindex="-1" aria-hidden="true"></button>
          <div class="bq-story" role="group" aria-label="Hero slides">
            {[0, 1, 2, 3].map((i) => <button class="bq-seg" type="button" data-i={i} aria-label={i < 3 ? `Show photo ${i + 1} of 4` : 'Show the sneak peek'}><span aria-hidden="true"><b></b></span></button>)}
          </div>
          <div class="bq-capwrap">
            <div class="bq-a" aria-hidden="true">
              <p class="bq-t">{words('Elegance in every detail').map((w, i) => <><b class="bq-w" style={`--i:${i}`}>{w}</b>{' '}</>)}</p>
              <p class="bq-n">{['Main banquet floor', 'Grand dinner seating', 'Table layout'].map((t) => <span>{words(t).map((w, i) => <><b class="bq-w" style={`--i:${i + 4}`}>{w}</b>{' '}</>)}</span>)}</p>
            </div>
            <div class="bq-b">
              <p class="bq-n bq-n--s" aria-hidden="true">{words('Sneak peek').map((w, i) => <><b class="bq-w" style={`--i:${i}`}>{w}</b>{' '}</>)}</p>
              <button class="bq-play" type="button" aria-label="Play the Fursat celebrations film with sound"><i aria-hidden="true"><svg viewBox="0 0 24 24"><path d="M9 6.5v11l9-5.5z" /></svg></i><span aria-hidden="true">{words('See the celebrations at Fursat').map((w, i) => <><b class="bq-w" style={`--i:${i + 2}`}>{w}</b>{' '}</>)}</span></button>
            </div>
          </div>
        </div>
      </Fragment>
      {/* TODO(client): confirm the capacity line (350 floating / 220 round-table, dual 4K laser projection & AV, valet parking & lift access). Same facts as the old band, now in the hero. */}
      <ul slot="after" class="bq-stats" role="list">
        <li><b class="bq-num" data-to="350">350</b><span>Max floating capacity</span></li>
        <li><b class="bq-num" data-to="220">220</b><span>Round-table seating</span></li>
        <li><b class="bq-num" data-to="4" data-s="K">4K</b><span>Dual laser projection &amp; AV</span></li>
        <li><b class="bq-num" data-to="100" data-s="%">100%</b><span>Valet parking &amp; lift access</span></li>
      </ul>
    </CornerHero>

    <!-- v5.85 banquet film: opens in a dialog with sound (the visitor's tap allows audio). Part 2 adds the silent loop in the new hero. -->
    <dialog class="bq-film" id="film" aria-label="Fursat Banquets film">
      <button class="bq-film-x" type="button" aria-label="Close the film">×</button>
      <video class="bq-film-v" controls playsinline preload="none" poster="/assets/video/banquet-film-poster-v1.jpg" width="1920" height="1080">
        <source src="/assets/video/banquet-film-v2.webm" type="video/webm" />
        <source src="/assets/video/banquet-film-v2.mp4" type="video/mp4" />
      </video>
    </dialog>

    <PackageBuilder />

    <!-- Lock your date: 3-step event flow (F2). Old #enquire links still land here. -->
    <section class="bq-enquiry fe-sec" id="lock-date" aria-labelledby="bq-ld-h">
      <span class="bq-anchor" id="enquire" aria-hidden="true"></span>
      <div class="fe-wrap">
        <div class="fe-stage">
        {FE_W && <img class="fe-side-m" src={FE_M + "welcome-720.webp"} width="720" height="720" alt="" aria-hidden="true" loading="lazy" decoding="async" />}
        <p class="fe-script" aria-hidden="true">Let’s make it <span>special</span></p>
        <div class="fk-f-card fe-card" data-step="1" style="--fe-tk-photo:url(/assets/venue/banquet/banquet-hall-04-480.webp)">
          <h2 class="fe-h2" id="bq-ld-h">Lock your <em>date</em></h2>

          <form class="fe-form" id="bq-form" action="https://wa.me/919059670033" target="_blank" data-wa-form data-wa-intro="Hi Fursat! 👋 I would like to enquire about the banquet hall:" data-last-hour={lastHour} novalidate>
            <input type="checkbox" name="botcheck" tabindex="-1" autocomplete="off" aria-hidden="true" style="position:absolute;left:-9999px;width:1px;height:1px;opacity:0">

            <p class="fk-f-steplabel fe-steplabel fe-sr" id="fe-steplabel" aria-live="polite">Step 1 of 3 · Occasion</p>
            <ol class="fe-steps" aria-hidden="true"><li data-n="1"><i><b>1</b><svg viewBox="0 0 24 24"><path d="m5 12.5 4.5 4.5L19 7.5" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"/></svg></i><span>Occasion</span></li><li data-n="2"><i><b>2</b><svg viewBox="0 0 24 24"><path d="m5 12.5 4.5 4.5L19 7.5" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"/></svg></i><span>Date &amp; Guests</span></li><li data-n="3"><i><b>3</b><svg viewBox="0 0 24 24"><path d="m5 12.5 4.5 4.5L19 7.5" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"/></svg></i><span>Details</span></li></ol>
            <div class="fk-f-progress fe-prog" aria-hidden="true"><i id="fe-bar"></i></div>

            <div class="fe-vp">
              <!-- 1 · occasion -->
              <section class="fe-step is-active" data-step="1" aria-labelledby="fe-s1-h">
                <h3 class="fe-q" id="fe-s1-h" tabindex="-1">What are you <em>celebrating?</em></h3>
                <p class="fe-qsub">Pick the closest one, or skip.</p>
                <div class="fe-tiles" role="radiogroup" aria-labelledby="fe-s1-h" id="fe-tiles">
                  {occasions.map((o, i) => (
                    <label class="fe-tile" style={`--i:${i}`}>
                      <input type="radio" name="fe-occ" value={o.v} data-t={o.t} />
                      <img src={o.img} srcset={`${o.img} ${o.w}w, ${o.img2} ${o.w2}w`} sizes="(max-width: 700px) 46vw, 250px" width={o.w2} height={o.h2} alt="" loading="lazy" decoding="async" />
                      <span class="fe-tile-txt"><b><span class="fe-tic" set:html={FE_TIC[i]} />{o.t}</b>{o.sub && <small>{o.sub}</small>}</span>
                      <span class="fe-tile-ring" aria-hidden="true"></span>
                      <span class="fe-tile-ck" aria-hidden="true"><svg viewBox="0 0 24 24"><path d="m5 12.5 4.5 4.5L19 7.5" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"/></svg></span>
                    </label>
                  ))}
                  {FE_W && <img class="fe-masc fe-masc-w fe-masc--cell" src={FE_M + "welcome-480.webp"} srcset={`${FE_M}welcome-480.webp 480w, ${FE_M}welcome-720.webp 720w`} sizes="(max-width: 700px) 46vw, 260px" width="720" height="720" alt="" aria-hidden="true" loading="lazy" decoding="async" />}
                </div>
                <input type="hidden" id="fe-occ" name="occasion" data-l="Occasion" value="" />
                <div class="fe-actions">
                  <button type="button" class="fk-f-btn fk-f-btn--ghost fe-sec2 fe-skip" data-go="2" data-skip>Skip</button>
                  <FeGo tone="red" label="Next: date &amp; guests" id="fe-next1" data-go="2" disabled />
                </div>
              </section>

              <!-- 2 · live ticket, date, guests, package -->
              <section class="fe-step" data-step="2" aria-label="Date and guests" inert>
                <div class="fe-tk-slot"></div>

                <div class="fe-sechead">
                  <span class="fe-lab" id="eq-date-l">Preferred date <span aria-hidden="true">*</span></span>
                  <span class="fe-weeknav"><button type="button" class="fe-link" id="fe-week-prev" hidden><span aria-hidden="true">←</span> Earlier</button><button type="button" class="fe-link" id="fe-week-next">Next week <span aria-hidden="true">→</span></button></span>
                </div>
                <div class="fe-days" role="group" aria-labelledby="eq-date-l" id="fe-days"></div>
                <button type="button" class="fe-pick" id="fe-pick" aria-expanded="false" aria-controls="eq-date">
                  <svg viewBox="0 0 24 24" aria-hidden="true"><rect x="3.5" y="5" width="17" height="15.5" rx="3" fill="none" stroke="currentColor" stroke-width="2"/><path d="M3.5 10h17M8 3v4M16 3v4" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"/></svg>
                  Pick a date
                </button>
                <input type="date" id="eq-date" name="date" class="fk-f-field fe-date" data-l="Date" data-v="date" aria-required="true" aria-labelledby="eq-date-l" aria-describedby="eq-date-e" hidden />
                <p class="fk-f-err fe-err" id="eq-date-e" role="alert"></p>

                <div class="fe-sechead fe-gap">
                  <label class="fe-lab" for="eq-guests">Approx. guest count <span aria-hidden="true">*</span></label>
                  <span class="fe-hint">Minimum 30</span>
                </div>
                <div class="fk-f-panel fe-guests">
                  <div class="fk-f-step fe-step-g">
                    <button type="button" id="fe-minus" aria-label="Fewer guests">−</button>
                    <input type="number" id="eq-guests" name="guests" inputmode="numeric" min="30" max="400" data-l="Guests" data-v="count" aria-required="true" aria-describedby="eq-guests-e" placeholder="100" />
                    <button type="button" id="fe-plus" aria-label="More guests">+</button>
                  </div>
                </div>
                <p class="fk-f-err fe-err fe-guests-err" id="eq-guests-e" role="alert"></p>

                <div class="fe-sechead fe-gap"><label class="fe-lab" for="eq-package">Interested package <span class="fk-f-opt">(optional)</span></label></div>
                <select id="eq-package" name="package" class="fk-f-field" data-l="Package" data-fk-sheet>
                  {pkgOpts.map((o: any) => <option value={o.text} data-pkg={o.id}>{o.text}</option>)}
                  <option value="Customized Menu">Customized Menu Requirements</option>
                </select>

                <div class="fe-sum" id="fe-sum"><div class="fe-sum-clip"><p class="fe-sum-p" id="fe-sum-p" aria-live="polite"><span data-s="occ" hidden><span class="fe-sw" data-tk="occ"></span></span><span data-s="date" hidden><span class="fe-sw" data-tk="date"></span></span><span data-s="guests" hidden><span class="fe-odo" data-tk="guests">—</span> guests</span></p></div></div>

                <div class="fe-actions">
                  <button type="button" class="fk-f-btn fk-f-btn--ghost fe-sec2 fe-back" data-go="1" aria-label="Back to occasion"><span aria-hidden="true">←</span> Back</button>
                  <FeGo label="Continue" data-go="3" />
                </div>
              </section>

              <!-- 3 · details -->
              <section class="fe-step" data-step="3" aria-labelledby="fe-s3-h" inert>
                <div class="fe-tk-slot"></div>
                <h3 class="fe-q fe-q--sm" id="fe-s3-h" tabindex="-1">Your <em>details</em></h3>

                <div class="fk-f-remember fe-remember" id="fe-remember" hidden>
                  <span>Booking as <b id="fe-rname"></b></span>
                  <button type="button" id="fe-clear">Not you? Clear</button>
                </div>

                <div class="fk-f-stack fe-fields">
                <div>
                  <div class="fe-fl">
                    <input type="text" id="eq-name" name="name" class="fk-f-field" placeholder=" " autocomplete="name" maxlength="40" data-l="Name" data-v="text" aria-required="true" aria-describedby="eq-name-e" data-msg="Please enter your name." />
                    <label class="fe-fl-lab" for="eq-name">Full name <span aria-hidden="true">*</span></label>
                    <svg class="fe-ok" viewBox="0 0 24 24" aria-hidden="true"><path d="m5 12.5 4.5 4.5L19 7.5" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"/></svg>
                  </div>
                  <p class="fk-f-err fe-err" id="eq-name-e" role="alert"></p>
                </div>
                <div>
                  <div class="fe-fl">
                    <input type="tel" id="eq-phone" name="phone" class="fk-f-field" placeholder=" " autocomplete="tel" inputmode="numeric" maxlength="14" data-l="Phone" data-v="phone" aria-required="true" aria-describedby="eq-phone-e" />
                    <label class="fe-fl-lab" for="eq-phone">Mobile / WhatsApp number <span aria-hidden="true">*</span></label>
                    <svg class="fe-ok" viewBox="0 0 24 24" aria-hidden="true"><path d="m5 12.5 4.5 4.5L19 7.5" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"/></svg>
                  </div>
                  <p class="fk-f-err fe-err" id="eq-phone-e" role="alert"></p>
                </div>
                <div>
                  <div class="fe-fl">
                    <input type="email" id="eq-email" name="email" class="fk-f-field" placeholder=" " autocomplete="email" data-l="Email" />
                    <label class="fe-fl-lab" for="eq-email">Email <span class="fk-f-opt">(optional)</span></label>
                    <svg class="fe-ok" viewBox="0 0 24 24" aria-hidden="true"><path d="m5 12.5 4.5 4.5L19 7.5" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"/></svg>
                  </div>
                </div>
                </div>

                <div class="fe-actions fe-actions--col">
                  <span class="fe-ring" id="fe-ring"><FeGo type="submit" label="Lock my date on WhatsApp" id="fe-send" icon="wa" /></span>
                  <div class="fe-row2">
                    <button type="button" class="fk-f-btn fk-f-btn--ghost fe-sec2 fe-back" data-go="2" aria-label="Back to date and guests"><span aria-hidden="true">←</span> Back</button>
                    <a class="fk-f-btn fk-f-btn--ghost fe-sec2 fe-sec2--r fe-call" href="tel:+919059670033"><svg viewBox="0 0 24 24" aria-hidden="true" class="fe-call-ic"><path d="M6.6 3.8 8.9 3.3c.5-.1 1 .2 1.2.6l1.2 2.9c.2.5.1 1-.3 1.3L9.5 9.4a11 11 0 0 0 5.1 5.1l1.3-1.5c.3-.4.9-.5 1.3-.3l2.9 1.2c.5.2.7.7.6 1.2l-.5 2.3c-.1.5-.6.9-1.1.9A16.3 16.3 0 0 1 5.7 4.9c0-.5.4-1 .9-1.1Z" fill="currentColor"/></svg>Call Fursat</a>
                  </div>
                </div>
                <p class="fk-f-fine">Your enquiry opens in WhatsApp. Banquet desk: +91 90596 70033.{/* TODO(client): a second Banquet-desk number was removed here: unconfirmed (Google shows only the main number). Add it back only after the client confirms it. */}</p>
              </section>
            </div>

            <!-- shown after a successful send -->
            <div class="fe-done" id="fe-done" hidden>
              <span class="fe-done-arch" aria-hidden="true">{FE_N && <img class="fe-masc-n" src={FE_M + "namaste-480.webp"} srcset={`${FE_M}namaste-480.webp 480w, ${FE_M}namaste-720.webp 720w`} sizes="240px" width="720" height="720" alt="" loading="lazy" decoding="async" />}<span class="fe-confetti"><i style="--k:0"></i><i style="--k:1"></i><i style="--k:2"></i><i style="--k:3"></i><i style="--k:4"></i><i style="--k:5"></i><i style="--k:6"></i><i style="--k:7"></i><i style="--k:8"></i><i style="--k:9"></i><i style="--k:10"></i><i style="--k:11"></i></span></span>
              <span class="fe-done-ring"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="m5.5 12.5 4.2 4.2L18.5 7.8" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"/></svg></span>
              <p class="fe-done-t" role="status">Opening WhatsApp…</p>
              <a class="fe-link" id="fe-done-wa" href="https://wa.me/919059670033" target="_blank" rel="noopener">Not opening? Tap here</a>
              <span class="fe-or" aria-hidden="true">or</span>
