<script>
/* Hosted at Fursat: tiles rise in (stagger) when the strip scrolls into view. Transform + opacity only. */
const bqh = document.getElementById('bq-hosted');
if (bqh) {
  const go = () => {
    bqh.classList.remove('bq-hosted--pre');
    bqh.querySelectorAll<HTMLElement>('.cvt').forEach((t, i) => t.animate([{ opacity: 0, transform: 'translateY(22px)' }, { opacity: 1, transform: 'translateY(0)' }], { duration: 320, delay: i * 55, easing: 'cubic-bezier(0.23, 1, 0.32, 1)', fill: 'backwards' }));
  };
  if ('IntersectionObserver' in window) {
    const io = new IntersectionObserver((es) => { if (es.some((e) => e.isIntersecting)) { io.disconnect(); go(); } }, { rootMargin: '0px 0px -12% 0px' });
