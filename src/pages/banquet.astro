<script>
  const form = document.querySelector('form[data-wa-form]');
  if (form) {
    const fields = Array.from(form.querySelectorAll('input:not([name=botcheck]), select'));
    const digits = (v) => { let x = v.replace(/\D/g, ''); if (x.length > 10 && x.startsWith('91')) x = x.slice(2); if (x.length === 11 && x[0] === '0') x = x.slice(1); return x; };
    const today = () => { const d = new Date(); d.setMinutes(d.getMinutes() - d.getTimezoneOffset()); return d.toISOString().slice(0, 10); };
    const errOf = (el) => document.getElementById(el.getAttribute('aria-describedby') || '');
    const check = (el) => {
      const v = el.value.trim(), t = el.dataset.v;
      if (t === 'text') return v.length < 2 ? el.dataset.msg : '';
      if (t === 'phone') return /^[6-9]\d{9}$/.test(digits(v)) ? '' : 'Please enter a valid 10-digit mobile number.';
      if (t === 'count') { const n = Number(v), lo = Number(el.min), hi = Number(el.max); return n >= lo && n <= hi ? '' : 'Please enter ' + lo + ' to ' + hi + ' guests.'; }
      if (t === 'date') return v && v >= today() ? '' : 'Please choose today or a later date.';
      return '';
    };
    const show = (el, msg) => { const e = errOf(el); if (msg) el.setAttribute('aria-invalid', 'true'); else el.removeAttribute('aria-invalid'); if (e) e.textContent = msg; };
    const dateEl = form.querySelector('input[type="date"]');
    if (dateEl) dateEl.min = today();
    /* date chips: This Sat / Next Sat set the date, Pick a date reveals the picker */
    const iso = (d) => { d.setMinutes(d.getMinutes() - d.getTimezoneOffset()); return d.toISOString().slice(0, 10); };
    const sat = (k) => { const d = new Date(); d.setHours(12, 0, 0, 0); d.setDate(d.getDate() + ((6 - d.getDay() + 7) % 7 || 7) + 7 * (k - 1)); return d; };
    const dChips = [...form.querySelectorAll('#bq-date-chips .bq-chip')];
    const fmt = (d) => d.toLocaleDateString('en-IN', { day: 'numeric', month: 'short' });
    dChips.forEach((c) => { if (c.dataset.q === 'sat1') c.querySelector('small').textContent = fmt(sat(1)); if (c.dataset.q === 'sat2') c.querySelector('small').textContent = fmt(sat(2)); });
    const pickDate = (c) => {
      dChips.forEach((x) => x.setAttribute('aria-checked', x === c ? 'true' : 'false'));
      const q = c.dataset.q; dateEl.hidden = q !== 'pick';
      if (q === 'pick') { dateEl.value = ''; dateEl.focus(); try { dateEl.showPicker && dateEl.showPicker(); } catch (x) {} }
      else { dateEl.value = iso(sat(q === 'sat1' ? 1 : 2)); }
      if (dateEl.hasAttribute('aria-invalid')) show(dateEl, '');
    };
    dChips.forEach((c) => c.addEventListener('click', () => pickDate(c)));
    dateEl.addEventListener('change', () => { const c = dChips.find((x) => x.dataset.q === 'pick'); const sm = c.querySelector('small'); sm.textContent = dateEl.value ? fmt(new Date(dateEl.value + 'T00:00')) : ''; });
    /* occasion chips (radio group -> hidden field) */
    const occ = form.querySelector('#eq-event'), oChips = [...form.querySelectorAll('#bq-occ-chips .bq-chip')];
    oChips.forEach((c) => c.addEventListener('click', () => { oChips.forEach((x) => x.setAttribute('aria-checked', x === c ? 'true' : 'false')); occ.value = c.dataset.v; }));
    /* arrow keys move inside each chip group */
    form.querySelectorAll('.bq-chips').forEach((g) => g.addEventListener('keydown', (e) => {
      const k = e.key, cs = [...g.querySelectorAll('.bq-chip')], i = cs.indexOf(document.activeElement); if (i < 0) return;
      const j = k === 'ArrowRight' || k === 'ArrowDown' ? i + 1 : k === 'ArrowLeft' || k === 'ArrowUp' ? i - 1 : null; if (j === null) return;
      e.preventDefault(); const n = cs[(j + cs.length) % cs.length]; n.focus(); n.click();
    }));
    /* guests stepper: 30-400, steps of 10 */
    const gEl = form.querySelector('#eq-guests');
    const stepG = (d) => { const v = parseInt(gEl.value, 10); const n = Number.isFinite(v) ? v + d : (d > 0 ? 50 : 30); gEl.value = Math.min(400, Math.max(30, n)); if (gEl.hasAttribute('aria-invalid')) show(gEl, ''); };
    form.querySelector('#eq-minus').addEventListener('click', () => stepG(-10));
    form.querySelector('#eq-plus').addEventListener('click', () => stepG(10));
    /* package prefilled from the Craft your feast choice */
    const pkgSel = form.querySelector('#eq-package');
    document.addEventListener('pb:pkg', (e) => { const o = [...pkgSel.options].find((x) => x.dataset.pkg === e.detail.id); if (o) pkgSel.value = o.value; });
    fields.forEach((el) => {
      if (!el.dataset.v) return;
      el.addEventListener('input', () => { if (el.hasAttribute('aria-invalid')) show(el, ''); });
      el.addEventListener('change', () => { if (el.hasAttribute('aria-invalid')) show(el, ''); });
    });
    form.addEventListener('submit', (e) => {
      e.preventDefault();
      let first = null;
      fields.forEach((el) => { if (!el.dataset.v) return; const m = check(el); show(el, m); if (m && !first) first = el; });
      if (first) { (first.hidden ? dChips[0] : first).focus(); return; }
      const lines = [form.dataset.waIntro], sent = {};
      fields.forEach((el) => {
        const t = el.dataset.v; let v = el.value.trim();
        if (el.type === 'email' && !v) return; // optional: only sent when filled
        if (t === 'phone') { const x = digits(v); v = '+91 ' + x.slice(0, 5) + ' ' + x.slice(5); }
        else if (t === 'date') v = new Date(v + 'T00:00').toLocaleDateString('en-IN', { weekday: 'short', day: 'numeric', month: 'short', year: 'numeric' });
        else if (el.tagName === 'SELECT') v = el.selectedOptions[0].textContent.trim();
        lines.push('\u2022 ' + el.dataset.l + ': ' + v);
        sent[el.dataset.l] = v;
      });
      window.fkForm?.send('events', 'Banquet enquiry', sent, form.querySelector('[name=botcheck]'));
      window.open('https://wa.me/919059670033?text=' + encodeURIComponent(lines.join('\n')), '_blank', 'noopener');
    });
  }
</script>
