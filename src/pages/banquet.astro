---
// banquet.astro - The Royal Banquet Hall at Fursat
// Hero, photos, capacity line, event packages, sample menu & enquiry form
// TODO(client): confirm the capacity line (350 floating / 220 round-table, dual 4K laser projection & AV, valet parking & lift access) and the 30% advance deposit in the FAQ. Kept as the owner decided.
import InstaFollow from '../components/InstaFollow.astro';
import Base from '../layouts/Base.astro';
import '../styles/fk-tokens.css';
import SiteHeader from '../components/SiteHeader.astro';
import SiteFooter from '../components/SiteFooter.astro';
import MobileBar from '../components/MobileBar.astro';
import MascotOfferModal from '../components/MascotOfferModal.astro';
import PackageBuilder from '../components/banquet/PackageBuilder.astro';
import CornerHero from '../components/CornerHero.astro';
import CelebrationViewer from '../components/CelebrationViewer.astro';
import InstagramFeed from '../components/InstagramFeed.astro';
const words = (t: string) => t.split(' ');
import partyData from '../data/party.json';
const inr = (n: number) => '₹' + n.toLocaleString('en-IN');
const pkgOpts = (partyData as any).packages.filter((p: any) => p.group === 'banquet').sort((a: any, b: any) => a.price - b.price).map((p: any) => ({ id: p.id, text: `${inr(p.price)} ${p.veg ? 'Veg' : 'Non-veg'} package` }));
const occasions = ['Birthday Celebration', 'Wedding / Sangeet / Reception', 'Corporate Gala / Seminar', 'Anniversary Celebration', 'Kitty Party / Family Reunion'];
---
<Base
  title="Banquet Hall – Fursat Kitchen & Bar, Madhapur Events"
  description="Host your wedding, corporate event, or milestone celebration at Fursat's grand banquet hall in Madhapur. Packages from ₹925 per person."
  canonical="https://fursatind.in/banquet/"
  ogImage="https://fursatind.in/assets/venue/banquet/banquet-tables-05.webp"
  ogImageAlt="Fursat Banquet Hall — grand event space in Madhapur Hyderabad"
  preloadImages={[{ href: '/assets/heroes/banquet-768.webp', media: '(max-width: 820px)', type: 'image/webp' }, { href: '/assets/heroes/banquet-1536.webp', media: '(min-width: 821px)', type: 'image/webp' }]}
>
  <SiteHeader active="banquet" variant="plaster" />

  <main class="bq-page" id="main">
    <CornerHero page="banquet" manual id="bq-h1" kicker="Banquet hall · Capital Park"
      h1a="The Grand Banquet" h1b="at Fursat"
      lead="Birthdays, weddings and corporate events in Madhapur, with buffet packages from ₹925 per guest. Craft your feast below and send it on WhatsApp."
      alt="The Fursat banquet hall set with long red and gold tables, framed in gold"
      ctas={[{ label: 'Craft your feast', href: '#feast', primary: true }, { label: 'Lock your date', href: '#lock-date' }, { label: 'See the celebrations at Fursat', href: '#film', film: true }]}>
      <Fragment slot="art">
        {/* 4th slide: the silent banquet loop, shown only inside the hero window (same mask as the art). Loaded when the browser is idle (see the script below). */}
        <div class="bq-sneak" aria-hidden="true">
          <video class="bq-sneak-v" muted loop playsinline preload="none" disablepictureinpicture tabindex="-1" width="1920" height="1080" data-src="/assets/video/banquet-loop-v1.mp4" data-poster="/assets/video/banquet-loop-poster-v1.jpg"></video>
        </div>
        <div class="bq-box">
          <div class="bq-sweep" aria-hidden="true"><i></i></div>
          <div class="bq-shade"></div>
          <button class="bq-hit" type="button" tabindex="-1" aria-hidden="true"></button>
          <div class="bq-story" role="group" aria-label="Hero slides">
            {[0, 1, 2, 3].map((i) => <button class="bq-seg" type="button" data-i={i} aria-label={i < 3 ? `Show photo ${i + 1} of 4` : 'Show the sneak peek'}><span aria-hidden="true"><b></b></span></button>)}
          </div>
          <div class="bq-capwrap">
            <div class="bq-a" aria-hidden="true">
              <p class="bq-t">{words('Elegance in every detail').map((w, i) => <><b class="bq-w" style={`--i:${i}`}>{w}</b>{' '}</>)}</p>
              <p class="bq-n">{['Main banquet floor', 'Grand dinner seating', 'Table layout'].map((t) => <span>{words(t).map((w, i) => <><b class="bq-w" style={`--i:${i + 4}`}>{w}</b>{' '}</>)}</span>)}</p>
            </div>
            <div class="bq-b">
              <p class="bq-n bq-n--s" aria-hidden="true">{words('Sneak peek').map((w, i) => <><b class="bq-w" style={`--i:${i}`}>{w}</b>{' '}</>)}</p>
              <button class="bq-play" type="button" aria-label="Play the Fursat celebrations film with sound"><i aria-hidden="true"><svg viewBox="0 0 24 24"><path d="M9 6.5v11l9-5.5z" /></svg></i><span aria-hidden="true">{words('See the celebrations at Fursat').map((w, i) => <><b class="bq-w" style={`--i:${i + 2}`}>{w}</b>{' '}</>)}</span></button>
            </div>
          </div>
        </div>
      </Fragment>
      {/* TODO(client): confirm the capacity line (350 floating / 220 round-table, dual 4K laser projection & AV, valet parking & lift access). Same facts as the old band, now in the hero. */}
      <ul slot="after" class="bq-stats" role="list">
        <li><b class="bq-num" data-to="350">350</b><span>Max floating capacity</span></li>
        <li><b class="bq-num" data-to="220">220</b><span>Round-table seating</span></li>
        <li><b class="bq-num" data-to="4" data-s="K">4K</b><span>Dual laser projection &amp; AV</span></li>
        <li><b class="bq-num" data-to="100" data-s="%">100%</b><span>Valet parking &amp; lift access</span></li>
      </ul>
    </CornerHero>

    <!-- v5.85 banquet film: opens in a dialog with sound (the visitor's tap allows audio). Part 2 adds the silent loop in the new hero. -->
    <dialog class="bq-film" id="film" aria-label="Fursat Banquets film">
      <button class="bq-film-x" type="button" aria-label="Close the film">×</button>
      <video class="bq-film-v" controls playsinline preload="none" poster="/assets/video/banquet-film-poster-v1.jpg" width="1920" height="1080">
        <source src="/assets/video/banquet-film-v2.webm" type="video/webm" />
        <source src="/assets/video/banquet-film-v2.mp4" type="video/mp4" />
      </video>
    </dialog>

    <PackageBuilder />

    <!-- Lock your date (old #enquire links still land here) -->
    <section class="bq-enquiry" id="lock-date" aria-labelledby="bq-ld-h">
      <span class="bq-anchor" id="enquire" aria-hidden="true"></span>
      <div class="bq-container bq-enquiry-wrap">
        <div class="bq-enquiry-card">
          <div class="bq-eq-head">
            <span class="fk-ty-label bq-kicker">RESERVE YOUR DATE</span>
            <h2 class="fk-ty-h2" id="bq-ld-h">Lock your date</h2>
            <p>Tell us about your celebration and we will share availability and a quotation.</p>
          </div>

          <form class="bq-form" id="bq-form" action="https://wa.me/919059670033" target="_blank" data-wa-form data-wa-intro="Hi Fursat! 👋 I would like to enquire about the banquet hall:" novalidate>
            <input type="checkbox" name="botcheck" tabindex="-1" autocomplete="off" aria-hidden="true" style="position:absolute;left:-9999px;width:1px;height:1px;opacity:0">
            <p class="bq-req">Fields marked * are required.</p>
            <div class="bq-form-row">
              <div class="bq-form-field">
                <label for="eq-name">Full name <span aria-hidden="true">*</span></label>
                <input type="text" id="eq-name" name="name" autocomplete="name" maxlength="40" data-l="Name" data-v="text" aria-required="true" aria-describedby="eq-name-e" data-msg="Please enter your name." placeholder="e.g. Rajesh Kumar" />
                <p class="bq-err" id="eq-name-e" role="alert"></p>
              </div>
              <div class="bq-form-field">
                <label for="eq-phone">Mobile / WhatsApp number <span aria-hidden="true">*</span></label>
                <input type="tel" id="eq-phone" name="phone" autocomplete="tel-national" inputmode="numeric" maxlength="14" data-l="Phone" data-v="phone" aria-required="true" aria-describedby="eq-phone-e" placeholder="Your phone number" />
                <p class="bq-err" id="eq-phone-e" role="alert"></p>
              </div>
              <div class="bq-form-field">
                <label for="eq-email">Email <span class="opt">(optional)</span></label>
                <input type="email" id="eq-email" name="email" autocomplete="email" data-l="Email" placeholder="you@example.com" />
              </div>
            </div>

            <div class="bq-form-field">
              <span class="bq-lab" id="eq-date-l">Preferred date <span aria-hidden="true">*</span></span>
              <div class="bq-chips" role="radiogroup" aria-labelledby="eq-date-l" id="bq-date-chips">
                <button type="button" class="bq-chip" role="radio" aria-checked="false" data-q="sat1"><b>This Sat</b><small></small></button>
                <button type="button" class="bq-chip" role="radio" aria-checked="false" data-q="sat2"><b>Next Sat</b><small></small></button>
                <button type="button" class="bq-chip" role="radio" aria-checked="false" data-q="pick"><b>Pick a date</b><small></small></button>
              </div>
              <input type="date" id="eq-date" name="date" class="bq-date" data-l="Date" data-v="date" aria-required="true" aria-labelledby="eq-date-l" aria-describedby="eq-date-e" hidden />
              <p class="bq-err" id="eq-date-e" role="alert"></p>
            </div>

            <div class="bq-form-field">
              <span class="bq-lab" id="eq-event-l">Occasion</span>
              <div class="bq-chips" role="radiogroup" aria-labelledby="eq-event-l" id="bq-occ-chips">
                {occasions.map((o, i) => <button type="button" class="bq-chip bq-chip--o" role="radio" aria-checked={i === 0 ? 'true' : 'false'} data-v={o}>{o}</button>)}
              </div>
              <input type="hidden" id="eq-event" name="occasion" data-l="Occasion" value={occasions[0]} />
            </div>

            <div class="bq-form-row">
              <div class="bq-form-field">
                <label for="eq-guests">Approx. guest count <span aria-hidden="true">*</span></label>
                <div class="bq-step">
                  <button type="button" id="eq-minus" aria-label="Fewer guests">−</button>
                  <input type="number" id="eq-guests" name="guests" inputmode="numeric" min="30" max="400" data-l="Guests" data-v="count" aria-required="true" aria-describedby="eq-guests-e" placeholder="e.g. 100" />
                  <button type="button" id="eq-plus" aria-label="More guests">+</button>
                </div>
                <p class="bq-err" id="eq-guests-e" role="alert"></p>
              </div>
              <div class="bq-form-field">
                <label for="eq-package">Interested package (optional)</label>
                <select id="eq-package" name="package" data-l="Package" data-fk-sheet>
                  {pkgOpts.map((o: any) => <option value={o.text} data-pkg={o.id}>{o.text}</option>)}
                  <option value="Customized Menu">Customized Menu Requirements</option>
                </select>
              </div>
            </div>
            <button type="submit" class="bq-lock">
              <svg viewBox="0 0 24 24" aria-hidden="true"><path fill="currentColor" d="M12.04 2C6.58 2 2.13 6.45 2.13 11.91c0 1.75.46 3.45 1.32 4.95L2.05 22l5.25-1.37a9.9 9.9 0 0 0 4.74 1.2c5.46 0 9.91-4.45 9.91-9.91C21.95 6.45 17.5 2 12.04 2z"/></svg>
              <span>Lock my date on WhatsApp</span>
            </button>
            <p class="bq-direct-call">
              Your enquiry opens in WhatsApp. Prefer to call? Reach our Banquet desk at <a href="tel:+919059670033">+91 90596 70033</a>.{/* TODO(client): a second Banquet-desk number was removed here: unconfirmed (Google shows only the main number). Add it back only after the client confirms it. */}
            </p>
          </form>
        </div>
      </div>
    </section>

    <!-- Hosted at Fursat: real event photos, swipe row + full-screen viewer (shared CelebrationViewer) -->
    <section class="bq-hosted bq-hosted--pre" id="bq-hosted" aria-labelledby="bq-hosted-h">
      <div class="bq-container">
        <h2 class="fk-ty-h2 bq-sec-title text-center" id="bq-hosted-h">Hosted at Fursat</h2>
        <p class="bq-hosted-sub">Felicitations, talks, corporate meets and private parties.</p>
      </div>
      <ul class="cv-strip" data-cv-group="banquet" aria-label="Photos of events hosted at Fursat">
        <li><button type="button" class="cvt" data-cv-full="/assets/celebrations/felicitation-group-stage-640.webp" data-cv-alt="A felicitation group photo on the stage at Fursat" data-cv-w="640" data-cv-h="853" aria-haspopup="dialog"><img src="/assets/celebrations/felicitation-group-stage-640.webp" srcset="/assets/celebrations/felicitation-group-stage-360.webp 360w, /assets/celebrations/felicitation-group-stage-640.webp 640w" sizes="(max-width: 767px) 62vw, 236px" alt="A felicitation group photo on the stage at Fursat" width="640" height="853" loading="lazy" decoding="async" /></button></li>
        <li><button type="button" class="cvt" data-cv-full="/assets/celebrations/talk-event-stage-640.webp" data-cv-alt="A talk on stage with the audience seated in banquet chairs" data-cv-w="640" data-cv-h="853" aria-haspopup="dialog"><img src="/assets/celebrations/talk-event-stage-640.webp" srcset="/assets/celebrations/talk-event-stage-360.webp 360w, /assets/celebrations/talk-event-stage-640.webp 640w" sizes="(max-width: 767px) 62vw, 236px" alt="A talk on stage with the audience seated in banquet chairs" width="640" height="853" loading="lazy" decoding="async" /></button></li>
        <li><button type="button" class="cvt" data-cv-full="/assets/celebrations/corporate-audience-stage-640.webp" data-cv-alt="A corporate audience seated in the hall facing a lit stage" data-cv-w="640" data-cv-h="853" aria-haspopup="dialog"><img src="/assets/celebrations/corporate-audience-stage-640.webp" srcset="/assets/celebrations/corporate-audience-stage-360.webp 360w, /assets/celebrations/corporate-audience-stage-640.webp 640w" sizes="(max-width: 767px) 62vw, 236px" alt="A corporate audience seated in the hall facing a lit stage" width="640" height="853" loading="lazy" decoding="async" /></button></li>
        <li><button type="button" class="cvt" data-cv-full="/assets/celebrations/hall-audience-cheering-640.webp" data-cv-alt="A packed audience cheering in the Fursat hall" data-cv-w="640" data-cv-h="853" aria-haspopup="dialog"><img src="/assets/celebrations/hall-audience-cheering-640.webp" srcset="/assets/celebrations/hall-audience-cheering-360.webp 360w, /assets/celebrations/hall-audience-cheering-640.webp 640w" sizes="(max-width: 767px) 62vw, 236px" alt="A packed audience cheering in the Fursat hall" width="640" height="853" loading="lazy" decoding="async" /></button></li>
        <li><button type="button" class="cvt" data-cv-full="/assets/celebrations/private-party-entrance-sign-640.webp" data-cv-alt="A Private Party sign at the hall entrance" data-cv-w="640" data-cv-h="853" aria-haspopup="dialog"><img src="/assets/celebrations/private-party-entrance-sign-640.webp" srcset="/assets/celebrations/private-party-entrance-sign-360.webp 360w, /assets/celebrations/private-party-entrance-sign-640.webp 640w" sizes="(max-width: 767px) 62vw, 236px" alt="A Private Party sign at the hall entrance" width="640" height="853" loading="lazy" decoding="async" /></button></li>
      </ul>
    </section>
    <CelebrationViewer />

    <!-- FAQ -->
<InstagramFeed account="banquets" layout="page" title="Latest from Fursat Banquets" />
<InstaFollow handle="fursatbanquets" />
    <section class="bq-faq">
      <div class="bq-container bq-faq-inner">
        <h2 class="fk-ty-h2 bq-sec-title text-center">Banquet FAQs</h2>
        <div class="bq-faq-list">
          <details class="bq-faq-item">
            <summary>What is the advance payment to lock a banquet date?</summary>
            <!-- TODO(client): confirm the 30% advance deposit -->
            <p>A 30% advance deposit secures your date on the Fursat banquet calendar. The remaining balance is payable on or before the day of the event.</p>
          </details>
          <details class="bq-faq-item">
            <summary>Is outside decor or photography permitted?</summary>
            <p>Yes, you are welcome to bring your preferred decorator or photographer. We also have seasoned in-house empanelled vendors with attractive bundled pricing.</p>
          </details>
          <details class="bq-faq-item">
            <summary>Can alcohol be served at private banquet events?</summary>
            <p>Yes! We have full bar license support. For private banquet bookings, we can provide liquor packages or coordinate special event permits (Form-24).</p>
          </details>
        </div>
      </div>
    </section>
  </main>
<style is:global>
  .bq-film { width: min(94vw, 1180px); max-width: none; padding: 0; border: 0; border-radius: 18px; background: #0d1308; overflow: hidden; box-shadow: 0 30px 80px rgba(0,0,0,.5); }
  .bq-film::backdrop { background: rgba(10,14,8,.78); }
  .bq-film-v { display: block; width: 100%; height: auto; aspect-ratio: 16 / 9; background: #0d1308; }
  .bq-film-x { position: absolute; top: 10px; right: 10px; z-index: 2; width: 44px; height: 44px; border: 0; border-radius: 50%; background: rgba(246,230,209,.92); color: #17200f; font-size: 26px; line-height: 1; cursor: pointer; }
  .bq-film-x:focus-visible { outline: 2px solid #c99a43; outline-offset: 2px; }
</style>
<script is:inline>
  /* Film dialog (with sound) + the hero: 4-slide rotation (3 photos 6 s, sneak-peek loop 8 s), stats count-up. All motion runs for every visitor (owner rule). */
  (function () {
    var d = document.getElementById('film'), hero = document.querySelector('.ch[data-manual]');
    var v = d && d.querySelector('video'), opener = null;
    function open(e, from) {
      if (e) e.preventDefault(); if (!d || !d.showModal) return;
      opener = from || (e && e.currentTarget) || document.activeElement;
      try { d.showModal(); } catch (x) { return; }
      try { dispatchEvent(new CustomEvent('fk:music', { detail: { id: 'film' } })); } catch (x) {}   /* SOUND-CONTRACT: other tracks stop */
      var p = v.play(); if (p && p.catch) p.catch(function () {});
      if (hero) hero.dispatchEvent(new Event('bq:hold'));
    }
    if (d && d.showModal) {
      document.querySelectorAll('a[href="#film"]').forEach(function (a) { a.addEventListener('click', open); });
      var play = document.querySelector('.bq-play'), hit = document.querySelector('.bq-hit');
      if (play) play.addEventListener('click', function (e) { open(e, play); });
      if (hit) hit.addEventListener('click', function (e) { open(e, play); });
      d.querySelector('.bq-film-x').addEventListener('click', function () { d.close(); });
      d.addEventListener('click', function (e) { if (e.target === d) d.close(); });
      d.addEventListener('close', function () {
        v.pause();
        var back = opener && opener.offsetParent !== null && !opener.hasAttribute('aria-hidden') ? opener : document.querySelector('a[href="#film"]');
        if (back && back.focus) back.focus({ preventScroll: true });
        if (hero) hero.dispatchEvent(new Event('bq:release'));
      });
      if (location.hash === '#film') open();
    }

    /* ---- stats: count up once when they come into view ---- */
    var nums = [].slice.call(document.querySelectorAll('.bq-num[data-to]'));
    function count(el) {
      var to = +el.dataset.to, suf = el.dataset.s || '', t0 = 0, dur = 1400;
      function f(t) { if (!t0) t0 = t; var k = Math.min(1, (t - t0) / dur), e = 1 - Math.pow(1 - k, 3); el.textContent = Math.round(to * e) + suf; if (k < 1) requestAnimationFrame(f); }
      el.textContent = '0' + suf; requestAnimationFrame(f);
    }
    if ('IntersectionObserver' in window && nums.length) {
      var io = new IntersectionObserver(function (es) { es.forEach(function (e) { if (e.isIntersecting) { io.unobserve(e.target); count(e.target); } }); }, { threshold: 0.6 });
      nums.forEach(function (n) { io.observe(n); });
    }

    /* ---- hero rotation: 3 photos (6 s) + sneak-peek loop (8 s), with Ken Burns, blur cross-fade, gold sweep, story bar and rising captions ---- */
    if (!hero) return;
    var imgs = [hero.querySelector('.ch-img:not(.ch-alt)')].concat([].slice.call(hero.querySelectorAll('.ch-alt')));
    var sneak = hero.querySelector('.bq-sneak'), vid = hero.querySelector('.bq-sneak-v');
    var box = hero.querySelector('.bq-box'), sweep = hero.querySelector('.bq-sweep'), segs = [].slice.call(hero.querySelectorAll('.bq-seg'));
    var photoN = imgs.length, N = photoN + (vid ? 1 : 0), cur = 0, vis = true, held = false, timer = 0, vidLoaded = false;
    var kb = [], fx = false, remain = 6000, t0 = 0, running = false;
    var saveData = !!(navigator.connection && navigator.connection.saveData);
    var idle = window.requestIdleCallback || function (f) { setTimeout(f, 1500); };
    var dur = function (n) { return n === photoN ? 8000 : 6000; };
    function loadAlts() { imgs.slice(1).forEach(function (im) { if (im.dataset.srcset && !im.getAttribute('src')) { im.srcset = im.dataset.srcset; im.src = im.dataset.srcset.split(' ')[0]; } }); }
    function loadVideo() {
      if (!vid || vidLoaded) return; vidLoaded = true;
      vid.poster = vid.dataset.poster;                       /* poster only when idle, never on first load */
      if (saveData) return;                                   /* Save-Data: no auto video, slide 4 shows the poster */
      var webm = vid.dataset.src.replace(/\.mp4$/, '.webm');
      vid.src = vid.canPlayType('video/webm; codecs="vp9"') ? webm : vid.dataset.src; vid.preload = 'auto';
      vid.addEventListener('canplay', playVid, { once: true }); vid.load();   /* plays at once if the sneak peek is already on screen */
    }
    function canRun() { return vis && !document.hidden && !held; }
    function playVid() { if (vid && cur === photoN && vid.src && !saveData) { var p = vid.play(); if (p && p.catch) p.catch(function () {}); } }
    function pauseNow() { if (running) { remain = Math.max(0, remain - (performance.now() - t0)); running = false; } clearTimeout(timer); hero.classList.add('is-paused'); if (vid && !vid.paused) vid.pause(); }
    function runNow() { if (running || !fx) return; hero.classList.remove('is-paused'); t0 = performance.now(); running = true; clearTimeout(timer); timer = setTimeout(tick, remain); playVid(); }
    function sync() { if (canRun()) runNow(); else pauseNow(); }
    function restart(el, cls) { el.classList.remove(cls); void el.offsetWidth; el.classList.add(cls); }
    function paintBar(n) {
      segs.forEach(function (sg, i) { sg.classList.remove('is-done', 'is-act'); sg.removeAttribute('aria-current'); sg.style.setProperty('--d', dur(i) + 'ms'); });
      segs.forEach(function (sg, i) { if (i < n) sg.classList.add('is-done'); });
      if (segs[n]) { void segs[n].offsetWidth; segs[n].classList.add('is-act'); segs[n].setAttribute('aria-current', 'true'); }
    }
    function fxIn(n, from) {
      if (!fx) return;
      restart(hero, 'is-cap'); if (sweep) restart(sweep, 'is-go'); paintBar(n);
      kb.forEach(function (l) { l.classList.remove('is-top', 'is-first'); });
      if (n < photoN && kb[n] && kb[n].firstChild.complete && kb[n].firstChild.naturalWidth) {
        var k = kb[n];
        if (from === photoN) kb.forEach(function (l) { l.classList.remove('is-on'); });
        k.classList.remove('is-on'); void k.offsetWidth; k.classList.add('is-on', 'is-top');
        setTimeout(function () { kb.forEach(function (l, i) { if (i !== cur) l.classList.remove('is-on'); }); }, 1400);
      }
    }
    function show(n) {
      if (n < photoN) {
