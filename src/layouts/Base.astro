---
import AskFab from '../components/AskFab.astro';
import InstaFab from '../components/InstaFab.astro';
import WaAgent from '../components/WaAgent.astro';
import fs from 'node:fs';
import ld from '../data/ld.json';
import site from '../data/site.json';
import seo from '../data/seo.json';
import foodData from '../data/food.json';
import drinksData from '../data/drinks.json'; // counts for {food} / {drinks} in seo.json
import '../styles/01.css';
import '../styles/02.css';
import '../styles/03.css';
import '../styles/04.css';
import '../styles/05.css';
import '../styles/06.css';
import '../styles/07.css';
import '../styles/08.css';
import '../styles/09.css';
import '../styles/10.css';
import '../styles/motion.css';
import '../styles/fk-wow.css';
import '../styles/fk-form.css'; // one white + red look for every form (22 Nov)

const DOMAIN = site.domain;
const PUBLIC = `${process.cwd()}/public`;

// Image dimensions from the file header (webp / jpeg / png), so og:image:width/height are true.
function imgDims(file: string): [number, number] | null {
  try {
    const b = fs.readFileSync(file);
    if (b.toString('ascii', 0, 4) === 'RIFF' && b.toString('ascii', 8, 12) === 'WEBP') {
      const t = b.toString('ascii', 12, 16);
      if (t === 'VP8 ') return [b.readUInt16LE(26) & 0x3fff, b.readUInt16LE(28) & 0x3fff];
      if (t === 'VP8L') return [1 + (((b[22] & 0x3f) << 8) | b[21]), 1 + (((b[24] & 0xf) << 10) | (b[23] << 2) | ((b[22] & 0xc0) >> 6))];
      if (t === 'VP8X') return [1 + b.readUIntLE(24, 3), 1 + b.readUIntLE(27, 3)];
    }
    if (b.toString('ascii', 1, 4) === 'PNG') return [b.readUInt32BE(16), b.readUInt32BE(20)];
    if (b[0] === 0xff && b[1] === 0xd8) {
      let i = 2;
      while (i < b.length) {
        if (b[i] !== 0xff) { i++; continue; }
        const m = b[i + 1];
        if (m >= 0xc0 && m <= 0xcf && m !== 0xc4 && m !== 0xc8 && m !== 0xcc) return [b.readUInt16BE(i + 7), b.readUInt16BE(i + 5)];
        i += 2 + b.readUInt16BE(i + 2);
      }
    }
  } catch { /* fall through */ }
  return null;
}

// Resolve a site image URL to a file that exists in public/. Pages pass /assets/fursat_space_NN.webp but the photos live in
// /assets/interior/, so try that folder too. A missing file falls back to /og-image.jpg and warns, so a 404 never ships.
const FALLBACK_OG = '/og-image.jpg';
const FALLBACK_OG_ALT = 'A hammered brass bowl of biryani topped with fried onions and herbs';
function resolveImage(url: string): string {
  const rel = url.startsWith(DOMAIN) ? url.slice(DOMAIN.length) : url;
  for (const c of [rel, rel.replace('/assets/', '/assets/interior/')]) {
    if (c.startsWith('/') && fs.existsSync(PUBLIC + c)) return c;
  }
  console.warn(`[Base] og:image not found in public/: ${url}. Using ${FALLBACK_OG}`);
  return FALLBACK_OG;
}

// JSON-LD. One Restaurant node built from site.json (name, phone, PIN, hours, map, menu URL) on every page, plus the WebSite node.
// Static facts that are not in site.json (description, cuisines, street, social profiles) come from ld.json. No ratings or reviews:
// none are confirmed. The build stops if any TODO value would reach the page.
const restaurantBase: any = (ld as any[]).find((n: any) => n['@type'] === 'Restaurant');
const phones = Array.from(new Set(['+' + site.phonePlain, ...[].concat(restaurantBase.telephone)]));
const graph = (ld as any[]).map((node: any) => {
  if (node['@type'] !== 'Restaurant') return node;
  return {
    ...node,
    name: site.name,
    alternateName: site.shortName,
    url: DOMAIN + '/',
    image: DOMAIN + resolveImage(node.image),
    logo: DOMAIN + resolveImage(node.logo),
    telephone: phones,
    address: { ...node.address, addressRegion: site.address.state, postalCode: site.address.pin },
    openingHoursSpecification: site.hours.schedule.map((h: any) => ({ '@type': 'OpeningHoursSpecification', dayOfWeek: h.dayOfWeek, opens: h.opens, closes: h.closes })),
    geo: { '@type': 'GeoCoordinates', latitude: site.address.geo.lat, longitude: site.address.geo.lng },
    hasMap: site.address.googleMaps,
    acceptsReservations: true,
    menu: DOMAIN + '/menu/',
  };
});
const ldJson = JSON.stringify(graph);
if (/TODO/i.test(ldJson)) throw new Error('[Base] JSON-LD contains a TODO value. Fill it in ld.json / site.json or remove the field.');

interface PreloadImage {
  href: string;
  media?: string;
  type?: string;
}

interface Props {
  title?: string;
  description?: string;
  canonical?: string;
  ogImage?: string;
  ogImageAlt?: string;
  pageType?: string;
  preloadImage?: PreloadImage;
  preloadImages?: PreloadImage[];
  noindex?: boolean;
  faq?: { q: string; a: string }[]; // FAQPage JSON-LD, built from the same array the page renders
}

// Canonical defaults to this page's own URL (with trailing slash), never to the home page.
const ownUrl = DOMAIN + (Astro.url.pathname.endsWith('/') ? Astro.url.pathname : Astro.url.pathname + '/');

const {
  title: titleProp = 'Fursat Kitchen & Bar – Café, Bar & Banquet in Madhapur',
  description: descriptionProp = 'Fursat Kitchen | Bar at Capital Park, Madhapur, Hyderabad: a café, kitchen, bar and banquet space.',
  canonical = ownUrl,
  noindex = false,
  ogImage: ogImageProp = DOMAIN + FALLBACK_OG,
  ogImageAlt: ogImageAltProp,
  pageType = 'website',
  preloadImage,
  preloadImages = preloadImage ? [preloadImage] : [],
  faq,
} = Astro.props;

// Per-page SEO from src/data/seo.json (looked up by path). It wins over a title, description or og image a page passes.
// Tokens: {hours} {opens} come from site.json, {food} {drinks} are counted from food.json / drinks.json. A page that is not in seo.json (the 404)
// keeps what it passes. og images are the 1200x630 PNGs in public/og/ (made by scripts/og-build.mjs).
const count = (l: any[]) => l.reduce((n, sec) => n + sec.items.length, 0);
const tokens: Record<string, string> = { hours: site.hours.display, opens: site.hours.schedule[0].open, food: String(count(foodData as any[])), drinks: String(count(drinksData as any[])) };
const fill = (t: string) => t.replace(/\{(\w+)\}/g, (m, k) => tokens[k] ?? (() => { throw new Error(`[Base] unknown token ${m} in seo.json`); })());
const seoKey = Astro.url.pathname.endsWith('/') ? Astro.url.pathname : Astro.url.pathname + '/';
const seoPage: any = (seo as any).pages[seoKey];
const ogFile = seoPage ? `/og/${seoKey === '/' ? 'home' : seoKey.replace(/\//g, '')}-${(seo as any).ogVersion}.png` : null;
if (ogFile && !fs.existsSync(PUBLIC + ogFile)) throw new Error(`[Base] og image missing: public${ogFile}. Run: node scripts/og-build.mjs`);
const title = seoPage ? fill(seoPage.title) : titleProp;
const description = seoPage ? fill(seoPage.description) : descriptionProp;
const ogImage = ogFile ? DOMAIN + ogFile : ogImageProp;
const ogImageAlt = seoPage ? seoPage.alt : ogImageAltProp;

// og:image is always a real file in public/. The alt is the page's own text, except for the shared fallback photo,
// whose alt always describes what the photo shows (pages that reuse it used to pass an elephant caption that did not match).
const ogPath = resolveImage(ogImage);
const ogUrl = DOMAIN + ogPath;
const ogAlt = ogPath === FALLBACK_OG ? FALLBACK_OG_ALT : (ogImageAlt ?? title);
const ogDims = imgDims(PUBLIC + ogPath);

// BreadcrumbList for inner pages (Home > Page). Label = the title up to the first " – ", so it always matches the page.
// Skipped on the home page and on noindex pages (404). Same site, no visual change: it is JSON-LD only.
const crumbPath = Astro.url.pathname.replace(/\/+$/, '');
const crumbLd = (!noindex && crumbPath && crumbPath !== '/404')
  ? JSON.stringify({
      '@context': 'https://schema.org',
      '@type': 'BreadcrumbList',
      itemListElement: [
        { '@type': 'ListItem', position: 1, name: 'Home', item: DOMAIN + '/' },
        { '@type': 'ListItem', position: 2, name: title.split(' – ')[0].trim(), item: canonical },
      ],
    })
  : '';

// FAQPage JSON-LD from the faq array a page passes (the same array it renders). ExperienceLayout pages emit their own, so they do not pass it.
const faqLd = faq && faq.length
  ? JSON.stringify({ '@context': 'https://schema.org', '@type': 'FAQPage', mainEntity: faq.map((f) => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a } })) })
  : '';
---
<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover"><meta name="color-scheme" content="light"><title>{title}</title>
<meta name="description" content={description}>
<meta name="robots" content={noindex ? "noindex,follow" : "index,follow,max-image-preview:large,max-snippet:-1"}>
{!noindex && <link rel="canonical" href={canonical}>}
<meta name="theme-color" content="#F2EEE4">
<meta name="application-name" content="Fursat">
<meta name="apple-mobile-web-app-title" content="Fursat">
<meta name="format-detection" content="telephone=yes">
<meta name="geo.region" content="IN-TG"><meta name="geo.placename" content="Madhapur, Hyderabad">
<meta property="og:type" content={pageType}><meta property="og:site_name" content="Fursat Kitchen | Bar">
<meta property="og:title" content={title}><meta property="og:description" content={description}>
<meta property="og:url" content={canonical}><meta property="og:locale" content="en_IN">
<meta property="og:image" content={ogUrl}>{ogPath.endsWith('.png') && <meta property="og:image:type" content="image/png">}{ogDims && <meta property="og:image:width" content={String(ogDims[0])}>}{ogDims && <meta property="og:image:height" content={String(ogDims[1])}>}
<meta property="og:image:alt" content={ogAlt}>
<meta name="twitter:card" content="summary_large_image"><meta name="twitter:title" content={title}><meta name="twitter:description" content={description}>
<meta name="twitter:image" content={ogUrl}><meta name="twitter:image:alt" content={ogAlt}>
<link rel="preload" href="/assets/8da3ca8f0a.woff2" as="font" type="font/woff2" crossorigin>
<link rel="preload" href="/assets/1233814dd2.woff2" as="font" type="font/woff2" crossorigin>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,500;0,600;1,500;1,600&family=Poppins:wght@400;500;600&display=swap" media="print" onload="this.media='all'">
<noscript><link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,500;0,600;1,500;1,600&family=Poppins:wght@400;500;600&display=swap"></noscript>
{preloadImages.map(img => (
  <link
    rel="preload"
    as="image"
    href={img.href}
    media={img.media}
    type={img.type || 'image/webp'}
    fetchpriority="high"
  />
))}
<link rel="stylesheet" href="/css/fk-cursor-v3.css">
<link rel="icon" href="/assets/9a3bba811b.webp">
<script type="application/ld+json" is:inline set:html={ldJson}></script>
{crumbLd && <script type="application/ld+json" is:inline set:html={crumbLd}></script>}
{faqLd && <script type="application/ld+json" is:inline set:html={faqLd}></script>}
<script is:inline define:vars={{ fkForms: site.forms }}>window.__FK_FORMS = fkForms;</script>
<script is:inline src="/js/w3f.js" defer></script>
<script is:inline src="/js/fk-ui.js" defer></script>
<script is:inline src="/js/fk-cursor.js" defer></script>
<script is:inline src="/js/fk-fx.js" defer></script>
<style is:global>
@view-transition{navigation:auto}
::view-transition-old(root),::view-transition-new(root){animation-duration:.28s;animation-timing-function:cubic-bezier(.23,1,.32,1)}
@media(prefers-reduced-motion:reduce){@view-transition{navigation:none}}
</style>
<noscript>
<style is:global>
  #intro, #ibox, #gate, #gatebtn, .lcap, .lgo, .lring { display: none !important; }
  .rv { opacity: 1 !important; transform: none !important; }
  .mot-headline, .mot-reveal-img, .mot-card-lit { opacity: 1 !important; clip-path: none !important; transform: none !important; }
  html.lock, body { overflow: auto !important; }
  #site-header.sh-hidden { transform: none !important; opacity: 1 !important; pointer-events: auto !important; }
  .ss-dish, .ss-heading, .ss-para { opacity: 1 !important; transform: none !important; }
  .ms-chew, .ms-cheer { display: none !important; }
</style>
</noscript>
</head>
<body>
<a class="fk-skip" href="#main">Skip to content</a>
<script is:inline>document.addEventListener("DOMContentLoaded",function(){if(!document.getElementById("main")){var m=document.querySelector("main");if(m){if(!m.id)m.id="main";document.querySelector(".fk-skip").href="#"+m.id;if(!m.hasAttribute("tabindex"))m.tabIndex=-1;}}});</script>
<style is:global>.fk-skip{position:fixed;left:12px;top:-70px;z-index:100000;min-height:44px;display:inline-flex;align-items:center;padding:0 20px;border-radius:999px;background:#10261a;color:#f6e6d1;font:600 15px/1 Poppins,system-ui,sans-serif;text-decoration:none;transition:top .2s}.fk-skip:focus{top:12px;outline:2px solid #c99a43;outline-offset:2px}</style>
<slot />
<AskFab />
<InstaFab />
<WaAgent />
</body>
</html>
